  },
  {
    "@id": "https://w3id.org/maestro#Recipe",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://w3id.org/maestro/recipe#Recipe"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "HHM-Core Recipe / ProcessPlan. Not restricted to batch production: its steps are realised by skills and may apply to discrete manufacturing. Disjoint with maestro:PlanStep."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/maestro/hhm/recipe"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Recipe"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/maestro#PlanStep"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Process plan"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "http://www.hsu-ifa.de/ontologies/ISA88.01#RecipeProcedure"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An ordered container of plan steps, each realised by a skill, that describes how a product is made."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "ISA88:RecipeProcedure is the highest level of the procedural control model of the HSU ISA88.01 ODP, describing the execution of an extensive production operation such as the production of a batch. maestro:Recipe is not restricted to batch production."
      }
    ]
  },
