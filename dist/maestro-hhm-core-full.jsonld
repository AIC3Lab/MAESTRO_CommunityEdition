  {
    "@id": "https://w3id.org/maestro#Module",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://w3id.org/maestro/resource#Module"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "HHM-Core Physical Resources cluster. Close match to VDI2206:Module of the HSU VDI 2206 ODP: system elements or components combined into a group that together perform a specific function. Real execution is attached to the module (see maestro:SkillExecution); a digital twin only represents it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/maestro/hhm/resource"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Module"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/maestro#InternalElement"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "http://www.w3id.org/hsu-aut/VDI2206#Module"
      },
      {
        "@id": "http://www.hsu-ifa.de/ontologies/ISA88.01#EquipmentModule"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A reconfigurable, plug-and-produce production module that provides capabilities and executes skills."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "ISA88:EquipmentModule can carry out a finite number of specific minor processing activities and combines the physical processing and control equipment required for them (HSU ISA88.01 ODP). maestro:Module additionally stresses plug-and-produce reconfiguration."
      }
    ]
  },
