  {
    "@id": "https://w3id.org/maestro/hhm",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/conformsTo": [
      {
        "@id": "https://www.w3.org/TR/owl2-profiles/#OWL_2_RL"
      }
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-09-30"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "Melwin Xavier"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "A version of the MAESTRO manufacturing ontology structured after the HHM-Core v1 reference model: product, physical resources, skills, recipe and planning, safety and policy, invocation hooks and minimal execution, with modules for telemetry, energy, maintenance and manufacturing as a service, and extensions for data formats, the digital twin, OPC UA, ISA-88, ISA-95, AutomationML, DTDL, REST, MQTT, DDS, Modbus, PROFINET, EtherCAT, PROV-O and ODRL."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://opensource.org/licenses/MIT"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-09-30"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/melwinxavier/MAESTRO"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "MAESTRO HHM-Core"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "maestro"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://w3id.org/maestro#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "All terms share the namespace https://w3id.org/maestro# (prefix maestro); rdfs:isDefinedBy names the module that defines each term. Definitions are reused from MAESTRO 1.0 wherever a matching term exists (dct:source per term). Standards are referenced only where their ontology design pattern or schema is pinned under references/ in the MAESTRO repository; ECLASS, DPP, PRONTO, CaSkMan, AAS, OpenAPI, SAREF4INMA and XACML are named as hooks and carry no IRIs and no mappings. This file is the merged form of all modules in one document."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "MAESTRO HHM-Core"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://w3id.org/maestro"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/maestro/hhm/0.1.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.1.0"
      }
    ]
  },
