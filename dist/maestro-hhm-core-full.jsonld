[
  {
    "@id": "https://w3id.org/maestro#Protocol",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://w3id.org/maestro/communication#Protocol"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "HHM-Core Invocation Hooks cluster, a controlled vocabulary of individuals. The individuals are declared in the extension modules, one module per protocol (maestro:OpcUaProtocol in ext/opcua.ttl, maestro:HttpProtocol in ext/rest.ttl, maestro:MqttProtocol, maestro:DdsProtocol, maestro:ModbusProtocol, maestro:ProfinetProtocol, maestro:EthercatProtocol in the module of the same name); a knowledge graph may declare further individuals. Transport protocols only: payload encodings are maestro:DataFormat, interface description languages are maestro:InterfaceDescriptionLanguage."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/maestro/hhm/invocation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Protocol"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A transport or application protocol an endpoint speaks."
      }
    ]
  },
