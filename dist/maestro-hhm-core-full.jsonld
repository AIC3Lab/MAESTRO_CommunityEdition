        "@value": "Control-flow constraint"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A constraint on when a plan step runs relative to another step: before it, in parallel with it, as an alternative to it, repeatedly, or optionally."
      }
    ]
  },
