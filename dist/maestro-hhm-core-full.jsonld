      {
        "@language": "en",
        "@value": "HHM-Core Recipe / Planning cluster (ControlFlowConstraint: precedes / parallel / alt / loop / optional). The kind is stated with maestro:flowType, the other step with maestro:relatedStep. MAESTRO 1.0 models the kinds as subclasses of skill:ControlFlow; here they are individuals of maestro:ControlFlowType."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/maestro/hhm/recipe"
      }
    ],
