    <dct:source rdf:resource="https://w3id.org/maestro/maas#listedOn"/>
    <skos:definition xml:lang="en">Relates a service offer to the marketplace it is published on.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ServiceOffer"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Marketplace"/>
  </owl:ObjectProperty>
