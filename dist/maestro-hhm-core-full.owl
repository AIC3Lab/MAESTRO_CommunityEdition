<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:maestro="https://w3id.org/maestro#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:schema="https://schema.org/"
  xmlns:dct="http://purl.org/dc/terms/"
  xmlns:vann="http://purl.org/vocab/vann/"
>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#suppliedBy">
    <skos:definition xml:lang="en">Relates an energy consumer to the energy source that supplies it.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
    <rdfs:label xml:lang="en">supplied by</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/maestro#EnergySource"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#EnergyConsumer"/>
    <dct:source rdf:resource="https://w3id.org/maestro/energy#suppliedBy"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#assumption">
    <rdfs:label xml:lang="en">assumption</rdfs:label>
    <skos:definition xml:lang="en">An assumption the assessment rests on: operating mode, exposure, access.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#RiskAssessment"/>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#assumption"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#affectsAsset">
    <rdfs:label xml:lang="en">affects asset</rdfs:label>
    <skos:definition xml:lang="en">Relates a maintenance action to the module it concerns.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#MaintenanceAction"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Module"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#affectsAsset"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#action">
    <rdfs:label xml:lang="en">action</rdfs:label>
    <skos:definition xml:lang="en">Relates a permission to the action it covers.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/policy#action"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Permission"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Action"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/action"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#riskAssessmentMethod">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">risk assessment method</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#RiskAssessment"/>
    <skos:definition xml:lang="en">The method and version used, stated as free text by the assessor, for example the risk estimation procedure or risk matrix applied.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#riskAssessmentMethod"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#faultSeverity">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Fault"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#FaultSpecification"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#faultSeverity"/>
    <rdfs:label xml:lang="en">fault severity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <skos:definition xml:lang="en">Severity label of the fault, for example warning, error or critical.</skos:definition>
    <rdfs:comment xml:lang="en">Domain left open, as for maestro:faultCode.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#describedIn">
    <dct:source rdf:resource="https://w3id.org/maestro/communication#describedIn"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#InterfaceDescriptionLanguage"/>
    <rdfs:comment xml:lang="en">Domain left open for maestro:SkillInterface and maestro:Binding.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Binding"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#SkillInterface"/>
    <skos:definition xml:lang="en">Relates a skill interface, or a binding, to the language its contract is written in.</skos:definition>
    <rdfs:label xml:lang="en">described in</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#description">
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Feature"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#SafetyFunction"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Hazard"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Mitigation"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Capability"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Risk"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#FaultDiagnosis"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Skill"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Domain left open: used by features, hazards, mitigations, safety functions and other entities.</rdfs:comment>
    <rdfs:label xml:lang="en">description</rdfs:label>
    <skos:definition xml:lang="en">Free-text description of an entity.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/core#description"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/resource"/>
  </owl:DatatypeProperty>
  <owl:AllDifferent rdf:nodeID="n52bdc07484054c9daae5394d1e2e127eb15">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/maestro#OperationalDimension"/>
      <rdf:Description rdf:about="https://w3id.org/maestro#HealthDimension"/>
      <rdf:Description rdf:about="https://w3id.org/maestro#ReservationDimension"/>
      <rdf:Description rdf:about="https://w3id.org/maestro#ModeDimension"/>
    </owl:members>
  </owl:AllDifferent>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#platform">
    <rdfs:label xml:lang="en">platform</rdfs:label>
    <skos:definition xml:lang="en">Name of the twin platform or packaging the binding targets, for example a DTDL-based twin service or an Asset Administration Shell package.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#TwinBinding"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/digital-twin"/>
    <rdfs:comment xml:lang="en">A plain name; naming a platform is not a conformance claim.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#instanceOf">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <rdfs:comment xml:lang="en">HHM-Core edge ParameterValue instanceOf ParameterDef.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ParameterValue"/>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#instanceOf"/>
    <skos:definition xml:lang="en">Relates a parameter value to the parameter definition it instantiates.</skos:definition>
    <rdfs:label xml:lang="en">instance of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ParameterDef"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#appliesTo">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Requirement"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Feature"/>
    <skos:definition xml:lang="en">Relates a requirement to the feature it applies to.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/product#appliesTo"/>
    <rdfs:comment xml:lang="en">HHM-Core edge Requirement appliesTo Feature.</rdfs:comment>
    <rdfs:label xml:lang="en">applies to</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasStep">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <skos:definition xml:lang="en">Relates a recipe to a plan step it contains.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core edge Recipe hasStep PlanStep. Order is stated on the step with maestro:stepOrder and with control-flow constraints.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/maestro#PlanStep"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Recipe"/>
    <dct:source rdf:resource="https://w3id.org/maestro/recipe#hasStep"/>
    <rdfs:label xml:lang="en">has step</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasTelemetry">
    <rdfs:label xml:lang="en">has telemetry</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/maestro#DtdlTelemetry"/>
    <skos:definition xml:lang="en">Relates a DTDL interface to a telemetry it declares.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/dtdl#hasTelemetry"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#DtdlInterface"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dtdl"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#endedAtTime">
    <rdfs:label xml:lang="en">ended at time</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#SkillExecution"/>
    <dct:source rdf:resource="https://w3id.org/maestro/prov#endedAtTime"/>
    <skos:definition xml:lang="en">End timestamp of a skill execution, mapped to prov:endedAtTime on the activity.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/prov"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#endedAtTime"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#realizedByOrder">
    <skos:definition xml:lang="en">Relates a contract to the production order that executes it.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ProductionOrder"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#realizedByOrder"/>
    <rdfs:label xml:lang="en">realized by order</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Contract"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#flowType">
    <rdfs:range rdf:resource="https://w3id.org/maestro#ControlFlowType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ControlFlowConstraint"/>
    <rdfs:label xml:lang="en">flow type</rdfs:label>
    <skos:definition xml:lang="en">Relates a control-flow constraint to its kind.</skos:definition>
    <rdfs:comment xml:lang="en">Implied by the HHM diagram's annotation (precedes / parallel / alt / loop / optional).</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#paramType">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <skos:definition xml:lang="en">Data type of the parameter, given as an XSD datatype IRI (for example xsd:double).</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#paramType"/>
    <rdfs:label xml:lang="en">parameter type</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ParameterDef"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#basedOnOffer">
    <skos:definition xml:lang="en">Relates a quote to the standing offer it was priced from.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#basedOnOffer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ServiceOffer"/>
    <rdfs:label xml:lang="en">based on offer</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Quote"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#stateEvidence">
    <skos:definition xml:lang="en">Relates a state assertion to the execution, event or evidence record it rests on.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#stateEvidence"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Fault"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#SkillExecution"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Evidence"/>
    <rdfs:comment xml:lang="en">Range left open.</rdfs:comment>
    <rdfs:label xml:lang="en">state evidence</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#StateAssertion"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#constrains">
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Skill"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#PlanStep"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Endpoint"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Module"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:label xml:lang="en">constrains</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Constraint"/>
    <rdfs:comment xml:lang="en">HHM-Core edges Constraint constrains Skill / PlanStep / Module / Endpoint. Range left open (a union of targets) to stay within OWL 2 RL.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/core#constrains"/>
    <skos:definition xml:lang="en">Relates a constraint to the target it restricts: a skill, a plan step, a module or an endpoint.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#usesProtocol">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Endpoint"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <skos:definition xml:lang="en">Relates an endpoint to the protocol it uses.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Protocol"/>
    <rdfs:comment xml:lang="en">HHM-Core edge Endpoint usesProtocol Protocol.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#usesProtocol"/>
    <rdfs:label xml:lang="en">uses protocol</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#providedAt">
    <rdfs:comment xml:lang="en">The join to the technical layer; MAESTRO 1.0 names a plant, the HHM-Core package a station.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Station"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ServiceOffer"/>
    <rdfs:label xml:lang="en">provided at</rdfs:label>
    <dct:references rdf:resource="https://w3id.org/maestro/maas#providedAt"/>
    <skos:definition xml:lang="en">Relates a service offer to the station that would do the work.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#requiresCapability">
    <rdfs:label xml:lang="en">requires capability</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#requiresCapability"/>
    <rdfs:comment xml:lang="en">HHM-Core edge Skill requiresCapability Capability. Matched against maestro:providesCapability of a module.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Skill"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Capability"/>
    <skos:definition xml:lang="en">Relates a skill to a capability its executor must provide.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasIdentifier">
    <rdfs:comment xml:lang="en">HHM-Core edges ProductType hasIdentifier Identifier and ProductInstance hasIdentifier Identifier. Domain left open so modules, stations and executions may carry identifiers too; an entity may carry several identifiers from different schemes.</rdfs:comment>
    <rdfs:label xml:lang="en">has identifier</rdfs:label>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#ProductType"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#ProductInstance"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <dct:source rdf:resource="https://w3id.org/maestro/core#hasIdentifier"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Identifier"/>
    <skos:definition xml:lang="en">Relates an entity to a scheme-qualified identifier it carries.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#requiresMode">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Policy"/>
    <skos:definition xml:lang="en">Relates a policy to the operating mode it gates on.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/policy#requiresMode"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Mode"/>
    <rdfs:comment xml:lang="en">HHM-Core edge Policy requiresMode Mode.</rdfs:comment>
    <rdfs:label xml:lang="en">requires mode</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasCommand">
    <rdfs:range rdf:resource="https://w3id.org/maestro#DtdlCommand"/>
    <skos:definition xml:lang="en">Relates a DTDL interface to a command it declares.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dtdl"/>
    <rdfs:label xml:lang="en">has command</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/dtdl#hasCommand"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#DtdlInterface"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#timestamp">
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#PowerMeasurement"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Fault"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#TelemetryEvent"/>
    <rdfs:comment xml:lang="en">Domain left open: used by maestro:Fault, maestro:TelemetryEvent and maestro:PowerMeasurement.</rdfs:comment>
    <skos:definition xml:lang="en">The instant at which an event or an instantaneous measurement occurred.</skos:definition>
    <rdfs:label xml:lang="en">timestamp</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#timestamp"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#modbusCount">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ModbusBinding"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">The number of consecutive coils or registers, from the start address, a Modbus binding reads or writes.</skos:definition>
    <rdfs:label xml:lang="en">Modbus count</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/modbus"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#fromState">
    <rdfs:label xml:lang="en">from state</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#fromState"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <skos:definition xml:lang="en">Relates a state transition to the state left.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#StateTransition"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#State"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#specializesAs">
    <dct:source rdf:resource="https://w3id.org/maestro/communication#specializesAs"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Binding"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Protocol"/>
    <rdfs:label xml:lang="en">specializes as</rdfs:label>
    <skos:definition xml:lang="en">Relates a binding to the concrete protocol it specialises to.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#mtbfHours">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Module"/>
    <rdfs:comment xml:lang="en">Numeric value; the range is rdfs:Literal so decimal, integer, double and float literals are all accepted (checked by the shapes).</rdfs:comment>
    <rdfs:label xml:lang="en">MTBF (hours)</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#mtbfHours"/>
    <skos:definition xml:lang="en">Mean time between failures of a module, in hours.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#endTime">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <rdfs:label xml:lang="en">end time</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#TimeInterval"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#endTime"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <skos:definition xml:lang="en">The instant at which an interval ended.</skos:definition>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasParameterDef">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Skill"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#OperationSignature"/>
    <rdfs:comment xml:lang="en">HHM-Core edge Skill hasParameterDef ParameterDef. Domain left open so an maestro:OperationSignature can declare its input parameters with the same property.</rdfs:comment>
    <skos:definition xml:lang="en">Relates a skill, or an operation signature, to a typed parameter definition it declares.</skos:definition>
    <rdfs:label xml:lang="en">has parameter definition</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#hasParameterDef"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ParameterDef"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasVariant">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ProductType"/>
    <rdfs:comment xml:lang="en">HHM-Core edge ProductType hasVariant Variant, read from the base type. MAESTRO 1.0 reads the inverse, prod:variantOf, from the variant.</rdfs:comment>
    <dct:references rdf:resource="https://w3id.org/maestro/product#variantOf"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Variant"/>
    <rdfs:label xml:lang="en">has variant</rdfs:label>
    <skos:definition xml:lang="en">Relates a product type to one of its variants.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasStatus">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ExecutionStatus"/>
    <rdfs:comment xml:lang="en">HHM-Core edge SkillExecution hasStatus ExecutionStatus.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#SkillExecution"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#hasStatus"/>
    <skos:definition xml:lang="en">Relates an execution to the status it reached.</skos:definition>
    <rdfs:label xml:lang="en">has status</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#stateValue">
    <rdfs:range rdf:resource="https://w3id.org/maestro#State"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#StateAssertion"/>
    <skos:definition xml:lang="en">Relates a state assertion to the state value asserted.</skos:definition>
    <rdfs:label xml:lang="en">state value</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#stateValue"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#mqttTopic">
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#topic">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Moved from core/invocation.ttl, where it sat on maestro:EventStream; a topic is protocol-level, so it now sits on the binding. Protocol modules specialise it: maestro:mqttTopic, maestro:ddsTopic.</rdfs:comment>
        <rdfs:label xml:lang="en">topic</rdfs:label>
        <skos:definition xml:lang="en">The topic, channel or other named destination a binding publishes to or subscribes from.</skos:definition>
        <rdfs:domain rdf:resource="https://w3id.org/maestro#Binding"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/addressing"/>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
    <rdfs:label xml:lang="en">MQTT topic</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#MqttBinding"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/mqtt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">A topic filter may contain the wildcards + (one level) and # (all remaining levels).</rdfs:comment>
    <skos:definition xml:lang="en">The MQTT topic name an MQTT binding publishes to, or the topic filter it subscribes with.</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#serialNumber">
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Module"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#ProductInstance"/>
    <rdfs:comment xml:lang="en">Domain left open: a module and a product instance both carry one.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/resource#serialNumber"/>
    <rdfs:label xml:lang="en">serial number</rdfs:label>
    <skos:definition xml:lang="en">The serial number of a resource or product instance as given by its manufacturer.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hostsInterface">
    <rdfs:range rdf:resource="https://w3id.org/maestro#OpcUaSkillInterface"/>
    <dct:source rdf:resource="https://w3id.org/maestro/opcua#hostsInterface"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/opcua"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#OpcUaServer"/>
    <rdfs:label xml:lang="en">hosts interface</rdfs:label>
    <skos:definition xml:lang="en">Relates an OPC UA server to a skill interface it hosts.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#executedOn">
    <skos:definition xml:lang="en">Relates an execution to the module, or station, the skill ran on.</skos:definition>
    <rdfs:label xml:lang="en">executed on</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#executedOn"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#SkillExecution"/>
    <rdfs:comment xml:lang="en">HHM-Core edge SkillExecution executedOn Module. Range left open so a whole station may be named as executor.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Module"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Station"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#executesRecipe">
    <rdfs:range rdf:resource="https://w3id.org/maestro#Recipe"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ProductionOrder"/>
    <rdfs:label xml:lang="en">executes recipe</rdfs:label>
    <dct:references rdf:resource="https://w3id.org/maestro/recipe#executesRecipe"/>
    <rdfs:comment xml:lang="en">MAESTRO 1.0 relates the executing equipment to the recipe; this package relates the order.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <skos:definition xml:lang="en">Relates a production order to the recipe it executes.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#triggeredBy">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#MaintenanceAction"/>
    <skos:definition xml:lang="en">Relates a maintenance action to the fault that caused the work.</skos:definition>
    <rdfs:label xml:lang="en">triggered by</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Fault"/>
    <dct:references rdf:resource="https://w3id.org/maestro/maintenance#triggeredBy"/>
    <rdfs:comment xml:lang="en">MAESTRO 1.0 also admits state assertions, plan intervals and predictions as triggers; this package narrows it to faults.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#requestedQuantity">
    <skos:definition xml:lang="en">How many units the request covers.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#requestedQuantity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">requested quantity</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ServiceRequest"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#ethercatPosition">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#EthercatBinding"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/ethercat"/>
    <skos:definition xml:lang="en">The position of the SubDevice an EtherCAT binding addresses, counted along the segment from the MainDevice starting at 0.</skos:definition>
    <rdfs:comment xml:lang="en">MainDevice and SubDevice are the current EtherCAT Technology Group terms for what older documents call master and slave.</rdfs:comment>
    <rdfs:label xml:lang="en">EtherCAT position</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasBinding">
    <rdfs:range rdf:resource="https://w3id.org/maestro#Binding"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <skos:definition xml:lang="en">Relates an endpoint to the protocol binding that realises it.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core edge Endpoint hasBinding Binding.</rdfs:comment>
    <rdfs:label xml:lang="en">has binding</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#hasBinding"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Endpoint"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#describesExecution">
    <rdfs:label xml:lang="en">describes execution</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#describesExecution"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <skos:definition xml:lang="en">Relates an execution record to the execution it describes.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/maestro#SkillExecution"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ExecutionRecord"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#diagnosesFault">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#FaultDiagnosis"/>
    <rdfs:comment xml:lang="en">Implied: MAESTRO 1.0 leaves the diagnosis unlinked; this package joins it to the fault.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Fault"/>
    <rdfs:label xml:lang="en">diagnoses fault</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <skos:definition xml:lang="en">Relates a fault diagnosis to the fault occurrence it explains.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#partOfWorkCenter">
    <skos:definition xml:lang="en">Relates a work unit, or a station, to the work centre it belongs to.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/maestro#WorkCenter"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/isa95"/>
    <rdfs:label xml:lang="en">part of work centre</rdfs:label>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/DINEN62264-2#UnitIsPartOfCenter"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#WorkUnit"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Station"/>
    <rdfs:comment xml:lang="en">Domain left open so an maestro:Station can be placed in a work centre without being retyped.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#reduces">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Mitigation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:label xml:lang="en">reduces</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#reduces"/>
    <rdfs:comment xml:lang="en">HHM-Core edge Mitigation reduces Risk.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Risk"/>
    <skos:definition xml:lang="en">Relates a mitigation to a risk it reduces.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#assessesRisk">
    <dct:source rdf:resource="https://w3id.org/maestro/safety#assessesRisk"/>
    <rdfs:label xml:lang="en">assesses risk</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <skos:definition xml:lang="en">Relates a risk assessment to the risk it evaluates.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#RiskAssessment"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Risk"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#leadTimeDays">
    <dct:references rdf:resource="https://w3id.org/maestro/maas#leadTime"/>
    <skos:definition xml:lang="en">Time from acceptance to delivery, in days, as promised by an offer or a quote.</skos:definition>
    <rdfs:label xml:lang="en">lead time (days)</rdfs:label>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#ServiceOffer"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Quote"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <rdfs:comment xml:lang="en">Domain left open for offers and quotes. MAESTRO 1.0 uses a unit-bearing quantity; this package has no unit module.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasSignature">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#OperationSignature"/>
    <skos:definition xml:lang="en">Relates a binding to the operation signature it exposes.</skos:definition>
    <rdfs:label xml:lang="en">has signature</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Binding"/>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#hasSignature"/>
    <rdfs:comment xml:lang="en">Hangs the signature off the binding, so one endpoint can carry several protocol-specific signatures.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:AllDifferent rdf:nodeID="n19c8a3caeb214acea69fd0d8c56e14deb1">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/maestro#ElectricalGrid"/>
      <rdf:Description rdf:about="https://w3id.org/maestro#Solar"/>
      <rdf:Description rdf:about="https://w3id.org/maestro#Wind"/>
