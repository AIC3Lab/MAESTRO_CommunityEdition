    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/permission"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#nodeId">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#OpcUaNode"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/opcua"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://w3id.org/maestro/opcua#nodeId"/>
    <skos:definition xml:lang="en">The node id of an OPC UA node, as a string.</skos:definition>
    <rdfs:label xml:lang="en">node id</rdfs:label>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="https://w3id.org/maestro/hhm">
    <rdfs:seeAlso rdf:resource="https://w3id.org/maestro"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-30</dct:modified>
    <owl:versionIRI rdf:resource="https://w3id.org/maestro/hhm/0.1.0"/>
    <dct:creator>Melwin Xavier</dct:creator>
    <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/maestro#</vann:preferredNamespaceUri>
    <dct:license rdf:resource="https://opensource.org/licenses/MIT"/>
    <dct:title>MAESTRO HHM-Core</dct:title>
    <vann:preferredNamespacePrefix>maestro</vann:preferredNamespacePrefix>
    <rdfs:comment xml:lang="en">All terms share the namespace https://w3id.org/maestro# (prefix maestro); rdfs:isDefinedBy names the module that defines each term. Definitions are reused from MAESTRO 1.0 wherever a matching term exists (dct:source per term). Standards are referenced only where their ontology design pattern or schema is pinned under references/ in the MAESTRO repository; ECLASS, DPP, PRONTO, CaSkMan, AAS, OpenAPI, SAREF4INMA and XACML are named as hooks and carry no IRIs and no mappings. This file is the merged form of all modules in one document.</rdfs:comment>
    <dct:description xml:lang="en">A version of the MAESTRO manufacturing ontology structured after the HHM-Core v1 reference model: product, physical resources, skills, recipe and planning, safety and policy, invocation hooks and minimal execution, with modules for telemetry, energy, maintenance and manufacturing as a service, and extensions for data formats, the digital twin, OPC UA, ISA-88, ISA-95, AutomationML, DTDL, REST, MQTT, DDS, Modbus, PROFINET, EtherCAT, PROV-O and ODRL.</dct:description>
    <dct:source rdf:resource="https://github.com/melwinxavier/MAESTRO"/>
    <dct:conformsTo rdf:resource="https://www.w3.org/TR/owl2-profiles/#OWL_2_RL"/>
    <rdfs:label xml:lang="en">MAESTRO HHM-Core</rdfs:label>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-30</dct:created>
  </owl:Ontology>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasControlFlow">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#PlanStep"/>
    <dct:source rdf:resource="https://w3id.org/maestro/recipe#hasControlFlow"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ControlFlowConstraint"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
