  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasTask">
    <skos:definition xml:lang="en">Relates a maintenance plan to a task it schedules.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/maestro#MaintenanceTask"/>
    <rdfs:label xml:lang="en">has task</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#hasTask"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#MaintenancePlan"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#offersCapability">
    <dct:source rdf:resource="https://w3id.org/maestro/maas#offersCapability"/>
    <skos:definition xml:lang="en">Relates a service offer to a capability it sells.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Capability"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ServiceOffer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <rdfs:label xml:lang="en">offers capability</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#exposesService">
    <rdfs:label xml:lang="en">exposes service</rdfs:label>
    <skos:definition xml:lang="en">Relates a service offer, or a digital twin, to the skill service it resolves to.</skos:definition>
    <rdfs:comment xml:lang="en">Domain left open: a commercial offer and a digital twin both point at a skill service, so a matched offer can be invoked through its interface and endpoint.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#ServiceOffer"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#DigitalTwin"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#exposesService"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#SkillService"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#mandatory">
    <skos:definition xml:lang="en">Whether a violated or unknown evaluation of this requirement decides the feasibility of a plan. Absent means true.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Requirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <dct:source rdf:resource="https://w3id.org/maestro/product#mandatory"/>
    <rdfs:label xml:lang="en">mandatory</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#performsTask">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#MaintenanceAction"/>
    <skos:definition xml:lang="en">Relates a maintenance action to the planned task it carries out.</skos:definition>
    <rdfs:label xml:lang="en">performs task</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#performsTask"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#MaintenanceTask"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/maestro#MqttBroker">
    <rdfs:comment xml:lang="en">Clients that publish or subscribe reach the broker, not each other; the broker address is the endpoint address.</rdfs:comment>
    <rdfs:label xml:lang="en">MQTT broker</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/mqtt"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Endpoint"/>
    <skos:definition xml:lang="en">An endpoint at which an MQTT broker accepts client connections and forwards each published message to the clients subscribed to its topic.</skos:definition>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#returns">
    <rdfs:range rdf:resource="https://w3id.org/maestro#ParameterDef"/>
    <rdfs:comment xml:lang="en">Input parameters of the signature use maestro:hasParameterDef.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#returns"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#OperationSignature"/>
    <rdfs:label xml:lang="en">returns</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <skos:definition xml:lang="en">Relates an operation signature to a parameter definition it returns.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#powerWatts">
    <rdfs:comment xml:lang="en">Numeric value; range rdfs:Literal for the same reason as maestro:energyKwh.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:label xml:lang="en">power (W)</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
    <skos:definition xml:lang="en">Instantaneous power in watts.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/energy#powerWatts"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#PowerMeasurement"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/maestro#RestInterface">
    <skos:definition xml:lang="en">A skill interface exposed as an HTTP resource with REST-style operations.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#SkillInterface"/>
    <skos:relatedMatch rdf:resource="http://www.w3id.org/hsu-aut/WADL#Resource"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/rest"/>
    <rdfs:comment xml:lang="en">Related to WADL:Resource of the HSU WADL ODP, the URI pattern under which the operations are reached.</rdfs:comment>
    <rdfs:label xml:lang="en">REST interface</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#energyKwh">
    <dct:source rdf:resource="https://w3id.org/maestro/energy#energyKwh"/>
    <rdfs:label xml:lang="en">energy (kWh)</rdfs:label>
    <rdfs:comment xml:lang="en">Numeric value; the range is rdfs:Literal so decimal, integer, double and float literals are all accepted (checked by the shapes).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#EnergyMeasurement"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
    <skos:definition xml:lang="en">Accumulated energy in kilowatt hours.</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#observedAt">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#StateAssertion"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#observedAt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">observed at</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <skos:definition xml:lang="en">When the state was observed, which may differ from when it began.</skos:definition>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#relatedStep">
    <rdfs:comment xml:lang="en">Implied by the HHM diagram: a constraint such as 'precedes' or 'parallel' needs a second step. A loop or optional constraint may omit it.</rdfs:comment>
    <rdfs:label xml:lang="en">related step</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ControlFlowConstraint"/>
    <skos:definition xml:lang="en">Relates a control-flow constraint to the other plan step it relates the constrained step to.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#PlanStep"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#rtsOutcome">
    <rdfs:label xml:lang="en">return-to-service outcome</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ReturnToServiceAssessment"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#rtsOutcome"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ReturnToServiceOutcome"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <skos:definition xml:lang="en">Relates a return-to-service assessment to its outcome.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#requiredValue">
    <dct:references rdf:resource="https://w3id.org/maestro/product#requiredValue"/>
    <rdfs:comment xml:lang="en">MAESTRO 1.0 demands a unit-bearing quantity or an enumerated entity; this package keeps a literal, since it has no unit module.</rdfs:comment>
    <skos:definition xml:lang="en">The value a requirement demands, as a literal.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">required value</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Requirement"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#assessedSubject">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:label xml:lang="en">assessed subject</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#RiskAssessment"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#PlanStep"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Skill"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Station"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Module"/>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#assessedSubject"/>
    <rdfs:comment xml:lang="en">Range left open.</rdfs:comment>
    <skos:definition xml:lang="en">Relates a risk assessment to the module, station, skill or plan step it assesses.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasExecutionHistory">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/digital-twin"/>
    <rdfs:label xml:lang="en">has execution history</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/maestro#SkillExecution"/>
    <rdfs:comment xml:lang="en">HHM edge DigitalTwin hasExecutionHistory SkillExecution.</rdfs:comment>
    <skos:definition xml:lang="en">Relates a digital twin to a skill execution of the entity it represents.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#DigitalTwin"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#mapsTo">
    <rdfs:label xml:lang="en">maps to</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#TwinBinding"/>
    <rdfs:comment xml:lang="en">HHM edge TwinBinding mapsTo AAS / DTDL.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/digital-twin"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <skos:definition xml:lang="en">IRI of the twin model or package the binding maps to, for example a DTDL interface identifier.</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#evidenceRef">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Evidence"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="en">evidence reference</rdfs:label>
    <skos:definition xml:lang="en">IRI of the log, document or observation the evidence refers to.</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#expression">
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Postcondition"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Precondition"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Constraint"/>
    <rdfs:comment xml:lang="en">Domain left open: used by maestro:Precondition, maestro:Postcondition and maestro:Constraint. An evaluator that does not understand the language answers Unknown, never true.</rdfs:comment>
    <skos:definition xml:lang="en">The text of a condition or constraint, in a language the evaluating system understands.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">expression</rdfs:label>
    <dct:references rdf:resource="https://w3id.org/maestro/skill#guardExpression"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#ordersProduct">
    <rdfs:range rdf:resource="https://w3id.org/maestro#ProductType"/>
    <rdfs:label xml:lang="en">orders product</rdfs:label>
