    <skos:definition xml:lang="en">Relates a data binding to the producing (output) parameter definition.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#DataBinding"/>
    <rdfs:label xml:lang="en">binds from</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#bindsFrom"/>
    <rdfs:comment xml:lang="en">Implied by the HHM diagram's annotation (output -&gt; input).</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ParameterDef"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#overInterval">
    <rdfs:label xml:lang="en">over interval</rdfs:label>
    <skos:definition xml:lang="en">Relates an energy measurement to the interval the energy accumulated over.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#EnergyMeasurement"/>
    <dct:source rdf:resource="https://w3id.org/maestro/energy#overInterval"/>
