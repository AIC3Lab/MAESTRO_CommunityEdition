    <rdfs:comment xml:lang="en">The join to an execution's maestro:hasTime.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#model">
    <dct:source rdf:resource="https://w3id.org/maestro/resource#model"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Module"/>
    <skos:definition xml:lang="en">The model designation of a resource as given by its manufacturer.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">model</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/resource"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#mitigates">
    <rdfs:comment xml:lang="en">A mitigation measure acts on a risk through maestro:reduces; a safety function acts on the hazard.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#SafetyFunction"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Hazard"/>
    <skos:definition xml:lang="en">Relates a safety function to the hazard it mitigates.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#mitigates"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:label xml:lang="en">mitigates</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#operates">
    <skos:definition xml:lang="en">Relates an actor to a station it owns and runs.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Actor"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Station"/>
    <dct:references rdf:resource="https://w3id.org/maestro/maas#operates"/>
    <rdfs:label xml:lang="en">operates</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#listedOn">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
