    <dct:source rdf:resource="https://w3id.org/maestro/planning#ordersProduct"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ProductionOrder"/>
  </owl:ObjectProperty>
