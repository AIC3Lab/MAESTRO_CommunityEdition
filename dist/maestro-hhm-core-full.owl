  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#minValue">
    <skos:definition xml:lang="en">Lower bound of the numeric range a parameter definition admits.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#minValue"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ParameterDef"/>
    <rdfs:comment xml:lang="en">Numeric value. The range is rdfs:Literal on purpose: the accepted datatypes are xsd:decimal, xsd:integer, xsd:double and xsd:float, checked by the shapes, so source literals are preserved rather than forced into one XSD family.</rdfs:comment>
    <rdfs:label xml:lang="en">minimum value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </owl:DatatypeProperty>
  <owl:AllDifferent rdf:nodeID="n3562dad4cae54074bc845c4baba0d42cb1">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/maestro#Cleared"/>
      <rdf:Description rdf:about="https://w3id.org/maestro#ConditionallyCleared"/>
      <rdf:Description rdf:about="https://w3id.org/maestro#NotCleared"/>
    </owl:members>
  </owl:AllDifferent>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#identifierScheme">
    <rdfs:label xml:lang="en">identifier scheme</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Identifier"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://w3id.org/maestro/core#identifierScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <skos:definition xml:lang="en">Name of the identifier scheme, for example GTIN, UUID, IRDI or IRI.</skos:definition>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#providesCapability">
    <skos:definition xml:lang="en">Relates a module to a capability it provides.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Capability"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/resource"/>
    <dct:source rdf:resource="https://w3id.org/maestro/resource#providesCapability"/>
    <rdfs:label xml:lang="en">provides capability</rdfs:label>
    <rdfs:comment xml:lang="en">HHM-Core edge Module providesCapability Capability. An asserted capability claim; whether a skill deployed on the module actually realises it is not entailed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Module"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#identifiesHazard">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#RiskAssessment"/>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#identifiesHazard"/>
    <skos:definition xml:lang="en">Relates a risk assessment to a hazard it considered.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Hazard"/>
    <rdfs:label xml:lang="en">identifies hazard</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasPermission">
    <rdfs:label xml:lang="en">has permission</rdfs:label>
    <skos:definition xml:lang="en">Relates a policy to a permission it grants.</skos:definition>
    <rdfs:comment xml:lang="en">What the policy grants; maestro:requiresPermission states what must already be held for the policy to apply.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Policy"/>
    <dct:source rdf:resource="https://w3id.org/maestro/policy#hasPermission"/>
