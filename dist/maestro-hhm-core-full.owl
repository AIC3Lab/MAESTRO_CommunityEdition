  <owl:Class rdf:about="https://w3id.org/maestro#AtomicSkill">
    <skos:definition xml:lang="en">An indivisible skill primitive.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core Skills cluster. Disjoint with maestro:CompositeSkill.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://w3id.org/maestro#CompositeSkill"/>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#AtomicSkill"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Skill"/>
    <rdfs:label xml:lang="en">Atomic skill</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#validFrom">
    <skos:definition xml:lang="en">The instant from which a state assertion holds.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#StateAssertion"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">valid from</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#validFrom"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#maxValue">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <skos:definition xml:lang="en">Upper bound of the numeric range a parameter definition admits.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ParameterDef"/>
    <rdfs:comment xml:lang="en">Numeric value; range rdfs:Literal for the same reason as maestro:minValue.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:label xml:lang="en">maximum value</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#maxValue"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#validTo">
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#validTo"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#StateAssertion"/>
    <rdfs:label xml:lang="en">valid to</rdfs:label>
    <skos:definition xml:lang="en">The instant until which a state assertion held. Absent while the assertion is current.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#startedAtTime">
    <dct:source rdf:resource="https://w3id.org/maestro/prov#startedAtTime"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/prov"/>
    <rdfs:label xml:lang="en">started at time</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#startedAtTime"/>
    <skos:definition xml:lang="en">Start timestamp of a skill execution, mapped to prov:startedAtTime on the activity.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#SkillExecution"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasSubSkillLink">
    <rdfs:comment xml:lang="en">HHM-Core edge CompositeSkill hasSubSkillLink Skill, stated directly between the two skills as the HHM diagram draws it. MAESTRO 1.0 reifies the link (skill:SubSkillLink) so that control flow can attach to it; in this package ordering and control flow belong to the recipe cluster.</rdfs:comment>
    <dct:references rdf:resource="https://w3id.org/maestro/skill#hasSubSkillLink"/>
    <skos:definition xml:lang="en">Relates a composite skill to a skill that is one of its constituents.</skos:definition>
    <rdfs:label xml:lang="en">has sub-skill link</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Skill"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#CompositeSkill"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#requiresPermission">
    <rdfs:label xml:lang="en">requires permission</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/policy#requiresPermission"/>
    <rdfs:comment xml:lang="en">HHM-Core edge Policy requiresPermission Permission.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Policy"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Permission"/>
    <skos:definition xml:lang="en">Relates a policy to a permission that must be held for the policy to apply.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/maestro#OpcUaVariable">
