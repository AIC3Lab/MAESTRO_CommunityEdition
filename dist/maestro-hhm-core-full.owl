    <rdfs:comment xml:lang="en">HHM-Core edge PlanStep hasControlFlow ControlFlowConstraint.</rdfs:comment>
    <rdfs:label xml:lang="en">has control flow</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#nodeFor">
