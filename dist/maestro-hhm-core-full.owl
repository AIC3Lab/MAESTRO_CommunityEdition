    <rdfs:label xml:lang="en">node for</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ProductType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <dct:references rdf:resource="https://w3id.org/maestro/product#nodeFor"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#BOMNode"/>
    <skos:definition xml:lang="en">Relates a bill-of-materials node to the product type it references.</skos:definition>
  </owl:ObjectProperty>
