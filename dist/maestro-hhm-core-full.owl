  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#governedBy">
    <skos:definition xml:lang="en">Relates a contract to the policy that governs it: confidentiality of shared data, permitted roles, permitted operating modes.</skos:definition>
    <rdfs:label xml:lang="en">governed by</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#governedBy"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Contract"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Policy"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#ddsTopic">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dds"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">DDS topic</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#DdsBinding"/>
    <skos:definition xml:lang="en">The name of the DDS topic a DDS binding publishes or subscribes.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/maestro#topic"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#bindsInterface">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#DtdlBinding"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#DtdlInterface"/>
    <rdfs:label xml:lang="en">binds interface</rdfs:label>
    <skos:definition xml:lang="en">Relates a DTDL binding to the DTDL interface it maps the endpoint onto.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dtdl"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#ddsTypeName">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">DDS type name</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#DdsBinding"/>
    <skos:definition xml:lang="en">The name of the data type registered for the topic of a DDS binding.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dds"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasState">
    <rdfs:label xml:lang="en">has state</rdfs:label>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Module"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Station"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#State"/>
    <dct:source rdf:resource="https://w3id.org/maestro/core#hasState"/>
    <skos:definition xml:lang="en">The current operational state of a station or module.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <rdfs:comment xml:lang="en">Shortcut for the open (no validTo) operational maestro:StateAssertion. Domain left open for stations and modules. Use only inside a runtime snapshot graph.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#mayRaiseFault">
    <rdfs:comment xml:lang="en">The potential fault on the specification; the fault that did occur is maestro:mayRaise on the execution.</rdfs:comment>
    <rdfs:label xml:lang="en">may raise fault</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/maestro#FaultSpecification"/>
    <skos:definition xml:lang="en">Relates a skill to a kind of fault it can raise.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Skill"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#mayRaiseFault"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#dueDate">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ProductionOrder"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <rdfs:label xml:lang="en">due date</rdfs:label>
    <skos:definition xml:lang="en">The instant by which a production order is to be completed.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dct:source rdf:resource="https://w3id.org/maestro/planning#dueDate"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hostedOn">
    <rdfs:comment xml:lang="en">Implied: MAESTRO 1.0 places servers on control components; this package has none and names the module.</rdfs:comment>
    <rdfs:label xml:lang="en">hosted on</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/opcua"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#OpcUaServer"/>
    <skos:definition xml:lang="en">Relates an OPC UA server to the module whose controller runs it.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Module"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#partOfSite">
    <rdfs:range rdf:resource="https://w3id.org/maestro#Site"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Area"/>
    <rdfs:label xml:lang="en">part of site</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/isa95"/>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/DINEN62264-2#AreaIsPartOfSite"/>
    <dct:source rdf:resource="https://w3id.org/maestro/planning#partOfSite"/>
    <skos:definition xml:lang="en">Relates an area to the site it belongs to.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#requiresOperation">
    <rdfs:label xml:lang="en">requires operation</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <skos:definition xml:lang="en">Relates a product feature to the plan step that produces it.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/maestro#PlanStep"/>
    <dct:source rdf:resource="https://w3id.org/maestro/recipe#requiresOperation"/>
    <rdfs:comment xml:lang="en">HHM-Core edge Feature requiresOperation PlanStep.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Feature"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#mqttQos">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#MqttBinding"/>
    <skos:definition xml:lang="en">The MQTT quality-of-service level of an MQTT binding: 0 (at most once), 1 (at least once) or 2 (exactly once).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/mqtt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">MQTT QoS</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#offeredBy">
    <rdfs:label xml:lang="en">offered by</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#offeredBy"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ServiceOffer"/>
    <skos:definition xml:lang="en">Relates a service offer to the provider standing behind it.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/maestro#PhysicalResourceProvider"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#urlTemplate">
    <rdfs:label xml:lang="en">URL template</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#RestBinding"/>
    <skos:definition xml:lang="en">The path template, relative to the endpoint address, a REST binding applies its HTTP method to.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/rest"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#modbusAddress">
    <rdfs:comment xml:lang="en">Zero-based protocol address; device manuals often print one-based register numbers such as 40001.</rdfs:comment>
    <rdfs:label xml:lang="en">Modbus address</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ModbusBinding"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">The zero-based start address, within its data table, of the values a Modbus binding reads or writes.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/modbus"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#recordedAt">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <skos:definition xml:lang="en">When a record or assertion was written.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ExecutionRecord"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#recordedAt"/>
    <rdfs:label xml:lang="en">recorded at</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#profinetSubslot">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ProfinetBinding"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/profinet"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">PROFINET subslot</rdfs:label>
    <skos:definition xml:lang="en">The subslot number of the submodule, within its slot, that a PROFINET binding addresses.</skos:definition>
