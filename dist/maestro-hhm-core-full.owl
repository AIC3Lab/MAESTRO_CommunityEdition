    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Skill"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#SkillService"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Endpoint"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Module"/>
    <rdfs:comment xml:lang="en">Range left open: the target may be any entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Permission"/>
    <skos:definition xml:lang="en">Relates a permission to the skill, service, endpoint, module or data set it covers.</skos:definition>
    <rdfs:label xml:lang="en">target</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/target"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#carbonGCO2eqPerKwh">
