  <owl:Class rdf:about="https://w3id.org/maestro#DataFormat">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <rdfs:label xml:lang="en">Data format</rdfs:label>
    <skos:relatedMatch rdf:resource="http://www.w3id.org/hsu-aut/WADL#Representation"/>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#DataFormat"/>
    <skos:definition xml:lang="en">A payload encoding carried over a protocol.</skos:definition>
    <rdfs:comment xml:lang="en">Folded in from the MAESTRO 1.0 communication module, a controlled vocabulary of individuals. The individuals are declared in the extension modules (maestro:JsonFormat, maestro:XmlFormat and maestro:ProtobufFormat in ext/data-formats.ttl, maestro:OpcUaBinaryFormat in ext/opcua.ttl); a knowledge graph may declare further individuals. Related to WADL:Representation of the HSU WADL ODP, which names the media type in which a resource state is represented.</rdfs:comment>
  </owl:Class>
  <maestro:DataFormat rdf:about="https://w3id.org/maestro#OpcUaBinaryFormat">
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: a data format that belongs to one protocol is declared in that protocol's module. An OPC UA binding names it with maestro:usesDataFormat.</rdfs:comment>
    <rdfs:label xml:lang="en">OPC UA Binary</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/opcua"/>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#OpcUaBinaryFormat"/>
    <skos:definition xml:lang="en">The OPC UA binary encoding.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </maestro:DataFormat>
  <owl:Class rdf:about="https://w3id.org/maestro#Capability">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/resource"/>
    <rdfs:label xml:lang="en">Capability</rdfs:label>
    <skos:definition xml:lang="en">A specification of a manufacturing possibility: what a holder can do, independent of how it is done.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/core#Capability"/>
    <rdfs:comment xml:lang="en">HHM-Core Physical Resources cluster. Provided by modules (maestro:providesCapability) and required by skills (maestro:requiresCapability); reusable capability specifications are individuals of this class.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#ReservationDimension">
    <rdf:type rdf:resource="https://w3id.org/maestro#StateDimension"/>
    <skos:definition xml:lang="en">Allocation to orders or requests: Reserved.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#ReservationDimension"/>
    <rdfs:label xml:lang="en">Reservation</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#Module">
    <skos:definition xml:lang="en">A reconfigurable, plug-and-produce production module that provides capabilities and executes skills.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/resource"/>
    <rdfs:comment xml:lang="en">HHM-Core Physical Resources cluster. Close match to VDI2206:Module of the HSU VDI 2206 ODP: system elements or components combined into a group that together perform a specific function. Real execution is attached to the module (see maestro:SkillExecution); a digital twin only represents it.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/resource#Module"/>
    <rdfs:label xml:lang="en">Module</rdfs:label>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/VDI2206#Module"/>
    <skos:closeMatch rdf:resource="http://www.hsu-ifa.de/ontologies/ISA88.01#EquipmentModule"/>
    <skos:scopeNote xml:lang="en">ISA88:EquipmentModule can carry out a finite number of specific minor processing activities and combines the physical processing and control equipment required for them (HSU ISA88.01 ODP). maestro:Module additionally stresses plug-and-produce reconfiguration.</skos:scopeNote>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#InternalElement"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#SkillService">
    <rdfs:label xml:lang="en">Skill service</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#SkillService"/>
    <skos:definition xml:lang="en">A service abstraction that exposes one or more skill interfaces.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core SkillService (drawn in the digital-twin diagram). The commercial face of a service is an maestro:ServiceOffer.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#OperationSignature">
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/WADL#Method"/>
    <skos:definition xml:lang="en">The parameter and return schema of an invocable operation.</skos:definition>
    <rdfs:comment xml:lang="en">Folded in from the MAESTRO 1.0 communication module. Close match to WADL:Method of the HSU WADL ODP, which describes the request and response of an HTTP method applied to a resource. Input parameters use maestro:hasParameterDef, returns use maestro:returns.</rdfs:comment>
    <rdfs:label xml:lang="en">Operation signature</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#OperationSignature"/>
  </owl:Class>
  <maestro:ReturnToServiceOutcome rdf:about="https://w3id.org/maestro#NotCleared">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#NotCleared"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">The asset may not return to service.</skos:definition>
    <rdfs:label xml:lang="en">Not cleared</rdfs:label>
  </maestro:ReturnToServiceOutcome>
  <owl:Class rdf:about="https://w3id.org/maestro#RiskAssessment">
    <rdfs:comment xml:lang="en">Ontology validation does not certify equipment compliance; it records what was assessed, how and on what evidence.</rdfs:comment>
    <rdfs:label xml:lang="en">Risk assessment</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <skos:definition xml:lang="en">A context-specific assessment of the risks to or from a subject, stating its method, assumptions, evidence and the mitigations it relies on.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#RiskAssessment"/>
  </owl:Class>
  <maestro:ExecutionStatus rdf:about="https://w3id.org/maestro#Aborted">
    <rdfs:label xml:lang="en">Aborted</rdfs:label>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/PackML#Aborted"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Aborted"/>
    <rdfs:comment xml:lang="en">Close match to PackML:Aborted, in which the machine keeps status information about the abort condition and leaves the state only after an explicit Clear command.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">The execution was ended abnormally, typically after a fault or an emergency stop.</skos:definition>
    <maestro:inDimension>
      <owl:NamedIndividual rdf:about="https://w3id.org/maestro#OperationalDimension">
        <rdfs:label xml:lang="en">Operational</rdfs:label>
        <rdf:type rdf:resource="https://w3id.org/maestro#StateDimension"/>
        <dct:source rdf:resource="https://w3id.org/maestro/runtime#OperationalDimension"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
        <skos:definition xml:lang="en">Operational state: Available, Busy, Idle, Executing, Held, Aborted, Fault, Alarm.</skos:definition>
      </owl:NamedIndividual>
    </maestro:inDimension>
  </maestro:ExecutionStatus>
  <maestro:ExecutionStatus rdf:about="https://w3id.org/maestro#Held">
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Held"/>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/PackML#Held"/>
    <rdfs:comment xml:lang="en">Close match to PackML:Held of the HSU PackML ODP.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Held</rdfs:label>
    <skos:definition xml:lang="en">Paused because internal conditions of the resource do not allow it to continue; waits to be resumed.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <maestro:inDimension rdf:resource="https://w3id.org/maestro#OperationalDimension"/>
  </maestro:ExecutionStatus>
  <owl:Class rdf:about="https://w3id.org/maestro#MaintenanceAction">
    <rdfs:label xml:lang="en">Maintenance action</rdfs:label>
    <skos:definition xml:lang="en">Maintenance work performed on an asset: an occurrence with duration, trigger, affected asset, findings and a return-to-service assessment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <rdfs:comment xml:lang="en">Its duration is an maestro:TimeInterval through maestro:hasTime.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#MaintenanceAction"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#ModbusProtocol">
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: each protocol individual is declared in the extension module of its protocol. An maestro:ModbusBinding names it with maestro:specializesAs.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/modbus"/>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#ModbusProtocol"/>
    <rdf:type rdf:resource="https://w3id.org/maestro#Protocol"/>
    <skos:definition xml:lang="en">The Modbus protocol.</skos:definition>
    <rdfs:label xml:lang="en">Modbus</rdfs:label>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#JsonFormat">
    <rdf:type rdf:resource="https://w3id.org/maestro#DataFormat"/>
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: data-format individuals are declared in the extension modules.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#JsonFormat"/>
    <skos:definition xml:lang="en">JavaScript Object Notation payloads.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/data-formats"/>
    <rdfs:label xml:lang="en">JSON</rdfs:label>
  </owl:NamedIndividual>
  <maestro:InterfaceDescriptionLanguage rdf:about="https://w3id.org/maestro#AasSubmodelTemplateIDL">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/digital-twin"/>
    <skos:definition xml:lang="en">An interface described as an Asset Administration Shell submodel template. A plain name of the technology; no conformance claim.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: each interface description language is declared in the extension module of its technology. AAS packaging is one of the twin-binding targets the HHM digital-twin diagram names.</rdfs:comment>
    <rdfs:label xml:lang="en">Asset Administration Shell submodel template</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#AasIDL"/>
  </maestro:InterfaceDescriptionLanguage>
  <owl:Class rdf:about="https://w3id.org/maestro#FaultDiagnosis">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <rdfs:comment xml:lang="en">The diagnosing activity itself is not modelled; this class records its result.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#FaultDiagnosis"/>
    <skos:definition xml:lang="en">The record of a fault diagnosis: the recognised fault, its localisation and its identified cause.</skos:definition>
    <rdfs:label xml:lang="en">Fault diagnosis</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Feature">
    <dct:source rdf:resource="https://w3id.org/maestro/product#Feature"/>
    <rdfs:label xml:lang="en">Feature</rdfs:label>
    <skos:definition xml:lang="en">A geometric or functional feature of a product, such as a hole, a slot or a surface.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core Product cluster. A feature may require a plan step that produces it (maestro:requiresOperation).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#InterfaceDescriptionLanguage">
    <dct:source rdf:resource="https://w3id.org/maestro/communication#InterfaceDescriptionLanguage"/>
    <rdfs:label xml:lang="en">Interface description language</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <rdfs:comment xml:lang="en">Folded in from the MAESTRO 1.0 communication module, a controlled vocabulary of individuals. The individuals are declared in the extension module of their technology (maestro:OpcUaNodeSetIDL in ext/opcua.ttl, maestro:DtdlIDL in ext/dtdl.ttl, maestro:OpenApiIDL in ext/rest.ttl, maestro:AasSubmodelTemplateIDL in ext/digital-twin.ttl); a knowledge graph may declare further individuals. Individuals name the languages; naming AAS submodel templates or OpenAPI is not a conformance claim.</rdfs:comment>
    <skos:definition xml:lang="en">A language in which an interface contract is described.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#DigitalTwin">
    <rdfs:label xml:lang="en">Digital twin</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/digital-twin"/>
    <skos:definition xml:lang="en">A digital representation of a product instance, a station or a module.</skos:definition>
    <rdfs:comment xml:lang="en">HHM digital-twin extension. Not another station or module: it represents a core entity, and real execution remains attached to the module it represents.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Site">
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/DINEN62264-2#Site"/>
    <dct:source rdf:resource="https://w3id.org/maestro/planning#Site"/>
    <skos:definition xml:lang="en">A physical, geographical or logical grouping of production within an enterprise.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/isa95"/>
    <rdfs:label xml:lang="en">Site</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Risk">
    <rdfs:label xml:lang="en">Risk</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:comment xml:lang="en">HHM-Core Safety / Security / Policy cluster. Used for harm to persons and also for property and production loss. Its rating after assessment is an maestro:RiskLevel on the assessment.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#Risk"/>
    <skos:definition xml:lang="en">How likely a harm is and how severe it would be, for a given subject in a given context.</skos:definition>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Cleared">
    <skos:definition xml:lang="en">The asset may return to service without restriction.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#Cleared"/>
    <rdfs:label xml:lang="en">Cleared for service</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/maestro#ReturnToServiceOutcome"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#TelemetryEvent">
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#RuntimeEvent"/>
    <skos:definition xml:lang="en">An occurrence recorded at runtime, such as a state transition or a fault.</skos:definition>
    <rdfs:label xml:lang="en">Telemetry event</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Busy">
    <rdf:type rdf:resource="https://w3id.org/maestro#State"/>
    <rdfs:label xml:lang="en">Busy</rdfs:label>
    <skos:definition xml:lang="en">The resource is currently executing a skill.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <maestro:inDimension rdf:resource="https://w3id.org/maestro#OperationalDimension"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Busy"/>
  </owl:NamedIndividual>
  <maestro:RiskLevel rdf:about="https://w3id.org/maestro#HighRisk">
    <dct:source rdf:resource="https://w3id.org/maestro/safety#HighRisk"/>
    <rdfs:label xml:lang="en">High</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <skos:definition xml:lang="en">High residual risk.</skos:definition>
  </maestro:RiskLevel>
  <owl:Class rdf:about="https://w3id.org/maestro#Actor">
    <skos:definition xml:lang="en">An organisation participating in the manufacturing-as-a-service ecosystem.</skos:definition>
    <skos:closeMatch rdf:resource="https://schema.org/Organization"/>
    <rdfs:label xml:lang="en">Actor</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <rdfs:comment xml:lang="en">Close match to schema:Organization.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#Actor"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Quote">
    <rdfs:label xml:lang="en">Quote</rdfs:label>
    <skos:closeMatch rdf:resource="https://schema.org/PriceSpecification"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#Quote"/>
    <rdfs:comment xml:lang="en">Close match to schema:PriceSpecification.</rdfs:comment>
    <skos:definition xml:lang="en">A provider's priced, time-bound answer to one request, derived from one offer.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Binding">
    <dct:source rdf:resource="https://w3id.org/maestro/communication#Binding"/>
    <skos:definition xml:lang="en">A neutral protocol-mapping indirection between an endpoint and a concrete protocol such as OPC UA, REST or DTDL.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core Invocation Hooks cluster (protocol-specific mapping placeholder). Concrete adapters specialise it: maestro:OpcUaBinding, maestro:RestBinding, maestro:MqttBinding, maestro:DdsBinding, maestro:ModbusBinding, maestro:ProfinetBinding, maestro:EthercatBinding and maestro:DtdlBinding in the extension modules.</rdfs:comment>
    <rdfs:label xml:lang="en">Binding</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
  </owl:Class>
  <maestro:PerformanceLevel rdf:about="https://w3id.org/maestro#PLb">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <skos:definition xml:lang="en">Performance level b, declared by the integrator.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#PLb"/>
    <rdfs:label xml:lang="en">PL b</rdfs:label>
  </maestro:PerformanceLevel>
  <maestro:ExecutionStatus rdf:about="https://w3id.org/maestro#Idle">
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/PackML#Idle"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <skos:definition xml:lang="en">Not executing and waiting for a start.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Idle</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Idle"/>
    <rdfs:comment xml:lang="en">Close match to PackML:Idle, which the HSU PackML ODP describes as the wait state indicating that resetting is complete.</rdfs:comment>
    <maestro:inDimension rdf:resource="https://w3id.org/maestro#OperationalDimension"/>
  </maestro:ExecutionStatus>
  <owl:Class rdf:about="https://w3id.org/maestro#Material">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <rdfs:label xml:lang="en">Material</rdfs:label>
    <skos:definition xml:lang="en">A substance a product or part is made of, referenced by requirements and bill-of-materials nodes.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core Product cluster.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/product#Material"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#CompressedAir">
    <rdfs:label xml:lang="en">Compressed air</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
    <rdf:type rdf:resource="https://w3id.org/maestro#EnergySource"/>
    <skos:definition xml:lang="en">Energy delivered as compressed air.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/energy#CompressedAir"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#Area">
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/DINEN62264-2#Area"/>
    <skos:definition xml:lang="en">A grouping of work centres within a site.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/planning#Area"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/isa95"/>
    <rdfs:label xml:lang="en">Area</rdfs:label>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#ManualMode">
    <rdfs:label xml:lang="en">Manual</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/policy#ManualMode"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdf:type rdf:resource="https://w3id.org/maestro#Mode"/>
    <skos:definition xml:lang="en">An operator drives the resource step by step.</skos:definition>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#WorkUnit">
    <dct:source rdf:resource="https://w3id.org/maestro/planning#WorkUnit"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/isa95"/>
    <rdfs:label xml:lang="en">Work unit</rdfs:label>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/DINEN62264-2#Work_Unit"/>
    <skos:definition xml:lang="en">The lowest level of the equipment hierarchy at which work is scheduled; an HHM-Core station typically plays this role.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ProductInstance">
    <rdfs:label xml:lang="en">Product instance</rdfs:label>
    <skos:definition xml:lang="en">A particular physical manufactured item realising a product type.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core Product cluster: the physically produced unit (what is built). Disjoint with maestro:ProductType.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://w3id.org/maestro#ProductType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <dct:source rdf:resource="https://w3id.org/maestro/product#ProductInstance"/>
  </owl:Class>
  <maestro:State rdf:about="https://w3id.org/maestro#Reserved">
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Reserved"/>
    <rdfs:label xml:lang="en">Reserved</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <maestro:inDimension rdf:resource="https://w3id.org/maestro#ReservationDimension"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <skos:definition xml:lang="en">Allocated to an order or request; independent of the operational state.</skos:definition>
  </maestro:State>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Read">
    <skos:definition xml:lang="en">Read data from the target.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/maestro#Action"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <dct:source rdf:resource="https://w3id.org/maestro/policy#Read"/>
    <rdfs:label xml:lang="en">Read data</rdfs:label>
  </owl:NamedIndividual>
  <maestro:RiskLevel rdf:about="https://w3id.org/maestro#MediumRisk">
    <rdfs:label xml:lang="en">Medium</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#MediumRisk"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <skos:definition xml:lang="en">Medium residual risk.</skos:definition>
  </maestro:RiskLevel>
  <owl:Class rdf:about="https://w3id.org/maestro#ControlFlowConstraint">
    <rdfs:comment xml:lang="en">HHM-Core Recipe / Planning cluster (ControlFlowConstraint: precedes / parallel / alt / loop / optional). The kind is stated with maestro:flowType, the other step with maestro:relatedStep. MAESTRO 1.0 models the kinds as subclasses of skill:ControlFlow; here they are individuals of maestro:ControlFlowType.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <dct:references rdf:resource="https://w3id.org/maestro/skill#ControlFlow"/>
    <rdfs:label xml:lang="en">Control-flow constraint</rdfs:label>
    <skos:definition xml:lang="en">A constraint on when a plan step runs relative to another step: before it, in parallel with it, as an alternative to it, repeatedly, or optionally.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#OpcUaSkillInterface">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/opcua"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#OpcUaObject"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#SkillInterface"/>
    <rdfs:label xml:lang="en">OPC UA skill interface</rdfs:label>
    <skos:definition xml:lang="en">An OPC UA object that exposes a skill to network clients; the OPC UA realisation of the protocol-neutral skill interface.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/opcua#OpcUaSkillInterface"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Alternative">
    <rdfs:label xml:lang="en">Alternative</rdfs:label>
    <dct:references rdf:resource="https://w3id.org/maestro/skill#Alternative"/>
    <rdf:type rdf:resource="https://w3id.org/maestro#ControlFlowType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <skos:definition xml:lang="en">Either the constrained step or the related step runs, not both.</skos:definition>
  </owl:NamedIndividual>
  <maestro:ReturnToServiceOutcome rdf:about="https://w3id.org/maestro#ConditionallyCleared">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#ConditionallyCleared"/>
    <rdfs:label xml:lang="en">Cleared with conditions</rdfs:label>
    <skos:definition xml:lang="en">The asset may return to service under stated restrictions.</skos:definition>
  </maestro:ReturnToServiceOutcome>
  <owl:Class rdf:about="https://w3id.org/maestro#Precondition">
    <skos:definition xml:lang="en">A condition that must hold before a skill runs.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <rdfs:comment xml:lang="en">HHM-Core Skills cluster. The condition text is carried by maestro:expression.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#Precondition"/>
    <rdfs:label xml:lang="en">Precondition</rdfs:label>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#ElectricalGrid">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
    <skos:definition xml:lang="en">Electricity drawn from the public grid.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/maestro#EnergySource"/>
    <rdfs:label xml:lang="en">Electrical grid</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/energy#ElectricalGrid"/>
  </owl:NamedIndividual>
  <maestro:State rdf:about="https://w3id.org/maestro#Alarm">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <maestro:inDimension rdf:resource="https://w3id.org/maestro#OperationalDimension"/>
    <skos:definition xml:lang="en">The resource raises an alarm that needs attention but has not stopped.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Alarm"/>
    <rdfs:label xml:lang="en">Alarm</rdfs:label>
  </maestro:State>
  <owl:Class rdf:about="https://w3id.org/maestro#EnergyMeasurement">
    <skos:definition xml:lang="en">A measurement of energy accumulated by a subject over an interval.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
    <dct:source rdf:resource="https://w3id.org/maestro/energy#EnergyMeasurement"/>
    <rdfs:label xml:lang="en">Energy measurement</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ParameterValue">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <rdfs:comment xml:lang="en">HHM-Core Skills cluster.</rdfs:comment>
    <skos:definition xml:lang="en">An instance-level value supplied for a parameter definition, for example at a skill execution.</skos:definition>
    <rdfs:label xml:lang="en">Parameter value</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#ParameterValue"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Write">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdf:type rdf:resource="https://w3id.org/maestro#Action"/>
    <skos:definition xml:lang="en">Write data to the target.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/policy#Write"/>
    <rdfs:label xml:lang="en">Write data</rdfs:label>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#Hazard">
    <rdfs:label xml:lang="en">Hazard</rdfs:label>
    <skos:definition xml:lang="en">A potential source of harm associated with a resource, process or environment.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#Hazard"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:comment xml:lang="en">HHM-Core Safety / Security / Policy cluster.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ServiceRequest">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <skos:closeMatch rdf:resource="https://schema.org/Demand"/>
    <rdfs:label xml:lang="en">Service request</rdfs:label>
    <rdfs:comment xml:lang="en">Close match to schema:Demand.</rdfs:comment>
    <skos:definition xml:lang="en">A customer's demand for a product to be manufactured, carrying its requirements and the latest acceptable lead time.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#ServiceRequest"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#OpcUaObject">
    <rdfs:label xml:lang="en">OPC UA object</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/opcua"/>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/OpcUa#UAObject"/>
    <skos:definition xml:lang="en">An OPC UA object node, to which variable and method nodes can be attached as components.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#OpcUaNode"/>
    <dct:source rdf:resource="https://w3id.org/maestro/opcua#OpcUaObject"/>
    <rdfs:comment xml:lang="en">Close match to OpcUa:UAObject of the HSU OPC UA ODP.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Preventive">
    <rdfs:label xml:lang="en">Preventive</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#Preventive"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#MaintenanceAction"/>
    <skos:definition xml:lang="en">A maintenance action performed at planned intervals or conditions to prevent failure.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#TimeInterval">
    <skos:definition xml:lang="en">A start and end time interval.</skos:definition>
    <rdfs:label xml:lang="en">Time interval</rdfs:label>
    <rdfs:comment xml:lang="en">HHM-Core Minimal Execution cluster. Complements the instant-only maestro:timestamp.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#TimeInterval"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Customer">
    <skos:definition xml:lang="en">An actor asking the ecosystem to manufacture something it cannot or will not make itself.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#Customer"/>
    <rdfs:label xml:lang="en">Customer</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Actor"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#SafetyFunction">
    <dct:source rdf:resource="https://w3id.org/maestro/safety#SafetyFunction"/>
    <rdfs:label xml:lang="en">Safety function</rdfs:label>
    <skos:definition xml:lang="en">A function of a resource or control system that is relied on to bring or keep equipment in a safe state when a specific hazard arises.</skos:definition>
    <rdfs:comment xml:lang="en">The ontology records the function; it does not define or verify its safety requirements.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#MqttBinding">
    <rdfs:label xml:lang="en">MQTT binding</rdfs:label>
    <rdfs:comment xml:lang="en">Specialises maestro:Binding, realising the HHM extension point on Binding.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/mqtt"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Binding"/>
    <skos:definition xml:lang="en">A binding that maps an endpoint onto MQTT: the topic a message is published to or subscribed from, with its quality of service and retain flag.</skos:definition>
  </owl:Class>
  <maestro:Action rdf:about="https://w3id.org/maestro#Invoke">
    <dct:source rdf:resource="https://w3id.org/maestro/policy#Invoke"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Invoke a skill or service</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <skos:definition xml:lang="en">Start a skill or call a service.</skos:definition>
  </maestro:Action>
  <owl:Class rdf:about="https://w3id.org/maestro#DtdlInterface">
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#SkillInterface"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dtdl"/>
    <rdfs:comment xml:lang="en">Close match to the DTDL v3 metamodel class Interface. A DTDL interface may serve as an maestro:SkillInterface described in DTDL.</rdfs:comment>
    <skos:definition xml:lang="en">A DTDL interface: the model of a twin's commands, telemetry and properties.</skos:definition>
    <rdfs:label xml:lang="en">DTDL interface</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/dtdl#Interface"/>
    <skos:closeMatch rdf:resource="dtmi:dtdl:class:Interface;3"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Skill">
    <rdfs:comment xml:lang="en">HHM-Core Skills cluster. A skill is a specification, not a running program and not a piece of hardware. Its kind is stated by the subclasses maestro:AtomicSkill and maestro:CompositeSkill.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/core#Skill"/>
    <rdfs:label xml:lang="en">Skill</rdfs:label>
    <skos:definition xml:lang="en">A reusable specification of executable behaviour that can be realised by a deployed implementation.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
  </owl:Class>
  <maestro:PerformanceLevel rdf:about="https://w3id.org/maestro#PLd">
    <skos:definition xml:lang="en">Performance level d, declared by the integrator.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:label xml:lang="en">PL d</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#PLd"/>
  </maestro:PerformanceLevel>
  <owl:Class rdf:about="https://w3id.org/maestro#Postcondition">
    <skos:definition xml:lang="en">A condition that holds after a skill has run: the effect it produces.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core Skills cluster, using the HHM name Postcondition; MAESTRO 1.0 also calls it Effect. The condition text is carried by maestro:expression.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#Postcondition"/>
    <rdfs:label xml:lang="en">Postcondition</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ControlFlowType">
    <rdfs:label xml:lang="en">Control-flow type</rdfs:label>
    <rdfs:comment xml:lang="en">Controlled vocabulary with the five individuals the HHM diagram names.</rdfs:comment>
    <skos:definition xml:lang="en">The kind of a control-flow constraint: precedes, parallel, alternative, loop or optional.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Finding">
    <rdfs:label xml:lang="en">Finding</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#Finding"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <skos:definition xml:lang="en">Something observed during maintenance work: wear, damage, a deviation.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Permission">
    <rdfs:label xml:lang="en">Permission</rdfs:label>
    <skos:definition xml:lang="en">The ability to perform an action over a target, granted to a role.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:comment xml:lang="en">HHM-Core Safety / Security / Policy cluster.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/policy#Permission"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Permission"/>
  </owl:Class>
  <maestro:Mode rdf:about="https://w3id.org/maestro#MaintenanceMode">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">The resource is under maintenance and not available for production.</skos:definition>
    <rdfs:label xml:lang="en">Maintenance</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/policy#MaintenanceMode"/>
  </maestro:Mode>
  <owl:Class rdf:about="https://w3id.org/maestro#SkillExecution">
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#SkillExecution"/>
    <rdfs:comment xml:lang="en">HHM-Core Minimal Execution cluster. The occurrence itself; a record describing it is an maestro:ExecutionRecord (modules/telemetry.ttl). Aligned to prov:Activity in ext/prov.ttl.</rdfs:comment>
    <skos:definition xml:lang="en">One execution of a skill on a resource: an occurrence with inputs, status, invocation endpoint, faults and time interval.</skos:definition>
    <rdfs:label xml:lang="en">Skill execution</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Evidence">
    <rdfs:label xml:lang="en">Evidence</rdfs:label>
    <skos:definition xml:lang="en">A reference to a log, document or observation that backs a policy, an assessment or a state assertion.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:comment xml:lang="en">HHM-Core Safety / Security / Policy cluster (Evidence: log / doc / obs ref). The reference itself is maestro:evidenceRef.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/policy#Evidence"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ExternalInterface">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/automationml"/>
    <rdfs:label xml:lang="en">External interface</rdfs:label>
    <skos:definition xml:lang="en">A port of an internal element through which it connects to other elements, such as a material, energy or signal port.</skos:definition>
    <skos:closeMatch rdf:resource="https://w3id.org/hsu-aut/AutomationML#ExternalInterface"/>
    <dct:source rdf:resource="https://w3id.org/maestro/automationml#ExternalInterface"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Mode">
    <rdfs:label xml:lang="en">Mode</rdfs:label>
    <rdfs:comment xml:lang="en">HHM-Core Safety / Security / Policy cluster, a controlled vocabulary of individuals.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/policy#Mode"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <skos:definition xml:lang="en">An operating mode, such as automatic, manual or maintenance, that a policy can require.</skos:definition>
  </owl:Class>
  <maestro:InterfaceDescriptionLanguage rdf:about="https://w3id.org/maestro#DtdlIDL">
    <dct:source rdf:resource="https://w3id.org/maestro/communication#DtdlIDL"/>
    <skos:definition xml:lang="en">An interface described in the Digital Twins Definition Language.</skos:definition>
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: each interface description language is declared in the extension module of its technology. A DTDL interface names it with maestro:describedIn.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dtdl"/>
    <rdfs:label xml:lang="en">DTDL</rdfs:label>
  </maestro:InterfaceDescriptionLanguage>
  <maestro:PerformanceLevel rdf:about="https://w3id.org/maestro#PLc">
    <rdfs:label xml:lang="en">PL c</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#PLc"/>
    <skos:definition xml:lang="en">Performance level c, declared by the integrator.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
  </maestro:PerformanceLevel>
  <maestro:EnergySource rdf:about="https://w3id.org/maestro#Solar">
    <dct:source rdf:resource="https://w3id.org/maestro/energy#Solar"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Solar</rdfs:label>
    <skos:definition xml:lang="en">Electricity from photovoltaic generation.</skos:definition>
  </maestro:EnergySource>
  <owl:Class rdf:about="https://w3id.org/maestro#Mitigation">
    <dct:source rdf:resource="https://w3id.org/maestro/safety#Mitigation"/>
    <rdfs:comment xml:lang="en">HHM-Core Safety / Security / Policy cluster. A reified measure, so that assessments can name the mitigations they rely on.</rdfs:comment>
    <skos:definition xml:lang="en">A measure that reduces a risk.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:label xml:lang="en">Mitigation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ModbusDataTable">
    <skos:definition xml:lang="en">One of the four Modbus data tables: coils, discrete inputs, input registers and holding registers.</skos:definition>
    <rdfs:comment xml:lang="en">A controlled vocabulary of individuals.</rdfs:comment>
    <rdfs:label xml:lang="en">Modbus data table</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/modbus"/>
  </owl:Class>
  <maestro:InterfaceDescriptionLanguage rdf:about="https://w3id.org/maestro#OpcUaNodeSetIDL">
    <dct:source rdf:resource="https://w3id.org/maestro/communication#OpcUaNodeSetIDL"/>
    <rdfs:label xml:lang="en">OPC UA NodeSet</rdfs:label>
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: each interface description language is declared in the extension module of its technology. A skill interface or binding names it with maestro:describedIn.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/opcua"/>
    <skos:definition xml:lang="en">An interface described as an OPC UA node set.</skos:definition>
  </maestro:InterfaceDescriptionLanguage>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Available">
    <rdf:type rdf:resource="https://w3id.org/maestro#State"/>
    <skos:definition xml:lang="en">The resource is ready to accept work.</skos:definition>
    <rdfs:label xml:lang="en">Available</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Available"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <maestro:inDimension rdf:resource="https://w3id.org/maestro#OperationalDimension"/>
  </owl:NamedIndividual>
  <maestro:StateDimension rdf:about="https://w3id.org/maestro#HealthDimension">
    <rdfs:label xml:lang="en">Health</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#HealthDimension"/>
    <skos:definition xml:lang="en">Diagnostic condition: Healthy, Degraded, Failed.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
  </maestro:StateDimension>
  <owl:Class rdf:about="https://w3id.org/maestro#ServiceOffer">
    <skos:definition xml:lang="en">A standing offer to perform manufacturing work: which capability, at which station, listed on which marketplace.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#ServiceOffer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <rdfs:comment xml:lang="en">Close match to schema:Offer. The commercial face of a technical maestro:SkillService, reached with maestro:exposesService.</rdfs:comment>
    <rdfs:label xml:lang="en">Service offer</rdfs:label>
    <skos:closeMatch rdf:resource="https://schema.org/Offer"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#DtdlProperty">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dtdl"/>
    <skos:closeMatch rdf:resource="dtmi:dtdl:class:Property;3"/>
    <dct:source rdf:resource="https://w3id.org/maestro/dtdl#Property"/>
    <skos:definition xml:lang="en">A DTDL property: a readable, optionally writable, state value of the twin.</skos:definition>
    <rdfs:label xml:lang="en">DTDL property</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Constraint">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:comment xml:lang="en">HHM-Core Safety / Security / Policy cluster. The target is stated with maestro:constrains, the restriction text with maestro:expression.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/core#Constraint"/>
    <rdfs:label xml:lang="en">Constraint</rdfs:label>
    <skos:definition xml:lang="en">A specified restriction on a skill, plan step, module, endpoint or other target.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#TwinBinding">
    <skos:definition xml:lang="en">The mapping of a digital twin onto a twin platform or model, such as an Asset Administration Shell package or a DTDL model.</skos:definition>
    <rdfs:comment xml:lang="en">HHM digital-twin extension. The platform is a literal (maestro:platform); the model is an IRI (maestro:mapsTo).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/digital-twin"/>
    <rdfs:label xml:lang="en">Twin binding</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Station">
    <skos:definition xml:lang="en">A work station composed of plug-and-produce modules; the top physical unit of the HHM-Core resource model.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/resource"/>
    <rdfs:label xml:lang="en">Station</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/resource#Station"/>
    <rdfs:comment xml:lang="en">HHM-Core Physical Resources cluster. A station carries modules through maestro:hasModule; which modules it carries may change through reconfiguration while the station itself stays stable.</rdfs:comment>
    <skos:scopeNote xml:lang="en">ISA88:Unit is made up of equipment modules and control modules and combines all necessary physical processing and control equipment (HSU ISA88.01 ODP). This package does not adopt the presumption that a unit operates on no more than one batch at a time.</skos:scopeNote>
    <skos:closeMatch rdf:resource="http://www.hsu-ifa.de/ontologies/ISA88.01#Unit"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#InternalLink">
    <dct:source rdf:resource="https://w3id.org/maestro/automationml#InternalLink"/>
    <rdfs:label xml:lang="en">Internal link</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/automationml"/>
    <skos:closeMatch rdf:resource="https://w3id.org/hsu-aut/AutomationML#InternalLink"/>
    <skos:definition xml:lang="en">A connection between two external interfaces.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#DtdlBinding">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dtdl"/>
    <rdfs:comment xml:lang="en">Specialises maestro:Binding, realising the HHM extension point on Binding.</rdfs:comment>
    <rdfs:label xml:lang="en">DTDL binding</rdfs:label>
    <skos:definition xml:lang="en">A binding that maps an endpoint onto a DTDL interface.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Binding"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#SIL2">
    <rdf:type rdf:resource="https://w3id.org/maestro#SafetyIntegrityLevel"/>
    <rdfs:label xml:lang="en">SIL 2</rdfs:label>
    <skos:definition xml:lang="en">Safety integrity level 2, declared by the integrator.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#SIL2"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#OpcUaBinding">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/opcua"/>
    <rdfs:comment xml:lang="en">Specialises maestro:Binding, realising the HHM extension point on Binding.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Binding"/>
    <rdfs:label xml:lang="en">OPC UA binding</rdfs:label>
    <skos:definition xml:lang="en">A binding that maps an endpoint onto OPC UA: the method that is called and the encoding used.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#SafetyIntegrityLevel">
    <rdfs:comment xml:lang="en">Kept separate from maestro:PerformanceLevel; the ontology does not convert between the two.</rdfs:comment>
    <skos:definition xml:lang="en">A safety integrity level, SIL 1 to SIL 4, declared by the integrator for a safety function.</skos:definition>
    <rdfs:label xml:lang="en">Safety integrity level</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#SafetyIntegrityLevel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Parallel">
    <skos:definition xml:lang="en">The constrained step and the related step run concurrently.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/maestro#ControlFlowType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <rdfs:label xml:lang="en">Parallel</rdfs:label>
    <dct:references rdf:resource="https://w3id.org/maestro/skill#Parallel"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#EnergySource">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
    <dct:source rdf:resource="https://w3id.org/maestro/energy#EnergySource"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary of individuals; add site-specific sources as further individuals.</rdfs:comment>
    <rdfs:label xml:lang="en">Energy source</rdfs:label>
    <skos:definition xml:lang="en">A source that supplies energy, such as a grid connection, a generator or a battery.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#FaultSpecification">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <rdfs:label xml:lang="en">Fault specification</rdfs:label>
    <rdfs:comment xml:lang="en">A specification, not an occurrence. The occurrence is maestro:Fault, linked to its kind with maestro:instanceOfFault.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#FaultSpecification"/>
    <skos:definition xml:lang="en">A kind of fault a skill or resource can raise: its code, meaning and severity.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ConditionBased">
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#ConditionBased"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Preventive"/>
    <rdfs:label xml:lang="en">Condition-based</rdfs:label>
    <skos:definition xml:lang="en">Preventive maintenance triggered by the measured or analysed condition of the asset, together with the maintenance actions that follow from that assessment.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#SkillInterface">
    <rdfs:comment xml:lang="en">HHM-Core Skills cluster (semantic contract). Protocol-specific interfaces, such as an OPC UA or a REST interface, are subclasses declared in the extension modules; the endpoint that exposes the contract is stated with maestro:exposedVia.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#SkillInterface"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <rdfs:label xml:lang="en">Skill interface</rdfs:label>
    <skos:definition xml:lang="en">A protocol-neutral contract through which a skill is invoked.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ProductionOrder">
    <dct:source rdf:resource="https://w3id.org/maestro/planning#ProductionOrder"/>
    <rdfs:label xml:lang="en">Production order</rdfs:label>
    <skos:definition xml:lang="en">An order to produce a quantity of a product type by a due date, executing a recipe.</skos:definition>
    <rdfs:comment xml:lang="en">Close match to ISO22400:ProductionOrder of the HSU ISO 22400-2 ODP. The hook for ISA-95 / IEC 62264 work orders (ext/isa95.ttl).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/ISO22400-2#ProductionOrder"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Endpoint">
    <dct:source rdf:resource="https://w3id.org/maestro/communication#Endpoint"/>
    <skos:definition xml:lang="en">A network-addressable access point through which a skill interface, stream or operation is reached, identified by protocol, host and port.</skos:definition>
    <skos:relatedMatch rdf:resource="http://www.w3id.org/hsu-aut/WADL#Resource"/>
    <rdfs:label xml:lang="en">Endpoint</rdfs:label>
    <rdfs:comment xml:lang="en">HHM-Core Invocation Hooks cluster. Related to WADL:Resource of the HSU WADL ODP: for an HTTP endpoint, the WADL resources reachable under its base address describe what it exposes; a WADL resource is a URI pattern, not a host and port.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#PerformanceLevel">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <skos:definition xml:lang="en">A performance level, PL a to PL e, declared by the integrator for a safety function.</skos:definition>
    <rdfs:label xml:lang="en">Performance level</rdfs:label>
    <rdfs:comment xml:lang="en">Kept separate from maestro:SafetyIntegrityLevel; the ontology does not convert between the two.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#PerformanceLevel"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#OpcUaServer">
    <rdfs:label xml:lang="en">OPC UA server</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/opcua#OpcUaServer"/>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/OpcUa#UAServer"/>
    <rdfs:comment xml:lang="en">Close match to OpcUa:UAServer of the HSU OPC UA ODP.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/opcua"/>
    <skos:definition xml:lang="en">An OPC UA server that holds a node set of OPC UA nodes.</skos:definition>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#SIL4">
    <rdfs:label xml:lang="en">SIL 4</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#SIL4"/>
    <rdf:type rdf:resource="https://w3id.org/maestro#SafetyIntegrityLevel"/>
    <skos:definition xml:lang="en">Safety integrity level 4, declared by the integrator.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Loop">
    <rdf:type rdf:resource="https://w3id.org/maestro#ControlFlowType"/>
    <rdfs:label xml:lang="en">Loop</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <dct:references rdf:resource="https://w3id.org/maestro/skill#Loop"/>
    <skos:definition xml:lang="en">The constrained step repeats while its condition holds.</skos:definition>
  </owl:NamedIndividual>
  <maestro:State rdf:about="https://w3id.org/maestro#Failed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Failed</rdfs:label>
    <skos:definition xml:lang="en">Diagnostic condition: the resource can no longer perform its function.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <maestro:inDimension rdf:resource="https://w3id.org/maestro#HealthDimension"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Failed"/>
  </maestro:State>
  <owl:Class rdf:about="https://w3id.org/maestro#Recipe">
    <skos:definition xml:lang="en">An ordered container of plan steps, each realised by a skill, that describes how a product is made.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <skos:altLabel xml:lang="en">Process plan</skos:altLabel>
    <rdfs:comment xml:lang="en">HHM-Core Recipe / ProcessPlan. Not restricted to batch production: its steps are realised by skills and may apply to discrete manufacturing. Disjoint with maestro:PlanStep.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/recipe#Recipe"/>
    <rdfs:label xml:lang="en">Recipe</rdfs:label>
    <owl:disjointWith rdf:resource="https://w3id.org/maestro#PlanStep"/>
    <skos:scopeNote xml:lang="en">ISA88:RecipeProcedure is the highest level of the procedural control model of the HSU ISA88.01 ODP, describing the execution of an extensive production operation such as the production of a batch. maestro:Recipe is not restricted to batch production.</skos:scopeNote>
    <skos:closeMatch rdf:resource="http://www.hsu-ifa.de/ontologies/ISA88.01#RecipeProcedure"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#RestBinding">
    <skos:definition xml:lang="en">A binding that maps an endpoint onto an HTTP method applied to a URL template.</skos:definition>
    <rdfs:comment xml:lang="en">Specialises maestro:Binding, realising the HHM extension point on Binding. Close match to WADL:Method of the HSU WADL ODP, which pairs an HTTP method with the request and response it carries.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Binding"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/rest"/>
    <rdfs:label xml:lang="en">REST binding</rdfs:label>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/WADL#Method"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#ModeDimension">
    <rdf:type rdf:resource="https://w3id.org/maestro#StateDimension"/>
    <rdfs:label xml:lang="en">Mode</rdfs:label>
    <skos:definition xml:lang="en">Operating mode; values are the maestro:Mode individuals of the policy cluster.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#ModeDimension"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
  </owl:NamedIndividual>
  <maestro:ParameterDirection rdf:about="https://w3id.org/maestro#Output">
    <skos:definition xml:lang="en">The parameter is produced by the skill.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#Output"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Output</rdfs:label>
  </maestro:ParameterDirection>
  <owl:Class rdf:about="https://w3id.org/maestro#WorkCenter">
    <dct:source rdf:resource="https://w3id.org/maestro/planning#WorkCenter"/>
    <skos:definition xml:lang="en">A grouping of work units within an area, such as a production line or a cell.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/isa95"/>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/DINEN62264-2#Work_Center"/>
    <rdfs:label xml:lang="en">Work centre</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#DtdlCommand">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dtdl"/>
    <dct:source rdf:resource="https://w3id.org/maestro/dtdl#Command"/>
    <skos:closeMatch rdf:resource="dtmi:dtdl:class:Command;3"/>
    <rdfs:label xml:lang="en">DTDL command</rdfs:label>
    <skos:definition xml:lang="en">A DTDL command: an operation a client can invoke on the twin.</skos:definition>
  </owl:Class>
  <maestro:Protocol rdf:about="https://w3id.org/maestro#HttpProtocol">
    <skos:definition xml:lang="en">The Hypertext Transfer Protocol.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/rest"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#HttpProtocol"/>
    <skos:scopeNote xml:lang="en">Includes REST-style APIs; REST is an architectural style, not a protocol.</skos:scopeNote>
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: each protocol individual is declared in the extension module of its protocol. A REST binding names it with maestro:specializesAs.</rdfs:comment>
    <rdfs:label xml:lang="en">HTTP</rdfs:label>
  </maestro:Protocol>
  <maestro:RiskLevel rdf:about="https://w3id.org/maestro#LowRisk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:label xml:lang="en">Low</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#LowRisk"/>
    <skos:definition xml:lang="en">Low residual risk.</skos:definition>
  </maestro:RiskLevel>
  <maestro:ParameterDirection rdf:about="https://w3id.org/maestro#Input">
    <skos:definition xml:lang="en">The parameter is consumed by the skill.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Input</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#Input"/>
  </maestro:ParameterDirection>
  <owl:Class rdf:about="https://w3id.org/maestro#ParameterDef">
    <rdfs:label xml:lang="en">Parameter definition</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <skos:definition xml:lang="en">Typed parameter definition of a skill: a data type, an optional unit reference and an optional numeric range.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#ParameterDef"/>
    <rdfs:comment xml:lang="en">HHM-Core Skills cluster (ParameterDef: type, unitRef, range). Also used as the parameter and return schema of an maestro:OperationSignature.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#ProtobufFormat">
    <rdf:type rdf:resource="https://w3id.org/maestro#DataFormat"/>
    <skos:definition xml:lang="en">Protocol Buffers binary payloads.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#ProtobufFormat"/>
    <rdfs:label xml:lang="en">Protocol Buffers</rdfs:label>
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: data-format individuals are declared in the extension modules.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/data-formats"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Configure">
    <rdf:type rdf:resource="https://w3id.org/maestro#Action"/>
    <rdfs:label xml:lang="en">Change a configuration</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/policy#Configure"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <skos:definition xml:lang="en">Change the configuration of the target.</skos:definition>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#EnergyConsumer">
    <rdfs:label xml:lang="en">Energy consumer</rdfs:label>
    <dct:references rdf:resource="https://w3id.org/maestro/energy#EnergyConsumer"/>
    <rdfs:comment xml:lang="en">Type a module additionally as an energy consumer to record its supply.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Module"/>
    <skos:definition xml:lang="en">A module that draws energy from an energy source while operating.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#StateTransition">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <skos:definition xml:lang="en">A telemetry event in which a subject leaves one state and enters another.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#TelemetryEvent"/>
    <rdfs:label xml:lang="en">State transition</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#StateTransition"/>
  </owl:Class>
  <maestro:Protocol rdf:about="https://w3id.org/maestro#DdsProtocol">
    <skos:definition xml:lang="en">The Data Distribution Service protocol.</skos:definition>
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: each protocol individual is declared in the extension module of its protocol. An maestro:DdsBinding names it with maestro:specializesAs.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dds"/>
    <rdfs:label xml:lang="en">DDS</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#DdsProtocol"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </maestro:Protocol>
  <maestro:ModbusDataTable rdf:about="https://w3id.org/maestro#ModbusHoldingRegister">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/modbus"/>
    <skos:definition xml:lang="en">The Modbus data table of 16-bit registers a client can read and write.</skos:definition>
    <rdfs:label xml:lang="en">Holding register</rdfs:label>
  </maestro:ModbusDataTable>
  <owl:Class rdf:about="https://w3id.org/maestro#ReturnToServiceOutcome">
    <rdfs:label xml:lang="en">Return-to-service outcome</rdfs:label>
    <skos:definition xml:lang="en">The controlled outcome of a return-to-service assessment: whether an asset may return to service, with or without restrictions.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#ReturnToServiceOutcome"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Protocol">
    <skos:definition xml:lang="en">A transport or application protocol an endpoint speaks.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#Protocol"/>
    <rdfs:comment xml:lang="en">HHM-Core Invocation Hooks cluster, a controlled vocabulary of individuals. The individuals are declared in the extension modules, one module per protocol (maestro:OpcUaProtocol in ext/opcua.ttl, maestro:HttpProtocol in ext/rest.ttl, maestro:MqttProtocol, maestro:DdsProtocol, maestro:ModbusProtocol, maestro:ProfinetProtocol, maestro:EthercatProtocol in the module of the same name); a knowledge graph may declare further individuals. Transport protocols only: payload encodings are maestro:DataFormat, interface description languages are maestro:InterfaceDescriptionLanguage.</rdfs:comment>
    <rdfs:label xml:lang="en">Protocol</rdfs:label>
  </owl:Class>
  <maestro:ExecutionStatus rdf:about="https://w3id.org/maestro#Completed">
    <rdfs:comment xml:lang="en">Close match to PackML:Complete of the HSU PackML ODP.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/PackML#Complete"/>
    <skos:definition xml:lang="en">The execution finished successfully.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <rdfs:label xml:lang="en">Completed</rdfs:label>
  </maestro:ExecutionStatus>
  <owl:Class rdf:about="https://w3id.org/maestro#DdsBinding">
    <skos:definition xml:lang="en">A binding that maps an endpoint onto DDS: the domain, topic and data type through which a participant publishes or subscribes.</skos:definition>
    <rdfs:label xml:lang="en">DDS binding</rdfs:label>
    <rdfs:comment xml:lang="en">Specialises maestro:Binding, realising the HHM extension point on Binding.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dds"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Binding"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Contract">
    <skos:closeMatch rdf:resource="https://schema.org/Order"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#Contract"/>
    <skos:definition xml:lang="en">An accepted quote: the agreement that turns a market transaction into a production order, governed by a policy.</skos:definition>
    <rdfs:comment xml:lang="en">Close match to schema:Order.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <rdfs:label xml:lang="en">Contract</rdfs:label>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#OpcUaProtocol">
    <rdf:type rdf:resource="https://w3id.org/maestro#Protocol"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/opcua"/>
    <rdfs:label xml:lang="en">OPC UA</rdfs:label>
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: each protocol individual is declared in the extension module of its protocol. An OPC UA binding names it with maestro:specializesAs.</rdfs:comment>
    <skos:definition xml:lang="en">The OPC Unified Architecture protocol.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#OpcUaProtocol"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#OpcUaNode">
    <rdfs:comment xml:lang="en">Close match to OpcUa:UANode of the HSU OPC UA ODP.</rdfs:comment>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/OpcUa#UANode"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/opcua"/>
    <rdfs:label xml:lang="en">OPC UA node</rdfs:label>
    <skos:definition xml:lang="en">A node of an OPC UA server's node set, identified by a node id and a browse name.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/opcua#OpcUaNode"/>
  </owl:Class>
  <maestro:DataFormat rdf:about="https://w3id.org/maestro#XmlFormat">
    <dct:source rdf:resource="https://w3id.org/maestro/communication#XmlFormat"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/data-formats"/>
    <skos:definition xml:lang="en">Extensible Markup Language payloads.</skos:definition>
    <rdfs:label xml:lang="en">XML</rdfs:label>
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: data-format individuals are declared in the extension modules.</rdfs:comment>
  </maestro:DataFormat>
  <owl:Class rdf:about="https://w3id.org/maestro#State">
    <rdfs:comment xml:lang="en">State values are individuals. The assertion that a subject is in a state at a time is an maestro:StateAssertion; maestro:hasState is the shortcut for the one current operational state.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <skos:definition xml:lang="en">A discrete operational condition value that a station, module or execution can be in.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/core#State"/>
    <rdfs:label xml:lang="en">State</rdfs:label>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Optional">
    <rdf:type rdf:resource="https://w3id.org/maestro#ControlFlowType"/>
    <skos:definition xml:lang="en">The constrained step runs only when its condition holds.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <rdfs:label xml:lang="en">Optional</rdfs:label>
    <dct:references rdf:resource="https://w3id.org/maestro/skill#Optional"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#SIL3">
    <rdf:type rdf:resource="https://w3id.org/maestro#SafetyIntegrityLevel"/>
    <rdfs:label xml:lang="en">SIL 3</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#SIL3"/>
    <skos:definition xml:lang="en">Safety integrity level 3, declared by the integrator.</skos:definition>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#EthercatBinding">
    <rdfs:comment xml:lang="en">Specialises maestro:Binding, realising the HHM extension point on Binding.</rdfs:comment>
    <rdfs:label xml:lang="en">EtherCAT binding</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/ethercat"/>
    <skos:definition xml:lang="en">A binding that maps an endpoint onto EtherCAT: the SubDevice addressed and the object dictionary entry, mapped as process data or read as service data, that carries the value.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Binding"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ExecutionStatus">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <rdfs:comment xml:lang="en">HHM-Core Minimal Execution cluster, a controlled vocabulary of individuals. modules/telemetry.ttl declares it a subclass of maestro:State, the live state of a resource, so the shared values Idle, Executing, Held and Aborted exist once.</rdfs:comment>
    <skos:definition xml:lang="en">A discrete condition value that an execution can be in.</skos:definition>
    <dct:references rdf:resource="https://w3id.org/maestro/core#State"/>
    <rdfs:label xml:lang="en">Execution status</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#State"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#StateAssertion">
    <rdfs:label xml:lang="en">State assertion</rdfs:label>
    <skos:definition xml:lang="en">The qualified assertion that a subject was in a state value, in one dimension, over a validity period, observed at a time and on stated evidence.</skos:definition>
    <rdfs:comment xml:lang="en">History, independent dimensions and evidence need a qualified assertion; maestro:hasState is only the shortcut for the open operational assertion.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#StateAssertion"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Precedes">
    <rdf:type rdf:resource="https://w3id.org/maestro#ControlFlowType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <skos:definition xml:lang="en">The constrained step runs before the related step.</skos:definition>
    <dct:references rdf:resource="https://w3id.org/maestro/skill#Sequence"/>
    <rdfs:label xml:lang="en">Precedes</rdfs:label>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#ProfinetBinding">
    <skos:definition xml:lang="en">A binding that maps an endpoint onto PROFINET IO: the IO device, and the slot and subslot of the submodule that carries the data.</skos:definition>
    <rdfs:comment xml:lang="en">Specialises maestro:Binding, realising the HHM extension point on Binding.</rdfs:comment>
    <rdfs:label xml:lang="en">PROFINET binding</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Binding"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/profinet"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#EventStream">
    <dct:source rdf:resource="https://w3id.org/maestro/communication#EventStream"/>
    <skos:definition xml:lang="en">A skill-level event or telemetry stream contract, independent of the technology that carries it.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core EventStream (drawn in the digital-twin diagram). A contract, not an event that happened; carried for example as DTDL telemetry or OPC UA events.</rdfs:comment>
    <rdfs:label xml:lang="en">Event stream</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
  </owl:Class>
  <maestro:Role rdf:about="https://w3id.org/maestro#MarketplaceRole">
    <skos:definition xml:lang="en">Held by the party operating a marketplace.</skos:definition>
    <rdfs:label xml:lang="en">Marketplace role</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#MarketplaceRole"/>
  </maestro:Role>
  <owl:Class rdf:about="https://w3id.org/maestro#PlanStep">
    <skos:definition xml:lang="en">A single step of a recipe, realised by a skill and carrying control-flow constraints and data bindings.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core Recipe / Planning cluster. One occurrence of a skill in a plan; the same skill may be used by several steps.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <dct:source rdf:resource="https://w3id.org/maestro/recipe#PlanStep"/>
    <rdfs:label xml:lang="en">Plan step</rdfs:label>
    <skos:scopeNote xml:lang="en">ISA88:Phase is the smallest element of the procedural control in the HSU ISA88.01 ODP, defining a single process control task; a plan step plays that role.</skos:scopeNote>
    <skos:closeMatch rdf:resource="http://www.hsu-ifa.de/ontologies/ISA88.01#Phase"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#CompositeSkill">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#CompositeSkill"/>
    <skos:definition xml:lang="en">A skill built by composing other skills.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core Skills cluster. Its constituents are stated with maestro:hasSubSkillLink; the order in which they run is a recipe concern (maestro:PlanStep, maestro:ControlFlowConstraint).</rdfs:comment>
    <rdfs:label xml:lang="en">Composite skill</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Skill"/>
  </owl:Class>
  <maestro:Protocol rdf:about="https://w3id.org/maestro#ProfinetProtocol">
    <dct:source rdf:resource="https://w3id.org/maestro/communication#ProfinetProtocol"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/profinet"/>
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: each protocol individual is declared in the extension module of its protocol. An maestro:ProfinetBinding names it with maestro:specializesAs.</rdfs:comment>
    <skos:definition xml:lang="en">The PROFINET industrial Ethernet protocol.</skos:definition>
    <rdfs:label xml:lang="en">PROFINET</rdfs:label>
  </maestro:Protocol>
  <owl:Class rdf:about="https://w3id.org/maestro#PowerMeasurement">
    <rdfs:label xml:lang="en">Power measurement</rdfs:label>
    <rdfs:comment xml:lang="en">Distinct from accumulated energy: a power reading has a timestamp and no interval.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
    <dct:source rdf:resource="https://w3id.org/maestro/energy#PowerMeasurement"/>
    <skos:definition xml:lang="en">An instantaneous measurement of the power drawn by a subject at a time.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#OpcUaMethod">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/opcua"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#OpcUaNode"/>
    <rdfs:label xml:lang="en">OPC UA method</rdfs:label>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/OpcUa#UAMethod"/>
    <skos:definition xml:lang="en">An OPC UA method node that a client can call.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/opcua#OpcUaMethod"/>
    <rdfs:comment xml:lang="en">Close match to OpcUa:UAMethod of the HSU OPC UA ODP.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ReturnToServiceAssessment">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <rdfs:label xml:lang="en">Return-to-service assessment</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#ReturnToServiceAssessment"/>
    <skos:definition xml:lang="en">The assessment, after maintenance work, whether the asset may return to service.</skos:definition>
  </owl:Class>
  <maestro:Role rdf:about="https://w3id.org/maestro#CustomerRole">
    <dct:source rdf:resource="https://w3id.org/maestro/maas#CustomerRole"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Customer role</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <skos:definition xml:lang="en">Held by the party a request is requested by.</skos:definition>
  </maestro:Role>
  <owl:Class rdf:about="https://w3id.org/maestro#Snapshot">
    <skos:definition xml:lang="en">Marker class for a graph that carries runtime triples captured at one instant.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Snapshot"/>
    <rdfs:label xml:lang="en">Snapshot</rdfs:label>
    <rdfs:comment xml:lang="en">Shapes that require every resource to have a state target the resources referenced from a snapshot, so design-time loads do not falsely fail.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
  </owl:Class>
  <maestro:Protocol rdf:about="https://w3id.org/maestro#EthercatProtocol">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/ethercat"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">EtherCAT</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#EthercatProtocol"/>
    <skos:definition xml:lang="en">The EtherCAT fieldbus protocol.</skos:definition>
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: each protocol individual is declared in the extension module of its protocol. An maestro:EthercatBinding names it with maestro:specializesAs.</rdfs:comment>
  </maestro:Protocol>
  <owl:Class rdf:about="https://w3id.org/maestro#Variant">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <skos:definition xml:lang="en">A configuration or variant of a product type, itself a product type.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#ProductType"/>
    <dct:source rdf:resource="https://w3id.org/maestro/product#Variant"/>
    <rdfs:comment xml:lang="en">HHM-Core Product cluster. Reached from the base type with maestro:hasVariant.</rdfs:comment>
    <rdfs:label xml:lang="en">Variant</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Role">
    <dct:source rdf:resource="https://w3id.org/maestro/policy#Role"/>
    <rdfs:label xml:lang="en">Role</rdfs:label>
    <skos:definition xml:lang="en">An actor role to which permissions are granted.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:comment xml:lang="en">HHM-Core Safety / Security / Policy cluster (role-based access). The manufacturing-as-a-service module adds the individuals CustomerRole, ProviderRole and MarketplaceRole.</rdfs:comment>
  </owl:Class>
  <maestro:PerformanceLevel rdf:about="https://w3id.org/maestro#PLa">
    <skos:definition xml:lang="en">Performance level a, declared by the integrator.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#PLa"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:label xml:lang="en">PL a</rdfs:label>
  </maestro:PerformanceLevel>
  <owl:Class rdf:about="https://w3id.org/maestro#PhysicalResourceProvider">
    <skos:definition xml:lang="en">An actor that owns and operates production equipment and offers its capabilities as a service.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <rdfs:comment xml:lang="en">The same party may also be a customer.</rdfs:comment>
    <rdfs:label xml:lang="en">Physical resource provider</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Actor"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#PhysicalResourceProvider"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Fault">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <rdfs:comment xml:lang="en">HHM-Core Fault. MAESTRO 1.0 calls the occurrence runtime:FaultEvent and keeps runtime:Fault for the faulted state value; this package follows the HHM name for the occurrence and calls the state value maestro:FaultState. The kind of fault is an maestro:FaultSpecification (modules/telemetry.ttl).</rdfs:comment>
    <dct:references rdf:resource="https://w3id.org/maestro/runtime#FaultEvent"/>
    <skos:definition xml:lang="en">A fault occurrence raised during an execution, carrying a code, a cause and a severity.</skos:definition>
    <rdfs:label xml:lang="en">Fault</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#TelemetryEvent"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#DtdlTelemetry">
    <rdfs:label xml:lang="en">DTDL telemetry</rdfs:label>
    <skos:definition xml:lang="en">A DTDL telemetry: a stream of values the twin emits.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dtdl"/>
    <skos:closeMatch rdf:resource="dtmi:dtdl:class:Telemetry;3"/>
    <dct:source rdf:resource="https://w3id.org/maestro/dtdl#Telemetry"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ModbusBinding">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/modbus"/>
    <rdfs:comment xml:lang="en">Specialises maestro:Binding, realising the HHM extension point on Binding.</rdfs:comment>
    <rdfs:label xml:lang="en">Modbus binding</rdfs:label>
    <skos:definition xml:lang="en">A binding that maps an endpoint onto Modbus: the unit addressed, the data table and the range of addresses read or written.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Binding"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#FaultState">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <maestro:inDimension rdf:resource="https://w3id.org/maestro#OperationalDimension"/>
    <rdfs:label xml:lang="en">Fault</rdfs:label>
    <rdfs:comment xml:lang="en">Named FaultState because maestro:Fault is the fault occurrence class. MAESTRO-local: the HSU PackML ODP has no Fault state; there a machine fault leads to Aborting and Aborted.</rdfs:comment>
    <rdf:type rdf:resource="https://w3id.org/maestro#State"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Fault"/>
    <skos:definition xml:lang="en">The resource is in a faulted or error state.</skos:definition>
  </owl:NamedIndividual>
  <maestro:ModbusDataTable rdf:about="https://w3id.org/maestro#ModbusDiscreteInput">
    <skos:definition xml:lang="en">The Modbus data table of single-bit values a client can only read.</skos:definition>
    <rdfs:label xml:lang="en">Discrete input</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/modbus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </maestro:ModbusDataTable>
  <owl:Class rdf:about="https://w3id.org/maestro#ProductType">
    <rdfs:comment xml:lang="en">HHM-Core Product cluster: the catalogue or design item (what is specified), as opposed to the produced unit (maestro:ProductInstance).</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/product#ProductType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <skos:definition xml:lang="en">An information entity specifying a repeatable product design or configuration.</skos:definition>
    <rdfs:label xml:lang="en">Product type</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#MaintenanceTask">
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#MaintenanceTask"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <rdfs:label xml:lang="en">Maintenance task</rdfs:label>
    <skos:definition xml:lang="en">A specified unit of maintenance work; a maintenance action performs it.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ParameterDirection">
    <rdfs:label xml:lang="en">Parameter direction</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <skos:definition xml:lang="en">Whether a parameter definition is consumed (input) or produced (output) by its skill.</skos:definition>
    <rdfs:comment xml:lang="en">Controlled vocabulary with the two individuals maestro:Input and maestro:Output. A data binding flows from an output to an input.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#ParameterDirection"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#RiskLevel">
    <dct:source rdf:resource="https://w3id.org/maestro/safety#RiskLevel"/>
    <rdfs:label xml:lang="en">Risk level</rdfs:label>
    <skos:definition xml:lang="en">A qualitative rating of a risk after assessment.</skos:definition>
    <rdfs:comment xml:lang="en">Controlled vocabulary: Low, Medium, High.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#Requirement">
    <rdfs:label xml:lang="en">Requirement</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <skos:definition xml:lang="en">A requirement that applies to a product or one of its features: functional, dimensional or regulatory.</skos:definition>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/DINEN61360#Instance_Description"/>
    <rdfs:comment xml:lang="en">HHM-Core Product cluster. Close match to DINEN61360:Instance_Description of the HSU DIN EN 61360 ODP, whose expression goal is a requirement. Also the demand side of a manufacturing-as-a-service request (maestro:hasRequirement).</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/product#Requirement"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#DataBinding">
    <dct:source rdf:resource="https://w3id.org/maestro/skill#DataBinding"/>
    <rdfs:comment xml:lang="en">HHM-Core Recipe / Planning cluster (DataBinding: output -&gt; input). The producing parameter is maestro:bindsFrom, the consuming parameter maestro:bindsTo; the step that owns the binding consumes the value.</rdfs:comment>
    <skos:definition xml:lang="en">Binds a producing skill's output parameter to a consuming skill's input parameter.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <rdfs:label xml:lang="en">Data binding</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#ExecutionRecord">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <rdfs:comment xml:lang="en">Separate from the execution so a record can be corrected, duplicated or retracted without pretending the execution happened twice.</rdfs:comment>
    <skos:definition xml:lang="en">An information entity describing an execution occurrence, as logged by a controller, an MES or an operator.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#ExecutionRecord"/>
    <rdfs:label xml:lang="en">Execution record</rdfs:label>
    <skos:broadMatch rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#InternalElement">
    <dct:source rdf:resource="https://w3id.org/maestro/automationml#InternalElement"/>
    <skos:definition xml:lang="en">A physical element of the plant topology that carries external interfaces and is connected by internal links.</skos:definition>
    <rdfs:comment xml:lang="en">Related to AML:InternalElement of the HSU AutomationML ODP, which is the model element of an AutomationML document that describes the physical element; hence skos:relatedMatch, not closeMatch.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/automationml"/>
    <rdfs:label xml:lang="en">Internal element</rdfs:label>
    <skos:relatedMatch rdf:resource="https://w3id.org/hsu-aut/AutomationML#InternalElement"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#BOMNode">
    <dct:source rdf:resource="https://w3id.org/maestro/product#BOMNode"/>
    <skos:definition xml:lang="en">A node in a structured bill of materials: a referenced product type with quantity and reference designator.</skos:definition>
    <rdfs:label xml:lang="en">BOM node</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <rdfs:comment xml:lang="en">HHM-Core Product cluster. Nested with maestro:hasPart; the referenced part type is maestro:nodeFor; the material with maestro:madeOf.</rdfs:comment>
  </owl:Class>
  <maestro:ExecutionStatus rdf:about="https://w3id.org/maestro#Executing">
    <rdfs:label xml:lang="en">Executing</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/PackML#Execute"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Close match to PackML:Execute, the acting state the machine is in once it is processing.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Executing"/>
    <skos:definition xml:lang="en">The skill is running.</skos:definition>
    <maestro:inDimension rdf:resource="https://w3id.org/maestro#OperationalDimension"/>
  </maestro:ExecutionStatus>
  <maestro:ModbusDataTable rdf:about="https://w3id.org/maestro#ModbusInputRegister">
    <skos:definition xml:lang="en">The Modbus data table of 16-bit registers a client can only read.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/modbus"/>
    <rdfs:label xml:lang="en">Input register</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </maestro:ModbusDataTable>
  <owl:Class rdf:about="https://w3id.org/maestro#Enterprise">
    <rdfs:label xml:lang="en">Enterprise</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/isa95"/>
    <dct:source rdf:resource="https://w3id.org/maestro/planning#Enterprise"/>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/DINEN62264-2#Enterprise"/>
    <skos:definition xml:lang="en">The organisation that owns and operates one or more sites.</skos:definition>
  </owl:Class>
  <maestro:Role rdf:about="https://w3id.org/maestro#ProviderRole">
    <skos:definition xml:lang="en">Held by the party an offer is offered by.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#ProviderRole"/>
    <rdfs:label xml:lang="en">Provider role</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
  </maestro:Role>
  <owl:Class rdf:about="https://w3id.org/maestro#Action">
    <dct:source rdf:resource="https://w3id.org/maestro/policy#Action"/>
    <skos:definition xml:lang="en">An operation a permission governs.</skos:definition>
    <rdfs:comment xml:lang="en">Controlled vocabulary of individuals: Invoke, Read, Write, Configure. Needed so a permission can say what it permits.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:label xml:lang="en">Action</rdfs:label>
    <skos:closeMatch rdf:resource="http://www.w3.org/ns/odrl/2/Action"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Degraded">
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Degraded"/>
    <maestro:inDimension rdf:resource="https://w3id.org/maestro#HealthDimension"/>
    <rdf:type rdf:resource="https://w3id.org/maestro#State"/>
    <rdfs:label xml:lang="en">Degraded</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <skos:definition xml:lang="en">Diagnostic condition: the resource still operates but outside its normal condition band.</skos:definition>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#StateDimension">
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#StateDimension"/>
    <rdfs:comment xml:lang="en">Controlled vocabulary: Operational, Health, Reservation, Mode.</rdfs:comment>
    <rdfs:label xml:lang="en">State dimension</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <skos:definition xml:lang="en">An independent aspect along which a subject has a state value at a time.</skos:definition>
  </owl:Class>
  <maestro:Protocol rdf:about="https://w3id.org/maestro#MqttProtocol">
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: each protocol individual is declared in the extension module of its protocol. An maestro:MqttBinding names it with maestro:specializesAs.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/mqtt"/>
    <rdfs:label xml:lang="en">MQTT</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#MqttProtocol"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">The MQTT publish-subscribe protocol.</skos:definition>
  </maestro:Protocol>
  <maestro:SafetyIntegrityLevel rdf:about="https://w3id.org/maestro#SIL1">
    <rdfs:label xml:lang="en">SIL 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#SIL1"/>
    <skos:definition xml:lang="en">Safety integrity level 1, declared by the integrator.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
  </maestro:SafetyIntegrityLevel>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Healthy">
    <skos:definition xml:lang="en">Diagnostic condition: the resource operates within its normal condition band.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/telemetry"/>
    <maestro:inDimension rdf:resource="https://w3id.org/maestro#HealthDimension"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#Healthy"/>
    <rdf:type rdf:resource="https://w3id.org/maestro#State"/>
    <rdfs:label xml:lang="en">Healthy</rdfs:label>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/maestro#Identifier">
    <rdfs:comment xml:lang="en">HHM-Core Product cluster (Identifier: GTIN / UUID / IRDI / IRI). The scheme is a literal (maestro:identifierScheme) so that no class per scheme is needed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <skos:definition xml:lang="en">A scheme-qualified identifier of an entity, such as a GTIN, a UUID, an IRDI or an IRI, whose value is unique within its scheme.</skos:definition>
    <rdfs:label xml:lang="en">Identifier</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/product#Identifier"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#ModbusCoil">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/modbus"/>
    <rdf:type rdf:resource="https://w3id.org/maestro#ModbusDataTable"/>
    <skos:definition xml:lang="en">The Modbus data table of single-bit values a client can read and write.</skos:definition>
    <rdfs:label xml:lang="en">Coil</rdfs:label>
  </owl:NamedIndividual>
  <maestro:InterfaceDescriptionLanguage rdf:about="https://w3id.org/maestro#OpenApiIDL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Moved from core/invocation.ttl: each interface description language is declared in the extension module of its technology. A REST interface names it with maestro:describedIn.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#OpenApiIDL"/>
    <skos:definition xml:lang="en">An interface described as an OpenAPI document. A plain name of the technology; no conformance claim.</skos:definition>
    <rdfs:label xml:lang="en">OpenAPI</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/rest"/>
  </maestro:InterfaceDescriptionLanguage>
  <owl:Class rdf:about="https://w3id.org/maestro#Marketplace">
    <rdfs:label xml:lang="en">Marketplace</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <skos:definition xml:lang="en">A platform on which offers are listed and matched.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#Actor"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#Marketplace"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/maestro#MaintenancePlan">
    <skos:definition xml:lang="en">A specification of the maintenance tasks an asset receives and when.</skos:definition>
    <rdfs:label xml:lang="en">Maintenance plan</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#MaintenancePlan"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/maestro#Wind">
    <rdfs:label xml:lang="en">Wind</rdfs:label>
    <skos:definition xml:lang="en">Electricity from wind generation.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
    <dct:source rdf:resource="https://w3id.org/maestro/energy#Wind"/>
    <rdf:type rdf:resource="https://w3id.org/maestro#EnergySource"/>
  </owl:NamedIndividual>
</rdf:RDF>
