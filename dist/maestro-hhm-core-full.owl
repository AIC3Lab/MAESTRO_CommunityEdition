    <rdfs:label xml:lang="en">reference designator</rdfs:label>
    <skos:definition xml:lang="en">Reference designator of a bill-of-materials node, for example R1 or C3.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#achievedPerformanceLevel">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#SafetyFunction"/>
    <rdfs:label xml:lang="en">achieved performance level</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#achievedPerformanceLevel"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <skos:definition xml:lang="en">The performance level a safety function has been assessed to achieve.</skos:definition>
    <rdfs:comment xml:lang="en">Assert only with an maestro:RiskAssessment as evidence.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/maestro#PerformanceLevel"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#bindsTo">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#DataBinding"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ParameterDef"/>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#bindsTo"/>
    <rdfs:comment xml:lang="en">Implied by the HHM diagram's annotation (output -&gt; input).</rdfs:comment>
    <rdfs:label xml:lang="en">binds to</rdfs:label>
    <skos:definition xml:lang="en">Relates a data binding to the consuming (input) parameter definition.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#exposedVia">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#SkillService"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#SkillInterface"/>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#exposedVia"/>
    <skos:definition xml:lang="en">Relates a skill interface, or a skill service, to the endpoint through which clients reach it.</skos:definition>
    <rdfs:label xml:lang="en">exposed via</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Endpoint"/>
    <rdfs:comment xml:lang="en">HHM-Core edge SkillInterface exposedVia Endpoint; the digital-twin diagram also draws SkillService exposedVia Endpoint. Domain left open for both.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasRequirement">
    <skos:definition xml:lang="en">Relates a product type, a variant or a service request to a requirement it carries.</skos:definition>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#ProductType"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Variant"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#ServiceRequest"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Requirement"/>
    <rdfs:comment xml:lang="en">Domain left open: shared by the product and the manufacturing-as-a-service modules.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/product#hasRequirement"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <rdfs:label xml:lang="en">has requirement</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasModule">
    <dct:source rdf:resource="https://w3id.org/maestro/resource#hasModule"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/resource"/>
    <skos:definition xml:lang="en">Relates a station to a plug-and-produce module it carries.</skos:definition>
    <rdfs:label xml:lang="en">has module</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Station"/>
    <rdfs:comment xml:lang="en">HHM-Core edge Station hasModule Module.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Module"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#measuredSubject">
    <rdfs:comment xml:lang="en">Domain and range left open: energy and power measurements, of modules, stations or executions.</rdfs:comment>
    <dct:source rdf:resource="https://w3id.org/maestro/energy#measuredSubject"/>
    <rdfs:label xml:lang="en">measured subject</rdfs:label>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#PowerMeasurement"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#EnergyMeasurement"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/energy"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Station"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#SkillExecution"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Module"/>
    <skos:definition xml:lang="en">Relates a measurement to the module, station or execution it is of.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasFinding">
    <skos:definition xml:lang="en">Relates a maintenance action or inspection to a finding recorded during it.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Finding"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#MaintenanceAction"/>
    <rdfs:label xml:lang="en">has finding</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#hasFinding"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#quantity">
    <dct:source rdf:resource="https://w3id.org/maestro/product#quantity"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#ProductionOrder"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#BOMNode"/>
    <skos:definition xml:lang="en">Quantity of the referenced product type in a bill-of-materials node, or the number of units a production order covers.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">quantity</rdfs:label>
    <rdfs:comment xml:lang="en">Domain left open: used by maestro:BOMNode and maestro:ProductionOrder.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#submittedOn">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ServiceRequest"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maas"/>
    <dct:source rdf:resource="https://w3id.org/maestro/maas#submittedOn"/>
    <rdfs:label xml:lang="en">submitted on</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <skos:definition xml:lang="en">When the request was raised.</skos:definition>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/maestro#Inspection">
    <rdfs:label xml:lang="en">Inspection</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/maestro#MaintenanceAction"/>
    <dct:references rdf:resource="https://w3id.org/maestro/maintenance#Inspection"/>
    <rdfs:comment xml:lang="en">MAESTRO 1.0 also types it as a quality inspection; this package has no quality module.</rdfs:comment>
    <skos:definition xml:lang="en">An inspection carried out as maintenance work, examining the condition of an asset and recording findings.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#value">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ParameterValue"/>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#value"/>
    <skos:definition xml:lang="en">The supplied literal value of a parameter value.</skos:definition>
    <rdfs:label xml:lang="en">value</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <rdfs:comment xml:lang="en">No range: the literal's datatype follows the parameter definition's maestro:paramType.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasInstance">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/product"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ProductInstance"/>
    <dct:references rdf:resource="https://w3id.org/maestro/product#instanceOfType"/>
    <rdfs:comment xml:lang="en">HHM-Core edge ProductType hasInstance ProductInstance, read from the type. MAESTRO 1.0 reads the inverse, prod:instanceOfType, from the instance.</rdfs:comment>
    <rdfs:label xml:lang="en">has instance</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ProductType"/>
    <skos:definition xml:lang="en">Relates a product type to a produced unit that realises it.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#stepOrder">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/recipe"/>
    <dct:source rdf:resource="https://w3id.org/maestro/skill#stepOrder"/>
    <rdfs:label xml:lang="en">step order</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#PlanStep"/>
    <skos:definition xml:lang="en">Position of a plan step within its recipe, counting from 1.</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#unitRef">
    <rdfs:label xml:lang="en">unit reference</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:comment xml:lang="en">HHM-Core ParameterDef unitRef, and the QUDT/OM extension point of the Skills cluster. MAESTRO 1.0 points at a unit individual of its unit module; this package has no unit module and keeps the QUDT IRI as a literal.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ParameterDef"/>
    <dct:references rdf:resource="https://w3id.org/maestro/skill#unitRef"/>
    <skos:definition xml:lang="en">The unit of the parameter, given as the IRI of a QUDT unit (for example http://qudt.org/vocab/unit/MilliM).</skos:definition>
  </owl:DatatypeProperty>
  <owl:AllDifferent rdf:nodeID="n00a0a59781e74eadac400128e5daaf8db1">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/maestro#Input"/>
      <rdf:Description rdf:about="https://w3id.org/maestro#Output"/>
    </owl:members>
  </owl:AllDifferent>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#faultCause">
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#Fault"/>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#faultCause"/>
