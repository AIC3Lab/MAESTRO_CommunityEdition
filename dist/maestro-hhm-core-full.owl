  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#usesDataFormat">
    <rdfs:label xml:lang="en">uses data format</rdfs:label>
    <skos:definition xml:lang="en">Relates a binding to the payload encoding it uses on its protocol.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Binding"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#DataFormat"/>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#usesDataFormat"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasInput">
    <rdfs:comment xml:lang="en">HHM-Core edge SkillExecution hasInput ParameterValue.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#SkillExecution"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ParameterValue"/>
    <rdfs:label xml:lang="en">has input</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#hasInput"/>
    <skos:definition xml:lang="en">Relates an execution to a parameter value supplied to it.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#partOfEnterprise">
    <rdfs:label xml:lang="en">part of enterprise</rdfs:label>
    <dct:source rdf:resource="https://w3id.org/maestro/planning#partOfEnterprise"/>
    <skos:definition xml:lang="en">Relates a site to the enterprise it belongs to.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Site"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/isa95"/>
    <skos:closeMatch rdf:resource="http://www.w3id.org/hsu-aut/DINEN62264-2#SiteIsPartOfEnterprise"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#Enterprise"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#modbusDataTable">
    <rdfs:label xml:lang="en">Modbus data table</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/modbus"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#ModbusDataTable"/>
    <skos:definition xml:lang="en">Relates a Modbus binding to the data table its addresses refer to.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#ModbusBinding"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasPostcondition">
    <rdfs:range rdf:resource="https://w3id.org/maestro#Postcondition"/>
    <skos:definition xml:lang="en">Relates a skill to a condition that holds after it has run.</skos:definition>
    <rdfs:comment xml:lang="en">HHM-Core edge Skill hasPostcondition Postcondition.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Skill"/>
    <dct:references rdf:resource="https://w3id.org/maestro/skill#hasPostcondition"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <rdfs:label xml:lang="en">has postcondition</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#startTime">
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#startTime"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#TimeInterval"/>
    <skos:definition xml:lang="en">The instant at which an interval started.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">start time</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#emits">
    <rdfs:range rdf:resource="https://w3id.org/maestro#EventStream"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Endpoint"/>
    <rdfs:comment xml:lang="en">HHM-Core edge Endpoint emits EventStream. A stream contract, not an event occurrence.</rdfs:comment>
    <rdfs:label xml:lang="en">emits</rdfs:label>
    <skos:definition xml:lang="en">Relates an endpoint to an event-stream contract it publishes.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/communication#emitsStream"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/invocation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasProperty">
    <rdfs:range rdf:resource="https://w3id.org/maestro#DtdlProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/dtdl"/>
    <rdfs:label xml:lang="en">has property</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#DtdlInterface"/>
    <skos:definition xml:lang="en">Relates a DTDL interface to a property it declares.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/dtdl#hasProperty"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#represents">
    <skos:definition xml:lang="en">Relates a digital twin to the product instance, station or module it represents.</skos:definition>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Module"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#Station"/>
    <schema:rangeIncludes rdf:resource="https://w3id.org/maestro#ProductInstance"/>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#DigitalTwin"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/digital-twin"/>
    <rdfs:label xml:lang="en">represents</rdfs:label>
    <rdfs:comment xml:lang="en">HHM edges DigitalTwin represents ProductInstance / Station / Module. Range left open for the three.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasInterfaceContract">
    <dct:source rdf:resource="https://w3id.org/maestro/skill#hasInterfaceContract"/>
    <rdfs:comment xml:lang="en">HHM-Core edge Skill hasInterfaceContract SkillInterface.</rdfs:comment>
    <skos:definition xml:lang="en">Relates a skill to the protocol-neutral interface contract through which it is invoked.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Skill"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/skill"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#SkillInterface"/>
    <rdfs:label xml:lang="en">has interface contract</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#requiredSIL">
    <rdfs:domain rdf:resource="https://w3id.org/maestro#SafetyFunction"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#SafetyIntegrityLevel"/>
    <skos:definition xml:lang="en">The safety integrity level required of a safety function (target level), as declared by the integrator.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/safety#requiredSIL"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/policy"/>
    <rdfs:label xml:lang="en">required SIL</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/maestro#hasTime">
    <rdfs:label xml:lang="en">has time</rdfs:label>
    <skos:definition xml:lang="en">Relates an execution, or another occurrence, to the time interval over which it ran.</skos:definition>
    <dct:source rdf:resource="https://w3id.org/maestro/runtime#hasTime"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#MaintenanceAction"/>
    <schema:domainIncludes rdf:resource="https://w3id.org/maestro#SkillExecution"/>
    <rdfs:range rdf:resource="https://w3id.org/maestro#TimeInterval"/>
    <rdfs:comment xml:lang="en">HHM-Core edge SkillExecution hasTime TimeInterval. Domain left open so maintenance actions and measurements can carry an interval too.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/execution"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/maestro#remainingUsefulLifeHours">
    <dct:source rdf:resource="https://w3id.org/maestro/maintenance#remainingUsefulLifeHours"/>
    <skos:definition xml:lang="en">Forecast remaining useful life of a module, in hours.</skos:definition>
    <rdfs:comment xml:lang="en">Numeric value; range rdfs:Literal for the same reason as maestro:mtbfHours.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/maestro/hhm/maintenance"/>
    <rdfs:label xml:lang="en">remaining useful life (hours)</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/maestro#Module"/>
  </owl:DatatypeProperty>
