###  https://w3id.org/maestro#hasExecutionHistory
maestro:hasExecutionHistory a owl:ObjectProperty ;
    rdfs:label "has execution history"@en ;
    skos:definition "Relates a digital twin to a skill execution of the entity it represents."@en ;
    rdfs:comment "HHM edge DigitalTwin hasExecutionHistory SkillExecution."@en ;
    rdfs:domain maestro:DigitalTwin ;
    rdfs:range maestro:SkillExecution ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/digital-twin> .

###  https://w3id.org/maestro#hasFeature
maestro:hasFeature a owl:ObjectProperty ;
    rdfs:label "has feature"@en ;
    skos:definition "Relates a product type to a geometric or functional feature."@en ;
    rdfs:comment "HHM-Core edge ProductType hasFeature Feature."@en ;
    rdfs:domain maestro:ProductType ;
    rdfs:range maestro:Feature ;
    dct:source <https://w3id.org/maestro/product#hasFeature> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#hasFinding
maestro:hasFinding a owl:ObjectProperty ;
    rdfs:label "has finding"@en ;
    skos:definition "Relates a maintenance action or inspection to a finding recorded during it."@en ;
    rdfs:domain maestro:MaintenanceAction ;
    rdfs:range maestro:Finding ;
    dct:source <https://w3id.org/maestro/maintenance#hasFinding> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#hasIdentifier
maestro:hasIdentifier a owl:ObjectProperty ;
    rdfs:label "has identifier"@en ;
    skos:definition "Relates an entity to a scheme-qualified identifier it carries."@en ;
    rdfs:comment "HHM-Core edges ProductType hasIdentifier Identifier and ProductInstance hasIdentifier Identifier. Domain left open so modules, stations and executions may carry identifiers too; an entity may carry several identifiers from different schemes."@en ;
    rdfs:range maestro:Identifier ;
    dct:source <https://w3id.org/maestro/core#hasIdentifier> ;
    schema:domainIncludes maestro:ProductInstance , maestro:ProductType ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#hasInput
maestro:hasInput a owl:ObjectProperty ;
    rdfs:label "has input"@en ;
    skos:definition "Relates an execution to a parameter value supplied to it."@en ;
    rdfs:comment "HHM-Core edge SkillExecution hasInput ParameterValue."@en ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain maestro:SkillExecution ;
    rdfs:range maestro:ParameterValue ;
    dct:source <https://w3id.org/maestro/runtime#hasInput> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#hasInstance
maestro:hasInstance a owl:ObjectProperty ;
    rdfs:label "has instance"@en ;
    skos:definition "Relates a product type to a produced unit that realises it."@en ;
    rdfs:comment "HHM-Core edge ProductType hasInstance ProductInstance, read from the type. MAESTRO 1.0 reads the inverse, prod:instanceOfType, from the instance."@en ;
    rdfs:domain maestro:ProductType ;
    rdfs:range maestro:ProductInstance ;
    dct:references <https://w3id.org/maestro/product#instanceOfType> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#hasInterface
maestro:hasInterface a owl:ObjectProperty ;
    rdfs:label "has interface"@en ;
    skos:definition "Relates an internal element to an external interface it carries."@en ;
    rdfs:domain maestro:InternalElement ;
    rdfs:range maestro:ExternalInterface ;
    dct:source <https://w3id.org/maestro/automationml#hasInterface> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/automationml> .

###  https://w3id.org/maestro#hasInterfaceContract
maestro:hasInterfaceContract a owl:ObjectProperty ;
    rdfs:label "has interface contract"@en ;
    skos:definition "Relates a skill to the protocol-neutral interface contract through which it is invoked."@en ;
