########################################################################
#    General axioms
########################################################################

[ a owl:AllDifferent ; owl:members ( maestro:AutomaticMode maestro:ManualMode maestro:MaintenanceMode ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:Available maestro:Busy maestro:FaultState maestro:Alarm maestro:Healthy maestro:Degraded maestro:Failed maestro:Reserved maestro:Idle maestro:Executing maestro:Held maestro:Completed maestro:Aborted ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:Cleared maestro:ConditionallyCleared maestro:NotCleared ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:CustomerRole maestro:ProviderRole maestro:MarketplaceRole ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:ElectricalGrid maestro:Solar maestro:Wind maestro:CompressedAir ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:Idle maestro:Executing maestro:Held maestro:Completed maestro:Aborted ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:Input maestro:Output ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:Invoke maestro:Read maestro:Write maestro:Configure ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:JsonFormat maestro:XmlFormat maestro:ProtobufFormat maestro:OpcUaBinaryFormat ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:LowRisk maestro:MediumRisk maestro:HighRisk ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:ModbusCoil maestro:ModbusDiscreteInput maestro:ModbusInputRegister maestro:ModbusHoldingRegister ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:OpcUaNodeSetIDL maestro:DtdlIDL maestro:AasSubmodelTemplateIDL maestro:OpenApiIDL ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:OpcUaProtocol maestro:DdsProtocol maestro:MqttProtocol maestro:ProfinetProtocol maestro:EthercatProtocol maestro:ModbusProtocol maestro:HttpProtocol ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:OperationalDimension maestro:HealthDimension maestro:ReservationDimension maestro:ModeDimension ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:PLa maestro:PLb maestro:PLc maestro:PLd maestro:PLe ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:Precedes maestro:Parallel maestro:Alternative maestro:Loop maestro:Optional ) ] .

[ a owl:AllDifferent ; owl:members ( maestro:SIL1 maestro:SIL2 maestro:SIL3 maestro:SIL4 ) ] .
