###  https://w3id.org/maestro#mayRaise
maestro:mayRaise a owl:ObjectProperty ;
    rdfs:label "may raise"@en ;
    skos:definition "Relates an execution to a fault occurrence raised during it."@en ;
    rdfs:comment "HHM-Core edge SkillExecution mayRaise Fault, kept under the HHM name. It records the fault that did occur; what a skill can raise in principle is maestro:mayRaiseFault on the skill (modules/telemetry.ttl)."@en ;
    rdfs:domain maestro:SkillExecution ;
    rdfs:range maestro:Fault ;
    dct:references <https://w3id.org/maestro/runtime#raisedFault> ;
