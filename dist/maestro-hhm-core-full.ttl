###  https://w3id.org/maestro#hasEvidence
maestro:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has evidence"@en ;
    skos:definition "Relates a policy, or another record, to the evidence that backs it."@en ;
    rdfs:comment "HHM-Core edge Policy hasEvidence Evidence. Domain left open so assessments and state assertions can reuse it."@en ;
    rdfs:range maestro:Evidence ;
    dct:source <https://w3id.org/maestro/policy#hasEvidence> ;
    schema:domainIncludes maestro:Policy ;
