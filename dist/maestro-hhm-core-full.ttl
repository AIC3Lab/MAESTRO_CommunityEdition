    rdfs:range maestro:Module ;
    dct:source <https://w3id.org/maestro/resource#hasModule> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/resource> .

###  https://w3id.org/maestro#hasParameterDef
maestro:hasParameterDef a owl:ObjectProperty ;
    rdfs:label "has parameter definition"@en ;
    skos:definition "Relates a skill, or an operation signature, to a typed parameter definition it declares."@en ;
    rdfs:comment "HHM-Core edge Skill hasParameterDef ParameterDef. Domain left open so an maestro:OperationSignature can declare its input parameters with the same property."@en ;
    rdfs:range maestro:ParameterDef ;
    dct:source <https://w3id.org/maestro/skill#hasParameterDef> ;
    schema:domainIncludes maestro:OperationSignature , maestro:Skill ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#hasPart
maestro:hasPart a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "has part"@en ;
    skos:definition "Relates a bill-of-materials node to a node nested under it."@en ;
    rdfs:comment "HHM-Core edge BOMNode hasPart BOMNode. Transitive."@en ;
    rdfs:domain maestro:BOMNode ;
    rdfs:range maestro:BOMNode ;
    dct:references <https://w3id.org/maestro/core#hasPart> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#hasPermission
maestro:hasPermission a owl:ObjectProperty ;
    rdfs:label "has permission"@en ;
    skos:definition "Relates a policy to a permission it grants."@en ;
    rdfs:comment "What the policy grants; maestro:requiresPermission states what must already be held for the policy to apply."@en ;
    rdfs:subPropertyOf odrl:permission ;
    rdfs:domain maestro:Policy ;
    rdfs:range maestro:Permission ;
    dct:source <https://w3id.org/maestro/policy#hasPermission> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#hasPostcondition
maestro:hasPostcondition a owl:ObjectProperty ;
    rdfs:label "has postcondition"@en ;
    skos:definition "Relates a skill to a condition that holds after it has run."@en ;
    rdfs:comment "HHM-Core edge Skill hasPostcondition Postcondition."@en ;
    rdfs:domain maestro:Skill ;
    rdfs:range maestro:Postcondition ;
    dct:references <https://w3id.org/maestro/skill#hasPostcondition> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#hasPrecondition
maestro:hasPrecondition a owl:ObjectProperty ;
    rdfs:label "has precondition"@en ;
    skos:definition "Relates a skill to a condition that must hold before it runs."@en ;
    rdfs:comment "HHM-Core edge Skill hasPrecondition Precondition."@en ;
    rdfs:domain maestro:Skill ;
    rdfs:range maestro:Precondition ;
    dct:references <https://w3id.org/maestro/skill#hasPrecondition> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#hasProperty
maestro:hasProperty a owl:ObjectProperty ;
    rdfs:label "has property"@en ;
    skos:definition "Relates a DTDL interface to a property it declares."@en ;
    rdfs:domain maestro:DtdlInterface ;
    rdfs:range maestro:DtdlProperty ;
    dct:source <https://w3id.org/maestro/dtdl#hasProperty> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/dtdl> .

###  https://w3id.org/maestro#hasRequirement
maestro:hasRequirement a owl:ObjectProperty ;
    rdfs:label "has requirement"@en ;
    skos:definition "Relates a product type, a variant or a service request to a requirement it carries."@en ;
    rdfs:comment "Domain left open: shared by the product and the manufacturing-as-a-service modules."@en ;
    rdfs:range maestro:Requirement ;
    dct:source <https://w3id.org/maestro/product#hasRequirement> ;
    schema:domainIncludes maestro:ProductType , maestro:ServiceRequest , maestro:Variant ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#hasSignature
maestro:hasSignature a owl:ObjectProperty ;
    rdfs:label "has signature"@en ;
    skos:definition "Relates a binding to the operation signature it exposes."@en ;
    rdfs:comment "Hangs the signature off the binding, so one endpoint can carry several protocol-specific signatures."@en ;
    rdfs:domain maestro:Binding ;
    rdfs:range maestro:OperationSignature ;
    dct:source <https://w3id.org/maestro/communication#hasSignature> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .

###  https://w3id.org/maestro#hasState
maestro:hasState a owl:ObjectProperty ;
    rdfs:label "has state"@en ;
    skos:definition "The current operational state of a station or module."@en ;
    rdfs:comment "Shortcut for the open (no validTo) operational maestro:StateAssertion. Domain left open for stations and modules. Use only inside a runtime snapshot graph."@en ;
    rdfs:range maestro:State ;
    dct:source <https://w3id.org/maestro/core#hasState> ;
    schema:domainIncludes maestro:Module , maestro:Station ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#hasStatus
maestro:hasStatus a owl:ObjectProperty ;
    rdfs:label "has status"@en ;
    skos:definition "Relates an execution to the status it reached."@en ;
    rdfs:comment "HHM-Core edge SkillExecution hasStatus ExecutionStatus."@en ;
    rdfs:domain maestro:SkillExecution ;
    rdfs:range maestro:ExecutionStatus ;
    dct:source <https://w3id.org/maestro/runtime#hasStatus> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#hasStep
maestro:hasStep a owl:ObjectProperty ;
    rdfs:label "has step"@en ;
    skos:definition "Relates a recipe to a plan step it contains."@en ;
    rdfs:comment "HHM-Core edge Recipe hasStep PlanStep. Order is stated on the step with maestro:stepOrder and with control-flow constraints."@en ;
    rdfs:domain maestro:Recipe ;
    rdfs:range maestro:PlanStep ;
    dct:source <https://w3id.org/maestro/recipe#hasStep> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/recipe> .

###  https://w3id.org/maestro#hasSubSkillLink
maestro:hasSubSkillLink a owl:ObjectProperty ;
    rdfs:label "has sub-skill link"@en ;
    skos:definition "Relates a composite skill to a skill that is one of its constituents."@en ;
    rdfs:comment "HHM-Core edge CompositeSkill hasSubSkillLink Skill, stated directly between the two skills as the HHM diagram draws it. MAESTRO 1.0 reifies the link (skill:SubSkillLink) so that control flow can attach to it; in this package ordering and control flow belong to the recipe cluster."@en ;
    rdfs:domain maestro:CompositeSkill ;
    rdfs:range maestro:Skill ;
    dct:references <https://w3id.org/maestro/skill#hasSubSkillLink> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

