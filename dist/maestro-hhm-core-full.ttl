maestro:mitigates a owl:ObjectProperty ;
    rdfs:label "mitigates"@en ;
    skos:definition "Relates a safety function to the hazard it mitigates."@en ;
    rdfs:comment "A mitigation measure acts on a risk through maestro:reduces; a safety function acts on the hazard."@en ;
    rdfs:domain maestro:SafetyFunction ;
    rdfs:range maestro:Hazard ;
    dct:source <https://w3id.org/maestro/safety#mitigates> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#modbusDataTable
maestro:modbusDataTable a owl:ObjectProperty ;
    rdfs:label "Modbus data table"@en ;
    skos:definition "Relates a Modbus binding to the data table its addresses refer to."@en ;
    rdfs:domain maestro:ModbusBinding ;
    rdfs:range maestro:ModbusDataTable ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/modbus> .

###  https://w3id.org/maestro#nodeFor
maestro:nodeFor a owl:ObjectProperty ;
    rdfs:label "node for"@en ;
    skos:definition "Relates a bill-of-materials node to the product type it references."@en ;
    rdfs:comment "Implied by the HHM diagram: a BOM node stands for a part. Not drawn in the diagram."@en ;
    rdfs:domain maestro:BOMNode ;
    rdfs:range maestro:ProductType ;
    dct:references <https://w3id.org/maestro/product#nodeFor> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#offeredBy
maestro:offeredBy a owl:ObjectProperty ;
    rdfs:label "offered by"@en ;
    skos:definition "Relates a service offer to the provider standing behind it."@en ;
    rdfs:domain maestro:ServiceOffer ;
    rdfs:range maestro:PhysicalResourceProvider ;
    dct:source <https://w3id.org/maestro/maas#offeredBy> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#offersCapability
maestro:offersCapability a owl:ObjectProperty ;
    rdfs:label "offers capability"@en ;
    skos:definition "Relates a service offer to a capability it sells."@en ;
    rdfs:domain maestro:ServiceOffer ;
    rdfs:range maestro:Capability ;
    dct:source <https://w3id.org/maestro/maas#offersCapability> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#operatedBy
maestro:operatedBy a owl:ObjectProperty ;
    rdfs:label "operated by"@en ;
    skos:definition "Relates a marketplace to the actor that runs it."@en ;
    rdfs:domain maestro:Marketplace ;
    rdfs:range maestro:Actor ;
    dct:source <https://w3id.org/maestro/maas#operatedBy> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#operates
maestro:operates a owl:ObjectProperty ;
    rdfs:label "operates"@en ;
    skos:definition "Relates an actor to a station it owns and runs."@en ;
    rdfs:domain maestro:Actor ;
    rdfs:range maestro:Station ;
    dct:references <https://w3id.org/maestro/maas#operates> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#ordersProduct
maestro:ordersProduct a owl:ObjectProperty ;
    rdfs:label "orders product"@en ;
    skos:definition "Relates a production order to the product type it produces."@en ;
    rdfs:domain maestro:ProductionOrder ;
    rdfs:range maestro:ProductType ;
    dct:source <https://w3id.org/maestro/planning#ordersProduct> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#overInterval
maestro:overInterval a owl:ObjectProperty ;
    rdfs:label "over interval"@en ;
    skos:definition "Relates an energy measurement to the interval the energy accumulated over."@en ;
    rdfs:comment "The join to an execution's maestro:hasTime."@en ;
    rdfs:domain maestro:EnergyMeasurement ;
    rdfs:range maestro:TimeInterval ;
    dct:source <https://w3id.org/maestro/energy#overInterval> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/energy> .

###  https://w3id.org/maestro#parameterDirection
maestro:parameterDirection a owl:ObjectProperty ;
    rdfs:label "parameter direction"@en ;
    skos:definition "Relates a parameter definition to its direction, input or output."@en ;
    rdfs:comment "A data binding flows from an maestro:Output parameter to an maestro:Input parameter (checked by the recipe shapes)."@en ;
    rdfs:domain maestro:ParameterDef ;
    rdfs:range maestro:ParameterDirection ;
    dct:source <https://w3id.org/maestro/skill#parameterDirection> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#partOfArea
maestro:partOfArea a owl:ObjectProperty ;
    rdfs:label "part of area"@en ;
    skos:definition "Relates a work centre to the area it belongs to."@en ;
    rdfs:domain maestro:WorkCenter ;
    rdfs:range maestro:Area ;
    skos:closeMatch DINEN62264:CenterIsPartOfArea ;
    dct:source <https://w3id.org/maestro/planning#partOfArea> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/isa95> .

###  https://w3id.org/maestro#partOfEnterprise
maestro:partOfEnterprise a owl:ObjectProperty ;
    rdfs:label "part of enterprise"@en ;
    skos:definition "Relates a site to the enterprise it belongs to."@en ;
    rdfs:domain maestro:Site ;
    rdfs:range maestro:Enterprise ;
    skos:closeMatch DINEN62264:SiteIsPartOfEnterprise ;
    dct:source <https://w3id.org/maestro/planning#partOfEnterprise> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/isa95> .

###  https://w3id.org/maestro#partOfSite
maestro:partOfSite a owl:ObjectProperty ;
    rdfs:label "part of site"@en ;
    skos:definition "Relates an area to the site it belongs to."@en ;
    rdfs:domain maestro:Area ;
    rdfs:range maestro:Site ;
    skos:closeMatch DINEN62264:AreaIsPartOfSite ;
    dct:source <https://w3id.org/maestro/planning#partOfSite> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/isa95> .

###  https://w3id.org/maestro#partOfWorkCenter
maestro:partOfWorkCenter a owl:ObjectProperty ;
    rdfs:label "part of work centre"@en ;
    skos:definition "Relates a work unit, or a station, to the work centre it belongs to."@en ;
    rdfs:comment "Domain left open so an maestro:Station can be placed in a work centre without being retyped."@en ;
    rdfs:range maestro:WorkCenter ;
    skos:closeMatch DINEN62264:UnitIsPartOfCenter ;
    schema:domainIncludes maestro:Station , maestro:WorkUnit ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/isa95> .

###  https://w3id.org/maestro#performsTask
maestro:performsTask a owl:ObjectProperty ;
    rdfs:label "performs task"@en ;
    skos:definition "Relates a maintenance action to the planned task it carries out."@en ;
    rdfs:domain maestro:MaintenanceAction ;
    rdfs:range maestro:MaintenanceTask ;
    dct:source <https://w3id.org/maestro/maintenance#performsTask> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#planForAsset
maestro:planForAsset a owl:ObjectProperty ;
    rdfs:label "plan for asset"@en ;
    skos:definition "Relates a maintenance plan to the module it is defined for."@en ;
    rdfs:domain maestro:MaintenancePlan ;
    rdfs:range maestro:Module ;
    dct:source <https://w3id.org/maestro/maintenance#planForAsset> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#providedAt
maestro:providedAt a owl:ObjectProperty ;
    rdfs:label "provided at"@en ;
    skos:definition "Relates a service offer to the station that would do the work."@en ;
    rdfs:comment "The join to the technical layer; MAESTRO 1.0 names a plant, the HHM-Core package a station."@en ;
    rdfs:domain maestro:ServiceOffer ;
    rdfs:range maestro:Station ;
    dct:references <https://w3id.org/maestro/maas#providedAt> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#providesCapability
maestro:providesCapability a owl:ObjectProperty ;
    rdfs:label "provides capability"@en ;
    skos:definition "Relates a module to a capability it provides."@en ;
    rdfs:comment "HHM-Core edge Module providesCapability Capability. An asserted capability claim; whether a skill deployed on the module actually realises it is not entailed."@en ;
    rdfs:domain maestro:Module ;
    rdfs:range maestro:Capability ;
    dct:source <https://w3id.org/maestro/resource#providesCapability> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/resource> .

###  https://w3id.org/maestro#quoteFor
maestro:quoteFor a owl:ObjectProperty ;
    rdfs:label "quote for"@en ;
    skos:definition "Relates a quote to the request it answers."@en ;
    rdfs:domain maestro:Quote ;
    rdfs:range maestro:ServiceRequest ;
    dct:source <https://w3id.org/maestro/maas#quoteFor> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#realizedBy
maestro:realizedBy a owl:ObjectProperty ;
    rdfs:label "realized by"@en ;
    skos:definition "Relates a plan step to the skill that realises it."@en ;
    rdfs:comment "HHM-Core edge PlanStep realizedBy Skill."@en ;
    rdfs:domain maestro:PlanStep ;
    rdfs:range maestro:Skill ;
    dct:source <https://w3id.org/maestro/recipe#realizedBy> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/recipe> .

###  https://w3id.org/maestro#realizedByOrder
maestro:realizedByOrder a owl:ObjectProperty ;
    rdfs:label "realized by order"@en ;
    skos:definition "Relates a contract to the production order that executes it."@en ;
    rdfs:domain maestro:Contract ;
    rdfs:range maestro:ProductionOrder ;
    dct:source <https://w3id.org/maestro/maas#realizedByOrder> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#reduces
maestro:reduces a owl:ObjectProperty ;
    rdfs:label "reduces"@en ;
    skos:definition "Relates a mitigation to a risk it reduces."@en ;
    rdfs:comment "HHM-Core edge Mitigation reduces Risk."@en ;
    rdfs:domain maestro:Mitigation ;
    rdfs:range maestro:Risk ;
    dct:source <https://w3id.org/maestro/safety#reduces> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#relatedStep
maestro:relatedStep a owl:ObjectProperty ;
    rdfs:label "related step"@en ;
    skos:definition "Relates a control-flow constraint to the other plan step it relates the constrained step to."@en ;
    rdfs:comment "Implied by the HHM diagram: a constraint such as 'precedes' or 'parallel' needs a second step. A loop or optional constraint may omit it."@en ;
    rdfs:domain maestro:ControlFlowConstraint ;
    rdfs:range maestro:PlanStep ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/recipe> .

###  https://w3id.org/maestro#reliesOnMitigation
maestro:reliesOnMitigation a owl:ObjectProperty ;
    rdfs:label "relies on mitigation"@en ;
    skos:definition "Relates a risk assessment to a mitigation the assessed level assumes in place."@en ;
    rdfs:domain maestro:RiskAssessment ;
    rdfs:range maestro:Mitigation ;
    dct:source <https://w3id.org/maestro/safety#reliesOnMitigation> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#represents
maestro:represents a owl:ObjectProperty ;
    rdfs:label "represents"@en ;
    skos:definition "Relates a digital twin to the product instance, station or module it represents."@en ;
    rdfs:comment "HHM edges DigitalTwin represents ProductInstance / Station / Module. Range left open for the three."@en ;
    rdfs:domain maestro:DigitalTwin ;
    schema:rangeIncludes maestro:Module , maestro:ProductInstance , maestro:Station ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/digital-twin> .

###  https://w3id.org/maestro#requestedBy
maestro:requestedBy a owl:ObjectProperty ;
    rdfs:label "requested by"@en ;
    skos:definition "Relates a service request to the customer that raised it."@en ;
    rdfs:domain maestro:ServiceRequest ;
    rdfs:range maestro:Customer ;
    dct:source <https://w3id.org/maestro/maas#requestedBy> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#requiredPerformanceLevel
maestro:requiredPerformanceLevel a owl:ObjectProperty ;
    rdfs:label "required performance level"@en ;
    skos:definition "The performance level required of a safety function (target level), as declared by the integrator."@en ;
    rdfs:domain maestro:SafetyFunction ;
    rdfs:range maestro:PerformanceLevel ;
    dct:source <https://w3id.org/maestro/safety#requiredPerformanceLevel> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#requiredSIL
maestro:requiredSIL a owl:ObjectProperty ;
    rdfs:label "required SIL"@en ;
    skos:definition "The safety integrity level required of a safety function (target level), as declared by the integrator."@en ;
    rdfs:domain maestro:SafetyFunction ;
    rdfs:range maestro:SafetyIntegrityLevel ;
    dct:source <https://w3id.org/maestro/safety#requiredSIL> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#requiresCapability
maestro:requiresCapability a owl:ObjectProperty ;
    rdfs:label "requires capability"@en ;
    skos:definition "Relates a skill to a capability its executor must provide."@en ;
    rdfs:comment "HHM-Core edge Skill requiresCapability Capability. Matched against maestro:providesCapability of a module."@en ;
    rdfs:domain maestro:Skill ;
    rdfs:range maestro:Capability ;
    dct:source <https://w3id.org/maestro/skill#requiresCapability> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#requiresMode
maestro:requiresMode a owl:ObjectProperty ;
    rdfs:label "requires mode"@en ;
    skos:definition "Relates a policy to the operating mode it gates on."@en ;
    rdfs:comment "HHM-Core edge Policy requiresMode Mode."@en ;
    rdfs:domain maestro:Policy ;
    rdfs:range maestro:Mode ;
    dct:source <https://w3id.org/maestro/policy#requiresMode> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#requiresOperation
maestro:requiresOperation a owl:ObjectProperty ;
    rdfs:label "requires operation"@en ;
    skos:definition "Relates a product feature to the plan step that produces it."@en ;
    rdfs:comment "HHM-Core edge Feature requiresOperation PlanStep."@en ;
    rdfs:domain maestro:Feature ;
    rdfs:range maestro:PlanStep ;
    dct:source <https://w3id.org/maestro/recipe#requiresOperation> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#requiresPermission
maestro:requiresPermission a owl:ObjectProperty ;
    rdfs:label "requires permission"@en ;
    skos:definition "Relates a policy to a permission that must be held for the policy to apply."@en ;
    rdfs:comment "HHM-Core edge Policy requiresPermission Permission."@en ;
    rdfs:domain maestro:Policy ;
    rdfs:range maestro:Permission ;
    dct:source <https://w3id.org/maestro/policy#requiresPermission> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#returns
maestro:returns a owl:ObjectProperty ;
    rdfs:label "returns"@en ;
    skos:definition "Relates an operation signature to a parameter definition it returns."@en ;
    rdfs:comment "Input parameters of the signature use maestro:hasParameterDef."@en ;
    rdfs:domain maestro:OperationSignature ;
    rdfs:range maestro:ParameterDef ;
    dct:source <https://w3id.org/maestro/communication#returns> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .

###  https://w3id.org/maestro#riskEvidence
maestro:riskEvidence a owl:ObjectProperty ;
    rdfs:label "risk evidence"@en ;
    skos:definition "Relates a risk assessment to evidence it rests on: a test report, an audit, an observation record."@en ;
    rdfs:domain maestro:RiskAssessment ;
    rdfs:range maestro:Evidence ;
    dct:source <https://w3id.org/maestro/safety#riskEvidence> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#riskLevel
maestro:riskLevel a owl:ObjectProperty ;
    rdfs:label "risk level"@en ;
    skos:definition "Relates a risk assessment to the residual risk rating it concludes."@en ;
    rdfs:domain maestro:RiskAssessment ;
    rdfs:range maestro:RiskLevel ;
    dct:source <https://w3id.org/maestro/safety#riskLevel> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#rtsEvidence
maestro:rtsEvidence a owl:ObjectProperty ;
    rdfs:label "return-to-service evidence"@en ;
    skos:definition "Relates a return-to-service assessment to the evidence the clearance rests on: an inspection, a test run, an observation."@en ;
    rdfs:domain maestro:ReturnToServiceAssessment ;
    rdfs:range maestro:Evidence ;
    dct:references <https://w3id.org/maestro/maintenance#rtsEvidence> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#rtsOutcome
maestro:rtsOutcome a owl:ObjectProperty ;
    rdfs:label "return-to-service outcome"@en ;
    skos:definition "Relates a return-to-service assessment to its outcome."@en ;
    rdfs:domain maestro:ReturnToServiceAssessment ;
    rdfs:range maestro:ReturnToServiceOutcome ;
    dct:source <https://w3id.org/maestro/maintenance#rtsOutcome> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#specializesAs
maestro:specializesAs a owl:ObjectProperty ;
    rdfs:label "specializes as"@en ;
    skos:definition "Relates a binding to the concrete protocol it specialises to."@en ;
    rdfs:domain maestro:Binding ;
    rdfs:range maestro:Protocol ;
    dct:source <https://w3id.org/maestro/communication#specializesAs> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .

###  https://w3id.org/maestro#stateDimension
maestro:stateDimension a owl:ObjectProperty ;
    rdfs:label "state dimension"@en ;
    skos:definition "Relates a state assertion to the dimension the state belongs to."@en ;
    rdfs:domain maestro:StateAssertion ;
    rdfs:range maestro:StateDimension ;
    dct:source <https://w3id.org/maestro/runtime#stateDimension> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#stateEvidence
maestro:stateEvidence a owl:ObjectProperty ;
    rdfs:label "state evidence"@en ;
    skos:definition "Relates a state assertion to the execution, event or evidence record it rests on."@en ;
    rdfs:comment "Range left open."@en ;
    rdfs:domain maestro:StateAssertion ;
    dct:source <https://w3id.org/maestro/runtime#stateEvidence> ;
    schema:rangeIncludes maestro:Evidence , maestro:Fault , maestro:SkillExecution ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#stateSubject
maestro:stateSubject a owl:ObjectProperty ;
    rdfs:label "state subject"@en ;
    skos:definition "Relates a state assertion to the station or module whose state is asserted."@en ;
    rdfs:comment "Range left open for stations and modules."@en ;
    rdfs:domain maestro:StateAssertion ;
    dct:source <https://w3id.org/maestro/runtime#stateSubject> ;
    schema:rangeIncludes maestro:Module , maestro:Station ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#stateValue
maestro:stateValue a owl:ObjectProperty ;
    rdfs:label "state value"@en ;
    skos:definition "Relates a state assertion to the state value asserted."@en ;
    rdfs:domain maestro:StateAssertion ;
    rdfs:range maestro:State ;
    dct:source <https://w3id.org/maestro/runtime#stateValue> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#suppliedBy
maestro:suppliedBy a owl:ObjectProperty ;
    rdfs:label "supplied by"@en ;
    skos:definition "Relates an energy consumer to the energy source that supplies it."@en ;
    rdfs:domain maestro:EnergyConsumer ;
    rdfs:range maestro:EnergySource ;
    dct:source <https://w3id.org/maestro/energy#suppliedBy> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/energy> .

###  https://w3id.org/maestro#target
maestro:target a owl:ObjectProperty ;
    rdfs:label "target"@en ;
    skos:definition "Relates a permission to the skill, service, endpoint, module or data set it covers."@en ;
    rdfs:comment "Range left open: the target may be any entity."@en ;
    rdfs:subPropertyOf odrl:target ;
    rdfs:domain maestro:Permission ;
    dct:source <https://w3id.org/maestro/policy#target> ;
    schema:rangeIncludes maestro:Endpoint , maestro:Module , maestro:Skill , maestro:SkillService ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#triggeredBy
maestro:triggeredBy a owl:ObjectProperty ;
    rdfs:label "triggered by"@en ;
    skos:definition "Relates a maintenance action to the fault that caused the work."@en ;
    rdfs:comment "MAESTRO 1.0 also admits state assertions, plan intervals and predictions as triggers; this package narrows it to faults."@en ;
    rdfs:domain maestro:MaintenanceAction ;
    rdfs:range maestro:Fault ;
    dct:references <https://w3id.org/maestro/maintenance#triggeredBy> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#usesDataFormat
maestro:usesDataFormat a owl:ObjectProperty ;
    rdfs:label "uses data format"@en ;
    skos:definition "Relates a binding to the payload encoding it uses on its protocol."@en ;
    rdfs:domain maestro:Binding ;
    rdfs:range maestro:DataFormat ;
    dct:source <https://w3id.org/maestro/communication#usesDataFormat> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .

###  https://w3id.org/maestro#usesEventStream
maestro:usesEventStream a owl:ObjectProperty ;
    rdfs:label "uses event stream"@en ;
    skos:definition "Relates a digital twin to an event-stream contract it consumes for telemetry and events."@en ;
    rdfs:comment "HHM edge DigitalTwin uses telemetry / events EventStream."@en ;
    rdfs:domain maestro:DigitalTwin ;
    rdfs:range maestro:EventStream ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/digital-twin> .

###  https://w3id.org/maestro#usesProtocol
maestro:usesProtocol a owl:ObjectProperty ;
    rdfs:label "uses protocol"@en ;
    skos:definition "Relates an endpoint to the protocol it uses."@en ;
    rdfs:comment "HHM-Core edge Endpoint usesProtocol Protocol."@en ;
    rdfs:domain maestro:Endpoint ;
    rdfs:range maestro:Protocol ;
    dct:source <https://w3id.org/maestro/communication#usesProtocol> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .


########################################################################
#    Datatype properties
########################################################################

###  https://w3id.org/maestro#address
maestro:address a owl:DatatypeProperty ;
    rdfs:label "address"@en ;
    skos:definition "URI or URL of the endpoint, for example opc.tcp://plc1:4840."@en ;
    rdfs:comment "Moved from core/invocation.ttl. Where an endpoint has no network address (parallel wiring, for example), a URN names it."@en ;
    rdfs:domain maestro:Endpoint ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/communication#address> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/addressing> .

###  https://w3id.org/maestro#assumption
maestro:assumption a owl:DatatypeProperty ;
    rdfs:label "assumption"@en ;
    skos:definition "An assumption the assessment rests on: operating mode, exposure, access."@en ;
    rdfs:domain maestro:RiskAssessment ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/safety#assumption> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#browseName
maestro:browseName a owl:DatatypeProperty ;
    rdfs:label "browse name"@en ;
    skos:definition "The browse name of an OPC UA node."@en ;
    rdfs:domain maestro:OpcUaNode ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/opcua#browseName> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/opcua> .

###  https://w3id.org/maestro#carbonGCO2eqPerKwh
maestro:carbonGCO2eqPerKwh a owl:DatatypeProperty ;
    rdfs:label "carbon intensity (g CO2-eq per kWh)"@en ;
    skos:definition "Grams of CO2-equivalent emitted per kilowatt hour produced by an energy source."@en ;
    rdfs:comment "Numeric value; range rdfs:Literal for the same reason as maestro:energyKwh."@en ;
    rdfs:domain maestro:EnergySource ;
    rdfs:range rdfs:Literal ;
    dct:source <https://w3id.org/maestro/energy#carbonGCO2eqPerKwh> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/energy> .

###  https://w3id.org/maestro#currency
maestro:currency a owl:DatatypeProperty ;
    rdfs:label "currency"@en ;
    skos:definition "Three-letter currency code for the accompanying amount, for example EUR."@en ;
    rdfs:comment "Corresponds to schema:priceCurrency."@en ;
    rdfs:domain maestro:Quote ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/maas#currency> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#ddsDomainId
maestro:ddsDomainId a owl:DatatypeProperty ;
    rdfs:label "DDS domain id"@en ;
    skos:definition "The id of the DDS domain in which the participants of a DDS binding communicate."@en ;
    rdfs:comment "Participants in different domains do not see each other."@en ;
    rdfs:domain maestro:DdsBinding ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/dds> .

###  https://w3id.org/maestro#ddsTopic
maestro:ddsTopic a owl:DatatypeProperty ;
    rdfs:label "DDS topic"@en ;
    skos:definition "The name of the DDS topic a DDS binding publishes or subscribes."@en ;
    rdfs:subPropertyOf maestro:topic ;
    rdfs:domain maestro:DdsBinding ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/dds> .

###  https://w3id.org/maestro#ddsTypeName
maestro:ddsTypeName a owl:DatatypeProperty ;
    rdfs:label "DDS type name"@en ;
    skos:definition "The name of the data type registered for the topic of a DDS binding."@en ;
    rdfs:domain maestro:DdsBinding ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/dds> .

###  https://w3id.org/maestro#description
maestro:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    skos:definition "Free-text description of an entity."@en ;
    rdfs:comment "Domain left open: used by features, hazards, mitigations, safety functions and other entities."@en ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/core#description> ;
    schema:domainIncludes maestro:Capability , maestro:FaultDiagnosis , maestro:Feature , maestro:Hazard , maestro:Mitigation , maestro:Risk , maestro:SafetyFunction , maestro:Skill ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/resource> .

###  https://w3id.org/maestro#dueDate
maestro:dueDate a owl:DatatypeProperty ;
    rdfs:label "due date"@en ;
    skos:definition "The instant by which a production order is to be completed."@en ;
    rdfs:domain maestro:ProductionOrder ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/planning#dueDate> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#endTime
maestro:endTime a owl:DatatypeProperty ;
    rdfs:label "end time"@en ;
    skos:definition "The instant at which an interval ended."@en ;
    rdfs:domain maestro:TimeInterval ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/runtime#endTime> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#endedAtTime
maestro:endedAtTime a owl:DatatypeProperty ;
    rdfs:label "ended at time"@en ;
    skos:definition "End timestamp of a skill execution, mapped to prov:endedAtTime on the activity."@en ;
    rdfs:subPropertyOf prov:endedAtTime ;
    rdfs:domain maestro:SkillExecution ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/prov#endedAtTime> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/prov> .

###  https://w3id.org/maestro#energyKwh
maestro:energyKwh a owl:DatatypeProperty ;
    rdfs:label "energy (kWh)"@en ;
    skos:definition "Accumulated energy in kilowatt hours."@en ;
    rdfs:comment "Numeric value; the range is rdfs:Literal so decimal, integer, double and float literals are all accepted (checked by the shapes)."@en ;
    rdfs:domain maestro:EnergyMeasurement ;
    rdfs:range rdfs:Literal ;
    dct:source <https://w3id.org/maestro/energy#energyKwh> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/energy> .

###  https://w3id.org/maestro#ethercatIndex
maestro:ethercatIndex a owl:DatatypeProperty ;
    rdfs:label "EtherCAT index"@en ;
    skos:definition "The index of the object dictionary entry an EtherCAT binding carries, for example 0x6000 written as 24576."@en ;
    rdfs:domain maestro:EthercatBinding ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/ethercat> .

###  https://w3id.org/maestro#ethercatPosition
maestro:ethercatPosition a owl:DatatypeProperty ;
    rdfs:label "EtherCAT position"@en ;
    skos:definition "The position of the SubDevice an EtherCAT binding addresses, counted along the segment from the MainDevice starting at 0."@en ;
    rdfs:comment "MainDevice and SubDevice are the current EtherCAT Technology Group terms for what older documents call master and slave."@en ;
    rdfs:domain maestro:EthercatBinding ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/ethercat> .

###  https://w3id.org/maestro#ethercatSubindex
maestro:ethercatSubindex a owl:DatatypeProperty ;
    rdfs:label "EtherCAT subindex"@en ;
    skos:definition "The subindex of the object dictionary entry an EtherCAT binding carries."@en ;
    rdfs:domain maestro:EthercatBinding ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/ethercat> .

###  https://w3id.org/maestro#evidenceRef
maestro:evidenceRef a owl:DatatypeProperty ;
    rdfs:label "evidence reference"@en ;
    skos:definition "IRI of the log, document or observation the evidence refers to."@en ;
    rdfs:domain maestro:Evidence ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#expression
maestro:expression a owl:DatatypeProperty ;
    rdfs:label "expression"@en ;
    skos:definition "The text of a condition or constraint, in a language the evaluating system understands."@en ;
    rdfs:comment "Domain left open: used by maestro:Precondition, maestro:Postcondition and maestro:Constraint. An evaluator that does not understand the language answers Unknown, never true."@en ;
    rdfs:range xsd:string ;
    dct:references <https://w3id.org/maestro/skill#guardExpression> ;
    schema:domainIncludes maestro:Constraint , maestro:Postcondition , maestro:Precondition ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#faultCause
maestro:faultCause a owl:DatatypeProperty ;
    rdfs:label "fault cause"@en ;
    skos:definition "Human-readable cause of the fault."@en ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/runtime#faultCause> ;
    schema:domainIncludes maestro:Fault ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#faultCode
maestro:faultCode a owl:DatatypeProperty ;
    rdfs:label "fault code"@en ;
    skos:definition "Vendor or controller fault code, as reported by the execution technology."@en ;
    rdfs:comment "Domain left open: describes both a fault occurrence (maestro:Fault) and a fault specification (maestro:FaultSpecification)."@en ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/runtime#faultCode> ;
    schema:domainIncludes maestro:Fault , maestro:FaultSpecification ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#faultSeverity
maestro:faultSeverity a owl:DatatypeProperty ;
    rdfs:label "fault severity"@en ;
    skos:definition "Severity label of the fault, for example warning, error or critical."@en ;
    rdfs:comment "Domain left open, as for maestro:faultCode."@en ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/runtime#faultSeverity> ;
    schema:domainIncludes maestro:Fault , maestro:FaultSpecification ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#findingDescription
maestro:findingDescription a owl:DatatypeProperty ;
    rdfs:label "finding description"@en ;
    skos:definition "Free-text description of a maintenance finding."@en ;
    rdfs:domain maestro:Finding ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/maintenance#findingDescription> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#httpMethod
maestro:httpMethod a owl:DatatypeProperty ;
    rdfs:label "HTTP method"@en ;
    skos:definition "The HTTP method of a REST binding, for example GET, POST or PUT."@en ;
    rdfs:domain maestro:RestBinding ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/rest> .

###  https://w3id.org/maestro#identifierScheme
maestro:identifierScheme a owl:DatatypeProperty ;
    rdfs:label "identifier scheme"@en ;
    skos:definition "Name of the identifier scheme, for example GTIN, UUID, IRDI or IRI."@en ;
    rdfs:domain maestro:Identifier ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/core#identifierScheme> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#identifierValue
maestro:identifierValue a owl:DatatypeProperty ;
    rdfs:label "identifier value"@en ;
    skos:definition "The identifier string as issued, preserved verbatim."@en ;
    rdfs:domain maestro:Identifier ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/core#identifierValue> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#leadTimeDays
maestro:leadTimeDays a owl:DatatypeProperty ;
    rdfs:label "lead time (days)"@en ;
    skos:definition "Time from acceptance to delivery, in days, as promised by an offer or a quote."@en ;
    rdfs:comment "Domain left open for offers and quotes. MAESTRO 1.0 uses a unit-bearing quantity; this package has no unit module."@en ;
    rdfs:range xsd:decimal ;
    dct:references <https://w3id.org/maestro/maas#leadTime> ;
    schema:domainIncludes maestro:Quote , maestro:ServiceOffer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#location
maestro:location a owl:DatatypeProperty ;
    rdfs:label "location"@en ;
    skos:definition "Free-text location of a station or an actor, such as a hall, a site or an address."@en ;
    rdfs:comment "MAESTRO 1.0 places entities at a planning Site; the HHM-Core package keeps a literal."@en ;
    rdfs:range xsd:string ;
    schema:domainIncludes maestro:Actor , maestro:Station ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/resource> .

###  https://w3id.org/maestro#mandatory
maestro:mandatory a owl:DatatypeProperty ;
    rdfs:label "mandatory"@en ;
    skos:definition "Whether a violated or unknown evaluation of this requirement decides the feasibility of a plan. Absent means true."@en ;
    rdfs:domain maestro:Requirement ;
    rdfs:range xsd:boolean ;
    dct:source <https://w3id.org/maestro/product#mandatory> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#manufacturer
maestro:manufacturer a owl:DatatypeProperty ;
    rdfs:label "manufacturer"@en ;
    skos:definition "The name of the manufacturer of a resource."@en ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/resource#manufacturer> ;
    schema:domainIncludes maestro:Module ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/resource> .

###  https://w3id.org/maestro#mapsTo
maestro:mapsTo a owl:DatatypeProperty ;
    rdfs:label "maps to"@en ;
    skos:definition "IRI of the twin model or package the binding maps to, for example a DTDL interface identifier."@en ;
    rdfs:comment "HHM edge TwinBinding mapsTo AAS / DTDL."@en ;
    rdfs:domain maestro:TwinBinding ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/digital-twin> .

###  https://w3id.org/maestro#maxLeadTimeDays
maestro:maxLeadTimeDays a owl:DatatypeProperty ;
    rdfs:label "maximum lead time (days)"@en ;
    skos:definition "The latest lead time, in days, the customer will accept; compared against the lead time of each quote."@en ;
    rdfs:domain maestro:ServiceRequest ;
    rdfs:range xsd:decimal ;
    dct:references <https://w3id.org/maestro/maas#maxLeadTime> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#maxQuantity
maestro:maxQuantity a owl:DatatypeProperty ;
    rdfs:label "maximum quantity"@en ;
    skos:definition "The largest quantity one order under this offer may cover. Absent means unknown capacity."@en ;
    rdfs:domain maestro:ServiceOffer ;
    rdfs:range xsd:integer ;
    dct:source <https://w3id.org/maestro/maas#maxQuantity> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#maxValue
maestro:maxValue a owl:DatatypeProperty ;
    rdfs:label "maximum value"@en ;
    skos:definition "Upper bound of the numeric range a parameter definition admits."@en ;
    rdfs:comment "Numeric value; range rdfs:Literal for the same reason as maestro:minValue."@en ;
    rdfs:domain maestro:ParameterDef ;
    rdfs:range rdfs:Literal ;
    dct:source <https://w3id.org/maestro/skill#maxValue> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#minValue
maestro:minValue a owl:DatatypeProperty ;
    rdfs:label "minimum value"@en ;
    skos:definition "Lower bound of the numeric range a parameter definition admits."@en ;
    rdfs:comment "Numeric value. The range is rdfs:Literal on purpose: the accepted datatypes are xsd:decimal, xsd:integer, xsd:double and xsd:float, checked by the shapes, so source literals are preserved rather than forced into one XSD family."@en ;
    rdfs:domain maestro:ParameterDef ;
    rdfs:range rdfs:Literal ;
    dct:source <https://w3id.org/maestro/skill#minValue> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#modbusAddress
maestro:modbusAddress a owl:DatatypeProperty ;
    rdfs:label "Modbus address"@en ;
    skos:definition "The zero-based start address, within its data table, of the values a Modbus binding reads or writes."@en ;
    rdfs:comment "Zero-based protocol address; device manuals often print one-based register numbers such as 40001."@en ;
    rdfs:domain maestro:ModbusBinding ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/modbus> .

###  https://w3id.org/maestro#modbusCount
maestro:modbusCount a owl:DatatypeProperty ;
    rdfs:label "Modbus count"@en ;
    skos:definition "The number of consecutive coils or registers, from the start address, a Modbus binding reads or writes."@en ;
    rdfs:domain maestro:ModbusBinding ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/modbus> .

###  https://w3id.org/maestro#modbusUnitId
maestro:modbusUnitId a owl:DatatypeProperty ;
    rdfs:label "Modbus unit id"@en ;
    skos:definition "The unit identifier of the device a Modbus binding addresses."@en ;
    rdfs:comment "Called the slave address in older Modbus documents."@en ;
    rdfs:domain maestro:ModbusBinding ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/modbus> .

###  https://w3id.org/maestro#model
maestro:model a owl:DatatypeProperty ;
    rdfs:label "model"@en ;
    skos:definition "The model designation of a resource as given by its manufacturer."@en ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/resource#model> ;
    schema:domainIncludes maestro:Module ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/resource> .

###  https://w3id.org/maestro#mqttQos
maestro:mqttQos a owl:DatatypeProperty ;
    rdfs:label "MQTT QoS"@en ;
    skos:definition "The MQTT quality-of-service level of an MQTT binding: 0 (at most once), 1 (at least once) or 2 (exactly once)."@en ;
    rdfs:domain maestro:MqttBinding ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/mqtt> .

###  https://w3id.org/maestro#mqttRetain
maestro:mqttRetain a owl:DatatypeProperty ;
    rdfs:label "MQTT retain"@en ;
    skos:definition "Whether messages published through an MQTT binding carry the retain flag, so the broker keeps the last message for clients that subscribe later."@en ;
    rdfs:domain maestro:MqttBinding ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/mqtt> .

###  https://w3id.org/maestro#mqttTopic
maestro:mqttTopic a owl:DatatypeProperty ;
    rdfs:label "MQTT topic"@en ;
    skos:definition "The MQTT topic name an MQTT binding publishes to, or the topic filter it subscribes with."@en ;
    rdfs:comment "A topic filter may contain the wildcards + (one level) and # (all remaining levels)."@en ;
    rdfs:subPropertyOf maestro:topic ;
    rdfs:domain maestro:MqttBinding ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/mqtt> .

###  https://w3id.org/maestro#mtbfHours
maestro:mtbfHours a owl:DatatypeProperty ;
    rdfs:label "MTBF (hours)"@en ;
    skos:definition "Mean time between failures of a module, in hours."@en ;
    rdfs:comment "Numeric value; the range is rdfs:Literal so decimal, integer, double and float literals are all accepted (checked by the shapes)."@en ;
    rdfs:domain maestro:Module ;
    rdfs:range rdfs:Literal ;
    dct:source <https://w3id.org/maestro/maintenance#mtbfHours> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#nodeId
maestro:nodeId a owl:DatatypeProperty ;
    rdfs:label "node id"@en ;
    skos:definition "The node id of an OPC UA node, as a string."@en ;
    rdfs:domain maestro:OpcUaNode ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/opcua#nodeId> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/opcua> .

###  https://w3id.org/maestro#observedAt
maestro:observedAt a owl:DatatypeProperty ;
    rdfs:label "observed at"@en ;
    skos:definition "When the state was observed, which may differ from when it began."@en ;
    rdfs:domain maestro:StateAssertion ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/runtime#observedAt> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#paramType
maestro:paramType a owl:DatatypeProperty ;
    rdfs:label "parameter type"@en ;
    skos:definition "Data type of the parameter, given as an XSD datatype IRI (for example xsd:double)."@en ;
    rdfs:domain maestro:ParameterDef ;
    rdfs:range xsd:anyURI ;
    dct:source <https://w3id.org/maestro/skill#paramType> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#performedAt
maestro:performedAt a owl:DatatypeProperty ;
    rdfs:label "performed at"@en ;
    skos:definition "The instant at which a maintenance action was performed."@en ;
    rdfs:domain maestro:MaintenanceAction ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/maintenance#performedAt> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#platform
maestro:platform a owl:DatatypeProperty ;
    rdfs:label "platform"@en ;
    skos:definition "Name of the twin platform or packaging the binding targets, for example a DTDL-based twin service or an Asset Administration Shell package."@en ;
    rdfs:comment "A plain name; naming a platform is not a conformance claim."@en ;
    rdfs:domain maestro:TwinBinding ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/digital-twin> .

###  https://w3id.org/maestro#port
maestro:port a owl:DatatypeProperty ;
    rdfs:label "port"@en ;
    skos:definition "The transport port number of an endpoint."@en ;
    rdfs:comment "Moved from core/invocation.ttl. Used by endpoints of protocols that run over TCP or UDP; when the address is a URI that names the port, the two agree."@en ;
    rdfs:domain maestro:Endpoint ;
    rdfs:range xsd:integer ;
    dct:source <https://w3id.org/maestro/communication#port> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/addressing> .

###  https://w3id.org/maestro#powerWatts
maestro:powerWatts a owl:DatatypeProperty ;
    rdfs:label "power (W)"@en ;
    skos:definition "Instantaneous power in watts."@en ;
    rdfs:comment "Numeric value; range rdfs:Literal for the same reason as maestro:energyKwh."@en ;
    rdfs:domain maestro:PowerMeasurement ;
    rdfs:range rdfs:Literal ;
    dct:source <https://w3id.org/maestro/energy#powerWatts> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/energy> .

###  https://w3id.org/maestro#price
maestro:price a owl:DatatypeProperty ;
    rdfs:label "price"@en ;
    skos:definition "Monetary amount of a quote, paired with maestro:currency."@en ;
    rdfs:comment "Corresponds to schema:price."@en ;
    rdfs:domain maestro:Quote ;
    rdfs:range xsd:decimal ;
    dct:source <https://w3id.org/maestro/maas#price> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#profinetSlot
maestro:profinetSlot a owl:DatatypeProperty ;
    rdfs:label "PROFINET slot"@en ;
    skos:definition "The slot number of the module, within the IO device, that a PROFINET binding addresses."@en ;
    rdfs:domain maestro:ProfinetBinding ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/profinet> .

###  https://w3id.org/maestro#profinetStationName
maestro:profinetStationName a owl:DatatypeProperty ;
    rdfs:label "PROFINET station name"@en ;
    skos:definition "The name of station by which the IO controller identifies the IO device of a PROFINET binding."@en ;
    rdfs:domain maestro:ProfinetBinding ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/profinet> .

###  https://w3id.org/maestro#profinetSubslot
maestro:profinetSubslot a owl:DatatypeProperty ;
    rdfs:label "PROFINET subslot"@en ;
    skos:definition "The subslot number of the submodule, within its slot, that a PROFINET binding addresses."@en ;
    rdfs:domain maestro:ProfinetBinding ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/profinet> .

###  https://w3id.org/maestro#quantity
maestro:quantity a owl:DatatypeProperty ;
    rdfs:label "quantity"@en ;
    skos:definition "Quantity of the referenced product type in a bill-of-materials node, or the number of units a production order covers."@en ;
    rdfs:comment "Domain left open: used by maestro:BOMNode and maestro:ProductionOrder."@en ;
    rdfs:range xsd:decimal ;
    dct:source <https://w3id.org/maestro/product#quantity> ;
    schema:domainIncludes maestro:BOMNode , maestro:ProductionOrder ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#recordedAt
maestro:recordedAt a owl:DatatypeProperty ;
    rdfs:label "recorded at"@en ;
    skos:definition "When a record or assertion was written."@en ;
    rdfs:domain maestro:ExecutionRecord ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/runtime#recordedAt> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#refDesignator
maestro:refDesignator a owl:DatatypeProperty ;
    rdfs:label "reference designator"@en ;
    skos:definition "Reference designator of a bill-of-materials node, for example R1 or C3."@en ;
    rdfs:domain maestro:BOMNode ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/product#refDesignator> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#remainingUsefulLifeHours
maestro:remainingUsefulLifeHours a owl:DatatypeProperty ;
    rdfs:label "remaining useful life (hours)"@en ;
    skos:definition "Forecast remaining useful life of a module, in hours."@en ;
    rdfs:comment "Numeric value; range rdfs:Literal for the same reason as maestro:mtbfHours."@en ;
    rdfs:domain maestro:Module ;
    rdfs:range rdfs:Literal ;
    dct:source <https://w3id.org/maestro/maintenance#remainingUsefulLifeHours> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#requestedQuantity
maestro:requestedQuantity a owl:DatatypeProperty ;
    rdfs:label "requested quantity"@en ;
    skos:definition "How many units the request covers."@en ;
    rdfs:domain maestro:ServiceRequest ;
    rdfs:range xsd:integer ;
    dct:source <https://w3id.org/maestro/maas#requestedQuantity> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#requiredValue
maestro:requiredValue a owl:DatatypeProperty ;
    rdfs:label "required value"@en ;
    skos:definition "The value a requirement demands, as a literal."@en ;
    rdfs:comment "MAESTRO 1.0 demands a unit-bearing quantity or an enumerated entity; this package keeps a literal, since it has no unit module."@en ;
    rdfs:domain maestro:Requirement ;
    rdfs:range xsd:string ;
    dct:references <https://w3id.org/maestro/product#requiredValue> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#riskAssessmentMethod
maestro:riskAssessmentMethod a owl:DatatypeProperty ;
    rdfs:label "risk assessment method"@en ;
    skos:definition "The method and version used, stated as free text by the assessor, for example the risk estimation procedure or risk matrix applied."@en ;
    rdfs:domain maestro:RiskAssessment ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/safety#riskAssessmentMethod> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#scheduledFor
maestro:scheduledFor a owl:DatatypeProperty ;
    rdfs:label "scheduled for"@en ;
    skos:definition "The instant at which a maintenance action is scheduled to take place."@en ;
    rdfs:domain maestro:MaintenanceAction ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/maintenance#scheduledFor> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#serialNumber
maestro:serialNumber a owl:DatatypeProperty ;
    rdfs:label "serial number"@en ;
    skos:definition "The serial number of a resource or product instance as given by its manufacturer."@en ;
    rdfs:comment "Domain left open: a module and a product instance both carry one."@en ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/resource#serialNumber> ;
    schema:domainIncludes maestro:Module , maestro:ProductInstance ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/resource> .

###  https://w3id.org/maestro#snapshotTaken
maestro:snapshotTaken a owl:DatatypeProperty ;
    rdfs:label "snapshot taken"@en ;
    skos:definition "Wall-clock instant at which the snapshot was captured."@en ;
    rdfs:domain maestro:Snapshot ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/runtime#snapshotTaken> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#startTime
maestro:startTime a owl:DatatypeProperty ;
    rdfs:label "start time"@en ;
    skos:definition "The instant at which an interval started."@en ;
    rdfs:domain maestro:TimeInterval ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/runtime#startTime> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#startedAtTime
maestro:startedAtTime a owl:DatatypeProperty ;
    rdfs:label "started at time"@en ;
    skos:definition "Start timestamp of a skill execution, mapped to prov:startedAtTime on the activity."@en ;
    rdfs:subPropertyOf prov:startedAtTime ;
    rdfs:domain maestro:SkillExecution ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/prov#startedAtTime> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/prov> .

###  https://w3id.org/maestro#stepOrder
maestro:stepOrder a owl:DatatypeProperty ;
    rdfs:label "step order"@en ;
    skos:definition "Position of a plan step within its recipe, counting from 1."@en ;
    rdfs:domain maestro:PlanStep ;
    rdfs:range xsd:integer ;
    dct:source <https://w3id.org/maestro/skill#stepOrder> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/recipe> .

###  https://w3id.org/maestro#submittedOn
maestro:submittedOn a owl:DatatypeProperty ;
    rdfs:label "submitted on"@en ;
    skos:definition "When the request was raised."@en ;
    rdfs:domain maestro:ServiceRequest ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/maas#submittedOn> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#timestamp
maestro:timestamp a owl:DatatypeProperty ;
    rdfs:label "timestamp"@en ;
    skos:definition "The instant at which an event or an instantaneous measurement occurred."@en ;
    rdfs:comment "Domain left open: used by maestro:Fault, maestro:TelemetryEvent and maestro:PowerMeasurement."@en ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/runtime#timestamp> ;
    schema:domainIncludes maestro:Fault , maestro:PowerMeasurement , maestro:TelemetryEvent ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#topic
maestro:topic a owl:DatatypeProperty ;
    rdfs:label "topic"@en ;
    skos:definition "The topic, channel or other named destination a binding publishes to or subscribes from."@en ;
    rdfs:comment "Moved from core/invocation.ttl, where it sat on maestro:EventStream; a topic is protocol-level, so it now sits on the binding. Protocol modules specialise it: maestro:mqttTopic, maestro:ddsTopic."@en ;
    rdfs:domain maestro:Binding ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/addressing> .

###  https://w3id.org/maestro#unitRef
maestro:unitRef a owl:DatatypeProperty ;
    rdfs:label "unit reference"@en ;
    skos:definition "The unit of the parameter, given as the IRI of a QUDT unit (for example http://qudt.org/vocab/unit/MilliM)."@en ;
    rdfs:comment "HHM-Core ParameterDef unitRef, and the QUDT/OM extension point of the Skills cluster. MAESTRO 1.0 points at a unit individual of its unit module; this package has no unit module and keeps the QUDT IRI as a literal."@en ;
    rdfs:domain maestro:ParameterDef ;
    rdfs:range xsd:anyURI ;
    dct:references <https://w3id.org/maestro/skill#unitRef> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#urlTemplate
maestro:urlTemplate a owl:DatatypeProperty ;
    rdfs:label "URL template"@en ;
    skos:definition "The path template, relative to the endpoint address, a REST binding applies its HTTP method to."@en ;
    rdfs:domain maestro:RestBinding ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/rest> .

###  https://w3id.org/maestro#validFrom
maestro:validFrom a owl:DatatypeProperty ;
    rdfs:label "valid from"@en ;
    skos:definition "The instant from which a state assertion holds."@en ;
    rdfs:domain maestro:StateAssertion ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/runtime#validFrom> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#validTo
maestro:validTo a owl:DatatypeProperty ;
    rdfs:label "valid to"@en ;
    skos:definition "The instant until which a state assertion held. Absent while the assertion is current."@en ;
    rdfs:domain maestro:StateAssertion ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/runtime#validTo> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#validUntil
maestro:validUntil a owl:DatatypeProperty ;
    rdfs:label "valid until"@en ;
    skos:definition "Expiry of the quote."@en ;
    rdfs:comment "Corresponds to schema:validThrough."@en ;
    rdfs:domain maestro:Quote ;
    rdfs:range xsd:dateTime ;
    dct:source <https://w3id.org/maestro/maas#validUntil> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#value
maestro:value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    skos:definition "The supplied literal value of a parameter value."@en ;
    rdfs:comment "No range: the literal's datatype follows the parameter definition's maestro:paramType."@en ;
    rdfs:domain maestro:ParameterValue ;
    dct:source <https://w3id.org/maestro/skill#value> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#version
maestro:version a owl:DatatypeProperty ;
    rdfs:label "version"@en ;
    skos:definition "Version designation of an entity's description."@en ;
    rdfs:comment "Domain left open: used by skills, recipes and policies."@en ;
    rdfs:range xsd:string ;
    dct:source <https://w3id.org/maestro/core#version> ;
    schema:domainIncludes maestro:Policy , maestro:Recipe , maestro:Skill ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/resource> .


########################################################################
#    Classes
########################################################################

###  https://w3id.org/maestro#Action
maestro:Action a owl:Class ;
    rdfs:label "Action"@en ;
    skos:definition "An operation a permission governs."@en ;
    rdfs:comment "Controlled vocabulary of individuals: Invoke, Read, Write, Configure. Needed so a permission can say what it permits."@en ;
    skos:closeMatch odrl:Action ;
    dct:source <https://w3id.org/maestro/policy#Action> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#Actor
maestro:Actor a owl:Class ;
    rdfs:label "Actor"@en ;
    skos:definition "An organisation participating in the manufacturing-as-a-service ecosystem."@en ;
    rdfs:comment "Close match to schema:Organization."@en ;
    skos:closeMatch schema:Organization ;
    dct:source <https://w3id.org/maestro/maas#Actor> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#Area
maestro:Area a owl:Class ;
    rdfs:label "Area"@en ;
    skos:definition "A grouping of work centres within a site."@en ;
    skos:closeMatch DINEN62264:Area ;
    dct:source <https://w3id.org/maestro/planning#Area> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/isa95> .

###  https://w3id.org/maestro#AtomicSkill
maestro:AtomicSkill a owl:Class ;
    rdfs:label "Atomic skill"@en ;
    skos:definition "An indivisible skill primitive."@en ;
    rdfs:comment "HHM-Core Skills cluster. Disjoint with maestro:CompositeSkill."@en ;
    rdfs:subClassOf maestro:Skill ;
    owl:disjointWith maestro:CompositeSkill ;
    dct:source <https://w3id.org/maestro/skill#AtomicSkill> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#BOMNode
maestro:BOMNode a owl:Class ;
    rdfs:label "BOM node"@en ;
    skos:definition "A node in a structured bill of materials: a referenced product type with quantity and reference designator."@en ;
    rdfs:comment "HHM-Core Product cluster. Nested with maestro:hasPart; the referenced part type is maestro:nodeFor; the material with maestro:madeOf."@en ;
    dct:source <https://w3id.org/maestro/product#BOMNode> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#Binding
maestro:Binding a owl:Class ;
    rdfs:label "Binding"@en ;
    skos:definition "A neutral protocol-mapping indirection between an endpoint and a concrete protocol such as OPC UA, REST or DTDL."@en ;
    rdfs:comment "HHM-Core Invocation Hooks cluster (protocol-specific mapping placeholder). Concrete adapters specialise it: maestro:OpcUaBinding, maestro:RestBinding, maestro:MqttBinding, maestro:DdsBinding, maestro:ModbusBinding, maestro:ProfinetBinding, maestro:EthercatBinding and maestro:DtdlBinding in the extension modules."@en ;
    dct:source <https://w3id.org/maestro/communication#Binding> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .

###  https://w3id.org/maestro#Capability
maestro:Capability a owl:Class ;
    rdfs:label "Capability"@en ;
    skos:definition "A specification of a manufacturing possibility: what a holder can do, independent of how it is done."@en ;
    rdfs:comment "HHM-Core Physical Resources cluster. Provided by modules (maestro:providesCapability) and required by skills (maestro:requiresCapability); reusable capability specifications are individuals of this class."@en ;
    dct:source <https://w3id.org/maestro/core#Capability> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/resource> .

###  https://w3id.org/maestro#CompositeSkill
maestro:CompositeSkill a owl:Class ;
    rdfs:label "Composite skill"@en ;
    skos:definition "A skill built by composing other skills."@en ;
    rdfs:comment "HHM-Core Skills cluster. Its constituents are stated with maestro:hasSubSkillLink; the order in which they run is a recipe concern (maestro:PlanStep, maestro:ControlFlowConstraint)."@en ;
    rdfs:subClassOf maestro:Skill ;
    dct:source <https://w3id.org/maestro/skill#CompositeSkill> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#ConditionBased
maestro:ConditionBased a owl:Class ;
    rdfs:label "Condition-based"@en ;
    skos:definition "Preventive maintenance triggered by the measured or analysed condition of the asset, together with the maintenance actions that follow from that assessment."@en ;
    rdfs:subClassOf maestro:Preventive ;
    dct:source <https://w3id.org/maestro/maintenance#ConditionBased> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#Constraint
maestro:Constraint a owl:Class ;
    rdfs:label "Constraint"@en ;
    skos:definition "A specified restriction on a skill, plan step, module, endpoint or other target."@en ;
    rdfs:comment "HHM-Core Safety / Security / Policy cluster. The target is stated with maestro:constrains, the restriction text with maestro:expression."@en ;
    dct:source <https://w3id.org/maestro/core#Constraint> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#Contract
maestro:Contract a owl:Class ;
    rdfs:label "Contract"@en ;
    skos:definition "An accepted quote: the agreement that turns a market transaction into a production order, governed by a policy."@en ;
    rdfs:comment "Close match to schema:Order."@en ;
    skos:closeMatch schema:Order ;
    dct:source <https://w3id.org/maestro/maas#Contract> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#ControlFlowConstraint
maestro:ControlFlowConstraint a owl:Class ;
    rdfs:label "Control-flow constraint"@en ;
    skos:definition "A constraint on when a plan step runs relative to another step: before it, in parallel with it, as an alternative to it, repeatedly, or optionally."@en ;
    rdfs:comment "HHM-Core Recipe / Planning cluster (ControlFlowConstraint: precedes / parallel / alt / loop / optional). The kind is stated with maestro:flowType, the other step with maestro:relatedStep. MAESTRO 1.0 models the kinds as subclasses of skill:ControlFlow; here they are individuals of maestro:ControlFlowType."@en ;
    dct:references <https://w3id.org/maestro/skill#ControlFlow> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/recipe> .

###  https://w3id.org/maestro#ControlFlowType
maestro:ControlFlowType a owl:Class ;
    rdfs:label "Control-flow type"@en ;
    skos:definition "The kind of a control-flow constraint: precedes, parallel, alternative, loop or optional."@en ;
    rdfs:comment "Controlled vocabulary with the five individuals the HHM diagram names."@en ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/recipe> .

###  https://w3id.org/maestro#Corrective
maestro:Corrective a owl:Class ;
    rdfs:label "Corrective"@en ;
    skos:definition "A maintenance action performed after a fault to restore an asset to its required condition."@en ;
    rdfs:subClassOf maestro:MaintenanceAction ;
    dct:source <https://w3id.org/maestro/maintenance#Corrective> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#Customer
maestro:Customer a owl:Class ;
    rdfs:label "Customer"@en ;
    skos:definition "An actor asking the ecosystem to manufacture something it cannot or will not make itself."@en ;
    rdfs:subClassOf maestro:Actor ;
    dct:source <https://w3id.org/maestro/maas#Customer> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#DataBinding
maestro:DataBinding a owl:Class ;
    rdfs:label "Data binding"@en ;
    skos:definition "Binds a producing skill's output parameter to a consuming skill's input parameter."@en ;
    rdfs:comment "HHM-Core Recipe / Planning cluster (DataBinding: output -> input). The producing parameter is maestro:bindsFrom, the consuming parameter maestro:bindsTo; the step that owns the binding consumes the value."@en ;
    dct:source <https://w3id.org/maestro/skill#DataBinding> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/recipe> .

###  https://w3id.org/maestro#DataFormat
maestro:DataFormat a owl:Class ;
    rdfs:label "Data format"@en ;
    skos:definition "A payload encoding carried over a protocol."@en ;
    rdfs:comment "Folded in from the MAESTRO 1.0 communication module, a controlled vocabulary of individuals. The individuals are declared in the extension modules (maestro:JsonFormat, maestro:XmlFormat and maestro:ProtobufFormat in ext/data-formats.ttl, maestro:OpcUaBinaryFormat in ext/opcua.ttl); a knowledge graph may declare further individuals. Related to WADL:Representation of the HSU WADL ODP, which names the media type in which a resource state is represented."@en ;
    skos:relatedMatch WADL:Representation ;
    dct:source <https://w3id.org/maestro/communication#DataFormat> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .

###  https://w3id.org/maestro#DdsBinding
maestro:DdsBinding a owl:Class ;
    rdfs:label "DDS binding"@en ;
    skos:definition "A binding that maps an endpoint onto DDS: the domain, topic and data type through which a participant publishes or subscribes."@en ;
    rdfs:comment "Specialises maestro:Binding, realising the HHM extension point on Binding."@en ;
    rdfs:subClassOf maestro:Binding ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/dds> .

###  https://w3id.org/maestro#DigitalTwin
maestro:DigitalTwin a owl:Class ;
    rdfs:label "Digital twin"@en ;
    skos:definition "A digital representation of a product instance, a station or a module."@en ;
    rdfs:comment "HHM digital-twin extension. Not another station or module: it represents a core entity, and real execution remains attached to the module it represents."@en ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/digital-twin> .

###  https://w3id.org/maestro#DtdlBinding
maestro:DtdlBinding a owl:Class ;
    rdfs:label "DTDL binding"@en ;
    skos:definition "A binding that maps an endpoint onto a DTDL interface."@en ;
    rdfs:comment "Specialises maestro:Binding, realising the HHM extension point on Binding."@en ;
    rdfs:subClassOf maestro:Binding ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/dtdl> .

###  https://w3id.org/maestro#DtdlCommand
maestro:DtdlCommand a owl:Class ;
    rdfs:label "DTDL command"@en ;
    skos:definition "A DTDL command: an operation a client can invoke on the twin."@en ;
    skos:closeMatch <dtmi:dtdl:class:Command;3> ;
    dct:source <https://w3id.org/maestro/dtdl#Command> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/dtdl> .

###  https://w3id.org/maestro#DtdlInterface
maestro:DtdlInterface a owl:Class ;
    rdfs:label "DTDL interface"@en ;
    skos:definition "A DTDL interface: the model of a twin's commands, telemetry and properties."@en ;
    rdfs:comment "Close match to the DTDL v3 metamodel class Interface. A DTDL interface may serve as an maestro:SkillInterface described in DTDL."@en ;
    rdfs:subClassOf maestro:SkillInterface ;
    skos:closeMatch <dtmi:dtdl:class:Interface;3> ;
    dct:source <https://w3id.org/maestro/dtdl#Interface> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/dtdl> .

###  https://w3id.org/maestro#DtdlProperty
maestro:DtdlProperty a owl:Class ;
    rdfs:label "DTDL property"@en ;
    skos:definition "A DTDL property: a readable, optionally writable, state value of the twin."@en ;
    skos:closeMatch <dtmi:dtdl:class:Property;3> ;
    dct:source <https://w3id.org/maestro/dtdl#Property> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/dtdl> .

###  https://w3id.org/maestro#DtdlTelemetry
maestro:DtdlTelemetry a owl:Class ;
    rdfs:label "DTDL telemetry"@en ;
    skos:definition "A DTDL telemetry: a stream of values the twin emits."@en ;
    skos:closeMatch <dtmi:dtdl:class:Telemetry;3> ;
    dct:source <https://w3id.org/maestro/dtdl#Telemetry> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/dtdl> .

###  https://w3id.org/maestro#EmergencyStop
maestro:EmergencyStop a owl:Class ;
    rdfs:label "Emergency stop"@en ;
    skos:definition "A safety function that a person triggers with a single action to stop a hazardous situation."@en ;
    rdfs:comment "Recorded as a complementary measure alongside other safeguards, not a substitute for them."@en ;
    rdfs:subClassOf maestro:SafetyFunction ;
    dct:source <https://w3id.org/maestro/safety#EmergencyStop> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#Endpoint
maestro:Endpoint a owl:Class ;
    rdfs:label "Endpoint"@en ;
    skos:definition "A network-addressable access point through which a skill interface, stream or operation is reached, identified by protocol, host and port."@en ;
    rdfs:comment "HHM-Core Invocation Hooks cluster. Related to WADL:Resource of the HSU WADL ODP: for an HTTP endpoint, the WADL resources reachable under its base address describe what it exposes; a WADL resource is a URI pattern, not a host and port."@en ;
    skos:relatedMatch WADL:Resource ;
    dct:source <https://w3id.org/maestro/communication#Endpoint> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .

###  https://w3id.org/maestro#EnergyConsumer
maestro:EnergyConsumer a owl:Class ;
    rdfs:label "Energy consumer"@en ;
    skos:definition "A module that draws energy from an energy source while operating."@en ;
    rdfs:comment "Type a module additionally as an energy consumer to record its supply."@en ;
    rdfs:subClassOf maestro:Module ;
    dct:references <https://w3id.org/maestro/energy#EnergyConsumer> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/energy> .

###  https://w3id.org/maestro#EnergyMeasurement
maestro:EnergyMeasurement a owl:Class ;
    rdfs:label "Energy measurement"@en ;
    skos:definition "A measurement of energy accumulated by a subject over an interval."@en ;
    dct:source <https://w3id.org/maestro/energy#EnergyMeasurement> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/energy> .

###  https://w3id.org/maestro#EnergySource
maestro:EnergySource a owl:Class ;
    rdfs:label "Energy source"@en ;
    skos:definition "A source that supplies energy, such as a grid connection, a generator or a battery."@en ;
    rdfs:comment "Controlled vocabulary of individuals; add site-specific sources as further individuals."@en ;
    dct:source <https://w3id.org/maestro/energy#EnergySource> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/energy> .

###  https://w3id.org/maestro#Enterprise
maestro:Enterprise a owl:Class ;
    rdfs:label "Enterprise"@en ;
    skos:definition "The organisation that owns and operates one or more sites."@en ;
    skos:closeMatch DINEN62264:Enterprise ;
    dct:source <https://w3id.org/maestro/planning#Enterprise> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/isa95> .

###  https://w3id.org/maestro#EthercatBinding
maestro:EthercatBinding a owl:Class ;
    rdfs:label "EtherCAT binding"@en ;
    skos:definition "A binding that maps an endpoint onto EtherCAT: the SubDevice addressed and the object dictionary entry, mapped as process data or read as service data, that carries the value."@en ;
    rdfs:comment "Specialises maestro:Binding, realising the HHM extension point on Binding."@en ;
    rdfs:subClassOf maestro:Binding ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/ethercat> .

###  https://w3id.org/maestro#EventStream
maestro:EventStream a owl:Class ;
    rdfs:label "Event stream"@en ;
    skos:definition "A skill-level event or telemetry stream contract, independent of the technology that carries it."@en ;
    rdfs:comment "HHM-Core EventStream (drawn in the digital-twin diagram). A contract, not an event that happened; carried for example as DTDL telemetry or OPC UA events."@en ;
    dct:source <https://w3id.org/maestro/communication#EventStream> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .

###  https://w3id.org/maestro#Evidence
maestro:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ;
    skos:definition "A reference to a log, document or observation that backs a policy, an assessment or a state assertion."@en ;
    rdfs:comment "HHM-Core Safety / Security / Policy cluster (Evidence: log / doc / obs ref). The reference itself is maestro:evidenceRef."@en ;
    dct:source <https://w3id.org/maestro/policy#Evidence> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#ExecutionRecord
maestro:ExecutionRecord a owl:Class ;
    rdfs:label "Execution record"@en ;
    skos:definition "An information entity describing an execution occurrence, as logged by a controller, an MES or an operator."@en ;
    rdfs:comment "Separate from the execution so a record can be corrected, duplicated or retracted without pretending the execution happened twice."@en ;
    skos:broadMatch prov:Entity ;
    dct:source <https://w3id.org/maestro/runtime#ExecutionRecord> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#ExecutionStatus
maestro:ExecutionStatus a owl:Class ;
    rdfs:label "Execution status"@en ;
    skos:definition "A discrete condition value that an execution can be in."@en ;
    rdfs:comment "HHM-Core Minimal Execution cluster, a controlled vocabulary of individuals. modules/telemetry.ttl declares it a subclass of maestro:State, the live state of a resource, so the shared values Idle, Executing, Held and Aborted exist once."@en ;
    rdfs:subClassOf maestro:State ;
    dct:references <https://w3id.org/maestro/core#State> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#ExternalInterface
maestro:ExternalInterface a owl:Class ;
    rdfs:label "External interface"@en ;
    skos:definition "A port of an internal element through which it connects to other elements, such as a material, energy or signal port."@en ;
    skos:closeMatch AML:ExternalInterface ;
    dct:source <https://w3id.org/maestro/automationml#ExternalInterface> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/automationml> .

###  https://w3id.org/maestro#Fault
maestro:Fault a owl:Class ;
    rdfs:label "Fault"@en ;
    skos:definition "A fault occurrence raised during an execution, carrying a code, a cause and a severity."@en ;
    rdfs:comment "HHM-Core Fault. MAESTRO 1.0 calls the occurrence runtime:FaultEvent and keeps runtime:Fault for the faulted state value; this package follows the HHM name for the occurrence and calls the state value maestro:FaultState. The kind of fault is an maestro:FaultSpecification (modules/telemetry.ttl)."@en ;
    rdfs:subClassOf maestro:TelemetryEvent ;
    dct:references <https://w3id.org/maestro/runtime#FaultEvent> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#FaultDiagnosis
maestro:FaultDiagnosis a owl:Class ;
    rdfs:label "Fault diagnosis"@en ;
    skos:definition "The record of a fault diagnosis: the recognised fault, its localisation and its identified cause."@en ;
    rdfs:comment "The diagnosing activity itself is not modelled; this class records its result."@en ;
    dct:source <https://w3id.org/maestro/maintenance#FaultDiagnosis> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#FaultSpecification
maestro:FaultSpecification a owl:Class ;
    rdfs:label "Fault specification"@en ;
    skos:definition "A kind of fault a skill or resource can raise: its code, meaning and severity."@en ;
    rdfs:comment "A specification, not an occurrence. The occurrence is maestro:Fault, linked to its kind with maestro:instanceOfFault."@en ;
    dct:source <https://w3id.org/maestro/runtime#FaultSpecification> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#Feature
maestro:Feature a owl:Class ;
    rdfs:label "Feature"@en ;
    skos:definition "A geometric or functional feature of a product, such as a hole, a slot or a surface."@en ;
    rdfs:comment "HHM-Core Product cluster. A feature may require a plan step that produces it (maestro:requiresOperation)."@en ;
    dct:source <https://w3id.org/maestro/product#Feature> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#Finding
maestro:Finding a owl:Class ;
    rdfs:label "Finding"@en ;
    skos:definition "Something observed during maintenance work: wear, damage, a deviation."@en ;
    dct:source <https://w3id.org/maestro/maintenance#Finding> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#Hazard
maestro:Hazard a owl:Class ;
    rdfs:label "Hazard"@en ;
    skos:definition "A potential source of harm associated with a resource, process or environment."@en ;
    rdfs:comment "HHM-Core Safety / Security / Policy cluster."@en ;
    dct:source <https://w3id.org/maestro/safety#Hazard> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#Identifier
maestro:Identifier a owl:Class ;
    rdfs:label "Identifier"@en ;
    skos:definition "A scheme-qualified identifier of an entity, such as a GTIN, a UUID, an IRDI or an IRI, whose value is unique within its scheme."@en ;
    rdfs:comment "HHM-Core Product cluster (Identifier: GTIN / UUID / IRDI / IRI). The scheme is a literal (maestro:identifierScheme) so that no class per scheme is needed."@en ;
    dct:source <https://w3id.org/maestro/product#Identifier> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#Inspection
maestro:Inspection a owl:Class ;
    rdfs:label "Inspection"@en ;
    skos:definition "An inspection carried out as maintenance work, examining the condition of an asset and recording findings."@en ;
    rdfs:comment "MAESTRO 1.0 also types it as a quality inspection; this package has no quality module."@en ;
    rdfs:subClassOf maestro:MaintenanceAction ;
    dct:references <https://w3id.org/maestro/maintenance#Inspection> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#InterfaceDescriptionLanguage
maestro:InterfaceDescriptionLanguage a owl:Class ;
    rdfs:label "Interface description language"@en ;
    skos:definition "A language in which an interface contract is described."@en ;
    rdfs:comment "Folded in from the MAESTRO 1.0 communication module, a controlled vocabulary of individuals. The individuals are declared in the extension module of their technology (maestro:OpcUaNodeSetIDL in ext/opcua.ttl, maestro:DtdlIDL in ext/dtdl.ttl, maestro:OpenApiIDL in ext/rest.ttl, maestro:AasSubmodelTemplateIDL in ext/digital-twin.ttl); a knowledge graph may declare further individuals. Individuals name the languages; naming AAS submodel templates or OpenAPI is not a conformance claim."@en ;
    dct:source <https://w3id.org/maestro/communication#InterfaceDescriptionLanguage> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .

###  https://w3id.org/maestro#InternalElement
maestro:InternalElement a owl:Class ;
    rdfs:label "Internal element"@en ;
    skos:definition "A physical element of the plant topology that carries external interfaces and is connected by internal links."@en ;
    rdfs:comment "Related to AML:InternalElement of the HSU AutomationML ODP, which is the model element of an AutomationML document that describes the physical element; hence skos:relatedMatch, not closeMatch."@en ;
    skos:relatedMatch AML:InternalElement ;
    dct:source <https://w3id.org/maestro/automationml#InternalElement> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/automationml> .

###  https://w3id.org/maestro#InternalLink
maestro:InternalLink a owl:Class ;
    rdfs:label "Internal link"@en ;
    skos:definition "A connection between two external interfaces."@en ;
    skos:closeMatch AML:InternalLink ;
    dct:source <https://w3id.org/maestro/automationml#InternalLink> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/automationml> .

###  https://w3id.org/maestro#MaintenanceAction
maestro:MaintenanceAction a owl:Class ;
    rdfs:label "Maintenance action"@en ;
    skos:definition "Maintenance work performed on an asset: an occurrence with duration, trigger, affected asset, findings and a return-to-service assessment."@en ;
    rdfs:comment "Its duration is an maestro:TimeInterval through maestro:hasTime."@en ;
    dct:source <https://w3id.org/maestro/maintenance#MaintenanceAction> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#MaintenancePlan
maestro:MaintenancePlan a owl:Class ;
    rdfs:label "Maintenance plan"@en ;
    skos:definition "A specification of the maintenance tasks an asset receives and when."@en ;
    dct:source <https://w3id.org/maestro/maintenance#MaintenancePlan> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#MaintenanceTask
maestro:MaintenanceTask a owl:Class ;
    rdfs:label "Maintenance task"@en ;
    skos:definition "A specified unit of maintenance work; a maintenance action performs it."@en ;
    dct:source <https://w3id.org/maestro/maintenance#MaintenanceTask> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#Marketplace
maestro:Marketplace a owl:Class ;
    rdfs:label "Marketplace"@en ;
    skos:definition "A platform on which offers are listed and matched."@en ;
    rdfs:subClassOf maestro:Actor ;
    dct:source <https://w3id.org/maestro/maas#Marketplace> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#Material
maestro:Material a owl:Class ;
    rdfs:label "Material"@en ;
    skos:definition "A substance a product or part is made of, referenced by requirements and bill-of-materials nodes."@en ;
    rdfs:comment "HHM-Core Product cluster."@en ;
    dct:source <https://w3id.org/maestro/product#Material> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#Mitigation
maestro:Mitigation a owl:Class ;
    rdfs:label "Mitigation"@en ;
    skos:definition "A measure that reduces a risk."@en ;
    rdfs:comment "HHM-Core Safety / Security / Policy cluster. A reified measure, so that assessments can name the mitigations they rely on."@en ;
    dct:source <https://w3id.org/maestro/safety#Mitigation> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#ModbusBinding
maestro:ModbusBinding a owl:Class ;
    rdfs:label "Modbus binding"@en ;
    skos:definition "A binding that maps an endpoint onto Modbus: the unit addressed, the data table and the range of addresses read or written."@en ;
    rdfs:comment "Specialises maestro:Binding, realising the HHM extension point on Binding."@en ;
    rdfs:subClassOf maestro:Binding ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/modbus> .

###  https://w3id.org/maestro#ModbusDataTable
maestro:ModbusDataTable a owl:Class ;
    rdfs:label "Modbus data table"@en ;
    skos:definition "One of the four Modbus data tables: coils, discrete inputs, input registers and holding registers."@en ;
    rdfs:comment "A controlled vocabulary of individuals."@en ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/modbus> .

###  https://w3id.org/maestro#Mode
maestro:Mode a owl:Class ;
    rdfs:label "Mode"@en ;
    skos:definition "An operating mode, such as automatic, manual or maintenance, that a policy can require."@en ;
    rdfs:comment "HHM-Core Safety / Security / Policy cluster, a controlled vocabulary of individuals."@en ;
    dct:source <https://w3id.org/maestro/policy#Mode> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#Module
maestro:Module a owl:Class ;
    rdfs:label "Module"@en ;
    skos:definition "A reconfigurable, plug-and-produce production module that provides capabilities and executes skills."@en ;
    rdfs:comment "HHM-Core Physical Resources cluster. Close match to VDI2206:Module of the HSU VDI 2206 ODP: system elements or components combined into a group that together perform a specific function. Real execution is attached to the module (see maestro:SkillExecution); a digital twin only represents it."@en ;
    skos:scopeNote "ISA88:EquipmentModule can carry out a finite number of specific minor processing activities and combines the physical processing and control equipment required for them (HSU ISA88.01 ODP). maestro:Module additionally stresses plug-and-produce reconfiguration."@en ;
    rdfs:subClassOf maestro:InternalElement ;
    skos:closeMatch ISA88:EquipmentModule , VDI2206:Module ;
    dct:source <https://w3id.org/maestro/resource#Module> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/resource> .

###  https://w3id.org/maestro#MqttBinding
maestro:MqttBinding a owl:Class ;
    rdfs:label "MQTT binding"@en ;
    skos:definition "A binding that maps an endpoint onto MQTT: the topic a message is published to or subscribed from, with its quality of service and retain flag."@en ;
    rdfs:comment "Specialises maestro:Binding, realising the HHM extension point on Binding."@en ;
    rdfs:subClassOf maestro:Binding ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/mqtt> .

###  https://w3id.org/maestro#MqttBroker
maestro:MqttBroker a owl:Class ;
    rdfs:label "MQTT broker"@en ;
    skos:definition "An endpoint at which an MQTT broker accepts client connections and forwards each published message to the clients subscribed to its topic."@en ;
    rdfs:comment "Clients that publish or subscribe reach the broker, not each other; the broker address is the endpoint address."@en ;
    rdfs:subClassOf maestro:Endpoint ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/mqtt> .

###  https://w3id.org/maestro#OpcUaBinding
maestro:OpcUaBinding a owl:Class ;
    rdfs:label "OPC UA binding"@en ;
    skos:definition "A binding that maps an endpoint onto OPC UA: the method that is called and the encoding used."@en ;
    rdfs:comment "Specialises maestro:Binding, realising the HHM extension point on Binding."@en ;
    rdfs:subClassOf maestro:Binding ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/opcua> .

###  https://w3id.org/maestro#OpcUaMethod
maestro:OpcUaMethod a owl:Class ;
    rdfs:label "OPC UA method"@en ;
    skos:definition "An OPC UA method node that a client can call."@en ;
    rdfs:comment "Close match to OpcUa:UAMethod of the HSU OPC UA ODP."@en ;
    rdfs:subClassOf maestro:OpcUaNode ;
    skos:closeMatch OpcUa:UAMethod ;
    dct:source <https://w3id.org/maestro/opcua#OpcUaMethod> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/opcua> .

###  https://w3id.org/maestro#OpcUaNode
maestro:OpcUaNode a owl:Class ;
    rdfs:label "OPC UA node"@en ;
    skos:definition "A node of an OPC UA server's node set, identified by a node id and a browse name."@en ;
    rdfs:comment "Close match to OpcUa:UANode of the HSU OPC UA ODP."@en ;
    skos:closeMatch OpcUa:UANode ;
    dct:source <https://w3id.org/maestro/opcua#OpcUaNode> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/opcua> .

###  https://w3id.org/maestro#OpcUaObject
maestro:OpcUaObject a owl:Class ;
    rdfs:label "OPC UA object"@en ;
    skos:definition "An OPC UA object node, to which variable and method nodes can be attached as components."@en ;
    rdfs:comment "Close match to OpcUa:UAObject of the HSU OPC UA ODP."@en ;
    rdfs:subClassOf maestro:OpcUaNode ;
    skos:closeMatch OpcUa:UAObject ;
    dct:source <https://w3id.org/maestro/opcua#OpcUaObject> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/opcua> .

###  https://w3id.org/maestro#OpcUaServer
maestro:OpcUaServer a owl:Class ;
    rdfs:label "OPC UA server"@en ;
    skos:definition "An OPC UA server that holds a node set of OPC UA nodes."@en ;
    rdfs:comment "Close match to OpcUa:UAServer of the HSU OPC UA ODP."@en ;
    skos:closeMatch OpcUa:UAServer ;
    dct:source <https://w3id.org/maestro/opcua#OpcUaServer> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/opcua> .

###  https://w3id.org/maestro#OpcUaSkillInterface
maestro:OpcUaSkillInterface a owl:Class ;
    rdfs:label "OPC UA skill interface"@en ;
    skos:definition "An OPC UA object that exposes a skill to network clients; the OPC UA realisation of the protocol-neutral skill interface."@en ;
    rdfs:subClassOf maestro:OpcUaObject , maestro:SkillInterface ;
    dct:source <https://w3id.org/maestro/opcua#OpcUaSkillInterface> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/opcua> .

###  https://w3id.org/maestro#OpcUaVariable
maestro:OpcUaVariable a owl:Class ;
    rdfs:label "OPC UA variable"@en ;
    skos:definition "An OPC UA variable node that holds a value."@en ;
    rdfs:comment "Close match to OpcUa:UAVariable of the HSU OPC UA ODP."@en ;
    rdfs:subClassOf maestro:OpcUaNode ;
    skos:closeMatch OpcUa:UAVariable ;
    dct:source <https://w3id.org/maestro/opcua#OpcUaVariable> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/opcua> .

###  https://w3id.org/maestro#OperationSignature
maestro:OperationSignature a owl:Class ;
    rdfs:label "Operation signature"@en ;
    skos:definition "The parameter and return schema of an invocable operation."@en ;
    rdfs:comment "Folded in from the MAESTRO 1.0 communication module. Close match to WADL:Method of the HSU WADL ODP, which describes the request and response of an HTTP method applied to a resource. Input parameters use maestro:hasParameterDef, returns use maestro:returns."@en ;
    skos:closeMatch WADL:Method ;
    dct:source <https://w3id.org/maestro/communication#OperationSignature> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .

###  https://w3id.org/maestro#ParameterDef
maestro:ParameterDef a owl:Class ;
    rdfs:label "Parameter definition"@en ;
    skos:definition "Typed parameter definition of a skill: a data type, an optional unit reference and an optional numeric range."@en ;
    rdfs:comment "HHM-Core Skills cluster (ParameterDef: type, unitRef, range). Also used as the parameter and return schema of an maestro:OperationSignature."@en ;
    dct:source <https://w3id.org/maestro/skill#ParameterDef> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#ParameterDirection
maestro:ParameterDirection a owl:Class ;
    rdfs:label "Parameter direction"@en ;
    skos:definition "Whether a parameter definition is consumed (input) or produced (output) by its skill."@en ;
    rdfs:comment "Controlled vocabulary with the two individuals maestro:Input and maestro:Output. A data binding flows from an output to an input."@en ;
    dct:source <https://w3id.org/maestro/skill#ParameterDirection> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#ParameterValue
maestro:ParameterValue a owl:Class ;
    rdfs:label "Parameter value"@en ;
    skos:definition "An instance-level value supplied for a parameter definition, for example at a skill execution."@en ;
    rdfs:comment "HHM-Core Skills cluster."@en ;
    dct:source <https://w3id.org/maestro/skill#ParameterValue> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#PerformanceLevel
maestro:PerformanceLevel a owl:Class ;
    rdfs:label "Performance level"@en ;
    skos:definition "A performance level, PL a to PL e, declared by the integrator for a safety function."@en ;
    rdfs:comment "Kept separate from maestro:SafetyIntegrityLevel; the ontology does not convert between the two."@en ;
    dct:source <https://w3id.org/maestro/safety#PerformanceLevel> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#Permission
maestro:Permission a owl:Class ;
    rdfs:label "Permission"@en ;
    skos:definition "The ability to perform an action over a target, granted to a role."@en ;
    rdfs:comment "HHM-Core Safety / Security / Policy cluster."@en ;
    rdfs:subClassOf odrl:Permission ;
    dct:source <https://w3id.org/maestro/policy#Permission> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#PhysicalResourceProvider
maestro:PhysicalResourceProvider a owl:Class ;
    rdfs:label "Physical resource provider"@en ;
    skos:definition "An actor that owns and operates production equipment and offers its capabilities as a service."@en ;
    rdfs:comment "The same party may also be a customer."@en ;
    rdfs:subClassOf maestro:Actor ;
    dct:source <https://w3id.org/maestro/maas#PhysicalResourceProvider> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#PlanStep
maestro:PlanStep a owl:Class ;
    rdfs:label "Plan step"@en ;
    skos:definition "A single step of a recipe, realised by a skill and carrying control-flow constraints and data bindings."@en ;
    rdfs:comment "HHM-Core Recipe / Planning cluster. One occurrence of a skill in a plan; the same skill may be used by several steps."@en ;
    skos:scopeNote "ISA88:Phase is the smallest element of the procedural control in the HSU ISA88.01 ODP, defining a single process control task; a plan step plays that role."@en ;
    skos:closeMatch ISA88:Phase ;
    dct:source <https://w3id.org/maestro/recipe#PlanStep> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/recipe> .

###  https://w3id.org/maestro#Policy
maestro:Policy a owl:Class ;
    rdfs:label "Policy"@en ;
    skos:definition "A group of constraints and permissions governing skills, plan steps, modules or endpoints."@en ;
    rdfs:comment "HHM-Core Safety / Security / Policy cluster."@en ;
    rdfs:subClassOf odrl:Policy ;
    dct:source <https://w3id.org/maestro/policy#Policy> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#Postcondition
maestro:Postcondition a owl:Class ;
    rdfs:label "Postcondition"@en ;
    skos:definition "A condition that holds after a skill has run: the effect it produces."@en ;
    rdfs:comment "HHM-Core Skills cluster, using the HHM name Postcondition; MAESTRO 1.0 also calls it Effect. The condition text is carried by maestro:expression."@en ;
    dct:source <https://w3id.org/maestro/skill#Postcondition> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#PowerMeasurement
maestro:PowerMeasurement a owl:Class ;
    rdfs:label "Power measurement"@en ;
    skos:definition "An instantaneous measurement of the power drawn by a subject at a time."@en ;
    rdfs:comment "Distinct from accumulated energy: a power reading has a timestamp and no interval."@en ;
    dct:source <https://w3id.org/maestro/energy#PowerMeasurement> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/energy> .

###  https://w3id.org/maestro#Precondition
maestro:Precondition a owl:Class ;
    rdfs:label "Precondition"@en ;
    skos:definition "A condition that must hold before a skill runs."@en ;
    rdfs:comment "HHM-Core Skills cluster. The condition text is carried by maestro:expression."@en ;
    dct:source <https://w3id.org/maestro/skill#Precondition> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#Predictive
maestro:Predictive a owl:Class ;
    rdfs:label "Predictive"@en ;
    skos:definition "Condition-based maintenance scheduled from a forecast of the asset's degradation, derived from repeated analysis of its condition data."@en ;
    rdfs:subClassOf maestro:ConditionBased ;
    dct:source <https://w3id.org/maestro/maintenance#Predictive> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#Preventive
maestro:Preventive a owl:Class ;
    rdfs:label "Preventive"@en ;
    skos:definition "A maintenance action performed at planned intervals or conditions to prevent failure."@en ;
    rdfs:subClassOf maestro:MaintenanceAction ;
    dct:source <https://w3id.org/maestro/maintenance#Preventive> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#ProductInstance
maestro:ProductInstance a owl:Class ;
    rdfs:label "Product instance"@en ;
    skos:definition "A particular physical manufactured item realising a product type."@en ;
    rdfs:comment "HHM-Core Product cluster: the physically produced unit (what is built). Disjoint with maestro:ProductType."@en ;
    owl:disjointWith maestro:ProductType ;
    dct:source <https://w3id.org/maestro/product#ProductInstance> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#ProductType
maestro:ProductType a owl:Class ;
    rdfs:label "Product type"@en ;
    skos:definition "An information entity specifying a repeatable product design or configuration."@en ;
    rdfs:comment "HHM-Core Product cluster: the catalogue or design item (what is specified), as opposed to the produced unit (maestro:ProductInstance)."@en ;
    dct:source <https://w3id.org/maestro/product#ProductType> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#ProductionOrder
maestro:ProductionOrder a owl:Class ;
    rdfs:label "Production order"@en ;
    skos:definition "An order to produce a quantity of a product type by a due date, executing a recipe."@en ;
    rdfs:comment "Close match to ISO22400:ProductionOrder of the HSU ISO 22400-2 ODP. The hook for ISA-95 / IEC 62264 work orders (ext/isa95.ttl)."@en ;
    skos:closeMatch ISO22400:ProductionOrder ;
    dct:source <https://w3id.org/maestro/planning#ProductionOrder> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#ProfinetBinding
maestro:ProfinetBinding a owl:Class ;
    rdfs:label "PROFINET binding"@en ;
    skos:definition "A binding that maps an endpoint onto PROFINET IO: the IO device, and the slot and subslot of the submodule that carries the data."@en ;
    rdfs:comment "Specialises maestro:Binding, realising the HHM extension point on Binding."@en ;
    rdfs:subClassOf maestro:Binding ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/profinet> .

###  https://w3id.org/maestro#Protocol
maestro:Protocol a owl:Class ;
    rdfs:label "Protocol"@en ;
    skos:definition "A transport or application protocol an endpoint speaks."@en ;
    rdfs:comment "HHM-Core Invocation Hooks cluster, a controlled vocabulary of individuals. The individuals are declared in the extension modules, one module per protocol (maestro:OpcUaProtocol in ext/opcua.ttl, maestro:HttpProtocol in ext/rest.ttl, maestro:MqttProtocol, maestro:DdsProtocol, maestro:ModbusProtocol, maestro:ProfinetProtocol, maestro:EthercatProtocol in the module of the same name); a knowledge graph may declare further individuals. Transport protocols only: payload encodings are maestro:DataFormat, interface description languages are maestro:InterfaceDescriptionLanguage."@en ;
    dct:source <https://w3id.org/maestro/communication#Protocol> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .

###  https://w3id.org/maestro#Quote
maestro:Quote a owl:Class ;
    rdfs:label "Quote"@en ;
    skos:definition "A provider's priced, time-bound answer to one request, derived from one offer."@en ;
    rdfs:comment "Close match to schema:PriceSpecification."@en ;
    skos:closeMatch schema:PriceSpecification ;
    dct:source <https://w3id.org/maestro/maas#Quote> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#Recipe
maestro:Recipe a owl:Class ;
    rdfs:label "Recipe"@en ;
    skos:altLabel "Process plan"@en ;
    skos:definition "An ordered container of plan steps, each realised by a skill, that describes how a product is made."@en ;
    rdfs:comment "HHM-Core Recipe / ProcessPlan. Not restricted to batch production: its steps are realised by skills and may apply to discrete manufacturing. Disjoint with maestro:PlanStep."@en ;
    skos:scopeNote "ISA88:RecipeProcedure is the highest level of the procedural control model of the HSU ISA88.01 ODP, describing the execution of an extensive production operation such as the production of a batch. maestro:Recipe is not restricted to batch production."@en ;
    owl:disjointWith maestro:PlanStep ;
    skos:closeMatch ISA88:RecipeProcedure ;
    dct:source <https://w3id.org/maestro/recipe#Recipe> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/recipe> .

###  https://w3id.org/maestro#Requirement
maestro:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    skos:definition "A requirement that applies to a product or one of its features: functional, dimensional or regulatory."@en ;
    rdfs:comment "HHM-Core Product cluster. Close match to DINEN61360:Instance_Description of the HSU DIN EN 61360 ODP, whose expression goal is a requirement. Also the demand side of a manufacturing-as-a-service request (maestro:hasRequirement)."@en ;
    skos:closeMatch DINEN61360:Instance_Description ;
    dct:source <https://w3id.org/maestro/product#Requirement> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#RestBinding
maestro:RestBinding a owl:Class ;
    rdfs:label "REST binding"@en ;
    skos:definition "A binding that maps an endpoint onto an HTTP method applied to a URL template."@en ;
    rdfs:comment "Specialises maestro:Binding, realising the HHM extension point on Binding. Close match to WADL:Method of the HSU WADL ODP, which pairs an HTTP method with the request and response it carries."@en ;
    rdfs:subClassOf maestro:Binding ;
    skos:closeMatch WADL:Method ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/rest> .

###  https://w3id.org/maestro#RestInterface
maestro:RestInterface a owl:Class ;
    rdfs:label "REST interface"@en ;
    skos:definition "A skill interface exposed as an HTTP resource with REST-style operations."@en ;
    rdfs:comment "Related to WADL:Resource of the HSU WADL ODP, the URI pattern under which the operations are reached."@en ;
    rdfs:subClassOf maestro:SkillInterface ;
    skos:relatedMatch WADL:Resource ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/rest> .

###  https://w3id.org/maestro#ReturnToServiceAssessment
maestro:ReturnToServiceAssessment a owl:Class ;
    rdfs:label "Return-to-service assessment"@en ;
    skos:definition "The assessment, after maintenance work, whether the asset may return to service."@en ;
    dct:source <https://w3id.org/maestro/maintenance#ReturnToServiceAssessment> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#ReturnToServiceOutcome
maestro:ReturnToServiceOutcome a owl:Class ;
    rdfs:label "Return-to-service outcome"@en ;
    skos:definition "The controlled outcome of a return-to-service assessment: whether an asset may return to service, with or without restrictions."@en ;
    dct:source <https://w3id.org/maestro/maintenance#ReturnToServiceOutcome> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#Risk
maestro:Risk a owl:Class ;
    rdfs:label "Risk"@en ;
    skos:definition "How likely a harm is and how severe it would be, for a given subject in a given context."@en ;
    rdfs:comment "HHM-Core Safety / Security / Policy cluster. Used for harm to persons and also for property and production loss. Its rating after assessment is an maestro:RiskLevel on the assessment."@en ;
    dct:source <https://w3id.org/maestro/safety#Risk> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#RiskAssessment
maestro:RiskAssessment a owl:Class ;
    rdfs:label "Risk assessment"@en ;
    skos:definition "A context-specific assessment of the risks to or from a subject, stating its method, assumptions, evidence and the mitigations it relies on."@en ;
    rdfs:comment "Ontology validation does not certify equipment compliance; it records what was assessed, how and on what evidence."@en ;
    dct:source <https://w3id.org/maestro/safety#RiskAssessment> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#RiskLevel
maestro:RiskLevel a owl:Class ;
    rdfs:label "Risk level"@en ;
    skos:definition "A qualitative rating of a risk after assessment."@en ;
    rdfs:comment "Controlled vocabulary: Low, Medium, High."@en ;
    dct:source <https://w3id.org/maestro/safety#RiskLevel> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#Role
maestro:Role a owl:Class ;
    rdfs:label "Role"@en ;
    skos:definition "An actor role to which permissions are granted."@en ;
    rdfs:comment "HHM-Core Safety / Security / Policy cluster (role-based access). The manufacturing-as-a-service module adds the individuals CustomerRole, ProviderRole and MarketplaceRole."@en ;
    dct:source <https://w3id.org/maestro/policy#Role> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#SafetyFunction
maestro:SafetyFunction a owl:Class ;
    rdfs:label "Safety function"@en ;
    skos:definition "A function of a resource or control system that is relied on to bring or keep equipment in a safe state when a specific hazard arises."@en ;
    rdfs:comment "The ontology records the function; it does not define or verify its safety requirements."@en ;
    dct:source <https://w3id.org/maestro/safety#SafetyFunction> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#SafetyIntegrityLevel
maestro:SafetyIntegrityLevel a owl:Class ;
    rdfs:label "Safety integrity level"@en ;
    skos:definition "A safety integrity level, SIL 1 to SIL 4, declared by the integrator for a safety function."@en ;
    rdfs:comment "Kept separate from maestro:PerformanceLevel; the ontology does not convert between the two."@en ;
    dct:source <https://w3id.org/maestro/safety#SafetyIntegrityLevel> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

###  https://w3id.org/maestro#ServiceOffer
maestro:ServiceOffer a owl:Class ;
    rdfs:label "Service offer"@en ;
    skos:definition "A standing offer to perform manufacturing work: which capability, at which station, listed on which marketplace."@en ;
    rdfs:comment "Close match to schema:Offer. The commercial face of a technical maestro:SkillService, reached with maestro:exposesService."@en ;
    skos:closeMatch schema:Offer ;
    dct:source <https://w3id.org/maestro/maas#ServiceOffer> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#ServiceRequest
maestro:ServiceRequest a owl:Class ;
    rdfs:label "Service request"@en ;
    skos:definition "A customer's demand for a product to be manufactured, carrying its requirements and the latest acceptable lead time."@en ;
    rdfs:comment "Close match to schema:Demand."@en ;
    skos:closeMatch schema:Demand ;
    dct:source <https://w3id.org/maestro/maas#ServiceRequest> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maas> .

###  https://w3id.org/maestro#Site
maestro:Site a owl:Class ;
    rdfs:label "Site"@en ;
    skos:definition "A physical, geographical or logical grouping of production within an enterprise."@en ;
    skos:closeMatch DINEN62264:Site ;
    dct:source <https://w3id.org/maestro/planning#Site> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/isa95> .

###  https://w3id.org/maestro#Skill
maestro:Skill a owl:Class ;
    rdfs:label "Skill"@en ;
    skos:definition "A reusable specification of executable behaviour that can be realised by a deployed implementation."@en ;
    rdfs:comment "HHM-Core Skills cluster. A skill is a specification, not a running program and not a piece of hardware. Its kind is stated by the subclasses maestro:AtomicSkill and maestro:CompositeSkill."@en ;
    dct:source <https://w3id.org/maestro/core#Skill> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#SkillExecution
maestro:SkillExecution a owl:Class ;
    rdfs:label "Skill execution"@en ;
    skos:definition "One execution of a skill on a resource: an occurrence with inputs, status, invocation endpoint, faults and time interval."@en ;
    rdfs:comment "HHM-Core Minimal Execution cluster. The occurrence itself; a record describing it is an maestro:ExecutionRecord (modules/telemetry.ttl). Aligned to prov:Activity in ext/prov.ttl."@en ;
    rdfs:subClassOf prov:Activity ;
    dct:source <https://w3id.org/maestro/runtime#SkillExecution> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#SkillInterface
maestro:SkillInterface a owl:Class ;
    rdfs:label "Skill interface"@en ;
    skos:definition "A protocol-neutral contract through which a skill is invoked."@en ;
    rdfs:comment "HHM-Core Skills cluster (semantic contract). Protocol-specific interfaces, such as an OPC UA or a REST interface, are subclasses declared in the extension modules; the endpoint that exposes the contract is stated with maestro:exposedVia."@en ;
    dct:source <https://w3id.org/maestro/skill#SkillInterface> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

###  https://w3id.org/maestro#SkillService
maestro:SkillService a owl:Class ;
    rdfs:label "Skill service"@en ;
    skos:definition "A service abstraction that exposes one or more skill interfaces."@en ;
    rdfs:comment "HHM-Core SkillService (drawn in the digital-twin diagram). The commercial face of a service is an maestro:ServiceOffer."@en ;
    dct:source <https://w3id.org/maestro/skill#SkillService> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/invocation> .

###  https://w3id.org/maestro#Snapshot
maestro:Snapshot a owl:Class ;
    rdfs:label "Snapshot"@en ;
    skos:definition "Marker class for a graph that carries runtime triples captured at one instant."@en ;
    rdfs:comment "Shapes that require every resource to have a state target the resources referenced from a snapshot, so design-time loads do not falsely fail."@en ;
    dct:source <https://w3id.org/maestro/runtime#Snapshot> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#State
maestro:State a owl:Class ;
    rdfs:label "State"@en ;
    skos:definition "A discrete operational condition value that a station, module or execution can be in."@en ;
    rdfs:comment "State values are individuals. The assertion that a subject is in a state at a time is an maestro:StateAssertion; maestro:hasState is the shortcut for the one current operational state."@en ;
    dct:source <https://w3id.org/maestro/core#State> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#StateAssertion
maestro:StateAssertion a owl:Class ;
    rdfs:label "State assertion"@en ;
    skos:definition "The qualified assertion that a subject was in a state value, in one dimension, over a validity period, observed at a time and on stated evidence."@en ;
    rdfs:comment "History, independent dimensions and evidence need a qualified assertion; maestro:hasState is only the shortcut for the open operational assertion."@en ;
    dct:source <https://w3id.org/maestro/runtime#StateAssertion> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#StateDimension
maestro:StateDimension a owl:Class ;
    rdfs:label "State dimension"@en ;
    skos:definition "An independent aspect along which a subject has a state value at a time."@en ;
    rdfs:comment "Controlled vocabulary: Operational, Health, Reservation, Mode."@en ;
    dct:source <https://w3id.org/maestro/runtime#StateDimension> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#StateTransition
maestro:StateTransition a owl:Class ;
    rdfs:label "State transition"@en ;
    skos:definition "A telemetry event in which a subject leaves one state and enters another."@en ;
    rdfs:subClassOf maestro:TelemetryEvent ;
    dct:source <https://w3id.org/maestro/runtime#StateTransition> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#Station
maestro:Station a owl:Class ;
    rdfs:label "Station"@en ;
    skos:definition "A work station composed of plug-and-produce modules; the top physical unit of the HHM-Core resource model."@en ;
    rdfs:comment "HHM-Core Physical Resources cluster. A station carries modules through maestro:hasModule; which modules it carries may change through reconfiguration while the station itself stays stable."@en ;
    skos:scopeNote "ISA88:Unit is made up of equipment modules and control modules and combines all necessary physical processing and control equipment (HSU ISA88.01 ODP). This package does not adopt the presumption that a unit operates on no more than one batch at a time."@en ;
    skos:closeMatch ISA88:Unit ;
    dct:source <https://w3id.org/maestro/resource#Station> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/resource> .

###  https://w3id.org/maestro#TelemetryEvent
maestro:TelemetryEvent a owl:Class ;
    rdfs:label "Telemetry event"@en ;
    skos:definition "An occurrence recorded at runtime, such as a state transition or a fault."@en ;
    dct:source <https://w3id.org/maestro/runtime#RuntimeEvent> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#TimeInterval
maestro:TimeInterval a owl:Class ;
    rdfs:label "Time interval"@en ;
    skos:definition "A start and end time interval."@en ;
    rdfs:comment "HHM-Core Minimal Execution cluster. Complements the instant-only maestro:timestamp."@en ;
    dct:source <https://w3id.org/maestro/runtime#TimeInterval> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#TwinBinding
maestro:TwinBinding a owl:Class ;
    rdfs:label "Twin binding"@en ;
    skos:definition "The mapping of a digital twin onto a twin platform or model, such as an Asset Administration Shell package or a DTDL model."@en ;
    rdfs:comment "HHM digital-twin extension. The platform is a literal (maestro:platform); the model is an IRI (maestro:mapsTo)."@en ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/digital-twin> .

###  https://w3id.org/maestro#Variant
maestro:Variant a owl:Class ;
    rdfs:label "Variant"@en ;
    skos:definition "A configuration or variant of a product type, itself a product type."@en ;
    rdfs:comment "HHM-Core Product cluster. Reached from the base type with maestro:hasVariant."@en ;
    rdfs:subClassOf maestro:ProductType ;
    dct:source <https://w3id.org/maestro/product#Variant> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#WorkCenter
maestro:WorkCenter a owl:Class ;
    rdfs:label "Work centre"@en ;
    skos:definition "A grouping of work units within an area, such as a production line or a cell."@en ;
    skos:closeMatch DINEN62264:Work_Center ;
    dct:source <https://w3id.org/maestro/planning#WorkCenter> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/isa95> .

###  https://w3id.org/maestro#WorkUnit
maestro:WorkUnit a owl:Class ;
    rdfs:label "Work unit"@en ;
    skos:definition "The lowest level of the equipment hierarchy at which work is scheduled; an HHM-Core station typically plays this role."@en ;
    skos:closeMatch DINEN62264:Work_Unit ;
    dct:source <https://w3id.org/maestro/planning#WorkUnit> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/isa95> .


