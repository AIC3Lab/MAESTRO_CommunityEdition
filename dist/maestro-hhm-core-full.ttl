maestro:inDimension a owl:ObjectProperty ;
    rdfs:label "in dimension"@en ;
    skos:definition "Relates a state value to the dimension it belongs to."@en ;
    rdfs:domain maestro:State ;
    rdfs:range maestro:StateDimension ;
    dct:source <https://w3id.org/maestro/runtime#inDimension> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/telemetry> .

###  https://w3id.org/maestro#increases
maestro:increases a owl:ObjectProperty ;
    rdfs:label "increases"@en ;
    skos:definition "Relates a hazard to a risk it raises."@en ;
    rdfs:comment "HHM-Core edge Hazard increases Risk."@en ;
    rdfs:domain maestro:Hazard ;
    rdfs:range maestro:Risk ;
    dct:source <https://w3id.org/maestro/safety#increases> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/policy> .

