maestro:instanceOf a owl:ObjectProperty ;
    rdfs:label "instance of"@en ;
    skos:definition "Relates a parameter value to the parameter definition it instantiates."@en ;
    rdfs:comment "HHM-Core edge ParameterValue instanceOf ParameterDef."@en ;
    rdfs:domain maestro:ParameterValue ;
    rdfs:range maestro:ParameterDef ;
    dct:source <https://w3id.org/maestro/skill#instanceOf> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/skill> .

