maestro:hasTask a owl:ObjectProperty ;
    rdfs:label "has task"@en ;
    skos:definition "Relates a maintenance plan to a task it schedules."@en ;
    rdfs:domain maestro:MaintenancePlan ;
    rdfs:range maestro:MaintenanceTask ;
    dct:source <https://w3id.org/maestro/maintenance#hasTask> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/maintenance> .

###  https://w3id.org/maestro#hasTelemetry
maestro:hasTelemetry a owl:ObjectProperty ;
    rdfs:label "has telemetry"@en ;
    skos:definition "Relates a DTDL interface to a telemetry it declares."@en ;
    rdfs:domain maestro:DtdlInterface ;
    rdfs:range maestro:DtdlTelemetry ;
    dct:source <https://w3id.org/maestro/dtdl#hasTelemetry> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/dtdl> .

###  https://w3id.org/maestro#hasTime
maestro:hasTime a owl:ObjectProperty ;
    rdfs:label "has time"@en ;
    skos:definition "Relates an execution, or another occurrence, to the time interval over which it ran."@en ;
    rdfs:comment "HHM-Core edge SkillExecution hasTime TimeInterval. Domain left open so maintenance actions and measurements can carry an interval too."@en ;
    rdfs:range maestro:TimeInterval ;
    dct:source <https://w3id.org/maestro/runtime#hasTime> ;
    schema:domainIncludes maestro:MaintenanceAction , maestro:SkillExecution ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/execution> .

###  https://w3id.org/maestro#hasTwinBinding
maestro:hasTwinBinding a owl:ObjectProperty ;
    rdfs:label "has twin binding"@en ;
    skos:definition "Relates a digital twin to a binding onto a twin platform or model."@en ;
    rdfs:comment "HHM edge DigitalTwin hasTwinBinding TwinBinding. The service a twin exposes is stated with maestro:exposesService (modules/maas.ttl), shared with service offers."@en ;
    rdfs:domain maestro:DigitalTwin ;
    rdfs:range maestro:TwinBinding ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/digital-twin> .

###  https://w3id.org/maestro#hasVariant
maestro:hasVariant a owl:ObjectProperty ;
    rdfs:label "has variant"@en ;
    skos:definition "Relates a product type to one of its variants."@en ;
    rdfs:comment "HHM-Core edge ProductType hasVariant Variant, read from the base type. MAESTRO 1.0 reads the inverse, prod:variantOf, from the variant."@en ;
    rdfs:domain maestro:ProductType ;
    rdfs:range maestro:Variant ;
    dct:references <https://w3id.org/maestro/product#variantOf> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/product> .

###  https://w3id.org/maestro#hostedOn
maestro:hostedOn a owl:ObjectProperty ;
    rdfs:label "hosted on"@en ;
    skos:definition "Relates an OPC UA server to the module whose controller runs it."@en ;
    rdfs:comment "Implied: MAESTRO 1.0 places servers on control components; this package has none and names the module."@en ;
    rdfs:domain maestro:OpcUaServer ;
    rdfs:range maestro:Module ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/opcua> .

