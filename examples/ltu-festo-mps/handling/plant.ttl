han:ID_DI_AtSortingPosition_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "1B3" .

han:DI_AtSortingPosition a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Handling at sorting position"@en ;
    maestro:description "Linear axis at the sorting position (slide 1, inferred)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:hasIdentifier han:ID_DI_AtSortingPosition_Bit ,
                     han:ID_DI_AtSortingPosition_Pin ,
                     han:ID_DI_AtSortingPosition_BMK .

han:ID_DI_GripperExtended_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "I4" .

han:ID_DI_GripperExtended_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "17" .

han:ID_DI_GripperExtended_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "2B1" .

han:DI_GripperExtended a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Gripper extended"@en ;
    maestro:description "Lifting cylinder advanced (gripper lowered)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:hasIdentifier han:ID_DI_GripperExtended_Bit ,
                     han:ID_DI_GripperExtended_Pin ,
                     han:ID_DI_GripperExtended_BMK .

han:ID_DI_GripperRetracted_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "I5" .

han:ID_DI_GripperRetracted_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "18" .

han:ID_DI_GripperRetracted_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "2B2" .

han:DI_GripperRetracted a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Gripper retracted"@en ;
    maestro:description "Lifting cylinder retracted (gripper raised)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:hasIdentifier han:ID_DI_GripperRetracted_Bit ,
                     han:ID_DI_GripperRetracted_Pin ,
                     han:ID_DI_GripperRetracted_BMK .

han:ID_DI_NotBlack_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "I6" .

han:ID_DI_NotBlack_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "19" .

han:ID_DI_NotBlack_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "3B1" .

han:DI_NotBlack a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Workpiece is not black"@en ;
    maestro:description "Fibre-optic diffuse sensor in the gripper jaw; 1 = red or metallic, 0 = black (or no workpiece)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:hasIdentifier han:ID_DI_NotBlack_Bit , han:ID_DI_NotBlack_Pin , han:ID_DI_NotBlack_BMK .

han:ID_DI_DownstreamFree_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "I7" .

han:ID_DI_DownstreamFree_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "20" .

han:ID_DI_DownstreamFree_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "IP_FI" .

han:DI_DownstreamFree a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Downstream station free"@en ;
    maestro:description "StationLink receiver."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:hasIdentifier han:ID_DI_DownstreamFree_Bit ,
                     han:ID_DI_DownstreamFree_Pin ,
                     han:ID_DI_DownstreamFree_BMK .

han:ID_DO_ToUpstream_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "O0" .

han:ID_DO_ToUpstream_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "1" .

han:ID_DO_ToUpstream_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "1M1" .

han:DO_ToUpstream a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Handling to upstream station"@en ;
    maestro:description "Linear axis towards the pick-up position."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:hasIdentifier han:ID_DO_ToUpstream_Bit , han:ID_DO_ToUpstream_Pin , han:ID_DO_ToUpstream_BMK .

han:ID_DO_ToDownstream_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "O1" .

han:ID_DO_ToDownstream_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "2" .

han:ID_DO_ToDownstream_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "1M2" .

han:DO_ToDownstream a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Handling to downstream station"@en ;
    maestro:description "Linear axis towards slide 2 / downstream station."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:hasIdentifier han:ID_DO_ToDownstream_Bit ,
                     han:ID_DO_ToDownstream_Pin ,
                     han:ID_DO_ToDownstream_BMK .

han:ID_DO_ExtendGripper_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "O2" .

han:ID_DO_ExtendGripper_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "3" .

han:ID_DO_ExtendGripper_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "2M1" .

han:DO_ExtendGripper a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Extend gripper"@en ;
    maestro:description "Lifting cylinder extends; de-energised = retract."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:hasIdentifier han:ID_DO_ExtendGripper_Bit ,
                     han:ID_DO_ExtendGripper_Pin ,
                     han:ID_DO_ExtendGripper_BMK .

han:ID_DO_OpenGripper_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "O3" .

han:ID_DO_OpenGripper_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "4" .

han:ID_DO_OpenGripper_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "3M1" .

han:DO_OpenGripper a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Open gripper"@en ;
    maestro:description "De-energised = close (monostable valve, inferred)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:hasIdentifier han:ID_DO_OpenGripper_Bit ,
                     han:ID_DO_OpenGripper_Pin ,
                     han:ID_DO_OpenGripper_BMK .

han:ID_DO_StationOccupied_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "O7" .

han:ID_DO_StationOccupied_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "8" .

han:ID_DO_StationOccupied_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "IP_N_FO" .

han:DO_StationOccupied a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Station occupied"@en ;
    maestro:description "StationLink transmitter towards the upstream station."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:hasIdentifier han:ID_DO_StationOccupied_Bit ,
                     han:ID_DO_StationOccupied_Pin ,
                     han:ID_DO_StationOccupied_BMK .

han:CC_Start a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "START pushbutton (illuminated)"@en ;
    maestro:description "Starts the sequence; also acknowledges an error after the operator has removed its cause. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:CC_Stop a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "STOP pushbutton"@en ;
    maestro:description "Interrupts the sequence at any time. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:CC_Reset a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "RESET pushbutton (illuminated)"@en ;
    maestro:description "The reset sequence is prompted by the illuminated RESET pushbutton and runs when it is pressed. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:CC_AutoMan a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Key-operated switch AUTO/MAN"@en ;
    maestro:description "AUTO = continuous cycle, MAN = individual cycle. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:CC_EmergencyStop a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "EMERGENCY-STOP pushbutton (if available)"@en ;
    maestro:description "Interrupts the sequence at any time; must be released before a program is loaded. Whether it is a PLC input or a hard-wired safety circuit is not stated. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:CC_StartLamp a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "'start' indicator light"@en ;
    maestro:description "Lamp of the START pushbutton; on while the station waits for START. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

han:CC_ResetLamp a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "'reset' indicator light"@en ;
    maestro:description "Lamp of the RESET pushbutton; on while the station is not reset. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

han:T_PickDelay a maestro:ParameterDef ;
    rdfs:label "Delay 3 s after 'station occupied' (3s/X8)"@en ;
    maestro:description "The only GRAFCET timer of the station; the pick-up starts 3 s after step 8."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/SEC"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 3.0 ;
    maestro:maxValue 3.0 .


#################################################################
# I/O PATH: SYSLINK ENDPOINTS AND DATA INTERFACES
#
# XMA2 digital, XMG1 console. The URNs only name the connectors.
#################################################################

han:XMA2 a maestro:Endpoint ;
    rdfs:label "Handling station: SysLink station connector XMA2 (I/O terminal)"@en ;
    maestro:address "urn:ltu:festo-mps:handling:XMA2" ;
    maestro:description "24-pin SysLink plug between the station I/O terminal and the PLC board; parallel wiring, no network address. The URN only names the connector."@en ;
    maestro:usesProtocol ltu:SysLinkDigitalIO .

han:XMG1 a maestro:Endpoint ;
    rdfs:label "Handling station: SysLink control-console connector XMG1"@en ;
    maestro:address "urn:ltu:festo-mps:handling:XMG1" ;
    maestro:description "SysLink plug between the control console and the PLC board. The URN only names the connector."@en ;
    maestro:usesProtocol ltu:SysLinkDigitalIO .

han:StationIO a maestro:DtdlInterface ;
    rdfs:label "Handling station I/O image (XMA2)"@en ;
    maestro:description "Digital inputs I0-I7 and outputs O0-O3, O7."@en ;
    maestro:hasTelemetry han:DI_WorkpieceAvailable ,
                    han:DI_AtUpstream ,
                    han:DI_AtDownstream ,
                    han:DI_AtSortingPosition ,
                    han:DI_GripperExtended ,
                    han:DI_GripperRetracted ,
                    han:DI_NotBlack ,
                    han:DI_DownstreamFree ;
    maestro:hasProperty han:DO_ToUpstream ,
                   han:DO_ToDownstream ,
                   han:DO_ExtendGripper ,
                   han:DO_OpenGripper ,
                   han:DO_StationOccupied ;
    maestro:exposedVia han:XMA2 .

han:ConsoleIO a maestro:DtdlInterface ;
    rdfs:label "Handling station control console (XMG1)"@en ;
    maestro:description "Operator signals of the control console."@en ;
    maestro:hasTelemetry han:CC_Start ,
                    han:CC_Stop ,
                    han:CC_Reset ,
                    han:CC_AutoMan ,
                    han:CC_EmergencyStop ;
    maestro:hasProperty han:CC_StartLamp , han:CC_ResetLamp ;
    maestro:exposedVia han:XMG1 .

han:ControlService a maestro:SkillService ;
    rdfs:label "Handling station PLC program"@en ;
    maestro:description "The station manual offers Siemens S7-313C / 313C-2DP / 314 / 315-2DP (STEP7), Festo FEC FC640 / IPC HC02 / HC20 (FST 4.02), Allen-Bradley MicroLogix 1500 (RSLogix 500) and Mitsubishi FX1N (GX IEC Developer) controllers with a ready program. Which controller and program LTU runs is not stated. Program names on the CD: 4HA_AS / 4HA_KFA (S7), 04HA_FEC, 04_HA_K (ML1500), 04_HA_AS (FX1N)."@en ;
    maestro:exposesInterface han:StationIO , han:ConsoleIO .


#################################################################
# SKILLS
#################################################################

han:ResetStation a maestro:AtomicSkill ;
    rdfs:label "Reset to initial position"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "GRAFCET steps 3-4: move to the initial position and set flag 'reset finished'."@en ;
    maestro:requiresCapability ltu:StationControlCapability ;
    maestro:hasParameterDef han:CC_Reset , han:DI_AtUpstream , han:DI_GripperRetracted ;
    maestro:hasPrecondition han:Pre_ResetStation ;
    maestro:hasPostcondition han:Post_ResetStation .

han:Pre_ResetStation a maestro:Precondition ;
    rdfs:label "RESET pressed"@en ;
    maestro:expression "CC_Reset == 1" .

han:Post_ResetStation a maestro:Postcondition ;
    rdfs:label "Initial position: linear axis at 'upstream station', lifting cylinder retracted, gripper open"@en ;
    maestro:expression "DI_AtUpstream == 1 && DI_GripperRetracted == 1 && DO_OpenGripper == 1" .

han:SwitchIndicatorLight a maestro:AtomicSkill ;
    rdfs:label "Switch indicator light"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Turn the 'reset' or 'start' light on or off."@en ;
    maestro:requiresCapability ltu:OperatorInterfaceCapability ;
    maestro:hasParameterDef han:CC_StartLamp , han:CC_ResetLamp .

han:SetStationLinkSignal a maestro:AtomicSkill ;
    rdfs:label "Signal 'station occupied' / 'not occupied'"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Switch the StationLink transmitter towards the upstream station."@en ;
    maestro:requiresCapability ltu:StationLinkCapability ;
    maestro:hasParameterDef han:DO_StationOccupied , han:T_PickDelay .

han:OpenGripper a maestro:AtomicSkill ;
    rdfs:label "Open gripper"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Energise 3M1."@en ;
    maestro:requiresCapability ltu:MechanicalGrippingCapability ;
    maestro:hasParameterDef han:DO_OpenGripper ;
    maestro:hasPostcondition han:Post_OpenGripper .

han:Post_OpenGripper a maestro:Postcondition ;
    rdfs:label "Gripper opened"@en ;
    maestro:expression "DO_OpenGripper == 1 (gripper state is not sensed)" .

han:CloseGripper a maestro:AtomicSkill ;
    rdfs:label "Close gripper"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "De-energise 3M1."@en ;
    maestro:requiresCapability ltu:MechanicalGrippingCapability ;
    maestro:hasParameterDef han:DO_OpenGripper ;
    maestro:hasPostcondition han:Post_CloseGripper .

han:Post_CloseGripper a maestro:Postcondition ;
    rdfs:label "Gripper closed"@en ;
    maestro:expression "DO_OpenGripper == 0 (gripper state is not sensed)" .

han:ExtendGripper a maestro:AtomicSkill ;
    rdfs:label "Extend gripper (lower)"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Energise 2M1: the lifting cylinder lowers the gripper."@en ;
    maestro:requiresCapability ltu:LiftingCapability ;
    maestro:hasParameterDef han:DO_ExtendGripper , han:DI_GripperExtended ;
    maestro:hasPostcondition han:Post_ExtendGripper .

han:Post_ExtendGripper a maestro:Postcondition ;
    rdfs:label "Gripper extended"@en ;
    maestro:expression "DI_GripperExtended == 1" .

han:RetractGripper a maestro:AtomicSkill ;
    rdfs:label "Retract gripper (raise)"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "De-energise 2M1."@en ;
    maestro:requiresCapability ltu:LiftingCapability ;
    maestro:hasParameterDef han:DO_ExtendGripper , han:DI_GripperRetracted ;
    maestro:hasPostcondition han:Post_RetractGripper .

han:Post_RetractGripper a maestro:Postcondition ;
    rdfs:label "Gripper retracted"@en ;
    maestro:expression "DI_GripperRetracted == 1" .

han:DetectMaterial a maestro:AtomicSkill ;
    rdfs:label "Detect material class in the gripper"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Read 3B1 while the workpiece is held: black or red/silver."@en ;
    maestro:requiresCapability ltu:MaterialRecognitionCapability ;
    maestro:hasParameterDef han:DI_NotBlack ;
    maestro:hasPostcondition han:Post_DetectMaterial .

han:Post_DetectMaterial a maestro:Postcondition ;
    rdfs:label "Material class known"@en ;
    maestro:expression "black := !DI_NotBlack" .

han:MoveToSlideBlack a maestro:AtomicSkill ;
    rdfs:label "Move linear drive to 'slide black'"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Move the axis to the sorting position 1B3 (slide 1). That the axis stops there by de-energising both 1M1 and 1M2 (closed-centre 1V1) is inferred."@en ;
    maestro:requiresCapability ltu:TransferCapability , ltu:SortingCapability ;
    maestro:hasParameterDef han:DI_AtSortingPosition ;
    maestro:hasPostcondition han:Post_MoveToSlideBlack .

han:Post_MoveToSlideBlack a maestro:Postcondition ;
    rdfs:label "Linear drive at 'slide black'"@en ;
    maestro:expression "DI_AtSortingPosition == 1" .

han:MoveToSlideRedSilver a maestro:AtomicSkill ;
    rdfs:label "Move linear drive to 'slide red/silver' (or 'downstream station')"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Energise 1M2: the axis runs to the slide-2 end stop."@en ;
    maestro:requiresCapability ltu:TransferCapability , ltu:SortingCapability ;
    maestro:hasParameterDef han:DO_ToDownstream , han:DI_AtDownstream ;
    maestro:hasPostcondition han:Post_MoveToSlideRedSilver .

han:Post_MoveToSlideRedSilver a maestro:Postcondition ;
    rdfs:label "Linear drive at 'slide red/silver' resp. 'downstream station'"@en ;
    maestro:expression "DI_AtDownstream == 1" .

han:MoveToUpstream a maestro:AtomicSkill ;
    rdfs:label "Move linear drive to 'upstream station'"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Energise 1M1: the axis returns to the receptacle."@en ;
    maestro:requiresCapability ltu:TransferCapability ;
    maestro:hasParameterDef han:DO_ToUpstream , han:DI_AtUpstream ;
    maestro:hasPostcondition han:Post_MoveToUpstream .

han:Post_MoveToUpstream a maestro:Postcondition ;
    rdfs:label "Linear drive at 'upstream station'"@en ;
    maestro:expression "DI_AtUpstream == 1" .

han:PickAndSortWorkpiece a maestro:CompositeSkill ;
    rdfs:label "Pick and sort workpiece (station cycle)"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Pick the workpiece from the receptacle, recognise black / non-black in the gripper and deposit it on slide 1 (black) or slide 2 (red/silver) (manual section 5, GRAFCET steps 7-18)."@en ;
    maestro:hasSubSkillLink han:OpenGripper ,
                       han:ExtendGripper ,
                       han:CloseGripper ,
                       han:RetractGripper ,
                       han:DetectMaterial ,
                       han:MoveToSlideBlack ,
                       han:MoveToSlideRedSilver ,
                       han:MoveToUpstream ;
    maestro:requiresCapability ltu:TransferCapability ,
                          ltu:LiftingCapability ,
                          ltu:MechanicalGrippingCapability ,
                          ltu:MaterialRecognitionCapability ,
                          ltu:SortingCapability ;
    maestro:hasPrecondition han:Pre_PickAndSortWorkpiece ;
    maestro:hasPostcondition han:Post_PickAndSortWorkpiece ;
    maestro:hasInterfaceContract han:StationIO .

han:Pre_PickAndSortWorkpiece a maestro:Precondition ;
    rdfs:label "Workpiece in the receptacle, START pressed"@en ;
    maestro:expression "DI_WorkpieceAvailable == 1 && CC_Start == 1" .

han:Post_PickAndSortWorkpiece a maestro:Postcondition ;
    rdfs:label "Black workpiece on slide 1, red/silver workpiece on slide 2"@en ;
    maestro:expression "DI_AtUpstream == 1 && DI_GripperRetracted == 1" .


#################################################################
# SAFETY
#################################################################

ltu:Perm_TraineeRunsStations maestro:target han:PickAndSortWorkpiece .

han:EmergencyStop a maestro:EmergencyStop ;
    rdfs:label "EMERGENCY-STOP pushbutton, Handling station control console"@en ;
    maestro:description "The manual names the EMERGENCY-STOP pushbutton '(if available)'; together with STOP it interrupts the sequence at any time and must be released before a program is loaded. Safety category, performance level and wiring are not stated."@en ;
    maestro:mitigates ltu:H_MovingStation .

han:C_MaxOperatingPressure a maestro:Constraint ;
    rdfs:label "Do not exceed the Handling station's maximum operating pressure of 4 bar (400 kPa)"@en ;
    maestro:expression "supplyPressure <= 4 bar" ;
    maestro:constrains han:Station .

han:C_FibreOpticNotProtective a maestro:Constraint ;
    rdfs:label "Fibre-optic devices must not be used as contactless protective devices"@en ;
    maestro:expression "PART_AV and 3B1 are not safety devices" ;
    maestro:constrains han:ReceptacleModule , han:PicAlfaModule .

ltu:MPSSafetyRules maestro:contains han:C_MaxOperatingPressure , han:C_FibreOpticNotProtective .


#################################################################
# MAINTENANCE
#
# Plus the fibre-optic device note of operating instructions 369669.
#################################################################

han:MT_CleanFibreOptic a maestro:MaintenanceTask ;
    rdfs:label "Clean the fibre-optic devices only with water (max. 60 degC) or isopropyl alcohol"@en .

han:MaintenancePlan a maestro:MaintenancePlan ;
    rdfs:label "Handling station care plan (manual chapter 'Maintenance')"@en ;
    maestro:description "Only 'at regular intervals' is given; no numeric interval is stated."@en ;
    maestro:planForAsset han:ReceptacleModule ,
                    han:PicAlfaModule ,
                    han:Slide1 ,
                    han:Slide2 ,
                    han:ValveTerminal ,
                    han:StationLinkTransmitter ,
                    han:StationLinkReceiver ;
    maestro:hasTask ltu:MT_CleanOptics ,
               ltu:MT_CleanProximitySensors ,
               ltu:MT_CleanStation ,
               ltu:MT_VisualCheck ,
               han:MT_CleanFibreOptic .
