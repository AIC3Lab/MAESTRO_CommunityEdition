    maestro:refDesignator "1B1, 1B2, 1B3, 2B1, 2B2" .

han:BOM_FlowControlValves a maestro:BOMNode ;
    rdfs:label "One-way flow control valve, type C"@en ;
    maestro:description "Type C 175056; the manual also lists type B 162991. Which BMK has which type is not stated."@en ;
    maestro:nodeFor ltu:PT_175056 ;
    maestro:quantity 4.0 ;
    maestro:refDesignator "1V2, 1V3, 2V2, 2V3" .

han:BOM_ShockAbsorbers a maestro:BOMNode ;
