    maestro:nodeFor ltu:PT_526212 ;
    maestro:quantity 2.0 ;
    maestro:refDesignator "PART_AV, 3B1" ;
    maestro:hasPart han:BOM_FibreOpticDevices , han:BOM_FibreOpticCables .

han:BOM_FibreOpticDevices a maestro:BOMNode ;
    rdfs:label "Fibre-optic device"@en ;
    maestro:nodeFor ltu:PT_165327 ;
    maestro:quantity 2.0 ;
    maestro:refDesignator "PART_AV, 3B1" .

han:BOM_FibreOpticCables a maestro:BOMNode ;
    rdfs:label "Fibre-optic cable, diffuse"@en ;
    maestro:nodeFor ltu:PT_165358 ;
    maestro:quantity 2.0 ;
    maestro:refDesignator "PART_AV, 3B1" .

han:BOM_PicAlfa a maestro:BOMNode ;
    rdfs:label "PicAlfa module"@en ;
    maestro:nodeFor ltu:PT_526215 ;
    maestro:quantity 1.0 ;
    maestro:hasPart han:BOM_1A1 ,
               han:BOM_2A1 ,
               han:BOM_3A1 ,
               han:BOM_ProximitySensors ,
               han:BOM_FlowControlValves ,
               han:BOM_ShockAbsorbers .

han:BOM_1A1 a maestro:BOMNode ;
    rdfs:label "Rodless linear drive DGPL-12"@en ;
    maestro:description "Linear axis (X)."@en ;
    maestro:nodeFor ltu:PT_161973 ;
    maestro:quantity 1.0 ;
    maestro:refDesignator "1A1" .

han:BOM_2A1 a maestro:BOMNode ;
    rdfs:label "Flat cylinder DZF-18-80"@en ;
    maestro:description "Lifting cylinder (Z)."@en ;
    maestro:nodeFor ltu:PT_164019 ;
    maestro:quantity 1.0 ;
    maestro:refDesignator "2A1" .

han:BOM_3A1 a maestro:BOMNode ;
    rdfs:label "Parallel gripper HGP-10"@en ;
    maestro:description "Parallel gripper."@en ;
    maestro:nodeFor ltu:PT_197542 ;
    maestro:quantity 1.0 ;
    maestro:refDesignator "3A1" .

han:BOM_ProximitySensors a maestro:BOMNode ;
