#################################################################
# SIGNALS (DATA POINTS)
#
# Bits, XMA2 pins and BMKs from the electric circuit diagram, pages 4-5.
# Sensor = maestro:Output / maestro:DtdlTelemetry; actuator command = maestro:Input /
# maestro:DtdlProperty.
#################################################################

han:ID_DI_WorkpieceAvailable_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "I0" .

han:ID_DI_WorkpieceAvailable_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "13" .

han:ID_DI_WorkpieceAvailable_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "PART_AV" .

han:DI_WorkpieceAvailable a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Workpiece available"@en ;
    maestro:description "Fibre-optic diffuse sensor in the receptacle; 1 = workpiece in the receptacle."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:hasIdentifier han:ID_DI_WorkpieceAvailable_Bit ,
                     han:ID_DI_WorkpieceAvailable_Pin ,
                     han:ID_DI_WorkpieceAvailable_BMK .

han:ID_DI_AtUpstream_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "I1" .

han:ID_DI_AtUpstream_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "14" .

han:ID_DI_AtUpstream_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "1B1" .

han:DI_AtUpstream a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Handling at upstream station"@en ;
    maestro:description "Linear axis at the pick-up (receptacle) position."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:hasIdentifier han:ID_DI_AtUpstream_Bit , han:ID_DI_AtUpstream_Pin , han:ID_DI_AtUpstream_BMK .

han:ID_DI_AtDownstream_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "I2" .

han:ID_DI_AtDownstream_Pin a maestro:Identifier ;
