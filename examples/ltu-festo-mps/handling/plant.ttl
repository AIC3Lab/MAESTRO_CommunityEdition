@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix ltu:  <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/shared#> .
@prefix han:  <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/handling#> .

#################################################################
# LTU FESTO MPS - HANDLING STATION - PLANT (DESIGN TIME)
#
# Sources (FESTO CD/04_Handling): 655633_Manual_Handling (DE/EN 04/06
# R2.2), Electric_Circuit_Diagram_Handling (drawing 195783, 05.04.06),
# Pneumatic_Circuit_Diagram_Handling, 526883_Parts_list_Handling,
# assembly
# instructions, data sheets, operating instructions, 04_Handling_GRAFCET.
#
# Documents disagree on: 7 digital outputs in the technical data vs 5
# wired (O0-O3, O7); 1 slide module in the parts list vs 2 in the manual
# and assembly instructions. The valve-to-solenoid mapping is inferred
# from the circuit symbols and data sheets.
#################################################################

<https://w3id.org/maestro/hhm/examples/ltu-festo-mps/handling> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/handling/0.1.0> ;
    rdfs:label "MAESTRO HHM-Core example: LTU Festo MPS - Handling station (plant)"@en ;
    owl:imports <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/shared> ;
    owl:versionInfo "0.1.0" ;
    rdfs:comment "The Festo MPS Handling station of the LTU line: modules, parts list, I/O allocation, skills, safety and care. The GRAFCET control sequence is in product.ttl. Built from manual 655633, the electric and pneumatic circuit diagrams, parts list 526883, data sheets and the GRAFCET."@en .


#################################################################
# STATION
#
# Material number 526883 (parts list) and manual order number 655633.
#################################################################

han:ID_StationMaterialNo a maestro:Identifier ;
    maestro:identifierScheme "Festo material number (station)" ;
    maestro:identifierValue "526883" .

han:ID_ManualOrderNo a maestro:Identifier ;
    maestro:identifierScheme "Festo order number (technical documentation)" ;
    maestro:identifierValue "655633" .

han:Station a maestro:Station , maestro:WorkUnit ;
    rdfs:label "Handling station"@en ;
    maestro:description "Station 4 (HA) of the MPS. Takes a workpiece from the receptacle with the PicAlfa two-axis pneumatic handling device, tells black from non-black (red, metallic) with an optical sensor in the gripper jaw, and puts black workpieces on slide 1 (inner) and red/silver ones on slide 2 (outer); after moving the slide-2 end stop it can pass workpieces to a downstream station instead. Last station of the LTU line."@en ;
    maestro:manufacturer "Festo Didactic GmbH & Co. KG" ;
    maestro:model "MPS Handling station (HA, PicAlfa)" ;
    maestro:hasIdentifier han:ID_StationMaterialNo , han:ID_ManualOrderNo ;
    maestro:partOfWorkCenter ltu:MPSLine ;
    maestro:hasModule han:ReceptacleModule ,
                 han:PicAlfaModule ,
                 han:Slide1 ,
                 han:Slide2 ,
                 han:ValveTerminal ,
                 han:ServiceUnit ,
                 han:IOTerminal ,
                 han:PLCBoard ,
                 han:ControlConsole ,
                 han:StationLinkTransmitter ,
                 han:StationLinkReceiver ;
    maestro:hasParameterDef han:TD_OperatingPressure ,
                       han:TD_MaxPressure ,
                       han:TD_AirConsumption ,
                       han:TD_SupplyVoltage ,
                       han:TD_SupplyCurrent ,
                       han:TD_DigitalInputs ,
                       han:TD_DigitalOutputs ,
                       han:TD_SlideCapacity .

ltu:LTU maestro:operates han:Station .

han:PSU a maestro:EnergySource ;
    rdfs:label "24 V DC power supply unit, Handling station"@en ;
    maestro:description "Power supply unit 24 V DC, 4.5 A (max. 5 A); feeds the whole station through the PLC board."@en .


#################################################################
# TECHNICAL DATA
#
# Static values from the manual's technical-data table and commissioning
# section.
#################################################################

han:TD_OperatingPressure a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Operating pressure 4 bar"@en ;
    maestro:description "Service unit setting. Operating pressure 4 bar (400 kPa), the maximum operating pressure of the Handling station."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/BAR"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 4.0 ;
    maestro:maxValue 4.0 .

han:TD_MaxPressure a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Maximum permissible pressure 8 bar"@en ;
    maestro:description "'Do not exceed' limit of the safety chapter."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/BAR"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:maxValue 8.0 .

han:TD_AirConsumption a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Compressed-air supply, suction capacity approx. 50 l/min"@en ;
    maestro:description "Compressed-air supply named for commissioning (approximate value)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/L-PER-MIN"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:maxValue 50.0 .

han:TD_SupplyVoltage a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Supply voltage 24 V DC"@en ;
    maestro:description "Power supply unit 24 V DC; the whole station is supplied through the PLC board."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/V"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 24.0 ;
    maestro:maxValue 24.0 .

han:TD_SupplyCurrent a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Supply current 4.5 A"@en ;
    maestro:description "Technical data 4.5 A; section 'voltage supply' says max. 5 A."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/A"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:maxValue 4.5 .

han:TD_DigitalInputs a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Digital inputs: 8"@en ;
    maestro:description "Number of digital inputs in the technical-data table."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 8.0 ;
    maestro:maxValue 8.0 .

han:TD_DigitalOutputs a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Digital outputs: 7"@en ;
    maestro:description "Number of digital outputs in the technical-data table."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 7.0 ;
    maestro:maxValue 7.0 .

han:TD_SlideCapacity a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Slide capacity: 5 workpieces each"@en ;
    maestro:description "Each of the two slides holds 5 workpieces; the slides have no fill-level sensor."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:maxValue 5.0 .


#################################################################
# MODULES
#################################################################

han:ReceptacleModule a maestro:Module ;
    rdfs:label "Receptacle (holder) module"@en ;
    maestro:description "Holds the workpiece at the pick-up position ('upstream station' in the circuit diagram); fibre-optic diffuse sensor PART_AV detects it. Stand-alone, workpieces are inserted by hand."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-AN-BS" ;
    maestro:hasIdentifier ltu:PN_195777 ;
    maestro:providesCapability ltu:PresenceSensingCapability ;
    maestro:hasInterface han:Port_MaterialIn .

han:Port_MaterialIn a maestro:ExternalInterface ;
    rdfs:label "Material input: receptacle (pick-up position 'upstream station')"@en ;
    maestro:description "The upstream station delivers the workpiece here; how it does so is not stated."@en .

han:PicAlfaModule a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "PicAlfa module (two-axis pick & place)"@en ;
    maestro:description "Rodless linear axis 1A1 (DGPL-12, positions receptacle / slide 1 / slide 2, end stops with shock absorbers, sensors 1B1-1B3), flat lifting cylinder 2A1 (DZF-18-80, sensors 2B1/2B2) and parallel gripper 3A1 (HGP-10) with fibre-optic sensor 3B1 flush in the jaw. The gripper state is not sensed."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-PA-B-BS" ;
    maestro:hasIdentifier ltu:PN_526215 ;
    maestro:providesCapability ltu:TransferCapability ,
                          ltu:LiftingCapability ,
                          ltu:MechanicalGrippingCapability ,
                          ltu:MaterialRecognitionCapability ,
                          ltu:SortingCapability ;
    maestro:suppliedBy maestro:CompressedAir ;
    maestro:hasInterface han:Port_MaterialOut .

han:Port_MaterialOut a maestro:ExternalInterface ;
    rdfs:label "Transfer point to a downstream station"@en ;
    maestro:description "Only after the slide-2 end stop is moved to the downstream 'material input' and 1B2 to 'downstream station'; not used in the LTU line, where Handling is last."@en .

han:Slide1 a maestro:Module ;
    rdfs:label "Slide 1 (inner, black workpieces)"@en ;
    maestro:description "Receives black workpieces; holds 5; inclination adjustable."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-RT250" ;
    maestro:hasIdentifier ltu:PN_653393 ;
    maestro:providesCapability ltu:SlideConveyingCapability .

han:Slide2 a maestro:Module ;
    rdfs:label "Slide 2 (outer, red/silver workpieces)"@en ;
    maestro:description "Receives red and silver workpieces; holds 5; inclination adjustable."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-RT250" ;
    maestro:hasIdentifier ltu:PN_653393 ;
    maestro:providesCapability ltu:SlideConveyingCapability .

han:ValveTerminal a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "CPV valve terminal 0V1"@en ;
    maestro:description "CPV10 valve terminal with 1M1/1M2 (linear axis), 1V1 (5/3 closed-centre kit), 2M1 (extend gripper) and 3M1 (open gripper). Valve-to-coil mapping inferred."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-CP-GMM" ;
    maestro:hasIdentifier ltu:PN_526872 ;
    maestro:providesCapability ltu:PneumaticActuationCapability ;
    maestro:suppliedBy maestro:CompressedAir , han:PSU .

han:ServiceUnit a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "Service unit (start-up valve with filter-control valve)"@en ;
    maestro:description "Compressed-air inlet, set to 4 bar."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:S-PVW-LFR" ;
    maestro:hasIdentifier ltu:PN_152894 ;
    maestro:providesCapability ltu:PneumaticActuationCapability ;
    maestro:suppliedBy maestro:CompressedAir .

han:IOTerminal a maestro:Module ;
    rdfs:label "I/O terminal"@en ;
    maestro:description "Station side of SysLink XMA2: inputs I0-I7, outputs O0-O3 and O7 used (O4-O6 free)."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP-B-AN-E/A-T" ;
    maestro:hasIdentifier ltu:PN_034035 ;
    maestro:providesCapability ltu:StationControlCapability .

han:PLCBoard a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "PLC board"@en ;
    maestro:description "Connects to XMA2, XMG1, the power supply and the PC."@en ;
    maestro:model "PLC board (controller not stated)" ;
    maestro:providesCapability ltu:StationControlCapability ;
    maestro:suppliedBy han:PSU .

han:ControlConsole a maestro:Module ;
    rdfs:label "Control console"@en ;
    maestro:description "START, STOP, RESET, AUTO/MAN and EMERGENCY-STOP (if available); connected via XMG1."@en ;
    maestro:providesCapability ltu:OperatorInterfaceCapability .

han:StationLinkTransmitter a maestro:Module ;
    rdfs:label "StationLink transmitter IP_N_FO"@en ;
    maestro:description "Incoming-material side; signals 'station occupied' to the upstream station (O7)."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-SLS" ;
    maestro:hasIdentifier ltu:PN_196963 ;
    maestro:providesCapability ltu:StationLinkCapability ;
    maestro:hasInterface han:Port_StationLinkTx .

han:Port_StationLinkTx a maestro:ExternalInterface ;
    rdfs:label "StationLink transmitter (incoming-material side)"@en .

han:StationLinkReceiver a maestro:Module ;
    rdfs:label "StationLink receiver IP_FI"@en ;
    maestro:description "Outgoing-material side; reads 'downstream station free' (I7). As the last station of the line it faces no transmitter; what the program then reads is not stated."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-SLE" ;
    maestro:hasIdentifier ltu:PN_196964 ;
    maestro:providesCapability ltu:StationLinkCapability ;
    maestro:hasInterface han:Port_StationLinkRx .

han:Port_StationLinkRx a maestro:ExternalInterface ;
    rdfs:label "StationLink receiver (outgoing-material side)"@en .


#################################################################
# BILL OF MATERIALS
#
# Parts list 526883 (11.11.2002) with the components of the circuit
# diagrams below each assembly.
#################################################################

han:StationType a maestro:ProductType ;
    rdfs:label "Festo MPS Handling station (equipment type)"@en ;
    maestro:manufacturer "Festo Didactic GmbH & Co. KG" ;
    maestro:model "MPS Handling station (HA, PicAlfa)" ;
    maestro:description "The station as a Festo product; its bill of materials follows the parts list and the component tables of the documents."@en ;
    maestro:hasIdentifier han:ID_StationMaterialNo , han:ID_ManualOrderNo ;
    maestro:hasBOM han:BOM_Receptacle ,
              han:BOM_DiffuseSensors ,
              han:BOM_PicAlfa ,
              han:BOM_Slides ,
              han:BOM_ValveTerminal ,
              han:BOM_IOTerminal ,
              han:BOM_ServiceUnit ,
              han:BOM_ProfilePlate ,
              han:BOM_Connectors ,
              han:BOM_MountingSystem ,
              han:BOM_StationLinkTransmitter ,
              han:BOM_StationLinkReceiver ,
              han:BOM_Holder ,
              han:BOM_Accessories .

han:BOM_Receptacle a maestro:BOMNode ;
    rdfs:label "Holder (receptacle) module"@en ;
    maestro:nodeFor ltu:PT_195777 ;
    maestro:quantity 1.0 .

han:BOM_DiffuseSensors a maestro:BOMNode ;
