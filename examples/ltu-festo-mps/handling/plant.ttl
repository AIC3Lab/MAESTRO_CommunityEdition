    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:hasIdentifier han:ID_DI_AtDownstream_Bit ,
                     han:ID_DI_AtDownstream_Pin ,
                     han:ID_DI_AtDownstream_BMK .

han:ID_DI_AtSortingPosition_Bit a maestro:Identifier ;
