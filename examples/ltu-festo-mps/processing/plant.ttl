@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix ltu:  <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/shared#> .
@prefix pro:  <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/processing#> .

#################################################################
# LTU FESTO MPS - PROCESSING STATION - PLANT (DESIGN TIME)
#
# Sources (FESTO CD/03_Processing): 648813_Manual_Processing (DE/EN 04/06
# R2.2), Electric_Circuit_Diagram_Processing (drawing 195782, 05.04.06),
# 526882_Parts_list_Processing, assembly instructions (Processing,
# Drilling,
# Indexing table), data sheets, 03_Processing_GRAFCET (DE 01/04).
#
# The station uses only electrical actuators; the English commissioning
# text still lists a 6 bar air supply, the German text does not, so no
# compressed air is modelled. Motor ratings differ between the circuit
# diagram (M1 5 W, M2 5 W, M3 25 W) and the data sheets; both are kept
# in the descriptions.
#################################################################

<https://w3id.org/maestro/hhm/examples/ltu-festo-mps/processing> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/processing/0.1.0> ;
    rdfs:label "MAESTRO HHM-Core example: LTU Festo MPS - Processing station (plant)"@en ;
    owl:imports <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/shared> ;
    owl:versionInfo "0.1.0" ;
    rdfs:comment "The Festo MPS Processing station of the LTU line: modules, parts list, I/O allocation and relay logic, skills, safety and care. The GRAFCET control sequence is in product.ttl. Built from manual 648813, the electric circuit diagram, parts list 526882, data sheets and the GRAFCET."@en .


#################################################################
# STATION
#
# Material number 526882 (parts list) and manual order number 648813.
#################################################################

pro:ID_StationMaterialNo a maestro:Identifier ;
    maestro:identifierScheme "Festo material number (station)" ;
    maestro:identifierValue "526882" .

pro:ID_ManualOrderNo a maestro:Identifier ;
    maestro:identifierScheme "Festo order number (technical documentation)" ;
    maestro:identifierValue "648813" .

pro:Station a maestro:Station , maestro:WorkUnit ;
    rdfs:label "Processing station"@en ;
    maestro:description "Station 3 (BE) of the MPS. Checks workpieces (correctly positioned, opening upwards), machines them and supplies them to the next station. A rotary indexing table driven by a DC gear motor and positioned by a relay circuit carries six workpiece retainers between material input, testing, drilling and ejection. Testing and drilling run in parallel: a solenoid plunger with inductive sensor checks the orientation, a solenoid clamps the workpiece, a 24 V drilling machine on a toothed-belt axis simulates polishing of the hole, and an electrical ejector passes finished workpieces on."@en ;
    maestro:manufacturer "Festo Didactic GmbH & Co. KG" ;
    maestro:model "MPS Processing station (BE)" ;
    maestro:hasIdentifier pro:ID_StationMaterialNo , pro:ID_ManualOrderNo ;
    maestro:partOfWorkCenter ltu:MPSLine ;
    maestro:hasModule pro:RotaryIndexingTable ,
                 pro:TestingModule ,
                 pro:DrillingModule ,
                 pro:ClampingModule ,
                 pro:EjectorModule ,
                 pro:ConnectionBoard ,
                 pro:IOTerminal ,
                 pro:PLCBoard ,
                 pro:ControlConsole ,
                 pro:StationLinkTransmitter ,
                 pro:StationLinkReceiver ;
    maestro:hasParameterDef pro:TD_SupplyVoltage ,
                       pro:TD_SupplyCurrent ,
                       pro:TD_DigitalInputs ,
                       pro:TD_DigitalOutputs ,
                       pro:TD_IndexingAngle ,
                       pro:TD_Retainers .

ltu:LTU maestro:operates pro:Station .

pro:PSU a maestro:EnergySource ;
    rdfs:label "24 V DC power supply unit, Processing station"@en ;
    maestro:description "Power supply unit 24 V DC, 4.5 A (max. 5 A); feeds the whole station through the PLC board."@en .


#################################################################
# TECHNICAL DATA
#
# Static values from the manual's technical-data table and commissioning
# section.
#################################################################

pro:TD_SupplyVoltage a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Supply voltage 24 V DC"@en ;
    maestro:description "Power supply unit 24 V DC; the whole station is supplied through the PLC board."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/V"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 24.0 ;
    maestro:maxValue 24.0 .

pro:TD_SupplyCurrent a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Supply current 4.5 A"@en ;
    maestro:description "Technical data 4.5 A; section 'voltage supply' says max. 5 A."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/A"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:maxValue 4.5 .

pro:TD_DigitalInputs a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Digital inputs: 8"@en ;
    maestro:description "Number of digital inputs in the technical-data table."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 8.0 ;
    maestro:maxValue 8.0 .

pro:TD_DigitalOutputs a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Digital outputs: 8"@en ;
    maestro:description "Number of digital outputs in the technical-data table."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 8.0 ;
    maestro:maxValue 8.0 .

pro:TD_IndexingAngle a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Indexing step 60 degrees"@en ;
    maestro:description "The rotary indexing table turns 60 degrees per step."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/DEG"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 60.0 ;
    maestro:maxValue 60.0 .

pro:TD_Retainers a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Workpiece retainers on the indexing table: 6"@en ;
    maestro:description "Semi-circular retainers, each with a centre hole for capacitive sensing."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 6.0 ;
    maestro:maxValue 6.0 .


#################################################################
# MODULES
#################################################################

pro:RotaryIndexingTable a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "Rotary indexing table module"@en ;
    maestro:description "Six-position table driven by gear motor M2 through relay K2 (latched) and stopped by K5 when inductive sensor B3 sees a positioning screw. Capacitive sensors PART_AV, B1 and B2 detect workpieces at material input, testing and drilling."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-RST" ;
    maestro:hasIdentifier ltu:PN_654972 ;
    maestro:providesCapability ltu:IndexingCapability ,
                          ltu:TransferCapability ,
                          ltu:PresenceSensingCapability ;
    maestro:suppliedBy pro:PSU ;
    maestro:hasInterface pro:Port_MaterialIn .

pro:Port_MaterialIn a maestro:ExternalInterface ;
    rdfs:label "Material input: workpiece retainer 1"@en ;
    maestro:description "PART_AV detects the workpiece here."@en .

pro:TestingModule a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "Testing module"@en ;
    maestro:description "Testing solenoid M5 lowers a plunger; if the opening faces upwards the armature reaches its end position and inductive sensor B4 switches."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-BP-B-BS" ;
    maestro:hasIdentifier ltu:PN_195773 ;
    maestro:providesCapability ltu:OrientationCheckingCapability ;
    maestro:suppliedBy pro:PSU .

pro:DrillingModule a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "Drilling module"@en ;
    maestro:description "Drilling machine M3 (24 V DC, switched by K1) on a DGEL-12 toothed-belt axis driven by gear motor M1 (K3 raise, K4 lower) with micro switches 1B1 (upper) and 1B2 (lower). Simulates polishing of the workpiece hole; the spindle really turns. Drilling machine service life 200 h (data sheet 326395)."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-B-BS" ;
    maestro:hasIdentifier ltu:PN_196974 ;
    maestro:providesCapability ltu:DrillingCapability , ltu:LiftingCapability ;
    maestro:suppliedBy pro:PSU .

pro:ClampingModule a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "Clamping module"@en ;
    maestro:description "Solenoid M4 fixes the workpiece during drilling. No 'clamped' sensor."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-S-BS" ;
    maestro:hasIdentifier ltu:PN_526218 ;
    maestro:providesCapability ltu:ClampingCapability ;
    maestro:suppliedBy pro:PSU .

pro:EjectorModule a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "Electrical sorting gate (ejector)"@en ;
    maestro:description "Solenoid M6 (via series resistor R3 56 Ohm) pushes the finished workpiece to the next station."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-AW-BS" ;
    maestro:hasIdentifier ltu:PN_526873 ;
    maestro:providesCapability ltu:EjectingCapability , ltu:TransferCapability ;
    maestro:suppliedBy pro:PSU ;
    maestro:hasInterface pro:Port_MaterialOut .

pro:Port_MaterialOut a maestro:ExternalInterface ;
    rdfs:label "Material output: transfer position of the electrical ejector"@en ;
    maestro:description "Pick-up position of the downstream station."@en .

pro:ConnectionBoard a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "Connection board with relays K1-K5"@en ;
    maestro:description "Terminal strip XA1, resistors R1 (47 Ohm / 5 W, motor M2) and R3, relays K1 (drill motor), K2 (table, self-holding), K3 (raise), K4 (lower), K5 (stop table in position). The micro switches 1B1/1B2 break the K3/K4 coils, so I3/I4 can only read 1 while O3/O2 is on (reading of the drawing)."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-KBL" ;
    maestro:hasIdentifier ltu:PN_526229 ;
    maestro:providesCapability ltu:StationControlCapability ;
    maestro:suppliedBy pro:PSU .

pro:IOTerminal a maestro:Module ;
    rdfs:label "I/O terminal"@en ;
    maestro:description "Station side of SysLink XMA2: all 8 inputs and 8 outputs used."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP-B-AN-E/A-T" ;
    maestro:hasIdentifier ltu:PN_034035 ;
    maestro:providesCapability ltu:StationControlCapability .

pro:PLCBoard a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "PLC board"@en ;
    maestro:description "Connects to XMA2, XMG1, the power supply and the PC."@en ;
    maestro:model "PLC board (controller not stated)" ;
    maestro:providesCapability ltu:StationControlCapability ;
    maestro:suppliedBy pro:PSU .

pro:ControlConsole a maestro:Module ;
    rdfs:label "Control console"@en ;
    maestro:description "START, STOP, RESET, AUTO/MAN, EMERGENCY-STOP (if available) and the WORKPIECE NOK warning light; connected via XMG1."@en ;
    maestro:providesCapability ltu:OperatorInterfaceCapability .

pro:StationLinkTransmitter a maestro:Module ;
    rdfs:label "StationLink transmitter IP_N_FO"@en ;
    maestro:description "Incoming-material side; signals 'station occupied' to the upstream station (O7)."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-SLS" ;
    maestro:hasIdentifier ltu:PN_196963 ;
    maestro:providesCapability ltu:StationLinkCapability ;
    maestro:hasInterface pro:Port_StationLinkTx .

pro:Port_StationLinkTx a maestro:ExternalInterface ;
    rdfs:label "StationLink transmitter (incoming-material side)"@en .

pro:StationLinkReceiver a maestro:Module ;
    rdfs:label "StationLink receiver IP_FI"@en ;
    maestro:description "Outgoing-material side; reads 'downstream station free' (I7) before each table rotation."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-SLE" ;
    maestro:hasIdentifier ltu:PN_196964 ;
    maestro:providesCapability ltu:StationLinkCapability ;
    maestro:hasInterface pro:Port_StationLinkRx .

pro:Port_StationLinkRx a maestro:ExternalInterface ;
    rdfs:label "StationLink receiver (outgoing-material side)"@en .


#################################################################
# BILL OF MATERIALS
#
# Parts list 526882 (11.11.2002) with the components of the circuit
# diagram below each assembly.
#################################################################

pro:StationType a maestro:ProductType ;
    rdfs:label "Festo MPS Processing station (equipment type)"@en ;
    maestro:manufacturer "Festo Didactic GmbH & Co. KG" ;
    maestro:model "MPS Processing station (BE)" ;
    maestro:description "The station as a Festo product; its bill of materials follows the parts list and the component tables of the documents."@en ;
    maestro:hasIdentifier pro:ID_StationMaterialNo , pro:ID_ManualOrderNo ;
    maestro:hasBOM pro:BOM_IndexingTable ,
              pro:BOM_TestingModule ,
              pro:BOM_DrillingModule ,
              pro:BOM_ClampingModule ,
              pro:BOM_BranchModule ,
              pro:BOM_TerminalBlock ,
              pro:BOM_Relays ,
              pro:BOM_IOTerminal ,
              pro:BOM_ProfilePlate ,
              pro:BOM_Connectors ,
              pro:BOM_MountingSystem ,
              pro:BOM_StationLinkTransmitter ,
              pro:BOM_StationLinkReceiver ,
              pro:BOM_Holder ,
              pro:BOM_Accessories .

