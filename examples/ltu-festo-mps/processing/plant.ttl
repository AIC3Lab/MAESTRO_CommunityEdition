#################################################################
# SIGNALS (DATA POINTS)
#
# Bits, XMA2 pins and BMKs from the electric circuit diagram, pages 4-7.
# Sensor = maestro:Output / maestro:DtdlTelemetry; actuator command = maestro:Input /
# maestro:DtdlProperty.
#################################################################

pro:ID_DI_WorkpieceAvailable_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "I0" .

pro:ID_DI_WorkpieceAvailable_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "13" .

pro:ID_DI_WorkpieceAvailable_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "PART_AV" .

pro:DI_WorkpieceAvailable a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Workpiece available"@en ;
    maestro:description "Capacitive sensor at the material input (retainer 1); detects workpieces independent of colour and material."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:hasIdentifier pro:ID_DI_WorkpieceAvailable_Bit ,
                     pro:ID_DI_WorkpieceAvailable_Pin ,
                     pro:ID_DI_WorkpieceAvailable_BMK .

pro:ID_DI_WorkpieceAtChecking_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "I1" .

pro:ID_DI_WorkpieceAtChecking_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "14" .

pro:ID_DI_WorkpieceAtChecking_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "B1" .

pro:DI_WorkpieceAtChecking a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Workpiece at checking unit"@en ;
    maestro:description "Capacitive sensor at the testing position."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:hasIdentifier pro:ID_DI_WorkpieceAtChecking_Bit ,
                     pro:ID_DI_WorkpieceAtChecking_Pin ,
                     pro:ID_DI_WorkpieceAtChecking_BMK .

pro:ID_DI_WorkpieceAtDrilling_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "I2" .

pro:ID_DI_WorkpieceAtDrilling_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "15" .

pro:ID_DI_WorkpieceAtDrilling_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "B2" .

pro:DI_WorkpieceAtDrilling a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Workpiece at drilling unit"@en ;
    maestro:description "Capacitive sensor at the drilling position."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:hasIdentifier pro:ID_DI_WorkpieceAtDrilling_Bit ,
                     pro:ID_DI_WorkpieceAtDrilling_Pin ,
                     pro:ID_DI_WorkpieceAtDrilling_BMK .

pro:ID_DI_DrillUp_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "I3" .

pro:ID_DI_DrillUp_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "16" .

pro:ID_DI_DrillUp_BMK a maestro:Identifier ;
    maestro:identifierScheme "Festo circuit-diagram equipment designation (BMK)" ;
    maestro:identifierValue "1B1" .

pro:DI_DrillUp a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Drilling unit in upper position"@en ;
    maestro:description "Micro switch NO contact; its common is fed from O3, so it reads 1 only while 'raise' is on (reading of the drawing)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:hasIdentifier pro:ID_DI_DrillUp_Bit , pro:ID_DI_DrillUp_Pin , pro:ID_DI_DrillUp_BMK .

pro:ID_DI_DrillDown_Bit a maestro:Identifier ;
    maestro:identifierScheme "XMA2 bit" ;
    maestro:identifierValue "I4" .

pro:ID_DI_DrillDown_Pin a maestro:Identifier ;
    maestro:identifierScheme "XMA2 pin" ;
    maestro:identifierValue "17" .

