@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix ltu:  <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/shared#> .

#################################################################
# LTU FESTO MPS (HHM-CORE) - SHARED REFERENCE DATA
#
# Source: the LTU use-case documents for the Festo Didactic Modular
# Production System (MPS) - the manuals, circuit diagrams, parts lists,
# data sheets and GRAFCET function charts of the Distributing (648811),
# Testing (648812), Processing (648813) and Handling (655633) stations.
#
# This file holds what the station and line graphs share: LTU and the MPS
# line, capabilities, the SysLink / StationLink protocols, the roles and
# safety rules every manual repeats, the cleaning tasks of the
# maintenance chapters and the Festo component catalogue used by the
# stations' bills of materials. Individuals of HHM-Core classes only;
# no class or property is declared here.
#################################################################

<https://w3id.org/maestro/hhm/examples/ltu-festo-mps/shared> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/shared/0.1.0> ;
    rdfs:label "MAESTRO HHM-Core example: LTU Festo MPS - shared reference data"@en ;
    owl:imports <https://w3id.org/maestro/hhm> ;
    owl:versionInfo "0.1.0" ;
    rdfs:comment "LTU, the four-station Festo MPS line, shared capabilities, protocols, roles, safety rules, maintenance tasks and the Festo component catalogue of the LTU use case. Individuals of HHM-Core classes only."@en .


#################################################################
# LTU AND THE MPS LINE (ISA-95 hierarchy)
#
# The documents are Festo manuals and do not name LTU, a room or a line
# layout. The line is the four stations in the Festo station numbering
# (1 Distributing, 2 Testing, 3 Processing, 4 Handling); each manual's
# combination matrix allows exactly these neighbours.
#################################################################

ltu:LTU a maestro:Enterprise , maestro:Actor ;
    rdfs:label "Luleå University of Technology (LTU)"@en ;
    maestro:description "Owner and operator of the Festo MPS stations of the use case. Named by the use case, not by the Festo documents."@en .

ltu:LTUSite a maestro:Site ;
    rdfs:label "LTU, Luleå"@en ;
    maestro:partOfEnterprise ltu:LTU .

ltu:MPSLab a maestro:Area ;
    rdfs:label "MPS laboratory (room not stated)"@en ;
    maestro:partOfSite ltu:LTUSite .

ltu:MPSLine a maestro:WorkCenter ;
    rdfs:label "Festo MPS line: Distributing - Testing - Processing - Handling"@en ;
    maestro:description "Line of four Festo Didactic MPS stations linked by optical StationLink (1-bit link). Order assumed from the Festo station numbering 1-4; the LTU layout itself is not stated in the documents."@en ;
    maestro:partOfArea ltu:MPSLab .


#################################################################
# CAPABILITIES
#
# What the station modules can do, named after the function texts of
# the four manuals. Every maestro:Module of a station provides at least one.
#################################################################

ltu:FeedingCapability a maestro:Capability ;
    rdfs:label "Feeding"@en ;
    maestro:description "Separate workpieces one at a time from a stack magazine and make them available at a transfer point (feed device in the sense of VDI 3240, as the Distributing manual calls it)."@en .

ltu:TransferCapability a maestro:Capability ;
    rdfs:label "Workpiece transfer"@en ;
    maestro:description "Move a workpiece from one position to another: swivel arm, linear axis or rotary indexing table."@en .

ltu:VacuumGrippingCapability a maestro:Capability ;
    rdfs:label "Vacuum gripping"@en ;
    maestro:description "Hold a workpiece with a suction cup and confirm the hold with a vacuum switch."@en .

ltu:MechanicalGrippingCapability a maestro:Capability ;
    rdfs:label "Mechanical gripping"@en ;
    maestro:description "Hold a workpiece between the jaws of a pneumatic parallel gripper."@en .

ltu:LiftingCapability a maestro:Capability ;
    rdfs:label "Lifting"@en ;
    maestro:description "Move a workpiece or tool vertically between two end positions."@en .

ltu:PresenceSensingCapability a maestro:Capability ;
    rdfs:label "Workpiece presence sensing"@en ;
    maestro:description "Detect whether a workpiece is present at a position (capacitive, diffuse or through-beam sensor)."@en .

ltu:MaterialRecognitionCapability a maestro:Capability ;
    rdfs:label "Material / colour recognition"@en ;
    maestro:description "Tell black workpieces from red and metallic (silver) ones with optical and capacitive sensors."@en .

ltu:HeightMeasuringCapability a maestro:Capability ;
    rdfs:label "Height measuring"@en ;
    maestro:description "Measure the workpiece height with an analogue displacement sensor and compare it with a window."@en .

ltu:OrientationCheckingCapability a maestro:Capability ;
    rdfs:label "Orientation checking"@en ;
    maestro:description "Check that the workpiece opening faces upwards with a solenoid plunger and an inductive sensor."@en .

ltu:EjectingCapability a maestro:Capability ;
    rdfs:label "Ejecting"@en ;
    maestro:description "Push a workpiece off a carrier onto a slide or towards the next station."@en .

ltu:SlideConveyingCapability a maestro:Capability ;
    rdfs:label "Slide conveying and buffering"@en ;
    maestro:description "Convey workpieces on an inclined (optionally air-cushioned) slide and hold a few of them."@en .

ltu:SortingCapability a maestro:Capability ;
    rdfs:label "Sorting"@en ;
    maestro:description "Route workpieces to different outlets by a test result or a material class."@en .

ltu:IndexingCapability a maestro:Capability ;
    rdfs:label "Rotary indexing"@en ;
    maestro:description "Rotate a six-position indexing table by 60 degrees and stop it in position."@en .

ltu:ClampingCapability a maestro:Capability ;
    rdfs:label "Clamping"@en ;
    maestro:description "Fix a workpiece in place during machining."@en .

ltu:DrillingCapability a maestro:Capability ;
    rdfs:label "Drilling (simulated hole polishing)"@en ;
    maestro:description "Lower a running drilling machine onto the workpiece hole and raise it again. The Processing manual says the polishing of the hole is only simulated, for safety."@en .

ltu:PneumaticActuationCapability a maestro:Capability ;
    rdfs:label "Pneumatic actuation"@en ;
    maestro:description "Supply and switch compressed air for the station actuators: service unit and CPV valve terminal."@en .

ltu:StationControlCapability a maestro:Capability ;
    rdfs:label "Station control and I/O"@en ;
    maestro:description "Read station sensors and drive station actuators: PLC board and I/O terminal."@en .

ltu:OperatorInterfaceCapability a maestro:Capability ;
    rdfs:label "Operator interface"@en ;
    maestro:description "Push buttons, key switch and indicator lights of the control console."@en .

ltu:StationLinkCapability a maestro:Capability ;
    rdfs:label "StationLink signalling"@en ;
    maestro:description "Exchange the optical 1-bit busy / free signal with a neighbouring station."@en .


#################################################################
# PROTOCOLS
#
# The stations have no network interface in the documents. The PLC board
# reaches the station over parallel SysLink cables (XMA2 digital, XMA3
# analogue on the Testing station, XMG1 control console); neighbouring
# stations exchange one bit over the optical StationLink.
#################################################################

ltu:SysLinkDigitalIO a maestro:Protocol ;
    rdfs:label "Festo SysLink parallel digital I/O (24 V DC)"@en ;
    maestro:description "24-pin SysLink connector carrying 8 digital inputs (pins 13-20), 8 digital outputs (pins 1-8) and the 24 V supplies of sensors (24VB/0VB) and actuators (24VA/0VA). Used by XMA2 (station) and XMG1 (control console)."@en .

ltu:SysLinkAnalogue a maestro:Protocol ;
    rdfs:label "Festo SysLink analogue (0-10 V)"@en ;
    maestro:description "15-pin SysLink analogue connector XMA3; the Testing station puts the height process value on UE1 (pin 8)."@en .

ltu:StationLinkProtocol a maestro:Protocol ;
    rdfs:label "Festo StationLink optical 1-bit link"@en ;
    maestro:description "Through-beam transmitter on the incoming-material side and receiver on the outgoing-material side. By switching its transmitter on or off a station tells its upstream station whether it is ready to receive a workpiece or busy. The light/dark polarity is not stated."@en .


#################################################################
# ENERGY
#
# Compressed air reuses maestro:CompressedAir; each station has its own 24 V
# DC supply (station files).
#################################################################


#################################################################
# ROLES, SAFETY RULES AND HAZARDS
#
# The four manuals repeat the same safety chapter. Station-specific
# constraints, hazards and safety functions are in the station files and
# add themselves to ltu:MPSSafetyRules.
#################################################################

ltu:InstructorRole a maestro:Role ;
    rdfs:label "Instructor"@en ;
    maestro:description "Supervises trainees working on the stations."@en .

ltu:TraineeRole a maestro:Role ;
    rdfs:label "Trainee"@en ;
    maestro:description "Works on the stations under the supervision of an instructor; the stations are intended only for vocational and further training in automation and technology."@en .

ltu:MPSSafetyRules a maestro:Policy ;
    rdfs:label "MPS notes on safety (station manuals)"@en ;
    maestro:description "Rules of the 'Notes on safety' chapter that all four station manuals share."@en ;
    maestro:contains ltu:C_Supervision ,
                ltu:C_MaxPressure ,
                ltu:C_LowVoltage ,
                ltu:C_WirePowerOff ,
                ltu:C_AirAfterTubing ,
                ltu:C_NoDisconnectUnderPressure ,
                ltu:C_InterventionAtRest ,
                ltu:C_SecureMounting ;
    maestro:hasPermission ltu:Perm_TraineeRunsStations ;
    maestro:requiresPermission ltu:Perm_TraineeRunsStations .

ltu:Perm_TraineeRunsStations a maestro:Permission ;
    rdfs:label "Trainees may run the station cycles"@en ;
    maestro:grantedTo ltu:TraineeRole ;
    maestro:action maestro:Invoke ;
    maestro:description "Targets are the station cycle skills, added by the station files."@en .

ltu:C_Supervision a maestro:Constraint ;
    rdfs:label "Trainees work only under the supervision of an instructor"@en ;
    maestro:expression "role == Trainee implies instructor present" ;
    maestro:constrains ltu:Perm_TraineeRunsStations .

ltu:C_MaxPressure a maestro:Constraint ;
    rdfs:label "Do not exceed the permissible pressure of 8 bar (800 kPa)"@en ;
    maestro:expression "supplyPressure <= 8 bar" ;
    maestro:constrains ltu:MPSLine .

ltu:C_LowVoltage a maestro:Constraint ;
    rdfs:label "Use only low voltages of up to 24 V DC"@en ;
    maestro:expression "supplyVoltage <= 24 V DC" ;
    maestro:constrains ltu:MPSLine .

ltu:C_WirePowerOff a maestro:Constraint ;
    rdfs:label "Make or break electrical connections only with the power switched off"@en ;
    maestro:expression "rewiring implies power == off" ;
    maestro:constrains ltu:MPSLine .

ltu:C_AirAfterTubing a maestro:Constraint ;
    rdfs:label "Switch on compressed air only after all tubing is connected and secured"@en ;
    maestro:expression "airOn implies allTubingSecured" ;
    maestro:constrains ltu:MPSLine .

ltu:C_NoDisconnectUnderPressure a maestro:Constraint ;
    rdfs:label "Do not disconnect air lines under pressure"@en ;
    maestro:expression "disconnectTubing implies pressure == 0" ;
    maestro:constrains ltu:MPSLine .

ltu:C_InterventionAtRest a maestro:Constraint ;
    rdfs:label "No manual intervention unless the machine is at rest"@en ;
    maestro:expression "manualIntervention implies stationAtRest" ;
    maestro:constrains ltu:MPSLine .

ltu:C_SecureMounting a maestro:Constraint ;
    rdfs:label "Mount all components securely on the profile plate"@en ;
    maestro:expression "allComponentsSecured" ;
    maestro:constrains ltu:MPSLine .

ltu:R_Injury a maestro:Risk ;
    rdfs:label "Physical or fatal injury to the user or third parties"@en ;
    maestro:description "Residual risk the manuals name for use of the stations."@en .

ltu:R_Damage a maestro:Risk ;
    rdfs:label "Damage to the machinery or other material property"@en ;
    maestro:description "Residual risk the manuals name for use of the stations."@en .

ltu:H_CylinderMotionOnAirOn a maestro:Hazard ;
    rdfs:label "Cylinders advance or retract when compressed air is switched on"@en ;
    maestro:description "Manual safety chapter: 'take care when switching on the compressed air; cylinders may advance or retract'."@en ;
    maestro:increases ltu:R_Injury .

ltu:H_MovingStation a maestro:Hazard ;
    rdfs:label "Manual intervention while the station is moving"@en ;
    maestro:increases ltu:R_Injury .

ltu:H_Overpressure a maestro:Hazard ;
    rdfs:label "Supply pressure above 8 bar"@en ;
    maestro:increases ltu:R_Damage .

ltu:M_AirAfterTubing a maestro:Mitigation ;
    rdfs:label "Switch on air only after all tubing is connected and secured"@en ;
    maestro:reduces ltu:R_Injury .

ltu:M_InterventionAtRest a maestro:Mitigation ;
    rdfs:label "Intervene only when the station is at rest; stop with STOP or EMERGENCY-STOP"@en ;
    maestro:reduces ltu:R_Injury .

ltu:M_Supervision a maestro:Mitigation ;
    rdfs:label "Instructor supervision of trainees"@en ;
    maestro:reduces ltu:R_Injury .

ltu:M_ServiceUnitSetting a maestro:Mitigation ;
    rdfs:label "Set the service unit to the station's operating pressure"@en ;
    maestro:reduces ltu:R_Damage .


#################################################################
# MAINTENANCE TASKS
#
# All four manuals: 'largely maintenance-free'; clean at regular
# intervals
# (no interval is given) with a soft lint-free cloth or brush, no
# aggressive or abrasive cleaning agents. Station plans are in the
# station files.
#################################################################

ltu:MT_CleanOptics a maestro:MaintenanceTask ;
    rdfs:label "Clean lenses of optical sensors, fibre optics and reflectors (at regular intervals)"@en .

ltu:MT_CleanProximitySensors a maestro:MaintenanceTask ;
    rdfs:label "Clean the active surface of the proximity sensors (at regular intervals)"@en .

ltu:MT_CleanStation a maestro:MaintenanceTask ;
    rdfs:label "Clean the entire station (at regular intervals)"@en .

ltu:MT_VisualCheck a maestro:MaintenanceTask ;
    rdfs:label "Visual check of electrical connections, compressed-air connections and mechanical components before each commissioning"@en .


