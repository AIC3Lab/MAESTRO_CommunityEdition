tes:AI_Height a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Workpiece height, process value (analogue)"@en ;
    maestro:description "Wiper of linear potentiometer R1 to comparator AIN and XMA3 UE1. The sensor gives 0-25 mm as 0-100 % of the 10 V reference; scaling at the PLC is not stated."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/V"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:minValue 0.0 ;
    maestro:maxValue 10.0 ;
    maestro:hasIdentifier tes:ID_AI_Height_Bit , tes:ID_AI_Height_Pin , tes:ID_AI_Height_BMK .

tes:CC_Start a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "START pushbutton (illuminated)"@en ;
    maestro:description "Starts the sequence; also acknowledges an error after the operator has removed its cause. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:CC_Stop a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "STOP pushbutton"@en ;
    maestro:description "Interrupts the sequence at any time. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:CC_Reset a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "RESET pushbutton (illuminated)"@en ;
    maestro:description "The reset sequence is prompted by the illuminated RESET pushbutton and runs when it is pressed. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:CC_AutoMan a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "Key-operated switch AUTO/MAN"@en ;
    maestro:description "AUTO = continuous cycle, MAN = individual cycle. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:CC_EmergencyStop a maestro:ParameterDef , maestro:DtdlTelemetry ;
    rdfs:label "EMERGENCY-STOP pushbutton (if available)"@en ;
    maestro:description "Interrupts the sequence at any time; must be released before a program is loaded. Whether it is a PLC input or a hard-wired safety circuit is not stated. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:CC_StartLamp a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "'start' indicator light"@en ;
    maestro:description "Lamp of the START pushbutton; on while the station waits for START. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:CC_ResetLamp a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "'reset' indicator light"@en ;
    maestro:description "Lamp of the RESET pushbutton; on while the station is not reset. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:CC_ColourLamp a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Warning light COLOUR"@en ;
    maestro:description "Manual: off for black, on for red/silver workpieces in the Recognition module. The GRAFCET turns its 'material' light on for black (steps 9/10); the documents disagree. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:T_RecognitionDwell a maestro:ParameterDef ;
    rdfs:label "Recognition dwell time 3 s (3s/X9, 3s/X10)"@en ;
    maestro:description "GRAFCET timer before the lifting cylinder rises."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/SEC"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 3.0 ;
    maestro:maxValue 3.0 .

tes:T_MeasuringDwell a maestro:ParameterDef ;
    rdfs:label "Measuring dwell time 2 s (2s/X12)"@en ;
    maestro:description "GRAFCET timer before the height result is evaluated."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/SEC"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 2.0 ;
    maestro:maxValue 2.0 .

tes:T_AirSlideOn a maestro:ParameterDef ;
    rdfs:label "Air slide on time 3 s (3s/X14)"@en ;
    maestro:description "Air cushion stays on 3 s after ejection, or until the downstream station is occupied."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/SEC"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 3.0 ;
    maestro:maxValue 3.0 .

tes:CFG_ComparatorLevel1 a maestro:ParameterDef ;
    rdfs:label "Comparator threshold LEVEL1 (lower)"@en ;
    maestro:description "Set with the red 25 mm workpiece at about the 5th scale mark so that MID lights; no value in mm or V is stated."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/V"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:CFG_ComparatorLevel2 a maestro:ParameterDef ;
    rdfs:label "Comparator threshold LEVEL2 (upper)"@en ;
    maestro:description "Set at about the 6th scale mark; no value in mm or V is stated."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/V"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .


#################################################################
# I/O PATH: SYSLINK ENDPOINTS AND DATA INTERFACES
#
# XMA2 digital, XMA3 analogue (height), XMG1 console. The URNs only name
# the connectors.
#################################################################

tes:XMA2 a maestro:Endpoint ;
    rdfs:label "Testing station: SysLink station connector XMA2 (I/O terminal)"@en ;
    maestro:address "urn:ltu:festo-mps:testing:XMA2" ;
    maestro:description "24-pin SysLink plug between the station I/O terminal and the PLC board; parallel wiring, no network address. The URN only names the connector."@en ;
    maestro:usesProtocol ltu:SysLinkDigitalIO .

tes:XMG1 a maestro:Endpoint ;
    rdfs:label "Testing station: SysLink control-console connector XMG1"@en ;
    maestro:address "urn:ltu:festo-mps:testing:XMG1" ;
    maestro:description "SysLink plug between the control console and the PLC board. The URN only names the connector."@en ;
    maestro:usesProtocol ltu:SysLinkDigitalIO .

tes:XMA3 a maestro:Endpoint ;
    rdfs:label "Testing station: SysLink analogue connector XMA3"@en ;
    maestro:address "urn:ltu:festo-mps:testing:XMA3" ;
    maestro:description "15-pin SysLink analogue terminal; UE1 (pin 8) carries the height process value. The URN only names the connector."@en ;
    maestro:usesProtocol ltu:SysLinkAnalogue .

tes:StationIO a maestro:DtdlInterface ;
    rdfs:label "Testing station I/O image (XMA2)"@en ;
    maestro:description "Digital inputs I0-I7 and outputs O0-O3, O7."@en ;
    maestro:hasTelemetry tes:DI_WorkpieceAvailable ,
                    tes:DI_NotBlack ,
                    tes:DI_SafetyLightBarrier ,
                    tes:DI_HeightOK ,
                    tes:DI_LiftRaised ,
                    tes:DI_LiftLowered ,
                    tes:DI_EjectorRetracted ,
                    tes:DI_DownstreamFree ;
    maestro:hasProperty tes:DO_LowerLift ,
                   tes:DO_RaiseLift ,
                   tes:DO_ExtendEjector ,
                   tes:DO_AirSlideOn ,
                   tes:DO_StationOccupied ;
    maestro:exposedVia tes:XMA2 .

tes:AnalogueIO a maestro:DtdlInterface ;
    rdfs:label "Testing station analogue height value (XMA3)"@en ;
    maestro:description "Analogue height for a PLC with analogue processing (S7-313C analogue variant, projects 02PR_AS_Analog / 02PR_KFA_Analog)."@en ;
    maestro:hasTelemetry tes:AI_Height ;
    maestro:exposedVia tes:XMA3 .

tes:ConsoleIO a maestro:DtdlInterface ;
    rdfs:label "Testing station control console (XMG1)"@en ;
    maestro:description "Operator signals of the control console."@en ;
    maestro:hasTelemetry tes:CC_Start ,
                    tes:CC_Stop ,
                    tes:CC_Reset ,
                    tes:CC_AutoMan ,
                    tes:CC_EmergencyStop ;
    maestro:hasProperty tes:CC_StartLamp , tes:CC_ResetLamp , tes:CC_ColourLamp ;
    maestro:exposedVia tes:XMG1 .

tes:ControlService a maestro:SkillService ;
    rdfs:label "Testing station PLC program"@en ;
    maestro:description "The station manual offers Siemens S7-313C / 313C-2DP / 314 / 315-2DP (STEP7), Festo FEC FC640 / IPC HC02 / HC20 (FST 4.02), Allen-Bradley MicroLogix 1500 (RSLogix 500) and Mitsubishi FX1N (GX IEC Developer) controllers with a ready program. Which controller and program LTU runs is not stated. Program names on the CD: 02PR_AS / 02PR_KFA (S7), 02PR_AS_Analog / 02PR_KFA_Analog (S7-313C analogue), 02PR_FEC, 02_PR_K (ML1500), 02_PR_AS (FX1N)."@en ;
    maestro:exposesInterface tes:StationIO , tes:AnalogueIO , tes:ConsoleIO .


#################################################################
# SKILLS
#################################################################

tes:ResetStation a maestro:AtomicSkill ;
    rdfs:label "Reset to initial position"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "GRAFCET steps 3-5: move to the initial position, eject a workpiece left on the lifting platform, set flag 'reset finished'."@en ;
    maestro:requiresCapability ltu:StationControlCapability ;
    maestro:hasParameterDef tes:CC_Reset ,
                       tes:DI_SafetyLightBarrier ,
                       tes:DI_LiftLowered ,
                       tes:DI_EjectorRetracted ;
    maestro:hasPrecondition tes:Pre_ResetStation ;
    maestro:hasPostcondition tes:Post_ResetStation .

tes:Pre_ResetStation a maestro:Precondition ;
    rdfs:label "RESET pressed and safety light barrier unbroken"@en ;
    maestro:expression "CC_Reset == 1 && working area free (DI_SafetyLightBarrier)" .

tes:Post_ResetStation a maestro:Postcondition ;
    rdfs:label "Initial position: lifting cylinder lowered, ejecting cylinder retracted, air slide off"@en ;
    maestro:expression "DI_LiftLowered == 1 && DI_EjectorRetracted == 1 && DO_AirSlideOn == 0" .

tes:SwitchIndicatorLight a maestro:AtomicSkill ;
    rdfs:label "Switch indicator light"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Turn the 'reset', 'start' or COLOUR ('material') light on or off."@en ;
    maestro:requiresCapability ltu:OperatorInterfaceCapability ;
    maestro:hasParameterDef tes:CC_StartLamp , tes:CC_ResetLamp , tes:CC_ColourLamp .

tes:SetStationLinkSignal a maestro:AtomicSkill ;
    rdfs:label "Signal 'station occupied' / 'not occupied'"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Switch the StationLink transmitter towards the upstream station."@en ;
    maestro:requiresCapability ltu:StationLinkCapability ;
    maestro:hasParameterDef tes:DO_StationOccupied .

tes:DetectMaterial a maestro:AtomicSkill ;
    rdfs:label "Detect workpiece and material class"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Read PART_AV and B2: black if PART_AV and not B2, red/silver if both. Silver and red are not told apart."@en ;
    maestro:requiresCapability ltu:PresenceSensingCapability , ltu:MaterialRecognitionCapability ;
    maestro:hasParameterDef tes:DI_WorkpieceAvailable , tes:DI_NotBlack , tes:T_RecognitionDwell ;
    maestro:hasPrecondition tes:Pre_DetectMaterial ;
    maestro:hasPostcondition tes:Post_DetectMaterial .

tes:Pre_DetectMaterial a maestro:Precondition ;
    rdfs:label "Workpiece available"@en ;
    maestro:expression "DI_WorkpieceAvailable == 1" .

tes:Post_DetectMaterial a maestro:Postcondition ;
    rdfs:label "Material class known"@en ;
    maestro:expression "black := DI_WorkpieceAvailable && !DI_NotBlack" .

tes:RaiseLiftingCylinder a maestro:AtomicSkill ;
    rdfs:label "Raise lifting cylinder"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Lift the workpiece to the Measuring module."@en ;
    maestro:requiresCapability ltu:LiftingCapability ;
    maestro:hasParameterDef tes:DO_RaiseLift , tes:DI_LiftRaised , tes:DI_SafetyLightBarrier ;
    maestro:hasPrecondition tes:Pre_RaiseLiftingCylinder ;
    maestro:hasPostcondition tes:Post_RaiseLiftingCylinder .

tes:Pre_RaiseLiftingCylinder a maestro:Precondition ;
    rdfs:label "Working area free"@en ;
    maestro:expression "safety light barrier unbroken (DI_SafetyLightBarrier)" .

tes:Post_RaiseLiftingCylinder a maestro:Postcondition ;
    rdfs:label "Lifting cylinder raised"@en ;
    maestro:expression "DI_LiftRaised == 1" .

tes:LowerLiftingCylinder a maestro:AtomicSkill ;
    rdfs:label "Lower lifting cylinder"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Lower the lifting platform to the retainer level."@en ;
    maestro:requiresCapability ltu:LiftingCapability ;
    maestro:hasParameterDef tes:DO_LowerLift , tes:DI_LiftLowered ;
    maestro:hasPostcondition tes:Post_LowerLiftingCylinder .

tes:Post_LowerLiftingCylinder a maestro:Postcondition ;
    rdfs:label "Lifting cylinder lowered"@en ;
    maestro:expression "DI_LiftLowered == 1" .

tes:MeasureHeight a maestro:AtomicSkill ;
    rdfs:label "Measure workpiece height"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "GRAFCET step 12 (empty step 'measure height'): wait 2 s and evaluate the comparator output; the analogue value is on XMA3."@en ;
    maestro:requiresCapability ltu:HeightMeasuringCapability ;
    maestro:hasParameterDef tes:DI_HeightOK ,
                       tes:AI_Height ,
                       tes:T_MeasuringDwell ,
                       tes:CFG_ComparatorLevel1 ,
                       tes:CFG_ComparatorLevel2 ;
    maestro:hasPrecondition tes:Pre_MeasureHeight ;
    maestro:hasPostcondition tes:Post_MeasureHeight .

tes:Pre_MeasureHeight a maestro:Precondition ;
    rdfs:label "Lifting cylinder raised"@en ;
    maestro:expression "DI_LiftRaised == 1" .

tes:Post_MeasureHeight a maestro:Postcondition ;
    rdfs:label "Height result known"@en ;
    maestro:expression "heightOk := DI_HeightOK after 2 s" .

tes:EjectWorkpiece a maestro:AtomicSkill ;
    rdfs:label "Eject workpiece"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Extend and retract the ejecting cylinder: in the upper position onto the air cushioned slide, in the lower position onto the lower slide."@en ;
    maestro:requiresCapability ltu:EjectingCapability ;
    maestro:hasParameterDef tes:DO_ExtendEjector , tes:DI_EjectorRetracted ;
    maestro:hasPostcondition tes:Post_EjectWorkpiece .

tes:Post_EjectWorkpiece a maestro:Postcondition ;
    rdfs:label "Workpiece ejected"@en ;
    maestro:expression "DI_EjectorRetracted == 1 after the extend stroke" .

tes:SwitchAirSlide a maestro:AtomicSkill ;
    rdfs:label "Switch air cushioned slide"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Turn the air cushion of the upper slide on for the hand-over and off again."@en ;
    maestro:requiresCapability ltu:SlideConveyingCapability ;
    maestro:hasParameterDef tes:DO_AirSlideOn , tes:T_AirSlideOn .

tes:TestWorkpiece a maestro:CompositeSkill ;
    rdfs:label "Test workpiece (station cycle)"@en ;
    maestro:version "DE 01/04" ;
    maestro:description "Detect the material class, lift and measure the height, then pass a good workpiece over the air cushioned slide to the downstream station or reject it onto the lower slide (manual section 5, GRAFCET steps 8-18)."@en ;
    maestro:hasSubSkillLink tes:DetectMaterial ,
                       tes:RaiseLiftingCylinder ,
                       tes:MeasureHeight ,
                       tes:SwitchAirSlide ,
                       tes:EjectWorkpiece ,
                       tes:LowerLiftingCylinder ;
    maestro:requiresCapability ltu:MaterialRecognitionCapability ,
                          ltu:HeightMeasuringCapability ,
                          ltu:LiftingCapability ,
                          ltu:EjectingCapability ,
                          ltu:SortingCapability ;
    maestro:hasPrecondition tes:Pre_TestWorkpiece ;
    maestro:hasPostcondition tes:Post_TestWorkpiece ;
    maestro:hasInterfaceContract tes:StationIO , tes:AnalogueIO .

tes:Pre_TestWorkpiece a maestro:Precondition ;
    rdfs:label "Workpiece in the retainer, working area free, START pressed"@en ;
    maestro:expression "DI_WorkpieceAvailable == 1 && working area free && CC_Start == 1" .

tes:Post_TestWorkpiece a maestro:Postcondition ;
    rdfs:label "Good workpiece on the air cushioned slide or rejected workpiece on the lower slide"@en ;
    maestro:expression "heightOk ? workpiece passed downstream : workpiece on lower slide" .


#################################################################
# SAFETY
#################################################################

ltu:Perm_TraineeRunsStations maestro:target tes:TestWorkpiece .

tes:EmergencyStop a maestro:EmergencyStop ;
    rdfs:label "EMERGENCY-STOP pushbutton, Testing station control console"@en ;
    maestro:description "The manual names the EMERGENCY-STOP pushbutton '(if available)'; together with STOP it interrupts the sequence at any time and must be released before a program is loaded. Safety category, performance level and wiring are not stated."@en ;
    maestro:mitigates ltu:H_MovingStation .

tes:H_LiftInWorkingArea a maestro:Hazard ;
    rdfs:label "Lifting cylinder moves while the working area above the retainer is occupied"@en ;
    maestro:description "The Lifting module moves the platform up to the Measuring module through this area."@en ;
    maestro:increases ltu:R_Injury .

tes:SF_SafetyLightBarrier a maestro:SafetyFunction ;
    rdfs:label "Safety light barrier B4 blocks the lifting cylinder"@en ;
    maestro:description "Retro-reflective sensor B4 prevents the lifting cylinder from moving when the working space is occupied; the reset also requires it unbroken. Whether B4 is a certified protective device is not stated."@en ;
    maestro:mitigates tes:H_LiftInWorkingArea .


#################################################################
# MAINTENANCE
#
# Plus the cylinder and CPV notes of the operating instructions 391172
# and 165200. Displacement sensor service life 100 million operations
# (data sheet 326498).
#################################################################

tes:MT_WipePistonRods a maestro:MaintenanceTask ;
    rdfs:label "Remove dirt from the cylinder piston rods with a soft cloth (cylinders have service-life lubrication)"@en .

tes:MT_CleanCPVSilencer a maestro:MaintenanceTask ;
    rdfs:label "Clean or replace the CPV surface-mounted silencer when dirt raises the exhaust pressure"@en .

tes:MaintenancePlan a maestro:MaintenancePlan ;
    rdfs:label "Testing station care plan (manual chapter 'Maintenance')"@en ;
    maestro:description "Only 'at regular intervals' is given; no numeric interval is stated."@en ;
    maestro:planForAsset tes:RecognitionModule ,
                    tes:LiftingModule ,
                    tes:MeasuringModule ,
                    tes:AirSlideModule ,
                    tes:SafetyLightBarrier ,
                    tes:ValveTerminal ,
                    tes:StationLinkTransmitter ,
                    tes:StationLinkReceiver ;
    maestro:hasTask ltu:MT_CleanOptics ,
               ltu:MT_CleanProximitySensors ,
               ltu:MT_CleanStation ,
               ltu:MT_VisualCheck ,
               tes:MT_WipePistonRods ,
               tes:MT_CleanCPVSilencer .
