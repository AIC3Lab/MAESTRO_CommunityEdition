@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix ltu:  <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/shared#> .
@prefix tes:  <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/testing#> .

#################################################################
# LTU FESTO MPS - TESTING STATION - PLANT (DESIGN TIME)
#
# Sources (FESTO CD/02_Testing): 648812_Manual_Testing (DE/EN 04/06
# R2.2),
# Electric_Circuit_Diagram_Testing (drawing 195781, 05.04.06),
# Pneumatic_Circuit_Diagram_Testing, 526881_Parts_list_Testing, assembly
# instructions, data sheets, operating instructions, 02_Testing_GRAFCET.
#
# I/O bits, XMA2 pins and BMKs are from the electric circuit diagram.
# Documents disagree on: 7 digital inputs in the technical data vs 8
# wired;
# BMK 3A1 = comparator (electric) and air slide (pneumatic); the COLOUR
# lamp polarity (manual: off for black; GRAFCET: on for black).
#################################################################

<https://w3id.org/maestro/hhm/examples/ltu-festo-mps/testing> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/testing/0.1.0> ;
    rdfs:label "MAESTRO HHM-Core example: LTU Festo MPS - Testing station (plant)"@en ;
    owl:imports <https://w3id.org/maestro/hhm/examples/ltu-festo-mps/shared> ;
    owl:versionInfo "0.1.0" ;
    rdfs:comment "The Festo MPS Testing station of the LTU line: modules, parts list, I/O allocation, skills, safety and care. The GRAFCET control sequence is in product.ttl. Built from manual 648812, the electric and pneumatic circuit diagrams, parts list 526881, data sheets and the GRAFCET."@en .


#################################################################
# STATION
#
# Material number 526881 (parts list) and manual order number 648812. The
# circuit wires 8 inputs although the technical data says 7.
#################################################################

tes:ID_StationMaterialNo a maestro:Identifier ;
    maestro:identifierScheme "Festo material number (station)" ;
    maestro:identifierValue "526881" .

tes:ID_ManualOrderNo a maestro:Identifier ;
    maestro:identifierScheme "Festo order number (technical documentation)" ;
    maestro:identifierValue "648812" .

tes:Station a maestro:Station , maestro:WorkUnit ;
    rdfs:label "Testing station"@en ;
    maestro:description "Station 2 (PR) of the MPS. Determines the material characteristics of a workpiece (black vs red/silver), checks its height and either rejects it or passes it to the next station: the Recognition module detects the workpiece and its colour class, the Lifting module raises it to the Measuring module (analogue height sensor and comparator), and the ejecting cylinder pushes good workpieces onto the upper air cushioned slide and rejected ones onto the lower slide."@en ;
    maestro:manufacturer "Festo Didactic GmbH & Co. KG" ;
    maestro:model "MPS Testing station (PR)" ;
    maestro:hasIdentifier tes:ID_StationMaterialNo , tes:ID_ManualOrderNo ;
    maestro:partOfWorkCenter ltu:MPSLine ;
    maestro:hasModule tes:RecognitionModule ,
                 tes:LiftingModule ,
                 tes:MeasuringModule ,
                 tes:AirSlideModule ,
                 tes:SlideModule ,
                 tes:SafetyLightBarrier ,
                 tes:ValveTerminal ,
                 tes:ServiceUnit ,
                 tes:IOTerminal ,
                 tes:PLCBoard ,
                 tes:ControlConsole ,
                 tes:StationLinkTransmitter ,
                 tes:StationLinkReceiver ;
    maestro:hasParameterDef tes:TD_OperatingPressure ,
                       tes:TD_MaxPressure ,
                       tes:TD_AirConsumption ,
                       tes:TD_SupplyVoltage ,
                       tes:TD_SupplyCurrent ,
                       tes:TD_DigitalInputs ,
                       tes:TD_DigitalOutputs ,
                       tes:TD_AirSlideCapacity ,
                       tes:TD_LowerSlideCapacity ,
                       tes:TD_MeasuringModuleHeight .

ltu:LTU maestro:operates tes:Station .

tes:PSU a maestro:EnergySource ;
    rdfs:label "24 V DC power supply unit, Testing station"@en ;
    maestro:description "Power supply unit 24 V DC, 4.5 A; feeds the whole station through the PLC board."@en .


#################################################################
# TECHNICAL DATA
#
# Static values from the manual's technical-data table and commissioning
# section.
#################################################################

tes:TD_OperatingPressure a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Operating pressure 6 bar"@en ;
    maestro:description "Service unit setting. Operating pressure 6 bar (600 kPa)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/BAR"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 6.0 ;
    maestro:maxValue 6.0 .

tes:TD_MaxPressure a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Maximum permissible pressure 8 bar"@en ;
    maestro:description "'Do not exceed' limit of the safety chapter."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/BAR"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:maxValue 8.0 .

tes:TD_AirConsumption a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Compressed-air supply, suction capacity approx. 50 l/min"@en ;
    maestro:description "Compressed-air supply named for commissioning (approximate value)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/L-PER-MIN"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:maxValue 50.0 .

tes:TD_SupplyVoltage a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Supply voltage 24 V DC"@en ;
    maestro:description "Power supply unit 24 V DC; the whole station is supplied through the PLC board."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/V"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 24.0 ;
    maestro:maxValue 24.0 .

tes:TD_SupplyCurrent a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Supply current 4.5 A"@en ;
    maestro:description "Technical data 4.5 A; section 'voltage supply' says max. 5 A."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/A"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:maxValue 4.5 .

tes:TD_DigitalInputs a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Digital inputs: 7"@en ;
    maestro:description "Number of digital inputs in the technical-data table."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 7.0 ;
    maestro:maxValue 7.0 .

tes:TD_DigitalOutputs a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Digital outputs: 5"@en ;
    maestro:description "Number of digital outputs in the technical-data table."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 5.0 ;
    maestro:maxValue 5.0 .

tes:TD_AirSlideCapacity a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Air cushioned slide capacity: 5 workpieces"@en ;
    maestro:description "With the mechanical stopper fitted."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:maxValue 5.0 .

tes:TD_LowerSlideCapacity a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Lower slide capacity: 4 workpieces"@en ;
    maestro:description "Slide module 210 with stopper fitted; receives rejected workpieces."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:maxValue 4.0 .

tes:TD_MeasuringModuleHeight a maestro:ParameterDef , maestro:DtdlProperty ;
    rdfs:label "Measuring module mounting height 240 mm"@en ;
    maestro:description "Top edge of the profile plate to the bottom edge of the measuring-module bracket (commissioning)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:unitRef "http://qudt.org/vocab/unit/MilliM"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:minValue 240.0 ;
    maestro:maxValue 240.0 .


#################################################################
# MODULES
#################################################################

tes:RecognitionModule a maestro:Module ;
    rdfs:label "Recognition module"@en ;
    maestro:description "Capacitive sensor PART_AV detects every workpiece; diffuse sensor B2 detects red and silver workpieces but not black ones. A logic combination gives 'black' or 'red/silver'; red and silver cannot be told apart."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-ME" ;
    maestro:hasIdentifier ltu:PN_526850 ;
    maestro:providesCapability ltu:PresenceSensingCapability , ltu:MaterialRecognitionCapability .

tes:LiftingModule a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "Lifting module"@en ;
    maestro:description "Rodless lifting cylinder 1A1 (DGO-12) lifts the workpiece from the retainer to the Measuring module; short-stroke ejecting cylinder 2A1 (ADVU-16) pushes it onto the upper or lower slide. End positions 1B1/1B2 (SMTO-1) and 2B1 (SME-8)."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-MH" ;
    maestro:hasIdentifier ltu:PN_532954 ;
    maestro:providesCapability ltu:LiftingCapability , ltu:EjectingCapability , ltu:SortingCapability ;
    maestro:suppliedBy maestro:CompressedAir ;
    maestro:hasInterface tes:Port_MaterialIn .

tes:Port_MaterialIn a maestro:ExternalInterface ;
    rdfs:label "Material input: workpiece retainer"@en ;
    maestro:description "The upstream station places the workpiece here; PART_AV detects it."@en .

tes:MeasuringModule a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "Measuring module"@en ;
    maestro:description "Linear potentiometer R1 gives the workpiece height as 0-10 V; comparator 3A1 turns it into 'height correct' (window LEVEL1-LEVEL2), or the analogue value goes to a PLC via XMA3. A shock absorber cushions the lifting cylinder's upper end position."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP2-M-M" ;
    maestro:hasIdentifier ltu:PN_195779 ;
    maestro:providesCapability ltu:HeightMeasuringCapability ;
    maestro:suppliedBy tes:PSU .

tes:AirSlideModule a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "Air cushioned slide module"@en ;
    maestro:description "Upper slide: takes good workpieces to the downstream station; the air cushion evens out friction. Inclination adjustable; stopper turned 180 degrees when a downstream station follows."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-LRT-B" ;
    maestro:hasIdentifier ltu:PN_656859 ;
    maestro:providesCapability ltu:SlideConveyingCapability ;
    maestro:suppliedBy maestro:CompressedAir ;
    maestro:hasInterface tes:Port_MaterialOut .

tes:Port_MaterialOut a maestro:ExternalInterface ;
    rdfs:label "Material output: end of the air cushioned slide"@en ;
    maestro:description "Pick-up position of the downstream station."@en .

tes:SlideModule a maestro:Module ;
    rdfs:label "Slide module 210 (lower slide)"@en ;
    maestro:description "Lower slide for rejected workpieces; holds 4."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-R210" ;
    maestro:hasIdentifier ltu:PN_656858 ;
    maestro:providesCapability ltu:SlideConveyingCapability .

tes:SafetyLightBarrier a maestro:Module ;
    rdfs:label "Safety light barrier B4 (retro-reflective sensor)"@en ;
    maestro:description "Retro-reflective sensor SOEG-RSP-Q30-PS-S-2L on the lifting-module bracket; checks that the working area above the retainer is free before the lifting cylinder moves."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-SOEG-RT-Q3" ;
    maestro:hasIdentifier ltu:PN_196969 ;
    maestro:providesCapability ltu:PresenceSensingCapability .

tes:ValveTerminal a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "CPV valve terminal 0V1"@en ;
    maestro:description "Valve locations 1V1 (code C: two 3/2-way valves, 1M1 lower / 1M2 raise), 2V1 (code M: 5/2-way, 2M1 eject) and 3V1 (code M: 5/2-way, 3M1 air slide)."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-MCM" ;
    maestro:hasIdentifier ltu:PN_526227 ;
    maestro:providesCapability ltu:PneumaticActuationCapability ;
    maestro:suppliedBy maestro:CompressedAir , tes:PSU .

tes:ServiceUnit a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "Service unit (start-up valve with filter-control valve)"@en ;
    maestro:description "Compressed-air inlet, set to 6 bar."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:S-PVW-LFR" ;
    maestro:hasIdentifier ltu:PN_152894 ;
    maestro:providesCapability ltu:PneumaticActuationCapability ;
    maestro:suppliedBy maestro:CompressedAir .

tes:IOTerminal a maestro:Module ;
    rdfs:label "I/O terminal"@en ;
    maestro:description "Station side of SysLink XMA2: inputs I0-I7, outputs O0-O3 and O7 used."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP-B-AN-E/A-T" ;
    maestro:hasIdentifier ltu:PN_034035 ;
    maestro:providesCapability ltu:StationControlCapability .

tes:PLCBoard a maestro:Module , maestro:EnergyConsumer ;
    rdfs:label "PLC board"@en ;
    maestro:description "Connects to XMA2, XMA3 (analogue variant), XMG1, the power supply and the PC."@en ;
    maestro:model "PLC board (controller not stated)" ;
    maestro:providesCapability ltu:StationControlCapability ;
    maestro:suppliedBy tes:PSU .

tes:ControlConsole a maestro:Module ;
    rdfs:label "Control console"@en ;
    maestro:description "START, STOP, RESET, AUTO/MAN, EMERGENCY-STOP (if available) and the COLOUR warning light; connected via XMG1."@en ;
    maestro:providesCapability ltu:OperatorInterfaceCapability .

tes:StationLinkTransmitter a maestro:Module ;
    rdfs:label "StationLink transmitter IP_N_FO"@en ;
    maestro:description "Incoming-material side; signals 'station occupied' to the upstream station (O7)."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-SLS" ;
    maestro:hasIdentifier ltu:PN_196963 ;
    maestro:providesCapability ltu:StationLinkCapability ;
    maestro:hasInterface tes:Port_StationLinkTx .

tes:Port_StationLinkTx a maestro:ExternalInterface ;
    rdfs:label "StationLink transmitter (incoming-material side)"@en .

tes:StationLinkReceiver a maestro:Module ;
    rdfs:label "StationLink receiver IP_FI"@en ;
    maestro:description "Outgoing-material side; reads 'downstream station free' (I7)."@en ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-SLE" ;
    maestro:hasIdentifier ltu:PN_196964 ;
    maestro:providesCapability ltu:StationLinkCapability ;
    maestro:hasInterface tes:Port_StationLinkRx .

tes:Port_StationLinkRx a maestro:ExternalInterface ;
    rdfs:label "StationLink receiver (outgoing-material side)"@en .


#################################################################
# BILL OF MATERIALS
#
# Parts list 526881 (11.11.2002) with the components of the circuit
# diagrams below each assembly.
#################################################################

tes:StationType a maestro:ProductType ;
    rdfs:label "Festo MPS Testing station (equipment type)"@en ;
    maestro:manufacturer "Festo Didactic GmbH & Co. KG" ;
    maestro:model "MPS Testing station (PR)" ;
    maestro:description "The station as a Festo product; its bill of materials follows the parts list and the component tables of the documents."@en ;
    maestro:hasIdentifier tes:ID_StationMaterialNo , tes:ID_ManualOrderNo ;
    maestro:hasBOM tes:BOM_Recognition ,
              tes:BOM_Lifting ,
              tes:BOM_CableGuide ,
              tes:BOM_Measuring ,
              tes:BOM_AirSlide ,
              tes:BOM_LowerSlide ,
              tes:BOM_ValveTerminal ,
              tes:BOM_IOTerminal ,
              tes:BOM_ServiceUnit ,
              tes:BOM_ProfilePlate ,
              tes:BOM_Connectors ,
              tes:BOM_MountingSystem ,
              tes:BOM_StationLinkTransmitter ,
              tes:BOM_StationLinkReceiver ,
              tes:BOM_Holder ,
              tes:BOM_RetroReflectiveSensor ,
              tes:BOM_Accessories .

