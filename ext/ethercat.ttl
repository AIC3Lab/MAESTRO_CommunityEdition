@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix maestro: <https://w3id.org/maestro#> .

#################################################################
# MAESTRO HHM-Core extension : EtherCAT
#
# Realises an extension point on Binding for EtherCAT: the EtherCAT
# protocol individual and an EtherCAT binding that names the SubDevice
# by its position in the segment and the CANopen-over-EtherCAT object
# dictionary entry it carries. ESI device descriptions are a hook only:
# no IRIs, no mapping.
#################################################################

<https://w3id.org/maestro/hhm/ethercat> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/maestro/hhm/ethercat/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dct:title "MAESTRO HHM-Core: EtherCAT" ;
    rdfs:label "MAESTRO HHM-Core: EtherCAT"@en ;
    dct:description "EtherCAT realisation of the invocation hooks: the EtherCAT protocol individual and an EtherCAT binding carrying SubDevice position and object index and subindex."@en ;
    rdfs:comment "MAESTRO-local vocabulary; it is not aligned with, and makes no conformance claim to, any external standard. The protocol individual reuses its definition from the MAESTRO 1.0 communication module (dct:source); the binding and its properties have no MAESTRO 1.0 counterpart."@en ;
    dct:creator "Melwin Xavier" ;
    dct:license <https://opensource.org/licenses/MIT> ;
    dct:created "2026-10-02"^^xsd:date ;
    dct:modified "2026-10-02"^^xsd:date ;
    dct:source <https://github.com/melwinxavier/MAESTRO> ;
    rdfs:seeAlso <https://w3id.org/maestro/communication> ;
    dct:conformsTo <https://www.w3.org/TR/owl2-profiles/#OWL_2_RL> ;
    dct:isPartOf <https://w3id.org/maestro/hhm> ;
    vann:preferredNamespacePrefix "maestro" ;
    vann:preferredNamespaceUri "https://w3id.org/maestro#"^^xsd:anyURI ;
    owl:imports <https://w3id.org/maestro/hhm/addressing> .

#################################################################
# INDIVIDUALS
#################################################################

maestro:EthercatProtocol a owl:NamedIndividual , maestro:Protocol ;
    rdfs:label "EtherCAT"@en ;
    skos:definition "The EtherCAT fieldbus protocol."@en ;
    rdfs:comment "Moved from core/invocation.ttl: each protocol individual is declared in the extension module of its protocol. An maestro:EthercatBinding names it with maestro:specializesAs."@en ;
    dct:source <https://w3id.org/maestro/communication#EthercatProtocol> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/ethercat> .

#################################################################
# CLASSES
#################################################################

maestro:EthercatBinding a owl:Class ;
    rdfs:label "EtherCAT binding"@en ;
    skos:definition "A binding that maps an endpoint onto EtherCAT: the SubDevice addressed and the object dictionary entry, mapped as process data or read as service data, that carries the value."@en ;
    rdfs:comment "Specialises maestro:Binding, realising the HHM extension point on Binding."@en ;
    rdfs:subClassOf maestro:Binding ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/ethercat> .

#################################################################
# DATATYPE PROPERTIES
#################################################################

maestro:ethercatPosition a owl:DatatypeProperty ;
    rdfs:label "EtherCAT position"@en ;
    skos:definition "The position of the SubDevice an EtherCAT binding addresses, counted along the segment from the MainDevice starting at 0."@en ;
    rdfs:comment "MainDevice and SubDevice are the current EtherCAT Technology Group terms for what older documents call master and slave."@en ;
    rdfs:domain maestro:EthercatBinding ;
    rdfs:range  xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/ethercat> .

maestro:ethercatIndex a owl:DatatypeProperty ;
    rdfs:label "EtherCAT index"@en ;
    skos:definition "The index of the object dictionary entry an EtherCAT binding carries, for example 0x6000 written as 24576."@en ;
    rdfs:domain maestro:EthercatBinding ;
    rdfs:range  xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/ethercat> .

maestro:ethercatSubindex a owl:DatatypeProperty ;
    rdfs:label "EtherCAT subindex"@en ;
    skos:definition "The subindex of the object dictionary entry an EtherCAT binding carries."@en ;
    rdfs:domain maestro:EthercatBinding ;
    rdfs:range  xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/ethercat> .
