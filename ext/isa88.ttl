@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix ISA88: <http://www.hsu-ifa.de/ontologies/ISA88.01#> .
@prefix maestro: <https://w3id.org/maestro#> .

#################################################################
# MAESTRO HHM-Core extension : ISA-88 (HSU ISA88.01 ODP)
#
# Realises the two HHM extension points "ISA-88 Equipment Model" (on
# Station) and "ISA-88 Procedural Model" (on Recipe) with documentary
# matches only. No class is redefined and no logical axiom is added;
# a station that satisfies the ISA-88 unit definition may be typed
# ISA88:Unit explicitly in data.
#################################################################

<https://w3id.org/maestro/hhm/isa88> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/maestro/hhm/isa88/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dct:title "MAESTRO HHM-Core: ISA-88 bridge" ;
    rdfs:label "MAESTRO HHM-Core: ISA-88 bridge"@en ;
    dct:description "Documentary correspondences between the HHM-Core recipe and resource clusters and the procedural and physical models of the HSU ISA88.01 ontology design pattern."@en ;
    rdfs:comment "Pinned to hsu-aut/IndustrialStandard-ODP-ISA88.01 (references/hsu-isa88.ttl). Documentary skos:closeMatch links only. The ODP orders the children of a procedural level through list cells; this package orders steps with maestro:stepOrder and control-flow constraints, hence close rather than exact matches."@en ;
    dct:creator "Melwin Xavier" ;
    dct:license <https://opensource.org/licenses/MIT> ;
    dct:created "2026-09-30"^^xsd:date ;
    dct:modified "2026-09-30"^^xsd:date ;
    dct:source <https://github.com/melwinxavier/MAESTRO> ;
    rdfs:seeAlso <https://github.com/hsu-aut/IndustrialStandard-ODP-ISA88.01> ;
    dct:conformsTo <https://www.w3.org/TR/owl2-profiles/#OWL_2_RL> ;
    dct:isPartOf <https://w3id.org/maestro/hhm> ;
    vann:preferredNamespacePrefix "maestro" ;
    vann:preferredNamespaceUri "https://w3id.org/maestro#"^^xsd:anyURI ;
    owl:imports <https://w3id.org/maestro/hhm/recipe> , <https://w3id.org/maestro/hhm/resource> .

# Procedural model
maestro:Recipe   skos:closeMatch ISA88:RecipeProcedure ;
    skos:scopeNote "ISA88:RecipeProcedure is the highest level of the procedural control model of the HSU ISA88.01 ODP, describing the execution of an extensive production operation such as the production of a batch. maestro:Recipe is not restricted to batch production."@en .
maestro:PlanStep skos:closeMatch ISA88:Phase ;
    skos:scopeNote "ISA88:Phase is the smallest element of the procedural control in the HSU ISA88.01 ODP, defining a single process control task; a plan step plays that role."@en .

# Physical (equipment) model
maestro:Station skos:closeMatch ISA88:Unit ;
    skos:scopeNote "ISA88:Unit is made up of equipment modules and control modules and combines all necessary physical processing and control equipment (HSU ISA88.01 ODP). This package does not adopt the presumption that a unit operates on no more than one batch at a time."@en .
maestro:Module  skos:closeMatch ISA88:EquipmentModule ;
    skos:scopeNote "ISA88:EquipmentModule can carry out a finite number of specific minor processing activities and combines the physical processing and control equipment required for them (HSU ISA88.01 ODP). maestro:Module additionally stresses plug-and-produce reconfiguration."@en .
