@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix maestro: <https://w3id.org/maestro#> .

#################################################################
# MAESTRO HHM-Core extension : PROFINET
#
# Realises an extension point on Binding for PROFINET IO: the PROFINET
# protocol individual and a PROFINET binding that names the IO device
# by its station name and the slot and subslot of the submodule whose
# IO data it carries. GSDML device descriptions are a hook only: no
# IRIs, no mapping.
#################################################################

<https://w3id.org/maestro/hhm/profinet> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/maestro/hhm/profinet/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dct:title "MAESTRO HHM-Core: PROFINET" ;
    rdfs:label "MAESTRO HHM-Core: PROFINET"@en ;
    dct:description "PROFINET realisation of the invocation hooks: the PROFINET protocol individual and a PROFINET binding carrying station name, slot and subslot."@en ;
    rdfs:comment "MAESTRO-local vocabulary; it is not aligned with, and makes no conformance claim to, any external standard. The protocol individual reuses its definition from the MAESTRO 1.0 communication module (dct:source); the binding and its properties have no MAESTRO 1.0 counterpart."@en ;
    dct:creator "Melwin Xavier" ;
    dct:license <https://opensource.org/licenses/MIT> ;
    dct:created "2026-10-02"^^xsd:date ;
    dct:modified "2026-10-02"^^xsd:date ;
    dct:source <https://github.com/melwinxavier/MAESTRO> ;
    rdfs:seeAlso <https://w3id.org/maestro/communication> ;
    dct:conformsTo <https://www.w3.org/TR/owl2-profiles/#OWL_2_RL> ;
    dct:isPartOf <https://w3id.org/maestro/hhm> ;
    vann:preferredNamespacePrefix "maestro" ;
    vann:preferredNamespaceUri "https://w3id.org/maestro#"^^xsd:anyURI ;
    owl:imports <https://w3id.org/maestro/hhm/addressing> .

#################################################################
# INDIVIDUALS
#################################################################

maestro:ProfinetProtocol a owl:NamedIndividual , maestro:Protocol ;
    rdfs:label "PROFINET"@en ;
    skos:definition "The PROFINET industrial Ethernet protocol."@en ;
    rdfs:comment "Moved from core/invocation.ttl: each protocol individual is declared in the extension module of its protocol. An maestro:ProfinetBinding names it with maestro:specializesAs."@en ;
    dct:source <https://w3id.org/maestro/communication#ProfinetProtocol> ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/profinet> .

#################################################################
# CLASSES
#################################################################

maestro:ProfinetBinding a owl:Class ;
    rdfs:label "PROFINET binding"@en ;
    skos:definition "A binding that maps an endpoint onto PROFINET IO: the IO device, and the slot and subslot of the submodule that carries the data."@en ;
    rdfs:comment "Specialises maestro:Binding, realising the HHM extension point on Binding."@en ;
    rdfs:subClassOf maestro:Binding ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/profinet> .

#################################################################
# DATATYPE PROPERTIES
#################################################################

maestro:profinetStationName a owl:DatatypeProperty ;
    rdfs:label "PROFINET station name"@en ;
    skos:definition "The name of station by which the IO controller identifies the IO device of a PROFINET binding."@en ;
    rdfs:domain maestro:ProfinetBinding ;
    rdfs:range  xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/profinet> .

maestro:profinetSlot a owl:DatatypeProperty ;
    rdfs:label "PROFINET slot"@en ;
    skos:definition "The slot number of the module, within the IO device, that a PROFINET binding addresses."@en ;
    rdfs:domain maestro:ProfinetBinding ;
    rdfs:range  xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/profinet> .

maestro:profinetSubslot a owl:DatatypeProperty ;
    rdfs:label "PROFINET subslot"@en ;
    skos:definition "The subslot number of the submodule, within its slot, that a PROFINET binding addresses."@en ;
    rdfs:domain maestro:ProfinetBinding ;
    rdfs:range  xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/maestro/hhm/profinet> .
