  n116 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Clean the active surface of the<BR/>proximity sensors (at regular<BR/>intervals)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">ltu:MT_CleanProximitySensors  a maestro:MaintenanceTask</FONT></TD></TR></TABLE>> color="#9ca3af" fillcolor="#ffffff" style="rounded,filled,dashed"];
  n131 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Clean the entire station (at<BR/>regular intervals)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">ltu:MT_CleanStation  a maestro:MaintenanceTask</FONT></TD></TR></TABLE>> color="#9ca3af" fillcolor="#ffffff" style="rounded,filled,dashed"];
  n106 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Visual check of electrical<BR/>connections, compressed-air<BR/>connections and mechanical<BR/>components before each<BR/>commissioning</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">ltu:MT_VisualCheck  a maestro:MaintenanceTask</FONT></TD></TR></TABLE>> color="#9ca3af" fillcolor="#ffffff" style="rounded,filled,dashed"];
}
