subgraph cluster_maintenance { label="Maintenance\nmodules/maintenance.ttl"; color="#B91C1C"; fontcolor="#B91C1C"; style="rounded,dashed"; penwidth=1.4;
  n76 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Handling station care plan (manual<BR/>chapter 'Maintenance')</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">han:MaintenancePlan  a maestro:MaintenancePlan</FONT></TD></TR></TABLE>> color="#B91C1C" fillcolor="#f9f9fb"];
  n75 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Clean the fibre-optic devices only<BR/>with water (max. 60 degC) or<BR/>isopropyl alcohol</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">han:MT_CleanFibreOptic  a maestro:MaintenanceTask</FONT></TD></TR></TABLE>> color="#B91C1C" fillcolor="#f9f9fb"];
  n148 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Clean lenses of optical sensors,<BR/>fibre optics and reflectors (at<BR/>regular intervals)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">ltu:MT_CleanOptics  a maestro:MaintenanceTask</FONT></TD></TR></TABLE>> color="#9ca3af" fillcolor="#ffffff" style="rounded,filled,dashed"];
  n163 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Clean the active surface of the<BR/>proximity sensors (at regular<BR/>intervals)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">ltu:MT_CleanProximitySensors  a maestro:MaintenanceTask</FONT></TD></TR></TABLE>> color="#9ca3af" fillcolor="#ffffff" style="rounded,filled,dashed"];
  n139 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Clean the entire station (at<BR/>regular intervals)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">ltu:MT_CleanStation  a maestro:MaintenanceTask</FONT></TD></TR></TABLE>> color="#9ca3af" fillcolor="#ffffff" style="rounded,filled,dashed"];
  n140 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Visual check of electrical<BR/>connections, compressed-air<BR/>connections and mechanical<BR/>components before each<BR/>commissioning</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">ltu:MT_VisualCheck  a maestro:MaintenanceTask</FONT></TD></TR></TABLE>> color="#9ca3af" fillcolor="#ffffff" style="rounded,filled,dashed"];
}
subgraph cluster_maas { label="Manufacturing as a Service\nmodules/maas.ttl"; color="#0369A1"; fontcolor="#0369A1"; style="rounded,dashed"; penwidth=1.4;
  n129 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Luleå University of Technology<BR/>(LTU)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">ltu:LTU  a maestro:Actor, maestro:Enterprise</FONT></TD></TR></TABLE>> color="#9ca3af" fillcolor="#ffffff" style="rounded,filled,dashed"];
}
