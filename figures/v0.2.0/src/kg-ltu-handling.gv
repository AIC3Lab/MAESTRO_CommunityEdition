  n86 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Transfer point to a downstream<BR/>station</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">han:Port_MaterialOut  a maestro:ExternalInterface</FONT></TD></TR></TABLE>> color="#4B5563" fillcolor="#f9f9fb"];
}
