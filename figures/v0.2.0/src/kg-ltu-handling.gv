  n85 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Material input: receptacle (pick-<BR/>up position 'upstream station')</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">han:Port_MaterialIn  a maestro:ExternalInterface</FONT></TD></TR></TABLE>> color="#4B5563" fillcolor="#f9f9fb"];
  n87 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>StationLink receiver (outgoing-<BR/>material side)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">han:Port_StationLinkRx  a maestro:ExternalInterface</FONT></TD></TR></TABLE>> color="#4B5563" fillcolor="#f9f9fb"];
