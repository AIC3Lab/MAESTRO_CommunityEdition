subgraph cluster_policy { label="Safety / Security / Policy\ncore/policy.ttl"; color="#111827"; fontcolor="#111827"; style="rounded"; penwidth=1.4;
  n52 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Do not exceed the Handling<BR/>station's maximum operating<BR/>pressure of 4 bar (400 kPa)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">han:C_MaxOperatingPressure  a maestro:Constraint</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">expression : supplyPressure &lt;= 4 bar</FONT></TD></TR></TABLE>> color="#111827" fillcolor="#f9f9fb"];
  n51 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Fibre-optic devices must not be<BR/>used as contactless protective<BR/>devices</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">han:C_FibreOpticNotProtective  a maestro:Constraint</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">expression : PART_AV and 3B1 are not safety devices</FONT></TD></TR></TABLE>> color="#111827" fillcolor="#f9f9fb"];
  n72 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>EMERGENCY-STOP pushbutton,<BR/>Handling station control console</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">han:EmergencyStop  a maestro:EmergencyStop</FONT></TD></TR></TABLE>> color="#111827" fillcolor="#f9f9fb"];
