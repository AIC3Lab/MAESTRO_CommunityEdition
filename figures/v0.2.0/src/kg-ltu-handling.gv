  n146 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Trainees may run the station<BR/>cycles</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">ltu:Perm_TraineeRunsStations  a maestro:Permission</FONT></TD></TR></TABLE>> color="#9ca3af" fillcolor="#ffffff" style="rounded,filled,dashed"];
