  n16 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Festo MPS line process: distribute,<BR/>test, process, sort</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#777777">lin:MPSLineRecipe  a maestro:Recipe  (line/product.ttl)</FONT></TD></TR></TABLE>> color="#3B82F6" fillcolor="#f9f9fb" style="rounded,filled" penwidth=1.4];
  n17 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Line step 1 - Distribute (Distributing<BR/>station)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#777777">lin:LS1_Distribute  a maestro:PlanStep</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">to next step when: workpiece released at the<BR ALIGN="LEFT"/>   Testing retainer; the Testing station<BR ALIGN="LEFT"/>   signalled 'not occupied' over StationLink</FONT></TD></TR></TABLE>> color="#3B82F6" fillcolor="#f9f9fb" style="rounded,filled" penwidth=1.4];
