}
subgraph cluster_distributing { label="distributing/  plant.ttl + product.ttl  (dis:)"; color="#12A594"; fontcolor="#12A594"; fontsize=16; style="rounded"; penwidth=2; labeljust="l";
  n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Distributing station (VE, station 1)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#777777">dis:Station  a maestro:Station, maestro:WorkUnit  (distributing/plant.ttl)</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">Stack magazine + Changer; feeds workpieces to the line<BR ALIGN="LEFT"/>Festo order number (technical documentation): 648811<BR ALIGN="LEFT"/>modules (8): CPV valve terminal, Changer module, Control<BR ALIGN="LEFT"/>   console, I/O terminal, PLC board, Service unit (start-<BR ALIGN="LEFT"/>   up valve with filter-control valve), Stack magazine<BR ALIGN="LEFT"/>   module, StationLink receiver<BR ALIGN="LEFT"/>modules provide: Feeding, Operator interface, Pneumatic<BR ALIGN="LEFT"/>   actuation, Station control and I/O, StationLink<BR ALIGN="LEFT"/>   signalling, Vacuum gripping, Workpiece presence<BR ALIGN="LEFT"/>   sensing, Workpiece transfer<BR ALIGN="LEFT"/>19 signals (maestro:ParameterDef) over XMA2, XMG1<BR ALIGN="LEFT"/>18 BOM nodes, 9 skills</FONT></TD></TR></TABLE>> color="#12A594" fillcolor="#f9f9fb" style="rounded,filled" penwidth=1.4];
  n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Distribute workpiece (station cycle)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#777777">dis:DistributeWorkpiece  a maestro:CompositeSkill</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">hasSubSkillLink: Drop off workpiece (vacuum off), Eject<BR ALIGN="LEFT"/>   workpiece from the magazine, Pick up workpiece (vacuum<BR ALIGN="LEFT"/>   on), Retract magazine slide, Swivel arm to 'downstream<BR ALIGN="LEFT"/>   station', Swivel arm to 'magazine'<BR ALIGN="LEFT"/>requiresCapability: Feeding, Vacuum gripping, Workpiece<BR ALIGN="LEFT"/>   transfer<BR ALIGN="LEFT"/>mayRaiseFault: MAG. EMPTY</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb" style="rounded,filled" penwidth=1.4];
  n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Distributing station control sequence<BR/>(GRAFCET, 1-bit link)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#777777">dis:ControlSequence  a maestro:Recipe  (distributing/product.ttl)</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">11 GRAFCET steps (maestro:PlanStep)<BR ALIGN="LEFT"/>transitions: 5 Alternative, 4 Loop, 7<BR ALIGN="LEFT"/>   Precedes</FONT></TD></TR></TABLE>> color="#3B82F6" fillcolor="#f9f9fb" style="rounded,filled" penwidth=1.4];
}
