  safety [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>MPS notes on safety</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#777777">ltu:MPSSafetyRules  a maestro:Policy</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">8 shared + 2 Handling constraints<BR ALIGN="LEFT"/>hazards: cylinder motion on air-on, moving<BR ALIGN="LEFT"/>   station, overpressure; + drill spindle, lift in<BR ALIGN="LEFT"/>   working area<BR ALIGN="LEFT"/>trainees may maestro:Invoke the station cycles<BR ALIGN="LEFT"/>emergency stop per station console</FONT></TD></TR></TABLE>> color="#111827" fillcolor="#f9f9fb" style="rounded,filled" penwidth=1.4];
