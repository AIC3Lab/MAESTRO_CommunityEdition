  caps [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>19 capabilities</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#777777">ltu:*Capability  a maestro:Capability</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">Clamping, Drilling (simulated hole polishing), Ejecting,<BR ALIGN="LEFT"/>   Feeding, Height measuring, Lifting, Material / colour<BR ALIGN="LEFT"/>   recognition, Mechanical gripping, Operator interface,<BR ALIGN="LEFT"/>   Orientation checking, Pneumatic actuation, Rotary<BR ALIGN="LEFT"/>   indexing, Slide conveying and buffering, Sorting, Station<BR ALIGN="LEFT"/>   control and I/O, StationLink signalling, Vacuum gripping,<BR ALIGN="LEFT"/>   Workpiece presence sensing, Workpiece transfer</FONT></TD></TR></TABLE>> color="#9ca3af" fillcolor="#ffffff" style="rounded,filled,dashed" penwidth=1.4];
