  n114 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Indexing step 60 degrees</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:TD_IndexingAngle  a maestro:DtdlProperty, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">maxValue : 60.0<BR ALIGN="LEFT"/>minValue : 60.0<BR ALIGN="LEFT"/>paramType : xsd:double<BR ALIGN="LEFT"/>parameterDirection : Input<BR ALIGN="LEFT"/>unitRef : unit:DEG</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n75 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Indexing table motor on (pulse)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DO_IndexTable  a maestro:DtdlProperty, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = K2<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = O1<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 2<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Input</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n76 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Lower drilling unit</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DO_LowerDrill  a maestro:DtdlProperty, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = K4<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = O2<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 3<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Input</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n79 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Proofing workpiece</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DO_TestSolenoid  a maestro:DtdlProperty, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = M5<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = O5<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 6<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Input</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n74 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Push out workpiece</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DO_Eject  a maestro:DtdlProperty, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = M6<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = O6<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 7<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Input</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n77 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Raise drilling unit</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DO_RaiseDrill  a maestro:DtdlProperty, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = K3<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = O3<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 4<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Input</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n78 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Station occupied</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DO_StationOccupied  a maestro:DtdlProperty, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = IP_N_FO<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = O7<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 8<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Input</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n116 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Supply current 4.5 A</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:TD_SupplyCurrent  a maestro:DtdlProperty, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">maxValue : 4.5<BR ALIGN="LEFT"/>paramType : xsd:double<BR ALIGN="LEFT"/>parameterDirection : Input<BR ALIGN="LEFT"/>unitRef : unit:A</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n117 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Supply voltage 24 V DC</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:TD_SupplyVoltage  a maestro:DtdlProperty, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">maxValue : 24.0<BR ALIGN="LEFT"/>minValue : 24.0<BR ALIGN="LEFT"/>paramType : xsd:double<BR ALIGN="LEFT"/>parameterDirection : Input<BR ALIGN="LEFT"/>unitRef : unit:V</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n32 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Warning light WORKPIECE NOK</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:CC_WorkpieceNokLamp  a maestro:DtdlProperty, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Input</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n115 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Workpiece retainers on the<BR/>indexing table: 6</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:TD_Retainers  a maestro:DtdlProperty, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">maxValue : 6.0<BR ALIGN="LEFT"/>minValue : 6.0<BR ALIGN="LEFT"/>paramType : xsd:integer<BR ALIGN="LEFT"/>parameterDirection : Input</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n67 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Checking drill hole o.k.</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DI_OrientationOK  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = B4<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = I6<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 19<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n64 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Downstream station free</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DI_DownstreamFree  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = IP_FI<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = I7<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 20<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n65 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Drilling unit in lower position</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DI_DrillDown  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = 1B2<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = I4<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 17<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n66 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Drilling unit in upper position</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DI_DrillUp  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = 1B1<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = I3<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 16<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n26 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>EMERGENCY-STOP pushbutton (if<BR/>available)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:CC_EmergencyStop  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n68 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Indexing table positioned</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DI_TablePositioned  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = B3<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = I5<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 18<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n25 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Key-operated switch AUTO/MAN</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:CC_AutoMan  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n27 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>RESET pushbutton (illuminated)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:CC_Reset  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n29 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>START pushbutton (illuminated)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:CC_Start  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n31 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>STOP pushbutton</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:CC_Stop  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n69 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Workpiece at checking unit</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DI_WorkpieceAtChecking  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = B1<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = I1<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 14<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n70 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Workpiece at drilling unit</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DI_WorkpieceAtDrilling  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = B2<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = I2<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 15<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n71 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Workpiece available</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:DI_WorkpieceAvailable  a maestro:DtdlTelemetry, maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">hasIdentifier : Festo circuit-diagram equipment designation (BMK) = PART_AV<BR ALIGN="LEFT"/>hasIdentifier : XMA2 bit = I0<BR ALIGN="LEFT"/>hasIdentifier : XMA2 pin = 13<BR ALIGN="LEFT"/>paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n121 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Delay 1 s after the table is<BR/>positioned (1s/X13)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:T_TableSettle  a maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">maxValue : 1.0<BR ALIGN="LEFT"/>minValue : 1.0<BR ALIGN="LEFT"/>paramType : xsd:double<BR ALIGN="LEFT"/>parameterDirection : Input<BR ALIGN="LEFT"/>unitRef : unit:SEC</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n120 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Delay 3 s after 'station occupied'<BR/>(3s/X9)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:T_OccupiedDelay  a maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">maxValue : 3.0<BR ALIGN="LEFT"/>minValue : 3.0<BR ALIGN="LEFT"/>paramType : xsd:double<BR ALIGN="LEFT"/>parameterDirection : Input<BR ALIGN="LEFT"/>unitRef : unit:SEC</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n119 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Eject duration 1 s (1s/X41)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:T_EjectDuration  a maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">maxValue : 1.0<BR ALIGN="LEFT"/>minValue : 1.0<BR ALIGN="LEFT"/>paramType : xsd:double<BR ALIGN="LEFT"/>parameterDirection : Input<BR ALIGN="LEFT"/>unitRef : unit:SEC</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n95 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Flag 'workpiece orientation' bit 1<BR/>(result of the check)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:P_OrientationResult  a maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Output</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n93 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Flag 'workpiece orientation' bit 2<BR/>(workpiece at drilling)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:P_OrientationAtDrilling  a maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Input</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n94 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Flag 'workpiece orientation' bit 3<BR/>(workpiece at output)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:P_OrientationAtOutput  a maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">paramType : xsd:boolean<BR ALIGN="LEFT"/>parameterDirection : Input</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  n118 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Testing-solenoid on time 3 s<BR/>(3s/X21)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">pro:T_CheckDwell  a maestro:ParameterDef</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">maxValue : 3.0<BR ALIGN="LEFT"/>minValue : 3.0<BR ALIGN="LEFT"/>paramType : xsd:double<BR ALIGN="LEFT"/>parameterDirection : Input<BR ALIGN="LEFT"/>unitRef : unit:SEC</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
}
