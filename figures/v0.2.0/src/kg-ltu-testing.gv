subgraph cluster_maintenance { label="Maintenance\nmodules/maintenance.ttl"; color="#B91C1C"; fontcolor="#B91C1C"; style="rounded,dashed"; penwidth=1.4;
  n91 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Testing station care plan (manual<BR/>chapter 'Maintenance')</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">tes:MaintenancePlan  a maestro:MaintenancePlan</FONT></TD></TR></TABLE>> color="#B91C1C" fillcolor="#f9f9fb"];
  n89 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Clean or replace the CPV surface-<BR/>mounted silencer when dirt raises<BR/>the exhaust pressure</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">tes:MT_CleanCPVSilencer  a maestro:MaintenanceTask</FONT></TD></TR></TABLE>> color="#B91C1C" fillcolor="#f9f9fb"];
  n90 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><B>Remove dirt from the cylinder<BR/>piston rods with a soft cloth<BR/>(cylinders have service-life<BR/>lubrication)</B></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#777777">tes:MT_WipePistonRods  a maestro:MaintenanceTask</FONT></TD></TR></TABLE>> color="#B91C1C" fillcolor="#f9f9fb"];
