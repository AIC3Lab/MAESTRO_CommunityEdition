  Precondition [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>maestro:Precondition</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">expression : string  (open domain)</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  Skill [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>maestro:Skill</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">description : string  (open domain)<BR ALIGN="LEFT"/>version : string  (open domain)</FONT></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  SkillElement [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>maestro:SkillElement</B></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  SkillInterface [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>maestro:SkillInterface</B></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
  EXT_skill [shape=note fillcolor="#fff7ed" color="#c2410c" fontsize=8 label="QUDT: unitRef holds a QUDT unit IRI (hook only)\nSOSA observation evidence (hook only)\nCSS / CaSkMan patterns (hook only)\nopen-domain datatype properties (drawn on the classes that use them): expression : string"];
  AtomicSkill -> EXT_skill [style=dotted color="#c2410c" arrowhead=none];
}
