  CompositeSkill [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>maestro:CompositeSkill</B></TD></TR></TABLE>> color="#E54D2E" fillcolor="#f9f9fb"];
