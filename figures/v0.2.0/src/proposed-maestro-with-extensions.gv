digraph MAESTRO_HHM_Core {
rankdir=LR; compound=true; nodesep=0.3; ranksep=0.85; fontname="Helvetica"; fontsize=18; newrank=true; labelloc="t"; label="MAESTRO 0.2.0, with the extension modules (OPC UA, digital twin, DTDL, REST, ISA-95, AutomationML)";
node [shape=box style="rounded,filled" fillcolor="#f9f9fb" fontname="Helvetica" fontsize=10 margin="0.08,0.04"];
edge [fontname="Helvetica" fontsize=8 arrowsize=0.7];
subgraph cluster_resource { label="Physical Resources\ncore/resource.ttl"; color="#12A594"; fontcolor="#12A594"; style="rounded"; penwidth=1.4;
  Capability [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>maestro:Capability</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">description : string  (open domain)</FONT></TD></TR></TABLE>> color="#12A594" fillcolor="#f9f9fb"];
  Module [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>maestro:Module</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">manufacturer : string  (open domain)<BR ALIGN="LEFT"/>model : string  (open domain)<BR ALIGN="LEFT"/>serialNumber : string  (open domain)</FONT></TD></TR></TABLE>> color="#12A594" fillcolor="#f9f9fb"];
  Resource [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>maestro:Resource</B></TD></TR></TABLE>> color="#12A594" fillcolor="#f9f9fb"];
  Station [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>maestro:Station</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">location : string  (open domain)</FONT></TD></TR></TABLE>> color="#12A594" fillcolor="#f9f9fb"];
  ValueSet [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>maestro:ValueSet</B></TD></TR></TABLE>> color="#12A594" fillcolor="#f9f9fb"];
  EXT_resource [shape=note fillcolor="#fff7ed" color="#c2410c" fontsize=8 label="AutomationML / CAEX topology -&gt; ext/automationml.ttl\nISA-88 equipment model -&gt; ext/isa88.ttl\nPackage-wide: ValueSet, transitive hasPart / partOf (super-property of hasModule, hasStep, hasSubSkill, hasSubItem)\nopen-domain datatype properties (drawn on the classes that use them): description : string, location : string, manufacturer : string, model : string, serialNumber : string, version : string\nValueSet: superclass of every value-set class (edges in figure 13)"];
  Capability -> EXT_resource [style=dotted color="#c2410c" arrowhead=none];
}
