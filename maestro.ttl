@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix maestro:   <https://w3id.org/maestro#> .

#################################################################
# MAESTRO : umbrella ontology
#
# Imports every module of the package. Seven of the modules under
# core/ mirror the HHM-Core v1 clusters one to one; core/maas.ttl
# and, under experimental-extensions/, runtime.ttl, energy.ttl and
# maintenance.ttl carry concerns no HHM cluster covers (manufacturing
# as a service, runtime state, energy, maintenance); the other
# modules under experimental-extensions/ realise the extension points
# the HHM diagram names for standards in the MAESTRO standards basis.
# The alignment files under alignment/ import this umbrella and are
# not imported by it.
#################################################################

<https://w3id.org/maestro> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/maestro/0.2.0> ;
    owl:versionInfo "0.2.0" ;
    owl:priorVersion <https://w3id.org/maestro/0.1.0> ;
    dct:title "MAESTRO" ;
    rdfs:label "MAESTRO"@en ;
    dct:description "A version of the MAESTRO manufacturing ontology structured after the HHM-Core v1 reference model: product, physical resources, skills, recipe and planning, safety and policy, invocation hooks and minimal execution, with modules for runtime state, energy, maintenance and manufacturing as a service, and extensions for the digital twin, OPC UA, ISA-88, ISA-95, AutomationML, DTDL, REST, PROV-O and ODRL. Version 0.2.0 adds grouping classes per cluster, a transitive part-whole property hierarchy, inverse properties, functional properties for single-valued attributes, disjoint value sets and clearer names for twelve terms; the 0.1.0 names remain as deprecated equivalents."@en ;
    rdfs:comment "All terms share the namespace https://w3id.org/maestro# (prefix maestro); rdfs:isDefinedBy names the module that defines each term. Definitions are reused from MAESTRO 1.0 wherever a matching term exists (dct:source per term). Standards are referenced only where their ontology design pattern or schema is pinned under references/ in the MAESTRO repository; ECLASS, DPP, PRONTO, CaSkMan, AAS, OpenAPI, SAREF4INMA and XACML are named as hooks and carry no IRIs and no mappings."@en ;
    dct:creator "Melwin Xavier" ;
    dct:license <https://opensource.org/licenses/MIT> ;
    dct:created "2026-09-30"^^xsd:date ;
    dct:modified "2026-11-13"^^xsd:date ;
    dct:source <https://github.com/melwinxavier/MAESTRO> ;
    dct:conformsTo <https://www.w3.org/TR/owl2-profiles/#OWL_2_RL> ;
    vann:preferredNamespacePrefix "maestro" ;
    vann:preferredNamespaceUri "https://w3id.org/maestro#"^^xsd:anyURI ;
    owl:imports <https://w3id.org/maestro/resource> ,
                <https://w3id.org/maestro/skill> ,
                <https://w3id.org/maestro/recipe> ,
                <https://w3id.org/maestro/product> ,
                <https://w3id.org/maestro/invocation> ,
                <https://w3id.org/maestro/policy> ,
                <https://w3id.org/maestro/execution> ,
                <https://w3id.org/maestro/runtime> ,
                <https://w3id.org/maestro/energy> ,
                <https://w3id.org/maestro/maintenance> ,
                <https://w3id.org/maestro/maas> ,
                <https://w3id.org/maestro/digital-twin> ,
                <https://w3id.org/maestro/opcua> ,
                <https://w3id.org/maestro/isa88> ,
                <https://w3id.org/maestro/isa95> ,
                <https://w3id.org/maestro/automationml> ,
                <https://w3id.org/maestro/dtdl> ,
                <https://w3id.org/maestro/rest> ,
                <https://w3id.org/maestro/prov> ,
                <https://w3id.org/maestro/odrl> .
