PREFIX maestro:   <https://w3id.org/maestro#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# CQ04 - Which output (or bidirectional) parameter feeds which input (or bidirectional) parameter of which step, and in which unit?
SELECT ?step ?binding ?fromParam ?fromUnit ?toParam ?toUnit
WHERE {
    ?step a maestro:PlanStep ;
          maestro:hasDataBinding ?binding .
    ?binding maestro:bindsFrom ?fromParam ;
             maestro:bindsTo ?toParam .
    ?fromParam maestro:parameterDirection ?fromDirection .
    ?toParam   maestro:parameterDirection ?toDirection .
    VALUES ?fromDirection { maestro:Output maestro:InOut }
    VALUES ?toDirection   { maestro:Input  maestro:InOut }
    OPTIONAL { ?fromParam maestro:unitRef ?fromUnit }
    OPTIONAL { ?toParam maestro:unitRef ?toUnit }
}
ORDER BY ?step ?binding
