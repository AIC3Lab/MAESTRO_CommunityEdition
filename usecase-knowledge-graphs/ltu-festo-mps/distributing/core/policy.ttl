# MAESTRO example: LTU Festo MPS - Distributing station
# core/policy.ttl: statements that belong to the MAESTRO policy module (https://w3id.org/maestro/policy).
# Umbrella: ../distributing.ttl. Single-file form of the use case: ../distributing-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix dis: <https://w3id.org/maestro/examples/ltu-festo-mps/distributing#> .
@prefix ltu: <https://w3id.org/maestro/examples/ltu-festo-mps/shared#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/distributing/core/policy> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Distributing station - core/policy"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/distributing> ;
    owl:imports <https://w3id.org/maestro/policy> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:EmergencyStop (1)
#################################################################

dis:EmergencyStop a maestro:EmergencyStop ;
    rdfs:label "EMERGENCY-STOP pushbutton, Distributing station control console"@en ;
    maestro:description "The manual names the EMERGENCY-STOP pushbutton '(if available)'; together with STOP it interrupts the sequence at any time and must be released before a program is loaded. Safety category, performance level and wiring are not stated."@en ;
    maestro:mitigates ltu:H_MovingStation .

#################################################################
# Further statements about individuals described in other files (1)
#################################################################

ltu:Perm_TraineeRunsStations
    maestro:target dis:DistributeWorkpiece .
