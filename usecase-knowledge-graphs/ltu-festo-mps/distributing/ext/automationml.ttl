# MAESTRO example: LTU Festo MPS - Distributing station
# ext/automationml.ttl: statements that belong to the MAESTRO automationml module (https://w3id.org/maestro/automationml).
# Umbrella: ../distributing.ttl. Single-file form of the use case: ../distributing-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix dis: <https://w3id.org/maestro/examples/ltu-festo-mps/distributing#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/distributing/ext/automationml> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Distributing station - ext/automationml"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/distributing> ;
    owl:imports <https://w3id.org/maestro/automationml> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:ExternalInterface (2)
#################################################################

dis:Port_MaterialOut a maestro:ExternalInterface ;
    rdfs:label "Material output: transfer point of the downstream station"@en ;
    maestro:description "The arm releases the workpiece here by switching the vacuum off."@en .

dis:Port_StationLinkRx a maestro:ExternalInterface ;
    rdfs:label "StationLink receiver (outgoing-material side)"@en .

#################################################################
# Further statements about individuals described in other files (2)
#################################################################

dis:ChangerModule
    maestro:hasInterface dis:Port_MaterialOut .

dis:StationLinkReceiver
    maestro:hasInterface dis:Port_StationLinkRx .
