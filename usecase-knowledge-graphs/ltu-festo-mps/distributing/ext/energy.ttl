# MAESTRO example: LTU Festo MPS - Distributing station
# ext/energy.ttl: statements that belong to the MAESTRO energy module (https://w3id.org/maestro/energy).
# Umbrella: ../distributing.ttl. Single-file form of the use case: ../distributing-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix dis: <https://w3id.org/maestro/examples/ltu-festo-mps/distributing#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/distributing/ext/energy> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Distributing station - ext/energy"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/distributing> ;
    owl:imports <https://w3id.org/maestro/energy> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:EnergyConsumer (5)
#################################################################

dis:ChangerModule a maestro:EnergyConsumer ;
    maestro:suppliedBy maestro:CompressedAir .

dis:PLCBoard a maestro:EnergyConsumer ;
    maestro:suppliedBy dis:PSU .

dis:ServiceUnit a maestro:EnergyConsumer ;
    maestro:suppliedBy maestro:CompressedAir .

dis:StackMagazineModule a maestro:EnergyConsumer ;
    maestro:suppliedBy maestro:CompressedAir .

dis:ValveTerminal a maestro:EnergyConsumer ;
    maestro:suppliedBy maestro:CompressedAir, dis:PSU .

#################################################################
# maestro:EnergySource (1)
#################################################################

dis:PSU a maestro:EnergySource ;
    rdfs:label "24 V DC power supply unit, Distributing station"@en ;
    maestro:description "Power supply unit 24 V DC, 4.5 A; feeds the whole station through the PLC board."@en .
