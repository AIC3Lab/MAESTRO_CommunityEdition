# MAESTRO example: LTU Festo MPS - Handling station
# core/product.ttl: statements that belong to the MAESTRO product module (https://w3id.org/maestro/product).
# Umbrella: ../handling.ttl. Single-file form of the use case: ../handling-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix han: <https://w3id.org/maestro/examples/ltu-festo-mps/handling#> .
@prefix ltu: <https://w3id.org/maestro/examples/ltu-festo-mps/shared#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/handling/core/product> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Handling station - core/product"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/handling> ;
    owl:imports <https://w3id.org/maestro/product> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:ProductType (1)
#################################################################

han:StationType a maestro:ProductType ;
    rdfs:label "Festo MPS Handling station (equipment type)"@en ;
    maestro:description "The station as a Festo product; its bill of materials follows the parts list and the component tables of the documents."@en ;
    maestro:hasBOMItem han:BOM_Accessories,
        han:BOM_Connectors,
        han:BOM_DiffuseSensors,
        han:BOM_Holder,
        han:BOM_IOTerminal,
        han:BOM_MountingSystem,
        han:BOM_PicAlfa,
        han:BOM_ProfilePlate,
        han:BOM_Receptacle,
        han:BOM_ServiceUnit,
        han:BOM_Slides,
        han:BOM_StationLinkReceiver,
        han:BOM_StationLinkTransmitter,
        han:BOM_ValveTerminal ;
    maestro:hasIdentifier han:ID_ManualOrderNo, han:ID_StationMaterialNo ;
    maestro:manufacturer "Festo Didactic GmbH & Co. KG" ;
    maestro:model "MPS Handling station (HA, PicAlfa)" .

