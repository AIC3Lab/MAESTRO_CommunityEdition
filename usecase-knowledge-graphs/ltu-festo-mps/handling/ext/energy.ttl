# MAESTRO example: LTU Festo MPS - Handling station
# ext/energy.ttl: statements that belong to the MAESTRO energy module (https://w3id.org/maestro/energy).
# Umbrella: ../handling.ttl. Single-file form of the use case: ../handling-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix han: <https://w3id.org/maestro/examples/ltu-festo-mps/handling#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/handling/ext/energy> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Handling station - ext/energy"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/handling> ;
    owl:imports <https://w3id.org/maestro/energy> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:EnergyConsumer (4)
#################################################################

han:PLCBoard a maestro:EnergyConsumer ;
    maestro:suppliedBy han:PSU .

han:PicAlfaModule a maestro:EnergyConsumer ;
    maestro:suppliedBy maestro:CompressedAir .

han:ServiceUnit a maestro:EnergyConsumer ;
    maestro:suppliedBy maestro:CompressedAir .

han:ValveTerminal a maestro:EnergyConsumer ;
    maestro:suppliedBy maestro:CompressedAir, han:PSU .

#################################################################
# maestro:EnergySource (1)
#################################################################

han:PSU a maestro:EnergySource ;
    rdfs:label "24 V DC power supply unit, Handling station"@en ;
    maestro:description "Power supply unit 24 V DC, 4.5 A (max. 5 A); feeds the whole station through the PLC board."@en .
