# MAESTRO example: LTU Festo MPS - Handling station
# ext/isa95.ttl: statements that belong to the MAESTRO isa95 module (https://w3id.org/maestro/isa95).
# Umbrella: ../handling.ttl. Single-file form of the use case: ../handling-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix han: <https://w3id.org/maestro/examples/ltu-festo-mps/handling#> .
@prefix ltu: <https://w3id.org/maestro/examples/ltu-festo-mps/shared#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/handling/ext/isa95> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Handling station - ext/isa95"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/handling> ;
    owl:imports <https://w3id.org/maestro/isa95> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:WorkUnit (1)
#################################################################

han:Station a maestro:WorkUnit ;
    maestro:partOfWorkCenter ltu:MPSLine .
