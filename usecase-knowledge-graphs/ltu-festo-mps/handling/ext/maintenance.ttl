# MAESTRO example: LTU Festo MPS - Handling station
# ext/maintenance.ttl: statements that belong to the MAESTRO maintenance module (https://w3id.org/maestro/maintenance).
# Umbrella: ../handling.ttl. Single-file form of the use case: ../handling-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix han: <https://w3id.org/maestro/examples/ltu-festo-mps/handling#> .
@prefix ltu: <https://w3id.org/maestro/examples/ltu-festo-mps/shared#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/handling/ext/maintenance> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Handling station - ext/maintenance"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/handling> ;
    owl:imports <https://w3id.org/maestro/maintenance> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:MaintenancePlan (1)
#################################################################

han:MaintenancePlan a maestro:MaintenancePlan ;
    rdfs:label "Handling station care plan (manual chapter 'Maintenance')"@en ;
    maestro:description "Only 'at regular intervals' is given; no numeric interval is stated."@en ;
    maestro:hasTask han:MT_CleanFibreOptic,
        ltu:MT_CleanOptics,
        ltu:MT_CleanProximitySensors,
        ltu:MT_CleanStation,
        ltu:MT_VisualCheck ;
    maestro:planForAsset han:PicAlfaModule,
        han:ReceptacleModule,
        han:Slide1,
        han:Slide2,
        han:StationLinkReceiver,
        han:StationLinkTransmitter,
        han:ValveTerminal .

#################################################################
# maestro:MaintenanceTask (1)
#################################################################

han:MT_CleanFibreOptic a maestro:MaintenanceTask ;
    rdfs:label "Clean the fibre-optic devices only with water (max. 60 degC) or isopropyl alcohol"@en .
