<https://w3id.org/maestro/examples/ltu-festo-mps/handling> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Handling station"@en ;
    rdfs:comment "The Festo MPS Handling station of the LTU line: modules, parts list, I/O allocation, skills, safety and care. The GRAFCET control sequence is an HHM-Core recipe in core/recipe.ttl. Built from manual 655633, the electric and pneumatic circuit diagrams, parts list 526883, data sheets and the GRAFCET. This file is the merged form of all module files of this use case in one document."@en ;
    owl:imports <https://w3id.org/maestro/examples/ltu-festo-mps/shared> ;
    owl:versionIRI <https://w3id.org/maestro/examples/ltu-festo-mps/handling/0.1.0> ;
    owl:versionInfo "0.1.0" .

#################################################################
# core/resource.ttl
#################################################################

han:Station a maestro:Station ;
    rdfs:label "Handling station"@en ;
    maestro:description "Station 4 (HA) of the MPS. Takes a workpiece from the receptacle with the PicAlfa two-axis pneumatic handling device, tells black from non-black (red, metallic) with an optical sensor in the gripper jaw, and puts black workpieces on slide 1 (inner) and red/silver ones on slide 2 (outer); after moving the slide-2 end stop it can pass workpieces to a downstream station instead. Last station of the LTU line."@en ;
    maestro:hasIdentifier han:ID_ManualOrderNo, han:ID_StationMaterialNo ;
    maestro:hasModule han:ControlConsole,
        han:IOTerminal,
        han:PLCBoard,
        han:PicAlfaModule,
        han:ReceptacleModule,
        han:ServiceUnit,
        han:Slide1,
        han:Slide2,
        han:StationLinkReceiver,
        han:StationLinkTransmitter,
        han:ValveTerminal ;
    maestro:hasParameterDef han:TD_AirConsumption,
        han:TD_DigitalInputs,
        han:TD_DigitalOutputs,
        han:TD_MaxPressure,
        han:TD_OperatingPressure,
        han:TD_SlideCapacity,
        han:TD_SupplyCurrent,
        han:TD_SupplyVoltage ;
    maestro:manufacturer "Festo Didactic GmbH & Co. KG" ;
    maestro:model "MPS Handling station (HA, PicAlfa)" .

han:ControlConsole a maestro:Module ;
    rdfs:label "Control console"@en ;
    maestro:description "START, STOP, RESET, AUTO/MAN and EMERGENCY-STOP (if available); connected via XMG1."@en ;
    maestro:providesCapability ltu:OperatorInterfaceCapability .

han:IOTerminal a maestro:Module ;
    rdfs:label "I/O terminal"@en ;
    maestro:description "Station side of SysLink XMA2: inputs I0-I7, outputs O0-O3 and O7 used (O4-O6 free)."@en ;
    maestro:hasIdentifier ltu:PN_034035 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP-B-AN-E/A-T" ;
    maestro:providesCapability ltu:StationControlCapability .

han:PLCBoard a maestro:Module ;
    rdfs:label "PLC board"@en ;
    maestro:description "Connects to XMA2, XMG1, the power supply and the PC."@en ;
    maestro:model "PLC board (controller not stated)" ;
    maestro:providesCapability ltu:StationControlCapability .

han:PicAlfaModule a maestro:Module ;
    rdfs:label "PicAlfa module (two-axis pick & place)"@en ;
    maestro:description "Rodless linear axis 1A1 (DGPL-12, positions receptacle / slide 1 / slide 2, end stops with shock absorbers, sensors 1B1-1B3), flat lifting cylinder 2A1 (DZF-18-80, sensors 2B1/2B2) and parallel gripper 3A1 (HGP-10) with fibre-optic sensor 3B1 flush in the jaw. The gripper state is not sensed."@en ;
    maestro:hasIdentifier ltu:PN_526215 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-PA-B-BS" ;
    maestro:providesCapability ltu:LiftingCapability,
        ltu:MaterialRecognitionCapability,
        ltu:MechanicalGrippingCapability,
        ltu:SortingCapability,
        ltu:TransferCapability .

han:ReceptacleModule a maestro:Module ;
    rdfs:label "Receptacle (holder) module"@en ;
    maestro:description "Holds the workpiece at the pick-up position ('upstream station' in the circuit diagram); fibre-optic diffuse sensor PART_AV detects it. Stand-alone, workpieces are inserted by hand."@en ;
    maestro:hasIdentifier ltu:PN_195777 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-AN-BS" ;
    maestro:providesCapability ltu:PresenceSensingCapability .

han:ServiceUnit a maestro:Module ;
    rdfs:label "Service unit (start-up valve with filter-control valve)"@en ;
    maestro:description "Compressed-air inlet, set to 4 bar."@en ;
    maestro:hasIdentifier ltu:PN_152894 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:S-PVW-LFR" ;
    maestro:providesCapability ltu:PneumaticActuationCapability .

han:Slide1 a maestro:Module ;
    rdfs:label "Slide 1 (inner, black workpieces)"@en ;
    maestro:description "Receives black workpieces; holds 5; inclination adjustable."@en ;
    maestro:hasIdentifier ltu:PN_653393 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-RT250" ;
    maestro:providesCapability ltu:SlideConveyingCapability .

han:Slide2 a maestro:Module ;
    rdfs:label "Slide 2 (outer, red/silver workpieces)"@en ;
    maestro:description "Receives red and silver workpieces; holds 5; inclination adjustable."@en ;
    maestro:hasIdentifier ltu:PN_653393 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-RT250" ;
    maestro:providesCapability ltu:SlideConveyingCapability .

han:StationLinkReceiver a maestro:Module ;
    rdfs:label "StationLink receiver IP_FI"@en ;
    maestro:description "Outgoing-material side; reads 'downstream station free' (I7). As the last station of the line it faces no transmitter; what the program then reads is not stated."@en ;
    maestro:hasIdentifier ltu:PN_196964 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-SLE" ;
    maestro:providesCapability ltu:StationLinkCapability .

han:StationLinkTransmitter a maestro:Module ;
    rdfs:label "StationLink transmitter IP_N_FO"@en ;
    maestro:description "Incoming-material side; signals 'station occupied' to the upstream station (O7)."@en ;
    maestro:hasIdentifier ltu:PN_196963 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-SLS" ;
    maestro:providesCapability ltu:StationLinkCapability .

han:ValveTerminal a maestro:Module ;
    rdfs:label "CPV valve terminal 0V1"@en ;
    maestro:description "CPV10 valve terminal with 1M1/1M2 (linear axis), 1V1 (5/3 closed-centre kit), 2M1 (extend gripper) and 3M1 (open gripper). Valve-to-coil mapping inferred."@en ;
    maestro:hasIdentifier ltu:PN_526872 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-CP-GMM" ;
    maestro:providesCapability ltu:PneumaticActuationCapability .

#################################################################
# core/skill.ttl
#################################################################

han:CloseGripper a maestro:AtomicSkill ;
    rdfs:label "Close gripper"@en ;
    maestro:description "De-energise 3M1."@en ;
    maestro:hasParameterDef han:DO_OpenGripper ;
    maestro:hasPostcondition han:Post_CloseGripper ;
    maestro:requiresCapability ltu:MechanicalGrippingCapability ;
    maestro:version "DE 01/04" .

han:DetectMaterial a maestro:AtomicSkill ;
    rdfs:label "Detect material class in the gripper"@en ;
    maestro:description "Read 3B1 while the workpiece is held: black or red/silver."@en ;
    maestro:hasParameterDef han:DI_NotBlack ;
    maestro:hasPostcondition han:Post_DetectMaterial ;
    maestro:requiresCapability ltu:MaterialRecognitionCapability ;
    maestro:version "DE 01/04" .

han:ExtendGripper a maestro:AtomicSkill ;
    rdfs:label "Extend gripper (lower)"@en ;
    maestro:description "Energise 2M1: the lifting cylinder lowers the gripper."@en ;
    maestro:hasParameterDef han:DI_GripperExtended, han:DO_ExtendGripper ;
    maestro:hasPostcondition han:Post_ExtendGripper ;
    maestro:requiresCapability ltu:LiftingCapability ;
    maestro:version "DE 01/04" .

han:MoveToSlideBlack a maestro:AtomicSkill ;
    rdfs:label "Move linear drive to 'slide black'"@en ;
    maestro:description "Move the axis to the sorting position 1B3 (slide 1). That the axis stops there by de-energising both 1M1 and 1M2 (closed-centre 1V1) is inferred."@en ;
    maestro:hasParameterDef han:DI_AtSortingPosition ;
    maestro:hasPostcondition han:Post_MoveToSlideBlack ;
    maestro:requiresCapability ltu:SortingCapability, ltu:TransferCapability ;
    maestro:version "DE 01/04" .

han:MoveToSlideRedSilver a maestro:AtomicSkill ;
    rdfs:label "Move linear drive to 'slide red/silver' (or 'downstream station')"@en ;
    maestro:description "Energise 1M2: the axis runs to the slide-2 end stop."@en ;
    maestro:hasParameterDef han:DI_AtDownstream, han:DO_ToDownstream ;
    maestro:hasPostcondition han:Post_MoveToSlideRedSilver ;
    maestro:requiresCapability ltu:SortingCapability, ltu:TransferCapability ;
    maestro:version "DE 01/04" .

han:MoveToUpstream a maestro:AtomicSkill ;
    rdfs:label "Move linear drive to 'upstream station'"@en ;
    maestro:description "Energise 1M1: the axis returns to the receptacle."@en ;
    maestro:hasParameterDef han:DI_AtUpstream, han:DO_ToUpstream ;
    maestro:hasPostcondition han:Post_MoveToUpstream ;
    maestro:requiresCapability ltu:TransferCapability ;
    maestro:version "DE 01/04" .

han:OpenGripper a maestro:AtomicSkill ;
    rdfs:label "Open gripper"@en ;
    maestro:description "Energise 3M1."@en ;
    maestro:hasParameterDef han:DO_OpenGripper ;
    maestro:hasPostcondition han:Post_OpenGripper ;
    maestro:requiresCapability ltu:MechanicalGrippingCapability ;
    maestro:version "DE 01/04" .

han:ResetStation a maestro:AtomicSkill ;
    rdfs:label "Reset to initial position"@en ;
    maestro:description "GRAFCET steps 3-4: move to the initial position and set flag 'reset finished'."@en ;
    maestro:hasParameterDef han:CC_Reset, han:DI_AtUpstream, han:DI_GripperRetracted ;
    maestro:hasPostcondition han:Post_ResetStation ;
    maestro:hasPrecondition han:Pre_ResetStation ;
    maestro:requiresCapability ltu:StationControlCapability ;
    maestro:version "DE 01/04" .

han:RetractGripper a maestro:AtomicSkill ;
    rdfs:label "Retract gripper (raise)"@en ;
    maestro:description "De-energise 2M1."@en ;
    maestro:hasParameterDef han:DI_GripperRetracted, han:DO_ExtendGripper ;
    maestro:hasPostcondition han:Post_RetractGripper ;
    maestro:requiresCapability ltu:LiftingCapability ;
    maestro:version "DE 01/04" .

han:SetStationLinkSignal a maestro:AtomicSkill ;
    rdfs:label "Signal 'station occupied' / 'not occupied'"@en ;
    maestro:description "Switch the StationLink transmitter towards the upstream station."@en ;
    maestro:hasParameterDef han:DO_StationOccupied, han:T_PickDelay ;
    maestro:requiresCapability ltu:StationLinkCapability ;
    maestro:version "DE 01/04" .

han:SwitchIndicatorLight a maestro:AtomicSkill ;
    rdfs:label "Switch indicator light"@en ;
    maestro:description "Turn the 'reset' or 'start' light on or off."@en ;
    maestro:hasParameterDef han:CC_ResetLamp, han:CC_StartLamp ;
    maestro:requiresCapability ltu:OperatorInterfaceCapability ;
    maestro:version "DE 01/04" .

han:PickAndSortWorkpiece a maestro:CompositeSkill ;
    rdfs:label "Pick and sort workpiece (station cycle)"@en ;
    maestro:description "Pick the workpiece from the receptacle, recognise black / non-black in the gripper and deposit it on slide 1 (black) or slide 2 (red/silver) (manual section 5, GRAFCET steps 7-18)."@en ;
    maestro:hasInterfaceContract han:StationIO ;
    maestro:hasPostcondition han:Post_PickAndSortWorkpiece ;
    maestro:hasPrecondition han:Pre_PickAndSortWorkpiece ;
    maestro:hasSubSkill han:CloseGripper,
        han:DetectMaterial,
        han:ExtendGripper,
        han:MoveToSlideBlack,
        han:MoveToSlideRedSilver,
        han:MoveToUpstream,
        han:OpenGripper,
        han:RetractGripper ;
    maestro:requiresCapability ltu:LiftingCapability,
        ltu:MaterialRecognitionCapability,
        ltu:MechanicalGrippingCapability,
        ltu:SortingCapability,
        ltu:TransferCapability ;
    maestro:version "DE 01/04" .

han:CC_AutoMan a maestro:ParameterDef ;
    rdfs:label "Key-operated switch AUTO/MAN"@en ;
    maestro:description "AUTO = continuous cycle, MAN = individual cycle. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:CC_EmergencyStop a maestro:ParameterDef ;
    rdfs:label "EMERGENCY-STOP pushbutton (if available)"@en ;
    maestro:description "Interrupts the sequence at any time; must be released before a program is loaded. Whether it is a PLC input or a hard-wired safety circuit is not stated. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:CC_Reset a maestro:ParameterDef ;
    rdfs:label "RESET pushbutton (illuminated)"@en ;
    maestro:description "The reset sequence is prompted by the illuminated RESET pushbutton and runs when it is pressed. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:CC_ResetLamp a maestro:ParameterDef ;
    rdfs:label "'reset' indicator light"@en ;
    maestro:description "Lamp of the RESET pushbutton; on while the station is not reset. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

han:CC_Start a maestro:ParameterDef ;
    rdfs:label "START pushbutton (illuminated)"@en ;
    maestro:description "Starts the sequence; also acknowledges an error after the operator has removed its cause. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:CC_StartLamp a maestro:ParameterDef ;
    rdfs:label "'start' indicator light"@en ;
    maestro:description "Lamp of the START pushbutton; on while the station waits for START. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

han:CC_Stop a maestro:ParameterDef ;
    rdfs:label "STOP pushbutton"@en ;
    maestro:description "Interrupts the sequence at any time. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:DI_AtDownstream a maestro:ParameterDef ;
    rdfs:label "Handling at downstream station"@en ;
    maestro:description "Linear axis at slide 2 (or at the downstream station after re-fitting)."@en ;
    maestro:hasIdentifier han:ID_DI_AtDownstream_BMK,
        han:ID_DI_AtDownstream_Bit,
        han:ID_DI_AtDownstream_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:DI_AtSortingPosition a maestro:ParameterDef ;
    rdfs:label "Handling at sorting position"@en ;
    maestro:description "Linear axis at the sorting position (slide 1, inferred)."@en ;
    maestro:hasIdentifier han:ID_DI_AtSortingPosition_BMK,
        han:ID_DI_AtSortingPosition_Bit,
        han:ID_DI_AtSortingPosition_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:DI_AtUpstream a maestro:ParameterDef ;
    rdfs:label "Handling at upstream station"@en ;
    maestro:description "Linear axis at the pick-up (receptacle) position."@en ;
    maestro:hasIdentifier han:ID_DI_AtUpstream_BMK,
        han:ID_DI_AtUpstream_Bit,
        han:ID_DI_AtUpstream_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:DI_DownstreamFree a maestro:ParameterDef ;
    rdfs:label "Downstream station free"@en ;
    maestro:description "StationLink receiver."@en ;
    maestro:hasIdentifier han:ID_DI_DownstreamFree_BMK,
        han:ID_DI_DownstreamFree_Bit,
        han:ID_DI_DownstreamFree_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:DI_GripperExtended a maestro:ParameterDef ;
    rdfs:label "Gripper extended"@en ;
    maestro:description "Lifting cylinder advanced (gripper lowered)."@en ;
    maestro:hasIdentifier han:ID_DI_GripperExtended_BMK,
        han:ID_DI_GripperExtended_Bit,
        han:ID_DI_GripperExtended_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:DI_GripperRetracted a maestro:ParameterDef ;
    rdfs:label "Gripper retracted"@en ;
    maestro:description "Lifting cylinder retracted (gripper raised)."@en ;
    maestro:hasIdentifier han:ID_DI_GripperRetracted_BMK,
        han:ID_DI_GripperRetracted_Bit,
        han:ID_DI_GripperRetracted_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:DI_NotBlack a maestro:ParameterDef ;
    rdfs:label "Workpiece is not black"@en ;
    maestro:description "Fibre-optic diffuse sensor in the gripper jaw; 1 = red or metallic, 0 = black (or no workpiece)."@en ;
    maestro:hasIdentifier han:ID_DI_NotBlack_BMK, han:ID_DI_NotBlack_Bit, han:ID_DI_NotBlack_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:DI_WorkpieceAvailable a maestro:ParameterDef ;
    rdfs:label "Workpiece available"@en ;
    maestro:description "Fibre-optic diffuse sensor in the receptacle; 1 = workpiece in the receptacle."@en ;
    maestro:hasIdentifier han:ID_DI_WorkpieceAvailable_BMK,
        han:ID_DI_WorkpieceAvailable_Bit,
        han:ID_DI_WorkpieceAvailable_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

han:DO_ExtendGripper a maestro:ParameterDef ;
    rdfs:label "Extend gripper"@en ;
    maestro:description "Lifting cylinder extends; de-energised = retract."@en ;
    maestro:hasIdentifier han:ID_DO_ExtendGripper_BMK,
        han:ID_DO_ExtendGripper_Bit,
        han:ID_DO_ExtendGripper_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

han:DO_OpenGripper a maestro:ParameterDef ;
    rdfs:label "Open gripper"@en ;
    maestro:description "De-energised = close (monostable valve, inferred)."@en ;
    maestro:hasIdentifier han:ID_DO_OpenGripper_BMK,
        han:ID_DO_OpenGripper_Bit,
        han:ID_DO_OpenGripper_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

han:DO_StationOccupied a maestro:ParameterDef ;
    rdfs:label "Station occupied"@en ;
    maestro:description "StationLink transmitter towards the upstream station."@en ;
    maestro:hasIdentifier han:ID_DO_StationOccupied_BMK,
        han:ID_DO_StationOccupied_Bit,
        han:ID_DO_StationOccupied_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

han:DO_ToDownstream a maestro:ParameterDef ;
    rdfs:label "Handling to downstream station"@en ;
    maestro:description "Linear axis towards slide 2 / downstream station."@en ;
    maestro:hasIdentifier han:ID_DO_ToDownstream_BMK,
        han:ID_DO_ToDownstream_Bit,
        han:ID_DO_ToDownstream_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

han:DO_ToUpstream a maestro:ParameterDef ;
    rdfs:label "Handling to upstream station"@en ;
    maestro:description "Linear axis towards the pick-up position."@en ;
    maestro:hasIdentifier han:ID_DO_ToUpstream_BMK,
        han:ID_DO_ToUpstream_Bit,
        han:ID_DO_ToUpstream_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

han:TD_AirConsumption a maestro:ParameterDef ;
    rdfs:label "Compressed-air supply, suction capacity approx. 50 l/min"@en ;
    maestro:description "Compressed-air supply named for commissioning (approximate value)."@en ;
    maestro:maxValue 50.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:unitRef "http://qudt.org/vocab/unit/L-PER-MIN"^^xsd:anyURI .

