han:DI_GripperRetracted a maestro:DtdlTelemetry .

han:DI_NotBlack a maestro:DtdlTelemetry .

han:DI_WorkpieceAvailable a maestro:DtdlTelemetry .

han:CC_ResetLamp a maestro:DtdlProperty .

han:CC_StartLamp a maestro:DtdlProperty .

han:DO_ExtendGripper a maestro:DtdlProperty .

han:DO_OpenGripper a maestro:DtdlProperty .

han:DO_StationOccupied a maestro:DtdlProperty .

han:DO_ToDownstream a maestro:DtdlProperty .

han:DO_ToUpstream a maestro:DtdlProperty .

han:TD_AirConsumption a maestro:DtdlProperty .

han:TD_DigitalInputs a maestro:DtdlProperty .

han:TD_DigitalOutputs a maestro:DtdlProperty .

han:TD_MaxPressure a maestro:DtdlProperty .

han:TD_OperatingPressure a maestro:DtdlProperty .

