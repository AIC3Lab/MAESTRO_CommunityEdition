# MAESTRO example: LTU Festo MPS - Processing station
# core/policy.ttl: statements that belong to the MAESTRO policy module (https://w3id.org/maestro/policy).
# Umbrella: ../processing.ttl. Single-file form of the use case: ../processing-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix ltu: <https://w3id.org/maestro/examples/ltu-festo-mps/shared#> .
@prefix pro: <https://w3id.org/maestro/examples/ltu-festo-mps/processing#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/processing/core/policy> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Processing station - core/policy"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/processing> ;
    owl:imports <https://w3id.org/maestro/policy> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:Hazard (1)
#################################################################

pro:H_DrillSpindle a maestro:Hazard ;
    rdfs:label "Rotating spindle of the drilling machine"@en ;
    maestro:causesRisk ltu:R_Injury ;
    maestro:description "The drilling machine is operational; stay at a safe distance from the rotating spindle."@en .

#################################################################
# maestro:Mitigation (1)
#################################################################

pro:M_SimulatedPolishing a maestro:Mitigation ;
    rdfs:label "Polishing of the hole is only simulated"@en ;
    maestro:description "'The polishing process is merely simulated for reasons of safety.'"@en ;
    maestro:reduces ltu:R_Injury .

#################################################################
# maestro:EmergencyStop (1)
#################################################################

pro:EmergencyStop a maestro:EmergencyStop ;
    rdfs:label "EMERGENCY-STOP pushbutton, Processing station control console"@en ;
    maestro:description "The manual names the EMERGENCY-STOP pushbutton '(if available)'; together with STOP it interrupts the sequence at any time and must be released before a program is loaded. Safety category, performance level and wiring are not stated."@en ;
    maestro:mitigates ltu:H_MovingStation .

#################################################################
# Further statements about individuals described in other files (1)
#################################################################

ltu:Perm_TraineeRunsStations
    maestro:target pro:ProcessWorkpiece .
