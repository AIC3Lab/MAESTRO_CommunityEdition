# MAESTRO example: LTU Festo MPS - Processing station
# core/product.ttl: statements that belong to the MAESTRO product module (https://w3id.org/maestro/product).
# Umbrella: ../processing.ttl. Single-file form of the use case: ../processing-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix ltu: <https://w3id.org/maestro/examples/ltu-festo-mps/shared#> .
@prefix pro: <https://w3id.org/maestro/examples/ltu-festo-mps/processing#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/processing/core/product> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Processing station - core/product"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/processing> ;
    owl:imports <https://w3id.org/maestro/product> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:ProductType (1)
#################################################################

pro:StationType a maestro:ProductType ;
    rdfs:label "Festo MPS Processing station (equipment type)"@en ;
    maestro:description "The station as a Festo product; its bill of materials follows the parts list and the component tables of the documents."@en ;
    maestro:hasBOMItem pro:BOM_Accessories,
        pro:BOM_BranchModule,
        pro:BOM_ClampingModule,
        pro:BOM_Connectors,
        pro:BOM_DrillingModule,
        pro:BOM_Holder,
        pro:BOM_IOTerminal,
        pro:BOM_IndexingTable,
        pro:BOM_MountingSystem,
        pro:BOM_ProfilePlate,
        pro:BOM_Relays,
        pro:BOM_StationLinkReceiver,
        pro:BOM_StationLinkTransmitter,
        pro:BOM_TerminalBlock,
        pro:BOM_TestingModule ;
    maestro:hasIdentifier pro:ID_ManualOrderNo, pro:ID_StationMaterialNo ;
    maestro:manufacturer "Festo Didactic GmbH & Co. KG" ;
    maestro:model "MPS Processing station (BE)" .

