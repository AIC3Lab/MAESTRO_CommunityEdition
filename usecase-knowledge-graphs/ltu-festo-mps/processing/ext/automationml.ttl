# MAESTRO example: LTU Festo MPS - Processing station
# ext/automationml.ttl: statements that belong to the MAESTRO automationml module (https://w3id.org/maestro/automationml).
# Umbrella: ../processing.ttl. Single-file form of the use case: ../processing-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix pro: <https://w3id.org/maestro/examples/ltu-festo-mps/processing#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/processing/ext/automationml> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Processing station - ext/automationml"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/processing> ;
    owl:imports <https://w3id.org/maestro/automationml> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:ExternalInterface (4)
#################################################################

pro:Port_MaterialIn a maestro:ExternalInterface ;
    rdfs:label "Material input: workpiece retainer 1"@en ;
    maestro:description "PART_AV detects the workpiece here."@en .

pro:Port_MaterialOut a maestro:ExternalInterface ;
    rdfs:label "Material output: transfer position of the electrical ejector"@en ;
    maestro:description "Pick-up position of the downstream station."@en .

pro:Port_StationLinkRx a maestro:ExternalInterface ;
    rdfs:label "StationLink receiver (outgoing-material side)"@en .

pro:Port_StationLinkTx a maestro:ExternalInterface ;
    rdfs:label "StationLink transmitter (incoming-material side)"@en .

#################################################################
# Further statements about individuals described in other files (4)
#################################################################

pro:EjectorModule
    maestro:hasInterface pro:Port_MaterialOut .

pro:RotaryIndexingTable
    maestro:hasInterface pro:Port_MaterialIn .

pro:StationLinkReceiver
    maestro:hasInterface pro:Port_StationLinkRx .

pro:StationLinkTransmitter
    maestro:hasInterface pro:Port_StationLinkTx .
