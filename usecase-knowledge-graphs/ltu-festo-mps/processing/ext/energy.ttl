# MAESTRO example: LTU Festo MPS - Processing station
# ext/energy.ttl: statements that belong to the MAESTRO energy module (https://w3id.org/maestro/energy).
# Umbrella: ../processing.ttl. Single-file form of the use case: ../processing-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix pro: <https://w3id.org/maestro/examples/ltu-festo-mps/processing#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/processing/ext/energy> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Processing station - ext/energy"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/processing> ;
    owl:imports <https://w3id.org/maestro/energy> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:EnergyConsumer (7)
#################################################################

pro:ClampingModule a maestro:EnergyConsumer ;
    maestro:suppliedBy pro:PSU .

pro:ConnectionBoard a maestro:EnergyConsumer ;
    maestro:suppliedBy pro:PSU .

pro:DrillingModule a maestro:EnergyConsumer ;
    maestro:suppliedBy pro:PSU .

pro:EjectorModule a maestro:EnergyConsumer ;
    maestro:suppliedBy pro:PSU .

pro:PLCBoard a maestro:EnergyConsumer ;
    maestro:suppliedBy pro:PSU .

pro:RotaryIndexingTable a maestro:EnergyConsumer ;
    maestro:suppliedBy pro:PSU .

pro:TestingModule a maestro:EnergyConsumer ;
    maestro:suppliedBy pro:PSU .

#################################################################
# maestro:EnergySource (1)
#################################################################

pro:PSU a maestro:EnergySource ;
    rdfs:label "24 V DC power supply unit, Processing station"@en ;
    maestro:description "Power supply unit 24 V DC, 4.5 A (max. 5 A); feeds the whole station through the PLC board."@en .
