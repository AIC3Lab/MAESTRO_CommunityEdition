# MAESTRO example: LTU Festo MPS - Processing station
# ext/maintenance.ttl: statements that belong to the MAESTRO maintenance module (https://w3id.org/maestro/maintenance).
# Umbrella: ../processing.ttl. Single-file form of the use case: ../processing-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix ltu: <https://w3id.org/maestro/examples/ltu-festo-mps/shared#> .
@prefix pro: <https://w3id.org/maestro/examples/ltu-festo-mps/processing#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/processing/ext/maintenance> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Processing station - ext/maintenance"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/processing> ;
    owl:imports <https://w3id.org/maestro/maintenance> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:MaintenancePlan (1)
#################################################################

pro:MaintenancePlan a maestro:MaintenancePlan ;
    rdfs:label "Processing station care plan (manual chapter 'Maintenance')"@en ;
    maestro:description "Only 'at regular intervals' is given; no numeric interval is stated."@en ;
    maestro:hasTask ltu:MT_CleanOptics,
        ltu:MT_CleanProximitySensors,
        ltu:MT_CleanStation,
        ltu:MT_VisualCheck ;
    maestro:planForAsset pro:ClampingModule,
        pro:DrillingModule,
        pro:EjectorModule,
        pro:RotaryIndexingTable,
        pro:StationLinkReceiver,
        pro:StationLinkTransmitter,
        pro:TestingModule .
