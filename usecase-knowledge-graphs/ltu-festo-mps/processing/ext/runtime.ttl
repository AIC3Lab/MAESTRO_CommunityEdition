# MAESTRO example: LTU Festo MPS - Processing station
# ext/runtime.ttl: statements that belong to the MAESTRO runtime module (https://w3id.org/maestro/runtime).
# Umbrella: ../processing.ttl. Single-file form of the use case: ../processing-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix pro: <https://w3id.org/maestro/examples/ltu-festo-mps/processing#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/processing/ext/runtime> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Processing station - ext/runtime"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/processing> ;
    owl:imports <https://w3id.org/maestro/runtime> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:FaultSpecification (1)
#################################################################

pro:FS_WorkpieceNOK a maestro:FaultSpecification ;
    rdfs:label "Workpiece orientation not ok"@en ;
    maestro:description "GRAFCET step 42: a workpiece inserted the wrong way up reaches the output; the 'start' and WORKPIECE NOK lights go on. Remove it by hand and acknowledge with START."@en ;
    maestro:faultCode "WORKPIECE NOK" ;
    maestro:faultSeverity "operator acknowledgement" .

#################################################################
# Further statements about individuals described in other files (1)
#################################################################

pro:ProcessWorkpiece
    maestro:mayRaiseFault pro:FS_WorkpieceNOK .
