# MAESTRO example: LTU Festo MPS - shared reference data
# core/maas.ttl: statements that belong to the MAESTRO maas module (https://w3id.org/maestro/maas).
# Umbrella: ../shared.ttl. Single-file form of the use case: ../shared-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix ltu: <https://w3id.org/maestro/examples/ltu-festo-mps/shared#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/shared/core/maas> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - shared reference data - core/maas"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/shared> ;
    owl:imports <https://w3id.org/maestro/maas> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:Actor (1)
#################################################################

ltu:LTU a maestro:Actor ;
    rdfs:label "Luleå University of Technology (LTU)"@en ;
    maestro:description "Owner and operator of the Festo MPS stations of the use case. Named by the use case, not by the Festo documents."@en .
