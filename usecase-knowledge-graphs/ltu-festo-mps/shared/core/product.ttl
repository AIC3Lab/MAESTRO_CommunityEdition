@prefix maestro: <https://w3id.org/maestro#> .
@prefix ltu: <https://w3id.org/maestro/examples/ltu-festo-mps/shared#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/shared/core/product> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - shared reference data - core/product"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/shared> ;
    owl:imports <https://w3id.org/maestro/product> ;
    owl:versionInfo "0.1.0" .

