# MAESTRO example: LTU Festo MPS - shared reference data
# ext/isa95.ttl: statements that belong to the MAESTRO isa95 module (https://w3id.org/maestro/isa95).
# Umbrella: ../shared.ttl. Single-file form of the use case: ../shared-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix ltu: <https://w3id.org/maestro/examples/ltu-festo-mps/shared#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/shared/ext/isa95> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - shared reference data - ext/isa95"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/shared> ;
    owl:imports <https://w3id.org/maestro/isa95> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:Enterprise (1)
#################################################################

ltu:LTU a maestro:Enterprise .

#################################################################
# maestro:Site (1)
#################################################################

ltu:LTUSite a maestro:Site ;
    rdfs:label "LTU, Luleå"@en ;
    maestro:partOfEnterprise ltu:LTU .

#################################################################
# maestro:Area (1)
#################################################################

ltu:MPSLab a maestro:Area ;
    rdfs:label "MPS laboratory (room not stated)"@en ;
    maestro:partOfSite ltu:LTUSite .

#################################################################
# maestro:WorkCenter (1)
#################################################################

ltu:MPSLine a maestro:WorkCenter ;
    rdfs:label "Festo MPS line: Distributing - Testing - Processing - Handling"@en ;
    maestro:description "Line of four Festo Didactic MPS stations linked by optical StationLink (1-bit link). Order assumed from the Festo station numbering 1-4; the LTU layout itself is not stated in the documents."@en ;
    maestro:partOfArea ltu:MPSLab .
