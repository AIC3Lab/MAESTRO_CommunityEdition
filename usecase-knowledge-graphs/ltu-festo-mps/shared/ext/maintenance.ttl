# MAESTRO example: LTU Festo MPS - shared reference data
# ext/maintenance.ttl: statements that belong to the MAESTRO maintenance module (https://w3id.org/maestro/maintenance).
# Umbrella: ../shared.ttl. Single-file form of the use case: ../shared-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix ltu: <https://w3id.org/maestro/examples/ltu-festo-mps/shared#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/shared/ext/maintenance> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - shared reference data - ext/maintenance"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/shared> ;
    owl:imports <https://w3id.org/maestro/maintenance> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:MaintenanceTask (4)
#################################################################

ltu:MT_CleanOptics a maestro:MaintenanceTask ;
    rdfs:label "Clean lenses of optical sensors, fibre optics and reflectors (at regular intervals)"@en .

ltu:MT_CleanProximitySensors a maestro:MaintenanceTask ;
    rdfs:label "Clean the active surface of the proximity sensors (at regular intervals)"@en .

ltu:MT_CleanStation a maestro:MaintenanceTask ;
    rdfs:label "Clean the entire station (at regular intervals)"@en .

ltu:MT_VisualCheck a maestro:MaintenanceTask ;
    rdfs:label "Visual check of electrical connections, compressed-air connections and mechanical components before each commissioning"@en .
