# MAESTRO example: LTU Festo MPS - Testing station
# core/product.ttl: statements that belong to the MAESTRO product module (https://w3id.org/maestro/product).
# Umbrella: ../testing.ttl. Single-file form of the use case: ../testing-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix ltu: <https://w3id.org/maestro/examples/ltu-festo-mps/shared#> .
@prefix tes: <https://w3id.org/maestro/examples/ltu-festo-mps/testing#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/testing/core/product> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Testing station - core/product"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/testing> ;
    owl:imports <https://w3id.org/maestro/product> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:ProductType (1)
#################################################################

tes:StationType a maestro:ProductType ;
    rdfs:label "Festo MPS Testing station (equipment type)"@en ;
    maestro:description "The station as a Festo product; its bill of materials follows the parts list and the component tables of the documents."@en ;
    maestro:hasBOMItem tes:BOM_Accessories,
        tes:BOM_AirSlide,
        tes:BOM_CableGuide,
        tes:BOM_Connectors,
        tes:BOM_Holder,
        tes:BOM_IOTerminal,
        tes:BOM_Lifting,
        tes:BOM_LowerSlide,
        tes:BOM_Measuring,
        tes:BOM_MountingSystem,
        tes:BOM_ProfilePlate,
        tes:BOM_Recognition,
        tes:BOM_RetroReflectiveSensor,
        tes:BOM_ServiceUnit,
        tes:BOM_StationLinkReceiver,
        tes:BOM_StationLinkTransmitter,
        tes:BOM_ValveTerminal ;
    maestro:hasIdentifier tes:ID_ManualOrderNo, tes:ID_StationMaterialNo ;
    maestro:manufacturer "Festo Didactic GmbH & Co. KG" ;
    maestro:model "MPS Testing station (PR)" .

