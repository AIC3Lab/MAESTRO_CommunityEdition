# MAESTRO example: LTU Festo MPS - Testing station
# ext/energy.ttl: statements that belong to the MAESTRO energy module (https://w3id.org/maestro/energy).
# Umbrella: ../testing.ttl. Single-file form of the use case: ../testing-merged.ttl.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix maestro: <https://w3id.org/maestro#> .
@prefix tes: <https://w3id.org/maestro/examples/ltu-festo-mps/testing#> .

<https://w3id.org/maestro/examples/ltu-festo-mps/testing/ext/energy> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Testing station - ext/energy"@en ;
    dct:isPartOf <https://w3id.org/maestro/examples/ltu-festo-mps/testing> ;
    owl:imports <https://w3id.org/maestro/energy> ;
    owl:versionInfo "0.1.0" .

#################################################################
# maestro:EnergyConsumer (6)
#################################################################

tes:AirSlideModule a maestro:EnergyConsumer ;
    maestro:suppliedBy maestro:CompressedAir .

tes:LiftingModule a maestro:EnergyConsumer ;
    maestro:suppliedBy maestro:CompressedAir .

tes:MeasuringModule a maestro:EnergyConsumer ;
    maestro:suppliedBy tes:PSU .

tes:PLCBoard a maestro:EnergyConsumer ;
    maestro:suppliedBy tes:PSU .

tes:ServiceUnit a maestro:EnergyConsumer ;
    maestro:suppliedBy maestro:CompressedAir .

tes:ValveTerminal a maestro:EnergyConsumer ;
    maestro:suppliedBy maestro:CompressedAir, tes:PSU .

#################################################################
# maestro:EnergySource (1)
#################################################################

tes:PSU a maestro:EnergySource ;
    rdfs:label "24 V DC power supply unit, Testing station"@en ;
    maestro:description "Power supply unit 24 V DC, 4.5 A; feeds the whole station through the PLC board."@en .
