<https://w3id.org/maestro/examples/ltu-festo-mps/testing> a owl:Ontology ;
    rdfs:label "MAESTRO example: LTU Festo MPS - Testing station"@en ;
    rdfs:comment "The Festo MPS Testing station of the LTU line: modules, parts list, I/O allocation, skills, safety and care. The GRAFCET control sequence is an HHM-Core recipe in core/recipe.ttl. Built from manual 648812, the electric and pneumatic circuit diagrams, parts list 526881, data sheets and the GRAFCET. This file is the merged form of all module files of this use case in one document."@en ;
    owl:imports <https://w3id.org/maestro/examples/ltu-festo-mps/shared> ;
    owl:versionIRI <https://w3id.org/maestro/examples/ltu-festo-mps/testing/0.1.0> ;
    owl:versionInfo "0.1.0" .

#################################################################
# core/resource.ttl
#################################################################

tes:Station a maestro:Station ;
    rdfs:label "Testing station"@en ;
    maestro:description "Station 2 (PR) of the MPS. Determines the material characteristics of a workpiece (black vs red/silver), checks its height and either rejects it or passes it to the next station: the Recognition module detects the workpiece and its colour class, the Lifting module raises it to the Measuring module (analogue height sensor and comparator), and the ejecting cylinder pushes good workpieces onto the upper air cushioned slide and rejected ones onto the lower slide."@en ;
    maestro:hasIdentifier tes:ID_ManualOrderNo, tes:ID_StationMaterialNo ;
    maestro:hasModule tes:AirSlideModule,
        tes:ControlConsole,
        tes:IOTerminal,
        tes:LiftingModule,
        tes:MeasuringModule,
        tes:PLCBoard,
        tes:RecognitionModule,
        tes:SafetyLightBarrier,
        tes:ServiceUnit,
        tes:SlideModule,
        tes:StationLinkReceiver,
        tes:StationLinkTransmitter,
        tes:ValveTerminal ;
    maestro:hasParameterDef tes:TD_AirConsumption,
        tes:TD_AirSlideCapacity,
        tes:TD_DigitalInputs,
        tes:TD_DigitalOutputs,
        tes:TD_LowerSlideCapacity,
        tes:TD_MaxPressure,
        tes:TD_MeasuringModuleHeight,
        tes:TD_OperatingPressure,
        tes:TD_SupplyCurrent,
        tes:TD_SupplyVoltage ;
    maestro:manufacturer "Festo Didactic GmbH & Co. KG" ;
    maestro:model "MPS Testing station (PR)" .

tes:AirSlideModule a maestro:Module ;
    rdfs:label "Air cushioned slide module"@en ;
    maestro:description "Upper slide: takes good workpieces to the downstream station; the air cushion evens out friction. Inclination adjustable; stopper turned 180 degrees when a downstream station follows."@en ;
    maestro:hasIdentifier ltu:PN_656859 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-LRT-B" ;
    maestro:providesCapability ltu:SlideConveyingCapability .

tes:ControlConsole a maestro:Module ;
    rdfs:label "Control console"@en ;
    maestro:description "START, STOP, RESET, AUTO/MAN, EMERGENCY-STOP (if available) and the COLOUR warning light; connected via XMG1."@en ;
    maestro:providesCapability ltu:OperatorInterfaceCapability .

tes:IOTerminal a maestro:Module ;
    rdfs:label "I/O terminal"@en ;
    maestro:description "Station side of SysLink XMA2: inputs I0-I7, outputs O0-O3 and O7 used."@en ;
    maestro:hasIdentifier ltu:PN_034035 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP-B-AN-E/A-T" ;
    maestro:providesCapability ltu:StationControlCapability .

tes:LiftingModule a maestro:Module ;
    rdfs:label "Lifting module"@en ;
    maestro:description "Rodless lifting cylinder 1A1 (DGO-12) lifts the workpiece from the retainer to the Measuring module; short-stroke ejecting cylinder 2A1 (ADVU-16) pushes it onto the upper or lower slide. End positions 1B1/1B2 (SMTO-1) and 2B1 (SME-8)."@en ;
    maestro:hasIdentifier ltu:PN_532954 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-MH" ;
    maestro:providesCapability ltu:EjectingCapability, ltu:LiftingCapability, ltu:SortingCapability .

tes:MeasuringModule a maestro:Module ;
    rdfs:label "Measuring module"@en ;
    maestro:description "Linear potentiometer R1 gives the workpiece height as 0-10 V; comparator 3A1 turns it into 'height correct' (window LEVEL1-LEVEL2), or the analogue value goes to a PLC via XMA3. A shock absorber cushions the lifting cylinder's upper end position."@en ;
    maestro:hasIdentifier ltu:PN_195779 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP2-M-M" ;
    maestro:providesCapability ltu:HeightMeasuringCapability .

tes:PLCBoard a maestro:Module ;
    rdfs:label "PLC board"@en ;
    maestro:description "Connects to XMA2, XMA3 (analogue variant), XMG1, the power supply and the PC."@en ;
    maestro:model "PLC board (controller not stated)" ;
    maestro:providesCapability ltu:StationControlCapability .

tes:RecognitionModule a maestro:Module ;
    rdfs:label "Recognition module"@en ;
    maestro:description "Capacitive sensor PART_AV detects every workpiece; diffuse sensor B2 detects red and silver workpieces but not black ones. A logic combination gives 'black' or 'red/silver'; red and silver cannot be told apart."@en ;
    maestro:hasIdentifier ltu:PN_526850 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-ME" ;
    maestro:providesCapability ltu:MaterialRecognitionCapability, ltu:PresenceSensingCapability .

tes:SafetyLightBarrier a maestro:Module ;
    rdfs:label "Safety light barrier B4 (retro-reflective sensor)"@en ;
    maestro:description "Retro-reflective sensor SOEG-RSP-Q30-PS-S-2L on the lifting-module bracket; checks that the working area above the retainer is free before the lifting cylinder moves."@en ;
    maestro:hasIdentifier ltu:PN_196969 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-SOEG-RT-Q3" ;
    maestro:providesCapability ltu:PresenceSensingCapability .

tes:ServiceUnit a maestro:Module ;
    rdfs:label "Service unit (start-up valve with filter-control valve)"@en ;
    maestro:description "Compressed-air inlet, set to 6 bar."@en ;
    maestro:hasIdentifier ltu:PN_152894 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:S-PVW-LFR" ;
    maestro:providesCapability ltu:PneumaticActuationCapability .

tes:SlideModule a maestro:Module ;
    rdfs:label "Slide module 210 (lower slide)"@en ;
    maestro:description "Lower slide for rejected workpieces; holds 4."@en ;
    maestro:hasIdentifier ltu:PN_656858 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-R210" ;
    maestro:providesCapability ltu:SlideConveyingCapability .

tes:StationLinkReceiver a maestro:Module ;
    rdfs:label "StationLink receiver IP_FI"@en ;
    maestro:description "Outgoing-material side; reads 'downstream station free' (I7)."@en ;
    maestro:hasIdentifier ltu:PN_196964 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-SLE" ;
    maestro:providesCapability ltu:StationLinkCapability .

tes:StationLinkTransmitter a maestro:Module ;
    rdfs:label "StationLink transmitter IP_N_FO"@en ;
    maestro:description "Incoming-material side; signals 'station occupied' to the upstream station (O7)."@en ;
    maestro:hasIdentifier ltu:PN_196963 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-SLS" ;
    maestro:providesCapability ltu:StationLinkCapability .

tes:ValveTerminal a maestro:Module ;
    rdfs:label "CPV valve terminal 0V1"@en ;
    maestro:description "Valve locations 1V1 (code C: two 3/2-way valves, 1M1 lower / 1M2 raise), 2V1 (code M: 5/2-way, 2M1 eject) and 3V1 (code M: 5/2-way, 3M1 air slide)."@en ;
    maestro:hasIdentifier ltu:PN_526227 ;
    maestro:manufacturer "Festo" ;
    maestro:model "D:MP3-M-MCM" ;
    maestro:providesCapability ltu:PneumaticActuationCapability .

#################################################################
# core/skill.ttl
#################################################################

tes:DetectMaterial a maestro:AtomicSkill ;
    rdfs:label "Detect workpiece and material class"@en ;
    maestro:description "Read PART_AV and B2: black if PART_AV and not B2, red/silver if both. Silver and red are not told apart."@en ;
    maestro:hasParameterDef tes:DI_NotBlack, tes:DI_WorkpieceAvailable, tes:T_RecognitionDwell ;
    maestro:hasPostcondition tes:Post_DetectMaterial ;
    maestro:hasPrecondition tes:Pre_DetectMaterial ;
    maestro:requiresCapability ltu:MaterialRecognitionCapability, ltu:PresenceSensingCapability ;
    maestro:version "DE 01/04" .

tes:EjectWorkpiece a maestro:AtomicSkill ;
    rdfs:label "Eject workpiece"@en ;
    maestro:description "Extend and retract the ejecting cylinder: in the upper position onto the air cushioned slide, in the lower position onto the lower slide."@en ;
    maestro:hasParameterDef tes:DI_EjectorRetracted, tes:DO_ExtendEjector ;
    maestro:hasPostcondition tes:Post_EjectWorkpiece ;
    maestro:requiresCapability ltu:EjectingCapability ;
    maestro:version "DE 01/04" .

tes:LowerLiftingCylinder a maestro:AtomicSkill ;
    rdfs:label "Lower lifting cylinder"@en ;
    maestro:description "Lower the lifting platform to the retainer level."@en ;
    maestro:hasParameterDef tes:DI_LiftLowered, tes:DO_LowerLift ;
    maestro:hasPostcondition tes:Post_LowerLiftingCylinder ;
    maestro:requiresCapability ltu:LiftingCapability ;
    maestro:version "DE 01/04" .

tes:MeasureHeight a maestro:AtomicSkill ;
    rdfs:label "Measure workpiece height"@en ;
    maestro:description "GRAFCET step 12 (empty step 'measure height'): wait 2 s and evaluate the comparator output; the analogue value is on XMA3."@en ;
    maestro:hasParameterDef tes:AI_Height,
        tes:CFG_ComparatorLevel1,
        tes:CFG_ComparatorLevel2,
        tes:DI_HeightOK,
        tes:T_MeasuringDwell ;
    maestro:hasPostcondition tes:Post_MeasureHeight ;
    maestro:hasPrecondition tes:Pre_MeasureHeight ;
    maestro:requiresCapability ltu:HeightMeasuringCapability ;
    maestro:version "DE 01/04" .

tes:RaiseLiftingCylinder a maestro:AtomicSkill ;
    rdfs:label "Raise lifting cylinder"@en ;
    maestro:description "Lift the workpiece to the Measuring module."@en ;
    maestro:hasParameterDef tes:DI_LiftRaised, tes:DI_SafetyLightBarrier, tes:DO_RaiseLift ;
    maestro:hasPostcondition tes:Post_RaiseLiftingCylinder ;
    maestro:hasPrecondition tes:Pre_RaiseLiftingCylinder ;
    maestro:requiresCapability ltu:LiftingCapability ;
    maestro:version "DE 01/04" .

tes:ResetStation a maestro:AtomicSkill ;
    rdfs:label "Reset to initial position"@en ;
    maestro:description "GRAFCET steps 3-5: move to the initial position, eject a workpiece left on the lifting platform, set flag 'reset finished'."@en ;
    maestro:hasParameterDef tes:CC_Reset,
        tes:DI_EjectorRetracted,
        tes:DI_LiftLowered,
        tes:DI_SafetyLightBarrier ;
    maestro:hasPostcondition tes:Post_ResetStation ;
    maestro:hasPrecondition tes:Pre_ResetStation ;
    maestro:requiresCapability ltu:StationControlCapability ;
    maestro:version "DE 01/04" .

tes:SetStationLinkSignal a maestro:AtomicSkill ;
    rdfs:label "Signal 'station occupied' / 'not occupied'"@en ;
    maestro:description "Switch the StationLink transmitter towards the upstream station."@en ;
    maestro:hasParameterDef tes:DO_StationOccupied ;
    maestro:requiresCapability ltu:StationLinkCapability ;
    maestro:version "DE 01/04" .

tes:SwitchAirSlide a maestro:AtomicSkill ;
    rdfs:label "Switch air cushioned slide"@en ;
    maestro:description "Turn the air cushion of the upper slide on for the hand-over and off again."@en ;
    maestro:hasParameterDef tes:DO_AirSlideOn, tes:T_AirSlideOn ;
    maestro:requiresCapability ltu:SlideConveyingCapability ;
    maestro:version "DE 01/04" .

tes:SwitchIndicatorLight a maestro:AtomicSkill ;
    rdfs:label "Switch indicator light"@en ;
    maestro:description "Turn the 'reset', 'start' or COLOUR ('material') light on or off."@en ;
    maestro:hasParameterDef tes:CC_ColourLamp, tes:CC_ResetLamp, tes:CC_StartLamp ;
    maestro:requiresCapability ltu:OperatorInterfaceCapability ;
    maestro:version "DE 01/04" .

tes:TestWorkpiece a maestro:CompositeSkill ;
    rdfs:label "Test workpiece (station cycle)"@en ;
    maestro:description "Detect the material class, lift and measure the height, then pass a good workpiece over the air cushioned slide to the downstream station or reject it onto the lower slide (manual section 5, GRAFCET steps 8-18)."@en ;
    maestro:hasInterfaceContract tes:AnalogueIO, tes:StationIO ;
    maestro:hasPostcondition tes:Post_TestWorkpiece ;
    maestro:hasPrecondition tes:Pre_TestWorkpiece ;
    maestro:hasSubSkill tes:DetectMaterial,
        tes:EjectWorkpiece,
        tes:LowerLiftingCylinder,
        tes:MeasureHeight,
        tes:RaiseLiftingCylinder,
        tes:SwitchAirSlide ;
    maestro:requiresCapability ltu:EjectingCapability,
        ltu:HeightMeasuringCapability,
        ltu:LiftingCapability,
        ltu:MaterialRecognitionCapability,
        ltu:SortingCapability ;
    maestro:version "DE 01/04" .

tes:AI_Height a maestro:ParameterDef ;
    rdfs:label "Workpiece height, process value (analogue)"@en ;
    maestro:description "Wiper of linear potentiometer R1 to comparator AIN and XMA3 UE1. The sensor gives 0-25 mm as 0-100 % of the 10 V reference; scaling at the PLC is not stated."@en ;
    maestro:hasIdentifier tes:ID_AI_Height_BMK, tes:ID_AI_Height_Bit, tes:ID_AI_Height_Pin ;
    maestro:maxValue 10.0 ;
    maestro:minValue 0.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output ;
    maestro:unitRef "http://qudt.org/vocab/unit/V"^^xsd:anyURI .

tes:CC_AutoMan a maestro:ParameterDef ;
    rdfs:label "Key-operated switch AUTO/MAN"@en ;
    maestro:description "AUTO = continuous cycle, MAN = individual cycle. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:CC_ColourLamp a maestro:ParameterDef ;
    rdfs:label "Warning light COLOUR"@en ;
    maestro:description "Manual: off for black, on for red/silver workpieces in the Recognition module. The GRAFCET turns its 'material' light on for black (steps 9/10); the documents disagree. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:CC_EmergencyStop a maestro:ParameterDef ;
    rdfs:label "EMERGENCY-STOP pushbutton (if available)"@en ;
    maestro:description "Interrupts the sequence at any time; must be released before a program is loaded. Whether it is a PLC input or a hard-wired safety circuit is not stated. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:CC_Reset a maestro:ParameterDef ;
    rdfs:label "RESET pushbutton (illuminated)"@en ;
    maestro:description "The reset sequence is prompted by the illuminated RESET pushbutton and runs when it is pressed. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:CC_ResetLamp a maestro:ParameterDef ;
    rdfs:label "'reset' indicator light"@en ;
    maestro:description "Lamp of the RESET pushbutton; on while the station is not reset. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:CC_Start a maestro:ParameterDef ;
    rdfs:label "START pushbutton (illuminated)"@en ;
    maestro:description "Starts the sequence; also acknowledges an error after the operator has removed its cause. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:CC_StartLamp a maestro:ParameterDef ;
    rdfs:label "'start' indicator light"@en ;
    maestro:description "Lamp of the START pushbutton; on while the station waits for START. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:CC_Stop a maestro:ParameterDef ;
    rdfs:label "STOP pushbutton"@en ;
    maestro:description "Interrupts the sequence at any time. PLC address not stated in the station documents (only the connector XMG1 is named)."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:CFG_ComparatorLevel1 a maestro:ParameterDef ;
    rdfs:label "Comparator threshold LEVEL1 (lower)"@en ;
    maestro:description "Set with the red 25 mm workpiece at about the 5th scale mark so that MID lights; no value in mm or V is stated."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:unitRef "http://qudt.org/vocab/unit/V"^^xsd:anyURI .

tes:CFG_ComparatorLevel2 a maestro:ParameterDef ;
    rdfs:label "Comparator threshold LEVEL2 (upper)"@en ;
    maestro:description "Set at about the 6th scale mark; no value in mm or V is stated."@en ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:unitRef "http://qudt.org/vocab/unit/V"^^xsd:anyURI .

tes:DI_DownstreamFree a maestro:ParameterDef ;
    rdfs:label "Downstream station free"@en ;
    maestro:description "StationLink receiver; light/dark polarity not stated."@en ;
    maestro:hasIdentifier tes:ID_DI_DownstreamFree_BMK,
        tes:ID_DI_DownstreamFree_Bit,
        tes:ID_DI_DownstreamFree_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:DI_EjectorRetracted a maestro:ParameterDef ;
    rdfs:label "Ejecting cylinder retracted"@en ;
    maestro:description "Retracted end position of 2A1."@en ;
    maestro:hasIdentifier tes:ID_DI_EjectorRetracted_BMK,
        tes:ID_DI_EjectorRetracted_Bit,
        tes:ID_DI_EjectorRetracted_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:DI_HeightOK a maestro:ParameterDef ;
    rdfs:label "Comparator: workpiece height correct"@en ;
    maestro:description "Comparator output 'OK' (MID): 1 = height inside the LEVEL1-LEVEL2 window."@en ;
    maestro:hasIdentifier tes:ID_DI_HeightOK_BMK, tes:ID_DI_HeightOK_Bit, tes:ID_DI_HeightOK_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:DI_LiftLowered a maestro:ParameterDef ;
    rdfs:label "Lifting cylinder lowered"@en ;
    maestro:description "Lower end position of 1A1."@en ;
    maestro:hasIdentifier tes:ID_DI_LiftLowered_BMK,
        tes:ID_DI_LiftLowered_Bit,
        tes:ID_DI_LiftLowered_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:DI_LiftRaised a maestro:ParameterDef ;
    rdfs:label "Lifting cylinder raised"@en ;
    maestro:description "Upper end position of 1A1."@en ;
    maestro:hasIdentifier tes:ID_DI_LiftRaised_BMK,
        tes:ID_DI_LiftRaised_Bit,
        tes:ID_DI_LiftRaised_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:DI_NotBlack a maestro:ParameterDef ;
    rdfs:label "Not black workpiece"@en ;
    maestro:description "Diffuse sensor; 1 = red or silver workpiece, 0 = black."@en ;
    maestro:hasIdentifier tes:ID_DI_NotBlack_BMK, tes:ID_DI_NotBlack_Bit, tes:ID_DI_NotBlack_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:DI_SafetyLightBarrier a maestro:ParameterDef ;
    rdfs:label "Safety light barrier"@en ;
    maestro:description "Retro-reflective sensor over the working area of the Lifting module. Logic level for 'free' not stated; the reset needs 'safety light barrier unbroken'."@en ;
    maestro:hasIdentifier tes:ID_DI_SafetyLightBarrier_BMK,
        tes:ID_DI_SafetyLightBarrier_Bit,
        tes:ID_DI_SafetyLightBarrier_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:DI_WorkpieceAvailable a maestro:ParameterDef ;
    rdfs:label "Workpiece available"@en ;
    maestro:description "Capacitive sensor in the Recognition module; 1 = workpiece in the retainer, any colour."@en ;
    maestro:hasIdentifier tes:ID_DI_WorkpieceAvailable_BMK,
        tes:ID_DI_WorkpieceAvailable_Bit,
        tes:ID_DI_WorkpieceAvailable_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Output .

tes:DO_AirSlideOn a maestro:ParameterDef ;
    rdfs:label "Air slider on"@en ;
    maestro:description "1 = air cushion of the upper slide on."@en ;
    maestro:hasIdentifier tes:ID_DO_AirSlideOn_BMK,
        tes:ID_DO_AirSlideOn_Bit,
        tes:ID_DO_AirSlideOn_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:DO_ExtendEjector a maestro:ParameterDef ;
    rdfs:label "Extend ejecting cylinder"@en ;
    maestro:description "1 = extend; single solenoid, spring return."@en ;
    maestro:hasIdentifier tes:ID_DO_ExtendEjector_BMK,
        tes:ID_DO_ExtendEjector_Bit,
        tes:ID_DO_ExtendEjector_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:DO_LowerLift a maestro:ParameterDef ;
    rdfs:label "Lower lifting cylinder"@en ;
    maestro:description "1 = lower (valve 1V1)."@en ;
    maestro:hasIdentifier tes:ID_DO_LowerLift_BMK, tes:ID_DO_LowerLift_Bit, tes:ID_DO_LowerLift_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:DO_RaiseLift a maestro:ParameterDef ;
    rdfs:label "Raise lifting cylinder"@en ;
    maestro:description "1 = raise (valve 1V1)."@en ;
    maestro:hasIdentifier tes:ID_DO_RaiseLift_BMK, tes:ID_DO_RaiseLift_Bit, tes:ID_DO_RaiseLift_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:DO_StationOccupied a maestro:ParameterDef ;
    rdfs:label "Station occupied"@en ;
    maestro:description "StationLink transmitter towards the upstream station; switched on/off to signal ready/busy (polarity not stated)."@en ;
    maestro:hasIdentifier tes:ID_DO_StationOccupied_BMK,
        tes:ID_DO_StationOccupied_Bit,
        tes:ID_DO_StationOccupied_Pin ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:TD_AirConsumption a maestro:ParameterDef ;
    rdfs:label "Compressed-air supply, suction capacity approx. 50 l/min"@en ;
    maestro:description "Compressed-air supply named for commissioning (approximate value)."@en ;
    maestro:maxValue 50.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:unitRef "http://qudt.org/vocab/unit/L-PER-MIN"^^xsd:anyURI .

tes:TD_AirSlideCapacity a maestro:ParameterDef ;
    rdfs:label "Air cushioned slide capacity: 5 workpieces"@en ;
    maestro:description "With the mechanical stopper fitted."@en ;
    maestro:maxValue 5.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:TD_DigitalInputs a maestro:ParameterDef ;
    rdfs:label "Digital inputs: 7"@en ;
    maestro:description "Number of digital inputs in the technical-data table."@en ;
    maestro:maxValue 7.0 ;
    maestro:minValue 7.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:TD_DigitalOutputs a maestro:ParameterDef ;
    rdfs:label "Digital outputs: 5"@en ;
    maestro:description "Number of digital outputs in the technical-data table."@en ;
    maestro:maxValue 5.0 ;
    maestro:minValue 5.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:TD_LowerSlideCapacity a maestro:ParameterDef ;
    rdfs:label "Lower slide capacity: 4 workpieces"@en ;
    maestro:description "Slide module 210 with stopper fitted; receives rejected workpieces."@en ;
    maestro:maxValue 4.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input .

tes:TD_MaxPressure a maestro:ParameterDef ;
    rdfs:label "Maximum permissible pressure 8 bar"@en ;
    maestro:description "'Do not exceed' limit of the safety chapter."@en ;
    maestro:maxValue 8.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:unitRef "http://qudt.org/vocab/unit/BAR"^^xsd:anyURI .

tes:TD_MeasuringModuleHeight a maestro:ParameterDef ;
    rdfs:label "Measuring module mounting height 240 mm"@en ;
    maestro:description "Top edge of the profile plate to the bottom edge of the measuring-module bracket (commissioning)."@en ;
    maestro:maxValue 240.0 ;
    maestro:minValue 240.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:unitRef "http://qudt.org/vocab/unit/MilliM"^^xsd:anyURI .

tes:TD_OperatingPressure a maestro:ParameterDef ;
    rdfs:label "Operating pressure 6 bar"@en ;
    maestro:description "Service unit setting. Operating pressure 6 bar (600 kPa)."@en ;
    maestro:maxValue 6.0 ;
    maestro:minValue 6.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:unitRef "http://qudt.org/vocab/unit/BAR"^^xsd:anyURI .

tes:TD_SupplyCurrent a maestro:ParameterDef ;
    rdfs:label "Supply current 4.5 A"@en ;
    maestro:description "Technical data 4.5 A; section 'voltage supply' says max. 5 A."@en ;
    maestro:maxValue 4.5 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:unitRef "http://qudt.org/vocab/unit/A"^^xsd:anyURI .

tes:TD_SupplyVoltage a maestro:ParameterDef ;
    rdfs:label "Supply voltage 24 V DC"@en ;
    maestro:description "Power supply unit 24 V DC; the whole station is supplied through the PLC board."@en ;
    maestro:maxValue 24.0 ;
    maestro:minValue 24.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:unitRef "http://qudt.org/vocab/unit/V"^^xsd:anyURI .

tes:T_AirSlideOn a maestro:ParameterDef ;
    rdfs:label "Air slide on time 3 s (3s/X14)"@en ;
    maestro:description "Air cushion stays on 3 s after ejection, or until the downstream station is occupied."@en ;
    maestro:maxValue 3.0 ;
    maestro:minValue 3.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:unitRef "http://qudt.org/vocab/unit/SEC"^^xsd:anyURI .

tes:T_MeasuringDwell a maestro:ParameterDef ;
    rdfs:label "Measuring dwell time 2 s (2s/X12)"@en ;
    maestro:description "GRAFCET timer before the height result is evaluated."@en ;
    maestro:maxValue 2.0 ;
    maestro:minValue 2.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:unitRef "http://qudt.org/vocab/unit/SEC"^^xsd:anyURI .

tes:T_RecognitionDwell a maestro:ParameterDef ;
    rdfs:label "Recognition dwell time 3 s (3s/X9, 3s/X10)"@en ;
    maestro:description "GRAFCET timer before the lifting cylinder rises."@en ;
    maestro:maxValue 3.0 ;
    maestro:minValue 3.0 ;
    maestro:paramType "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI ;
    maestro:parameterDirection maestro:Input ;
    maestro:unitRef "http://qudt.org/vocab/unit/SEC"^^xsd:anyURI .

tes:Pre_DetectMaterial a maestro:Precondition ;
    rdfs:label "Workpiece available"@en ;
    maestro:expression "DI_WorkpieceAvailable == 1" .

tes:Pre_MeasureHeight a maestro:Precondition ;
    rdfs:label "Lifting cylinder raised"@en ;
    maestro:expression "DI_LiftRaised == 1" .

tes:Pre_RaiseLiftingCylinder a maestro:Precondition ;
    rdfs:label "Working area free"@en ;
    maestro:expression "safety light barrier unbroken (DI_SafetyLightBarrier)" .

tes:Pre_ResetStation a maestro:Precondition ;
    rdfs:label "RESET pressed and safety light barrier unbroken"@en ;
    maestro:expression "CC_Reset == 1 && working area free (DI_SafetyLightBarrier)" .

tes:Pre_TestWorkpiece a maestro:Precondition ;
    rdfs:label "Workpiece in the retainer, working area free, START pressed"@en ;
    maestro:expression "DI_WorkpieceAvailable == 1 && working area free && CC_Start == 1" .

tes:Post_DetectMaterial a maestro:Postcondition ;
    rdfs:label "Material class known"@en ;
    maestro:expression "black := DI_WorkpieceAvailable && !DI_NotBlack" .

tes:Post_EjectWorkpiece a maestro:Postcondition ;
    rdfs:label "Workpiece ejected"@en ;
    maestro:expression "DI_EjectorRetracted == 1 after the extend stroke" .

tes:Post_LowerLiftingCylinder a maestro:Postcondition ;
    rdfs:label "Lifting cylinder lowered"@en ;
    maestro:expression "DI_LiftLowered == 1" .

tes:Post_MeasureHeight a maestro:Postcondition ;
    rdfs:label "Height result known"@en ;
    maestro:expression "heightOk := DI_HeightOK after 2 s" .

tes:Post_RaiseLiftingCylinder a maestro:Postcondition ;
    rdfs:label "Lifting cylinder raised"@en ;
    maestro:expression "DI_LiftRaised == 1" .

tes:Post_ResetStation a maestro:Postcondition ;
    rdfs:label "Initial position: lifting cylinder lowered, ejecting cylinder retracted, air slide off"@en ;
    maestro:expression "DI_LiftLowered == 1 && DI_EjectorRetracted == 1 && DO_AirSlideOn == 0" .

tes:Post_TestWorkpiece a maestro:Postcondition ;
    rdfs:label "Good workpiece on the air cushioned slide or rejected workpiece on the lower slide"@en ;
    maestro:expression "heightOk ? workpiece passed downstream : workpiece on lower slide" .

#################################################################
# core/recipe.ttl
#################################################################

tes:ControlSequence a maestro:Recipe ;
    rdfs:label "Testing station control sequence (GRAFCET, 1-bit link)"@en ;
    maestro:description "Function chart according to DIN EN 60848 (IEC 60848) for the Testing station, '1-bit-link'. Timers 3s/X9, 3s/X10, 2s/X12, 3s/X14. Accept: '2s/X12 and height ok and downstream station free'; reject: '2s/X12 and invalid height'."@en ;
    maestro:hasStep tes:X10,
        tes:X11,
        tes:X12,
        tes:X13,
        tes:X14,
        tes:X15,
        tes:X16,
        tes:X17,
        tes:X2,
        tes:X3,
        tes:X4,
        tes:X7,
        tes:X8,
        tes:X9 ;
    maestro:version "DE 01/04" .

tes:X10 a maestro:PlanStep ;
    rdfs:label "Step 10 - 'material' indicator light off"@en ;
    maestro:description "Turns off the 'material' light and sets 'station occupied'."@en ;
    maestro:hasControlFlow tes:CF_X10_X11 ;
    maestro:realizedBy tes:DetectMaterial, tes:SetStationLinkSignal, tes:SwitchIndicatorLight ;
    maestro:stepOrder 10 .

tes:X11 a maestro:PlanStep ;
    rdfs:label "Step 11 - raise lifting cylinder"@en ;
    maestro:hasControlFlow tes:CF_X11_X12 ;
    maestro:realizedBy tes:RaiseLiftingCylinder ;
    maestro:stepOrder 11 .

tes:X12 a maestro:PlanStep ;
    rdfs:label "Step 12 - measure height (empty step)"@en ;
    maestro:hasControlFlow tes:CF_X12_X13, tes:CF_X12_X16 ;
    maestro:realizedBy tes:MeasureHeight ;
    maestro:stepOrder 12 .

tes:X13 a maestro:PlanStep ;
    rdfs:label "Step 13 - eject workpiece (accepted)"@en ;
    maestro:description "Ejects onto the air cushioned slide with the air cushion on."@en ;
    maestro:hasControlFlow tes:CF_X13_X14 ;
    maestro:realizedBy tes:EjectWorkpiece, tes:SwitchAirSlide ;
    maestro:stepOrder 13 .

tes:X14 a maestro:PlanStep ;
    rdfs:label "Step 14 - turn on air slide"@en ;
    maestro:hasControlFlow tes:CF_X14_X15 ;
    maestro:realizedBy tes:SwitchAirSlide ;
    maestro:stepOrder 14 .

tes:X15 a maestro:PlanStep ;
    rdfs:label "Step 15 - lower lifting cylinder"@en ;
    maestro:hasControlFlow tes:CF_X15_X7, tes:CF_X15_X8 ;
    maestro:realizedBy tes:LowerLiftingCylinder ;
    maestro:stepOrder 15 .

tes:X16 a maestro:PlanStep ;
    rdfs:label "Step 16 - lower lifting cylinder (rejected)"@en ;
    maestro:hasControlFlow tes:CF_X16_X17 ;
    maestro:realizedBy tes:LowerLiftingCylinder ;
    maestro:stepOrder 16 .

tes:X17 a maestro:PlanStep ;
    rdfs:label "Step 17 - eject workpiece (rejected)"@en ;
    maestro:description "Ejects onto the lower slide."@en ;
    maestro:hasControlFlow tes:CF_X17_X7, tes:CF_X17_X8 ;
    maestro:realizedBy tes:EjectWorkpiece ;
    maestro:stepOrder 17 .

tes:X2 a maestro:PlanStep ;
    rdfs:label "Step 2 - 'reset' indicator light"@en ;
    maestro:hasControlFlow tes:CF_X2_X3 ;
    maestro:realizedBy tes:SwitchIndicatorLight ;
    maestro:stepOrder 2 .

tes:X3 a maestro:PlanStep ;
    rdfs:label "Step 3 - move station to initial position"@en ;
    maestro:hasControlFlow tes:CF_X3_X4 ;
    maestro:realizedBy tes:ResetStation ;
    maestro:stepOrder 3 .

tes:X4 a maestro:PlanStep ;
    rdfs:label "Step 4 - eject workpiece"@en ;
    maestro:hasControlFlow tes:CF_X4_X7, tes:CF_X4_X8 ;
    maestro:realizedBy tes:EjectWorkpiece ;
    maestro:stepOrder 4 .

tes:X7 a maestro:PlanStep ;
    rdfs:label "Step 7 - 'start' indicator light"@en ;
    maestro:hasControlFlow tes:CF_X7_X8 ;
    maestro:realizedBy tes:SwitchIndicatorLight ;
    maestro:stepOrder 7 .

tes:X8 a maestro:PlanStep ;
    rdfs:label "Step 8 - station not occupied"@en ;
    maestro:hasControlFlow tes:CF_X8_X10, tes:CF_X8_X9 ;
    maestro:realizedBy tes:SetStationLinkSignal ;
    maestro:stepOrder 8 .

tes:X9 a maestro:PlanStep ;
    rdfs:label "Step 9 - 'material' indicator light on"@en ;
    maestro:description "Turns on the 'material' light and sets 'station occupied'."@en ;
    maestro:hasControlFlow tes:CF_X9_X11 ;
    maestro:realizedBy tes:DetectMaterial, tes:SetStationLinkSignal, tes:SwitchIndicatorLight ;
    maestro:stepOrder 9 .

tes:CF_X10_X11 a maestro:ControlFlowConstraint ;
    rdfs:label "X10 -> X11"@en ;
    maestro:expression "3s/X10 and workpiece not black" ;
    maestro:flowType maestro:Precedes ;
    maestro:targetStep tes:X11 .

tes:CF_X11_X12 a maestro:ControlFlowConstraint ;
    rdfs:label "X11 -> X12"@en ;
    maestro:expression "lifting cylinder raised" ;
    maestro:flowType maestro:Precedes ;
    maestro:targetStep tes:X12 .

tes:CF_X12_X13 a maestro:ControlFlowConstraint ;
    rdfs:label "X12 -> X13"@en ;
    maestro:expression "2s/X12 and height ok and downstream station free" ;
    maestro:flowType maestro:Alternative ;
    maestro:targetStep tes:X13 .

tes:CF_X12_X16 a maestro:ControlFlowConstraint ;
    rdfs:label "X12 -> X16"@en ;
    maestro:expression "2s/X12 and invalid height" ;
    maestro:flowType maestro:Alternative ;
    maestro:targetStep tes:X16 .

tes:CF_X13_X14 a maestro:ControlFlowConstraint ;
    rdfs:label "X13 -> X14"@en ;
    maestro:expression "workpiece ejected" ;
    maestro:flowType maestro:Precedes ;
    maestro:targetStep tes:X14 .

tes:CF_X14_X15 a maestro:ControlFlowConstraint ;
    rdfs:label "X14 -> X15"@en ;
    maestro:expression "3s/X14 or downstream station occupied" ;
    maestro:flowType maestro:Precedes ;
    maestro:targetStep tes:X15 .

tes:CF_X15_X7 a maestro:ControlFlowConstraint ;
    rdfs:label "X15 -> X7"@en ;
    maestro:expression "lifting cylinder lowered; flag 'cycle end' set (step 18); flag 'start' not set (via step 6)" ;
    maestro:flowType maestro:Loop ;
    maestro:targetStep tes:X7 .

tes:CF_X15_X8 a maestro:ControlFlowConstraint ;
    rdfs:label "X15 -> X8"@en ;
    maestro:expression "lifting cylinder lowered; flag 'cycle end' set (step 18); flag 'start' set (via step 6)" ;
    maestro:flowType maestro:Loop ;
    maestro:targetStep tes:X8 .

tes:CF_X16_X17 a maestro:ControlFlowConstraint ;
    rdfs:label "X16 -> X17"@en ;
    maestro:expression "lifting cylinder lowered" ;
    maestro:flowType maestro:Precedes ;
    maestro:targetStep tes:X17 .

tes:CF_X17_X7 a maestro:ControlFlowConstraint ;
    rdfs:label "X17 -> X7"@en ;
    maestro:expression "workpiece ejected; flag 'cycle end' set (step 18); flag 'start' not set (via step 6)" ;
    maestro:flowType maestro:Loop ;
    maestro:targetStep tes:X7 .

tes:CF_X17_X8 a maestro:ControlFlowConstraint ;
    rdfs:label "X17 -> X8"@en ;
    maestro:expression "workpiece ejected; flag 'cycle end' set (step 18); flag 'start' set (via step 6)" ;
    maestro:flowType maestro:Loop ;
    maestro:targetStep tes:X8 .

tes:CF_X2_X3 a maestro:ControlFlowConstraint ;
    rdfs:label "X2 -> X3"@en ;
    maestro:expression "'reset' button pressed and safety light barrier unbroken" ;
    maestro:flowType maestro:Precedes ;
    maestro:targetStep tes:X3 .

tes:CF_X3_X4 a maestro:ControlFlowConstraint ;
    rdfs:label "X3 -> X4"@en ;
    maestro:expression "station in initial position" ;
    maestro:flowType maestro:Precedes ;
    maestro:targetStep tes:X4 .

tes:CF_X4_X7 a maestro:ControlFlowConstraint ;
    rdfs:label "X4 -> X7"@en ;
    maestro:expression "workpiece ejected; flag 'reset finished' set (step 5); flag 'start' not set (via step 6)" ;
    maestro:flowType maestro:Alternative ;
    maestro:targetStep tes:X7 .

tes:CF_X4_X8 a maestro:ControlFlowConstraint ;
    rdfs:label "X4 -> X8"@en ;
    maestro:expression "workpiece ejected; flag 'reset finished' set (step 5); flag 'start' set (via step 6)" ;
    maestro:flowType maestro:Alternative ;
    maestro:targetStep tes:X8 .

tes:CF_X7_X8 a maestro:ControlFlowConstraint ;
    rdfs:label "X7 -> X8"@en ;
    maestro:expression "flag 'start' is set" ;
    maestro:flowType maestro:Precedes ;
    maestro:targetStep tes:X8 .

tes:CF_X8_X10 a maestro:ControlFlowConstraint ;
    rdfs:label "X8 -> X10"@en ;
    maestro:expression "workpiece available and not black" ;
    maestro:flowType maestro:Alternative ;
    maestro:targetStep tes:X10 .

tes:CF_X8_X9 a maestro:ControlFlowConstraint ;
    rdfs:label "X8 -> X9"@en ;
    maestro:expression "workpiece available and black" ;
    maestro:flowType maestro:Alternative ;
    maestro:targetStep tes:X9 .

tes:CF_X9_X11 a maestro:ControlFlowConstraint ;
    rdfs:label "X9 -> X11"@en ;
    maestro:expression "3s/X9 and workpiece black" ;
    maestro:flowType maestro:Precedes ;
    maestro:targetStep tes:X11 .

#################################################################
# core/product.ttl
#################################################################

tes:StationType a maestro:ProductType ;
    rdfs:label "Festo MPS Testing station (equipment type)"@en ;
    maestro:description "The station as a Festo product; its bill of materials follows the parts list and the component tables of the documents."@en ;
    maestro:hasBOMItem tes:BOM_Accessories,
        tes:BOM_AirSlide,
        tes:BOM_CableGuide,
        tes:BOM_Connectors,
        tes:BOM_Holder,
        tes:BOM_IOTerminal,
        tes:BOM_Lifting,
        tes:BOM_LowerSlide,
        tes:BOM_Measuring,
        tes:BOM_MountingSystem,
        tes:BOM_ProfilePlate,
        tes:BOM_Recognition,
        tes:BOM_RetroReflectiveSensor,
        tes:BOM_ServiceUnit,
        tes:BOM_StationLinkReceiver,
        tes:BOM_StationLinkTransmitter,
        tes:BOM_ValveTerminal ;
    maestro:hasIdentifier tes:ID_ManualOrderNo, tes:ID_StationMaterialNo ;
    maestro:manufacturer "Festo Didactic GmbH & Co. KG" ;
    maestro:model "MPS Testing station (PR)" .

